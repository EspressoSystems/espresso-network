      },
      "GetCirculatingSupplyEthereumRequest": {
        "description": "Request for the circulating supply on Ethereum L1 (no parameters)",
        "properties": {},
        "type": "object"
      },
      "GetCirculatingSupplyRequest": {
        "description": "Request for the circulating supply (no parameters)",
