{
  "components": {
    "schemas": {
      "BLSPublicKey": {
        "properties": {
          "key": {
            "description": "TaggedBase64, e.g. \"BLS_VER_KEY~AAA...\"",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BlockHeightResponse": {
        "properties": {
          "height": {
            "description": "Height of the latest decided block",
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BlockRewardResponse": {
        "properties": {
          "amount": {
            "description": "Reward distributed per block, in wei (decimal string); absent when the node does not know\na reward for the epoch",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CirculatingSupplyEthereumResponse": {
        "properties": {
          "amount": {
            "description": "Circulating supply of ESP tokens on Ethereum L1, in ESP (decimal string):\ntotal_supply_l1 - locked",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CirculatingSupplyResponse": {
        "properties": {
          "amount": {
            "description": "Circulating supply in ESP (decimal string): initial_supply + reward_distributed -\nlocked, following the mainnet unlock schedule",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "Error response following the Google API error model",
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "HTTP status code",
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "gRPC status name, e.g. NOT_FOUND",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "NodeKeysResponse": {
        "properties": {
          "consensusKey": {
            "$ref": "#/components/schemas/BLSPublicKey"
          },
          "ethAccount": {
            "description": "Ethereum account associated with this node, 0x-prefixed hex",
            "type": "string"
          },
          "stateVerKey": {
            "$ref": "#/components/schemas/SchnorrPublicKey"
          },
          "x25519Key": {
            "description": "X25519 public key for cliquenet, TaggedBase64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PayloadSizeResponse": {
        "properties": {
          "bytes": {
            "description": "Cumulative payload size in bytes",
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ResourceSyncStatus": {
        "properties": {
          "missing": {
            "description": "Number of missing objects, not counting pruned ones",
            "format": "uint64",
            "type": "string"
          },
          "ranges": {
            "description": "Contiguous height ranges sharing one status, in ascending order",
            "items": {
              "$ref": "#/components/schemas/SyncStatusRange"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "SchnorrPublicKey": {
        "properties": {
          "key": {
            "description": "TaggedBase64, e.g. \"SCHNORR_VER_KEY~AAA...\"",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SuccessRateResponse": {
        "properties": {
          "rate": {
            "description": "Fraction of views in which this node decided a block. Node-local, not a network measure.\nZero before the node has seen any view, so a fresh node reports zero rather than an\nundefined ratio.",
            "type": "number"
          }
        },
        "type": "object"
      },
      "SyncStatus": {
        "description": "Whether this node stores an object, still has to fetch it, or deleted it on purpose\n\n- `SYNC_STATUS_MISSING`: Not stored yet; the node fetches it from peers in the background\n- `SYNC_STATUS_PRUNED`: Deleted by the pruner; the node will not fetch it again",
        "enum": [
          "SYNC_STATUS_UNSPECIFIED",
          "SYNC_STATUS_PRESENT",
          "SYNC_STATUS_MISSING",
          "SYNC_STATUS_PRUNED"
        ],
        "type": "string"
      },
      "SyncStatusRange": {
        "properties": {
          "end": {
            "description": "Height just past the last one in the range (exclusive)",
            "format": "uint64",
            "type": "string"
          },
          "start": {
            "description": "First height in the range (inclusive)",
            "format": "uint64",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SyncStatus"
          }
        },
        "type": "object"
      },
      "SyncStatusResponse": {
        "properties": {
          "blocks": {
            "$ref": "#/components/schemas/ResourceSyncStatus"
          },
          "leaves": {
            "$ref": "#/components/schemas/ResourceSyncStatus"
          },
          "prunedHeight": {
            "description": "Height of the last pruned object: everything at or below it is pruned rather than missing.\nAbsent when nothing has been pruned",
            "format": "uint64",
            "type": "string"
          },
          "vidCommon": {
            "$ref": "#/components/schemas/ResourceSyncStatus"
          }
        },
        "type": "object"
      },
      "TimeSinceLastDecideResponse": {
        "properties": {
          "seconds": {
            "description": "Seconds elapsed since this node last decided a block",
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TotalIssuedSupplyResponse": {
        "properties": {
          "amount": {
            "description": "Total issued supply in ESP (decimal string): initial_supply +\ntotal_reward_distributed, including rewards not yet claimed on Ethereum",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TotalMintedSupplyResponse": {
        "properties": {
          "amount": {
            "description": "Total supply of the ESP token minted on Ethereum, in ESP (decimal string);\nexcludes unclaimed rewards",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TotalRewardDistributedResponse": {
        "properties": {
          "amount": {
            "description": "Total rewards distributed by consensus, in ESP (decimal string), including rewards\nnot yet claimed on Ethereum",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TransactionCountResponse": {
        "properties": {
          "count": {
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Generated from the proto definitions in crates/espresso/api/proto/v2. JSON follows canonical protoJSON: camelCase field names, 64-bit integers as decimal strings, bytes as base64, enums as their value names, oneofs flattened, defaults omitted. Query parameters accept both the proto field name and its camelCase form.",
    "title": "Espresso Node API v2",
    "version": "2"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v2/node/block-reward": {
      "get": {
        "operationId": "GetBlockReward",
        "parameters": [
          {
            "description": "Epoch whose block reward to report; when absent, the protocol-wide reward used before\nrewards became epoch-dependent",
            "in": "query",
            "name": "epoch",
            "required": false,
            "schema": {
              "format": "uint64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlockRewardResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error, following the Google API error model"
          }
        },
        "summary": "Get the block reward for an epoch",
        "tags": [
          "Node"
        ]
      }
    },
    "/v2/node/payload-size": {
      "get": {
        "operationId": "GetPayloadSize",
        "parameters": [
          {
            "description": "Lowest block height to include; the genesis block when absent",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "uint64",
              "type": "integer"
            }
          },
          {
            "description": "Highest block height to include (inclusive); the latest aggregated block when absent,\nwhich can lag the chain tip",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "uint64",
              "type": "integer"
            }
          },
          {
            "description": "Measure only this namespace's payload data; every namespace when absent",
            "in": "query",
            "name": "namespace",
            "required": false,
            "schema": {
              "format": "uint64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayloadSizeResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error, following the Google API error model"
          }
        },
        "summary": "Get the cumulative payload size of a block range, optionally of one namespace",
        "tags": [
          "Node"
        ]
      }
    },
