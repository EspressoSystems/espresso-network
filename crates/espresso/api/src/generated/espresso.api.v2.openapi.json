        "properties": {},
        "type": "object"
      },
      "GetTotalIssuedSupplyRequest": {
        "description": "Request for the total issued supply (no parameters)",
        "properties": {},
        "type": "object"
      },
      "GetTotalMintedSupplyRequest": {
        "description": "Request for the total minted supply (no parameters)",
        "properties": {},
        "type": "object"
      },
      "GetTotalRewardDistributedRequest": {
        "description": "Request for the total reward distributed (no parameters)",
        "properties": {},
        "type": "object"
      },
