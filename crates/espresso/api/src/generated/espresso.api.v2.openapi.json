{
  "components": {
    "schemas": {
      "BLSPublicKey": {
        "properties": {
          "key": {
            "description": "TaggedBase64, e.g. \"BLS_VER_KEY~AAA...\"",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BlockHeightResponse": {
        "properties": {
          "height": {
            "description": "Height of the latest decided block",
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BlockRewardResponse": {
        "properties": {
          "amount": {
            "description": "Reward distributed per block, in wei (decimal string); absent when the node does not know\na reward for the epoch",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CirculatingSupplyEthereumResponse": {
        "properties": {
          "amount": {
            "description": "Circulating supply of ESP tokens on Ethereum L1, in ESP (decimal string):\ntotal_supply_l1 - locked",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CirculatingSupplyResponse": {
        "properties": {
          "amount": {
            "description": "Circulating supply in ESP (decimal string): initial_supply + reward_distributed -\nlocked, following the mainnet unlock schedule",
            "type": "string"
          }
        },
        "type": "object"
      },
      "EnvResponse": {
        "properties": {
          "variables": {
            "description": "Only the variables the node's public-env-vars.toml allowlists",
            "items": {
              "$ref": "#/components/schemas/EnvVar"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "EnvVar": {
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "description": "Empty when the variable is not set",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "Error response following the Google API error model",
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "HTTP status code",
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "gRPC status name, e.g. NOT_FOUND",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "HotshotConfigResponse": {
        "description": "The consensus parameters this node runs with. The bootstrap peer lists of the v1 endpoint are\nnot repeated here; stake tables have their own endpoints",
        "properties": {
          "builderTimeoutMs": {
            "description": "Longest a leader waits for a builder's block before proposing without one",
            "format": "uint64",
            "type": "string"
          },
          "builderUrls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "daStakedCommitteeSize": {
            "format": "uint64",
            "type": "string"
          },
          "dataRequestDelayMs": {
            "description": "Wait before requesting the data behind a proposal from peers",
            "format": "uint64",
            "type": "string"
          },
          "drbDifficulty": {
            "description": "Iterations of the DRB computation",
            "format": "uint64",
            "type": "string"
          },
          "drbUpgradeDifficulty": {
            "description": "Iterations of the DRB computation after the DRB upgrade",
            "format": "uint64",
            "type": "string"
          },
          "epochHeight": {
            "description": "Blocks per epoch; zero before proof of stake",
            "format": "uint64",
            "type": "string"
          },
          "epochStartBlock": {
            "format": "uint64",
            "type": "string"
          },
          "nextViewTimeoutMs": {
            "format": "uint64",
            "type": "string"
          },
          "numNodesWithStake": {
            "format": "uint64",
            "type": "string"
          },
          "stakeTableCapacity": {
            "description": "Stake table size the light-client circuit is built for",
            "format": "uint64",
            "type": "string"
          },
          "startProposingTime": {
            "description": "Unix seconds from which this node proposes a consensus upgrade",
            "format": "uint64",
            "type": "string"
          },
          "startProposingView": {
            "description": "View from which this node proposes a consensus upgrade",
            "format": "uint64",
            "type": "string"
          },
          "startThresholdDenominator": {
            "format": "uint64",
            "type": "string"
          },
          "startThresholdNumerator": {
            "description": "Share of stake that must be online before consensus starts, as a fraction",
            "format": "uint64",
            "type": "string"
          },
          "startVotingTime": {
            "description": "Unix seconds from which this node votes for a consensus upgrade",
            "format": "uint64",
            "type": "string"
          },
          "startVotingView": {
            "description": "View from which this node votes for a consensus upgrade",
            "format": "uint64",
            "type": "string"
          },
          "stopProposingTime": {
            "description": "Unix seconds",
            "format": "uint64",
            "type": "string"
          },
          "stopProposingView": {
            "format": "uint64",
            "type": "string"
          },
          "stopVotingTime": {
            "description": "Unix seconds",
            "format": "uint64",
            "type": "string"
          },
          "stopVotingView": {
            "format": "uint64",
            "type": "string"
          },
          "viewSyncTimeoutMs": {
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "NodeIdentity": {
        "properties": {
          "companyName": {
            "type": "string"
          },
          "companyWebsite": {
            "type": "string"
          },
          "countryCode": {
            "description": "ISO 3166-1 alpha-2",
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "networkType": {
            "type": "string"
          },
          "nodeDescription": {
            "type": "string"
          },
          "nodeName": {
            "type": "string"
          },
          "nodeType": {
            "description": "Binary name and version unless the operator overrode it",
            "type": "string"
          },
          "operatingSystem": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "NodeKeysResponse": {
        "properties": {
          "consensusKey": {
            "$ref": "#/components/schemas/BLSPublicKey"
          },
          "ethAccount": {
            "description": "Ethereum account associated with this node, 0x-prefixed hex",
            "type": "string"
          },
          "stateVerKey": {
            "$ref": "#/components/schemas/SchnorrPublicKey"
          },
          "x25519Key": {
            "description": "X25519 public key for cliquenet, TaggedBase64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PayloadSizeResponse": {
        "properties": {
          "bytes": {
            "description": "Cumulative payload size in bytes",
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ResourceSyncStatus": {
        "properties": {
          "missing": {
            "description": "Number of missing objects, not counting pruned ones",
            "format": "uint64",
            "type": "string"
          },
          "ranges": {
            "description": "Contiguous height ranges sharing one status, in ascending order",
            "items": {
              "$ref": "#/components/schemas/SyncStatusRange"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "RuntimeConfigResponse": {
        "description": "The node's effective runtime configuration: CLI flags, environment and defaults merged. Tuning\nparameters and the genesis stay on v1; secrets are never served",
        "properties": {
          "builderUrls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cdnEndpoint": {
            "type": "string"
          },
          "cliquenetAdvertiseAddress": {
            "type": "string"
          },
          "cliquenetBindAddress": {
            "type": "string"
          },
          "configPeers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "genesisFile": {
            "description": "Path or URL the genesis was loaded from",
            "type": "string"
          },
          "identity": {
            "$ref": "#/components/schemas/NodeIdentity"
          },
          "isDa": {
            "type": "boolean"
          },
          "l1ProviderCount": {
            "description": "How many L1 RPC endpoints are configured; the URLs can carry credentials and are not served",
            "format": "uint64",
            "type": "string"
          },
          "l1WsProviderCount": {
            "format": "uint64",
            "type": "string"
          },
          "libp2pAdvertiseAddress": {
            "type": "string"
          },
          "libp2pBindAddress": {
            "type": "string"
          },
          "libp2pBootstrapNodes": {
            "description": "libp2p multiaddrs",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "orchestratorUrl": {
            "type": "string"
          },
          "publicApiUrl": {
            "type": "string"
          },
          "statePeers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "stateRelayServerUrl": {
            "type": "string"
          },
          "storageBackend": {
            "$ref": "#/components/schemas/StorageBackend"
          }
        },
        "type": "object"
      },
      "SchnorrPublicKey": {
        "properties": {
          "key": {
            "description": "TaggedBase64, e.g. \"SCHNORR_VER_KEY~AAA...\"",
            "type": "string"
          }
        },
        "type": "object"
      },
      "StorageBackend": {
        "description": "`STORAGE_BACKEND_FS_DEFAULT`: Filesystem storage with default settings, used when no storage flag was given",
        "enum": [
          "STORAGE_BACKEND_UNSPECIFIED",
          "STORAGE_BACKEND_SQL",
          "STORAGE_BACKEND_FS",
          "STORAGE_BACKEND_FS_DEFAULT"
        ],
        "type": "string"
      },
      "SuccessRateResponse": {
        "properties": {
          "rate": {
            "description": "Fraction of views in which this node decided a block. Node-local, not a network measure.\nZero before the node has seen any view, so a fresh node reports zero rather than an\nundefined ratio.",
            "type": "number"
          }
        },
        "type": "object"
      },
      "SyncStatus": {
        "description": "Whether this node stores an object, still has to fetch it, or deleted it on purpose\n`SYNC_STATUS_MISSING`: Not stored yet; the node fetches it from peers in the background\n`SYNC_STATUS_PRUNED`: Deleted by the pruner; the node will not fetch it again",
        "enum": [
          "SYNC_STATUS_UNSPECIFIED",
          "SYNC_STATUS_PRESENT",
          "SYNC_STATUS_MISSING",
          "SYNC_STATUS_PRUNED"
        ],
        "type": "string"
      },
      "SyncStatusRange": {
        "properties": {
          "end": {
            "description": "Height just past the last one in the range (exclusive)",
            "format": "uint64",
            "type": "string"
          },
          "start": {
            "description": "First height in the range (inclusive)",
            "format": "uint64",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SyncStatus"
          }
        },
        "type": "object"
      },
      "SyncStatusResponse": {
        "properties": {
          "blocks": {
            "$ref": "#/components/schemas/ResourceSyncStatus"
          },
          "leaves": {
            "$ref": "#/components/schemas/ResourceSyncStatus"
          },
          "prunedHeight": {
            "description": "Height of the last pruned object: everything below it is pruned rather than missing. Absent\nwhen nothing has been pruned",
            "format": "uint64",
            "type": "string"
          },
          "vidCommon": {
            "$ref": "#/components/schemas/ResourceSyncStatus"
          }
