      "U256": {
        "description": "U256 value encoded as hex string",
        "properties": {
          "value": {
            "description": "Hex-encoded value with \"0x\" prefix (e.g., \"0x32fe2fedb43f62b4ee2\")",
            "type": "string"
          }
        },
        "type": "object"
      }
