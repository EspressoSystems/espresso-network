{
  "components": {
    "schemas": {
      "BLSPublicKey": {
        "properties": {
          "key": {
            "description": "TaggedBase64, e.g. \"BLS_VER_KEY~AAA...\"",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BlockHeightResponse": {
        "properties": {
          "height": {
            "description": "Height of the latest decided block",
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Branch": {
        "description": "Branch node with hash and children",
        "properties": {
          "children": {
            "description": "Child nodes (up to 2 for binary tree)",
            "items": {
              "$ref": "#/components/schemas/MerkleNode"
            },
            "type": "array"
          },
          "value": {
            "description": "Hash value, TaggedBase64 format",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CirculatingSupplyEthereumResponse": {
        "properties": {
          "amount": {
            "description": "Circulating supply of ESP tokens on Ethereum L1, in ESP (decimal string):\ntotal_supply_l1 - locked",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CirculatingSupplyResponse": {
        "properties": {
          "amount": {
            "description": "Circulating supply in ESP (decimal string): initial_supply + reward_distributed -\nlocked, following the mainnet unlock schedule",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Empty": {
        "description": "Empty node variant (no data)",
        "properties": {},
        "type": "object"
      },
      "Error": {
        "description": "Error response following the Google API error model",
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "HTTP status code",
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "gRPC status name, e.g. NOT_FOUND",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "ForgottenSubtree": {
        "description": "Forgotten subtree node with hash only",
        "properties": {
          "value": {
            "description": "Hash value, TaggedBase64 format",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Leaf": {
        "description": "Leaf node containing account and reward amount",
        "properties": {
          "elem": {
            "description": "Reward amount (U256), TaggedBase64 format",
            "type": "string"
          },
          "pos": {
            "description": "Leaf position (account address), TaggedBase64 format",
            "type": "string"
          },
          "value": {
            "description": "Node hash value, TaggedBase64 format",
            "type": "string"
          }
        },
        "type": "object"
      },
      "MerkleNode": {
        "description": "Merkle tree node (one of four variants)",
        "properties": {
          "branch": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Branch"
              }
            ],
            "description": "Member of oneof `node_type`."
          },
          "empty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Empty"
              }
            ],
            "description": "Member of oneof `node_type`."
          },
          "forgottenSubtree": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ForgottenSubtree"
              }
            ],
            "description": "Member of oneof `node_type`."
          },
          "leaf": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Leaf"
              }
            ],
            "description": "Member of oneof `node_type`."
          }
        },
        "type": "object"
      },
      "MerkleProof": {
        "description": "Merkle proof containing leaf position and path to root",
        "properties": {
          "pos": {
            "description": "Leaf position (account address), TaggedBase64 format",
            "type": "string"
          },
          "proof": {
            "description": "Merkle path from leaf to root (160 levels for binary tree)",
            "items": {
              "$ref": "#/components/schemas/MerkleNode"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "NodeKeysResponse": {
        "properties": {
          "consensusKey": {
            "$ref": "#/components/schemas/BLSPublicKey"
          },
          "ethAccount": {
            "description": "Ethereum account associated with this node, 0x-prefixed hex",
            "type": "string"
          },
          "stateVerKey": {
            "$ref": "#/components/schemas/SchnorrPublicKey"
          },
          "x25519Key": {
            "description": "X25519 public key for cliquenet, TaggedBase64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RewardAccountProofV2": {
        "description": "Reward account proof containing account address and merkle path",
        "properties": {
          "account": {
            "description": "Ethereum address of the account",
            "type": "string"
          },
          "proof": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RewardMerkleProofV2"
              }
            ],
            "description": "Merkle proof (Presence or Absence)"
          }
        },
        "type": "object"
      },
      "RewardAccountQueryDataV2": {
        "description": "Complete reward account query data with balance and merkle proof",
        "properties": {
          "balance": {
            "description": "Current balance for this account (decimal string)",
            "type": "string"
          },
          "proof": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RewardAccountProofV2"
              }
            ],
            "description": "Merkle proof for this account"
          }
        },
        "type": "object"
      },
      "RewardAmount": {
        "description": "Single reward amount entry",
        "properties": {
          "address": {
            "description": "Ethereum address",
            "type": "string"
          },
          "amount": {
            "description": "Reward amount in wei (decimal string)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RewardBalance": {
        "description": "Reward balance for an address",
        "properties": {
          "amount": {
            "description": "Balance amount in wei (decimal string)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RewardBalances": {
        "description": "Paginated list of reward balances",
        "properties": {
          "amounts": {
            "description": "List of reward amounts in this page",
            "items": {
              "$ref": "#/components/schemas/RewardAmount"
            },
            "type": "array"
          },
          "total": {
            "description": "Total number of accounts with rewards at this height",
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RewardClaimInput": {
        "description": "Reward claim input for contract submission\nContains all data needed to call the claimRewards function on the L1 contract",
        "properties": {
          "address": {
            "description": "Ethereum address of the reward recipient",
            "type": "string"
          },
          "authData": {
            "description": "Auth data containing the Merkle proof and auth root inputs (hex-encoded with \"0x\" prefix)\nThis is the encoded RewardAuthData from the contract adapter",
            "type": "string"
          },
          "lifetimeRewards": {
            "description": "Total lifetime rewards for this address (hex-encoded with \"0x\" prefix for contract)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RewardMerkleProofV2": {
        "description": "Merkle proof variant (Presence for existing accounts, Absence for non-existing)",
        "properties": {
          "absence": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MerkleProof"
              }
            ],
            "description": "Member of oneof `proof_type`."
          },
          "presence": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MerkleProof"
              }
            ],
            "description": "Member of oneof `proof_type`."
          }
        },
        "type": "object"
      },
      "RewardMerkleTreeV2Data": {
        "description": "Raw RewardMerkleTreeV2 snapshot data",
        "properties": {
          "data": {
            "description": "Serialized merkle tree data",
            "format": "byte",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SchnorrPublicKey": {
        "properties": {
          "key": {
            "description": "TaggedBase64, e.g. \"SCHNORR_VER_KEY~AAA...\"",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SuccessRateResponse": {
        "properties": {
          "rate": {
            "description": "Fraction of views in which this node decided a block. Node-local, not a network measure.\nZero before the node has seen any view, so a fresh node reports zero rather than an\nundefined ratio.",
            "type": "number"
          }
        },
        "type": "object"
      },
      "TimeSinceLastDecideResponse": {
        "properties": {
          "seconds": {
            "description": "Seconds elapsed since this node last decided a block",
            "format": "uint64",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TotalIssuedSupplyResponse": {
        "properties": {
          "amount": {
            "description": "Total issued supply in ESP (decimal string): initial_supply +\ntotal_reward_distributed, including rewards not yet claimed on Ethereum",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TotalMintedSupplyResponse": {
        "properties": {
          "amount": {
            "description": "Total supply of the ESP token minted on Ethereum, in ESP (decimal string);\nexcludes unclaimed rewards",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TotalRewardDistributedResponse": {
        "properties": {
          "amount": {
            "description": "Total rewards distributed by consensus, in ESP (decimal string), including rewards\nnot yet claimed on Ethereum",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Generated from the proto definitions in crates/espresso/api/proto/v2. JSON follows canonical protoJSON: camelCase field names, 64-bit integers as decimal strings, bytes as base64, oneofs flattened, defaults omitted. Query parameters accept both the proto field name and its camelCase form.",
    "title": "Espresso Node API v2",
    "version": "2"
  },
