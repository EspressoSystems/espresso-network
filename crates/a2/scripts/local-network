#!/usr/bin/env bash
# Runs an a2 network on this machine: anvil as L1 with the Espresso contracts and the demo
# validators staked, and for each of the five validators of the demo genesis file a deployment of
# a consensus node, an ingester, a store service on Postgres and an API instance. Ingesters find
# the other deployments' API services through the validators' records, starting from the first.
# Node 4's ingester starts a minute late, so its store misses what node 4 freed meanwhile, and it
# fills that from the others. Logs go to RUNDIR. Stops everything on exit.
set -euo pipefail

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} RUNDIR

Run an a2 network, keeping its stores and logs in RUNDIR, which must not exist. Needs anvil on the
PATH or in the repository root, Postgres, and the binaries deploy, consensus-node, store-service,
ingester, api-service and staking-cli in target/PROFILE or target/debug.

The API services serve on http://127.0.0.1:24000 to http://127.0.0.1:24004, one per node.

ENVIRONMENT:
  GENESIS_FILE   The genesis file, data/genesis/demo-ff.toml by default
  PROFILE        The cargo profile whose binaries to run, debug by default
  EMPTY_BLOCK_DELAY
                 How long a leader without transactions waits before proposing an empty
                 block, e.g. 3ms; the consensus node's default if unset
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -ne 1 ]]; then
    usage
    exit 1
  fi
  local rundir=$1
  local root
  root=$(git rev-parse --show-toplevel)
  mkdir "$rundir"
  rundir=$(cd "$rundir" && pwd)
  cd "$root"

  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
  export PATH="$root/target/${PROFILE:-debug}:$root/target/debug:$root:$PATH"
  local l1="http://127.0.0.1:${ESPRESSO_L1_PORT}"
  local genesis=${GENESIS_FILE:-data/genesis/demo-ff.toml}

  # Expanded now: the trap runs after main's locals are gone.
  # shellcheck disable=SC2064
  trap "stop '$rundir'" EXIT
  trap 'exit 1' INT TERM

  anvil --host 127.0.0.1 --port "$ESPRESSO_L1_PORT" --chain-id 31337 --accounts 20 \
    --balance 1000000000 --block-time 1 --slots-in-an-epoch 32 >"$rundir/anvil.log" 2>&1 &
  wait_for_l1 "$l1"

  (
    unset ESPRESSO_FEE_CONTRACT_PROXY_ADDRESS ESP_TOKEN_PROXY_ADDRESS \
      ESPRESSO_STAKE_TABLE_PROXY_ADDRESS
    deploy --deploy-ops-timelock --deploy-safe-exit-timelock --deploy-fee-v1 \
      --deploy-esp-token-v1 --deploy-stake-table-v1 --upgrade-stake-table-v2 \
      --upgrade-stake-table-v3 --rpc-url "$l1"
  ) >"$rundir/deploy.log" 2>&1
  L1_PROVIDER=$l1 MNEMONIC=$ESPRESSO_ETH_MNEMONIC \
    ACCOUNT_INDEX=$ESP_TOKEN_INITIAL_GRANT_RECIPIENT_ACCOUNT_INDEX \
    ESP_TOKEN_CONTRACT_ADDRESS=$ESP_TOKEN_PROXY_ADDRESS \
    STAKE_TABLE_ADDRESS=$ESPRESSO_STAKE_TABLE_PROXY_ADDRESS \
    staking-cli --no-config stake-for-demo >"$rundir/stake.log" 2>&1
  # Stake tables come from finalized L1 blocks. Without the stake, the first epoch roots, which
  # fast blocks reach within the finality lag, give empty stake tables and the chain stops.
  wait_for_finalized "$l1" "$(l1_block "$l1" latest)"

  local pg_port=25432
  # Postgres keeps its socket in its data directory, whose path must stay short.
  local pg_data
  pg_data=$(mktemp -d)
  echo "$pg_data" >"$rundir/postgres-data"
  scripts/run-postgres "$pg_port" "$pg_data/data" >"$rundir/postgres.log" 2>&1 &
  until pg_isready -h 127.0.0.1 -p "$pg_port" >/dev/null 2>&1; do sleep 1; done
  sleep 2
  for i in 0 1 2 3 4; do
    local staking="ESPRESSO_DEMO_NODE_STAKING_PRIVATE_KEY_$i"
    local state="ESPRESSO_DEMO_NODE_STATE_PRIVATE_KEY_$i"
    local x25519="ESPRESSO_DEMO_NODE_X25519_PRIVATE_KEY_$i"
    local port="ESPRESSO_DEMO_NODE_CLIQUENET_PORT_$i"
    psql -h 127.0.0.1 -p "$pg_port" -U root -d espresso -c "CREATE DATABASE chain$i" >/dev/null
    store-service --address "127.0.0.1:$((8070 + i))" \
      --database "postgres://root@127.0.0.1:${pg_port}/chain$i" >"$rundir/store-$i.log" 2>&1 &
    ESPRESSO_NODE_PRIVATE_STAKING_KEY=${!staking} \
      ESPRESSO_NODE_PRIVATE_STATE_KEY=${!state} \
      ESPRESSO_NODE_PRIVATE_X25519_KEY=${!x25519} \
      consensus-node \
      --genesis-file "$genesis" \
      --l1-provider "$l1" \
      --store-path "$rundir/consensus-$i" \
      --bind-address "127.0.0.1:${!port}" \
      --api-address "127.0.0.1:$((9978 + i))" \
      --public-api-url "http://127.0.0.1:$((24000 + i))" \
      ${EMPTY_BLOCK_DELAY:+--empty-block-delay "$EMPTY_BLOCK_DELAY"} \
      >"$rundir/consensus-$i.log" 2>&1 &
  done

  sleep 5
  for i in 0 1 2 3 4; do
    api-service --port $((24000 + i)) --store "http://127.0.0.1:$((8070 + i))" \
      --consensus-api "127.0.0.1:$((9978 + i))" --genesis-file "$genesis" \
      >"$rundir/api-$i.log" 2>&1 &
    if ((i < 4)); then
      start_ingester "$rundir" "$i" "$genesis" "$l1"
    fi
  done

  echo "running; logs in $rundir"
  sleep 60
  start_ingester "$rundir" 4 "$genesis" "$l1"
  echo "ingester 4 started"
  wait
}

# Starts the ingester of node $2, from its consensus node into its store, with genesis file $3 and
# L1 $4. All but the first learn the other API services from the first.
start_ingester() {
  local bootstrap=()
  if (($2 > 0)); then
    bootstrap=(--bootstrap http://127.0.0.1:24000)
  fi
  ingester --consensus-api "127.0.0.1:$((9978 + $2))" --store "http://127.0.0.1:$((8070 + $2))" \
    --genesis-file "$3" --l1-provider "$4" --public-url "http://127.0.0.1:$((24000 + $2))" \
    "${bootstrap[@]}" >"$1/ingester-$2.log" 2>&1 &
}

# Stops every process and removes the Postgres data, which lives outside RUNDIR.
stop() {
  kill $(jobs -p) 2>/dev/null || true
  wait || true
  if [[ -f "$1/postgres-data" ]]; then
    rm -rf "$(cat "$1/postgres-data")"
  fi
}

# The number of the L1 block with tag $2 (latest, finalized, ...).
l1_block() {
  local body="{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"$2\",false],\"id\":1}"
  local hex
  hex=$(curl -s -H "Content-Type: application/json" --data "$body" "$1" |
    sed -n 's/.*"number":"0x\([0-9a-fA-F]*\)".*/\1/p')
  echo $((16#${hex:-0}))
}

# Waits until the L1 at $1 has finalized block $2.
wait_for_finalized() {
  echo "waiting for L1 block $2 to be finalized"
  until (($(l1_block "$1" finalized) >= $2)); do
    sleep 2
  done
}

wait_for_l1() {
  local body='{"jsonrpc":"2.0","method":"eth_chainId","params":[],"id":1}'
  until curl -s -H "Content-Type: application/json" --data "$body" "$1" >/dev/null; do
    sleep 1
  done
}

main "$@"
