#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["matplotlib", "pandas", "tabulate", "typer"]
# ///
r"""A/B the leader's block-build critical path between two git refs.

Runs the `request_block` benchmarks of the `block_build` bench in espresso-types, which call the
leader's own code (`from_transactions` and new-protocol's `block_commitments`), for a base and a
head ref. Prints a markdown table with the total and one row per step, and draws a waterfall of
the steps.

    just bench-block-build                      # origin/main vs HEAD
    just bench-block-build main my-branch
    scripts/bench-block-build --filter 'request_block/50MB' --repeats 5 main HEAD
    scripts/bench-block-build --malloc default --malloc hugetlb main HEAD
    scripts/bench-block-build --chart tmp/bench-block-build/<base>-<head>.csv

Method:
    Each ref is built once in a temporary git worktree; binaries are cached by commit in
    tmp/bench-block-build/bin. Each benchmark runs in its own process, because glibc's mmap
    threshold depends on what the process allocated earlier. Base and head alternate. Samples are
    pooled across repeats; the table also lists each run's median, so a noisy run stands out.
    Steps partly run in parallel, so they do not add up to the total.

    Runs use `GLIBC_TUNABLES=glibc.malloc.hugetlb=1` (the AWS bench node setting) by default.
    Without it, glibc maps every buffer of 32 MiB or more (64 MiB on worker threads) fresh per
    block in 4 KiB pages, and the page faults dominate and vary between runs.

Both refs must contain crates/espresso/types/benches/block_build.rs. Results go to
tmp/bench-block-build/<base>-<head>.{csv,md,svg}.
"""

import json
import logging
import os
import re
import shutil
import subprocess
from enum import Enum
from pathlib import Path
from typing import Annotated

import matplotlib.pyplot as plt
import pandas as pd
import typer

OUT = Path("tmp/bench-block-build")
BENCH_FILE = "crates/espresso/types/benches/block_build.rs"
DEFAULT_FILTER = r"^block_build/request_block/(30|50|70)MB_1000KB_t\d+_n100$"
# Waterfall lanes top to bottom: the whole build, its sequential prefix, the commitment phase and
# the steps inside it that run in parallel.
LANES = {
    "request_block": "#898781",
    "from_transactions": "#2a78d6",
    "block_commitments": "#c3c2b7",
    "encode": "#e87ba4",
    "transaction_commitments": "#eb6834",
    "vid_commitment": "#1baf7a",
    "builder_commitment": "#eda100",
}

log = logging.getLogger("bench-block-build")


class Malloc(str, Enum):
    default = "default"
    hugetlb = "hugetlb"


MALLOC_ENV = {
    Malloc.default: {},
    Malloc.hugetlb: {"GLIBC_TUNABLES": "glibc.malloc.hugetlb=1"},
}


def main(
    base: Annotated[str, typer.Argument()] = "origin/main",
    head: Annotated[str, typer.Argument()] = "HEAD",
    bench_filter: Annotated[
        str, typer.Option("--filter", help="regex over full benchmark ids")
    ] = DEFAULT_FILTER,
    repeats: Annotated[int, typer.Option(min=1)] = 3,
    malloc: Annotated[
        list[Malloc] | None,
        typer.Option(help="repeat to measure several; default hugetlb"),
    ] = None,
    dry_run: Annotated[
        bool, typer.Option(help="resolve refs and show the plan")
    ] = False,
    chart: Annotated[
        Path | None, typer.Option(help="redraw the SVG of a saved .csv")
    ] = None,
) -> None:
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    mallocs = malloc or [Malloc.hugetlb]
    if chart:
        waterfall(pd.read_csv(chart), chart.with_suffix(".svg"))
        return
    refs = {"base": base, "head": head}
    shas = {
        side: git("rev-parse", "--verify", f"{ref}^{{commit}}")
        for side, ref in refs.items()
    }
    for side, sha in shas.items():
        log.info("%s %s = %s (%s)", side, refs[side], sha[:10], cache_state(sha))
        if subprocess.run(
            ["git", "cat-file", "-e", f"{sha}:{BENCH_FILE}"],
            check=False,
            capture_output=True,
        ).returncode:
            raise SystemExit(f"{side} {refs[side]} has no {BENCH_FILE}")
    log.info(
        "filter %s, %d repeats, malloc %s",
        bench_filter,
        repeats,
        [m.value for m in mallocs],
    )
    if dry_run:
        return

    binaries = {side: build(sha) for side, sha in shas.items()}
    names = [n for n in list_benches(binaries["head"]) if re.search(bench_filter, n)]
    if not names:
        raise SystemExit(f"no benchmark matches {bench_filter!r}")
    labels = {side: f"{side} {refs[side]} {shas[side][:10]}" for side in refs}
    runs = measure(binaries, labels, names, mallocs, repeats)

    stem = OUT / f"{shas['base'][:10]}-{shas['head'][:10]}"
    runs.to_csv(stem.with_suffix(".csv"), index=False)
    table = summarize(runs)
    print(table)
    stem.with_suffix(".md").write_text(
        f"{labels['base']}, {labels['head']}\n\n{table}\n"
    )
    waterfall(runs, stem.with_suffix(".svg"))
    log.info("wrote %s.{csv,md,svg}", stem)


def measure(
    binaries: dict[str, Path],
    labels: dict[str, str],
    names: list[str],
    mallocs: list[Malloc],
    repeats: int,
) -> pd.DataFrame:
    """One row per sample: malloc, benchmark, side, label, rep, step, start, duration (ms)."""
    frames = []
    for rep in range(repeats):
        order = ["base", "head"] if rep % 2 == 0 else ["head", "base"]
        for malloc in mallocs:
            for name in names:
                for side in order:
                    run = run_one(binaries[side], name, MALLOC_ENV[malloc])
                    run = run.assign(
                        malloc=malloc.value, benchmark=name, side=side, rep=rep
                    )
                    frames.append(run.assign(label=labels[side]))
                    total = run.loc[run.step == "total", "duration"].median()
                    log.info(
                        "rep %d %s %s %s %.2f ms", rep, malloc.value, side, name, total
                    )
    return pd.concat(frames, ignore_index=True)


def summarize(runs: pd.DataFrame) -> str:
    """Markdown table: total, then each step both sides recorded, pooled over repeats."""
    pooled = runs.pivot_table(
        index=["malloc", "benchmark", "step"],
        columns="side",
        values="duration",
        aggfunc="median",
    ).dropna()
    per_run = runs.groupby(
        ["malloc", "benchmark", "step", "side", "rep"]
    ).duration.median()
    spread = per_run.groupby(level=[0, 1, 2, 3]).agg(
        lambda v: " ".join(f"{x:.2f}" for x in v)
    )
    table = pooled.assign(
        change=lambda t: (t["head"] / t["base"] - 1).map("{:+.1%}".format),
        base_runs=spread.xs("base", level="side"),
        head_runs=spread.xs("head", level="side"),
    ).reset_index()
    table["benchmark"] = table.benchmark.str.removeprefix("block_build/")
    table["order"] = table.step.ne("total")
    table = table.sort_values(["malloc", "benchmark", "order", "step"]).drop(
        columns="order"
    )
    return table.to_markdown(index=False, floatfmt=".2f")


def waterfall(runs: pd.DataFrame, path: Path) -> None:
    """One panel per malloc, benchmark and side: bars at each step's median start and duration."""
    steps = runs[runs.step.isin(LANES.keys())]
    medians = steps.groupby(["malloc", "benchmark", "label", "step"])[
        ["start", "duration"]
    ].median()
    panels = medians.index.droplevel("step").unique()
    fig, axes = plt.subplots(
        len(panels), sharex=True, squeeze=False, figsize=(10, 2.2 * len(panels))
    )
    for ax, panel in zip(axes[:, 0], panels, strict=True):
        bars = medians.loc[panel].reindex(list(LANES))
        lanes = range(len(LANES))
        ax.barh(
            lanes,
            bars.duration,
            left=bars.start,
            color=list(LANES.values()),
            height=0.6,
        )
        for lane, (start, duration) in zip(
            lanes, bars.itertuples(index=False), strict=True
        ):
            note = "not run" if pd.isna(duration) else f"{duration:.1f} ms"
            ax.text(
                0 if pd.isna(start) else start + duration,
                lane,
                f"  {note}",
                va="center",
            )
        ax.set_yticks(list(lanes), list(LANES))
        ax.invert_yaxis()
        ax.set_title(
            " · ".join(panel).replace("block_build/request_block/", ""), loc="left"
        )
        ax.grid(axis="x", color="#e1e0d9")
        ax.set_axisbelow(True)
    end = (medians.start + medians.duration).max()
    axes[-1, 0].set_xlim(0, end * 1.15)
    axes[-1, 0].set_xlabel(
        "ms since the build started; overlapping bars ran in parallel"
    )
    fig.tight_layout()
    fig.savefig(path)


def run_one(binary: Path, name: str, env: dict[str, str]) -> pd.DataFrame:
    home = OUT / "criterion"
    sample_file, steps_file = (
        home / name / "new" / "sample.json",
        home / name / "steps.json",
    )
    # A binary without this benchmark exits 0 and writes nothing; never read a previous run.
    sample_file.unlink(missing_ok=True)
    steps_file.unlink(missing_ok=True)
    run = subprocess.run(
        [binary, "--bench", "--noplot", f"^{re.escape(name)}$"],
        env={**os.environ, **env, "CRITERION_HOME": str(home.resolve())},
        check=False,
        capture_output=True,
        text=True,
    )
    if run.returncode or not sample_file.exists():
        raise SystemExit(f"{binary} {name} failed:\n{run.stderr}")
    sample = json.loads(sample_file.read_text())
    rows = [
        ("total", None, t / i / 1e6)
        for t, i in zip(sample["times"], sample["iters"], strict=True)
    ]
    # Steps start with criterion's warm-up iterations; keep one per measured iteration.
    measured = int(sum(sample["iters"]))
    steps = json.loads(steps_file.read_text()) if steps_file.exists() else {}
    rows += [
        (step, s, d) for step, spans in steps.items() for s, d in spans[-measured:]
    ]
    return pd.DataFrame(rows, columns=["step", "start", "duration"])


def list_benches(binary: Path) -> list[str]:
    out = subprocess.run(
        [binary, "--bench", "--list"], check=True, capture_output=True, text=True
    )
    return [
        line.removesuffix(": benchmark")
        for line in out.stdout.splitlines()
        if line.endswith(": benchmark")
    ]


def cache_state(sha: str) -> str:
    return "cached" if (OUT / "bin" / sha).exists() else "build in worktree"


def build(sha: str) -> Path:
    target = OUT / "bin" / sha
    if target.exists():
        return target
    worktree = (OUT / "worktrees" / sha).resolve()
    # A run killed mid-build leaves its worktree behind.
    shutil.rmtree(worktree, ignore_errors=True)
    git("worktree", "prune")
    git("worktree", "add", "--detach", str(worktree), sha)
    # Share build artifacts between refs unless the caller already picked a target dir.
    env = {"CARGO_TARGET_DIR": str((OUT / "target").resolve()), **os.environ}
    cargo = [
        "cargo",
        "bench",
        "-p",
        "espresso-types",
        "--bench",
        "block_build",
        "--no-run",
    ]
    try:
        log.info("building block_build at %s", sha[:10])
        out = subprocess.run(
            [*cargo, "--message-format=json"],
            cwd=worktree,
            env=env,
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        ).stdout
    finally:
        git("worktree", "remove", "--force", str(worktree))
    artifacts = [json.loads(line) for line in out.splitlines()]
    executable = next(
        a["executable"]
        for a in artifacts
        if a.get("reason") == "compiler-artifact"
        and a["target"]["name"] == "block_build"
        and a["executable"]
    )
    target.parent.mkdir(parents=True, exist_ok=True)
    partial = target.with_suffix(".partial")
    shutil.copy2(executable, partial)
    os.replace(partial, target)
    return target


def git(*args: str) -> str:
    run = subprocess.run(["git", *args], check=False, capture_output=True, text=True)
    if run.returncode:
        raise SystemExit(f"git {' '.join(args)} failed:\n{run.stderr.strip()}")
    return run.stdout.strip()


if __name__ == "__main__":
    typer.run(main)
