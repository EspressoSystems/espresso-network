#!/usr/bin/env python3
"""Symbolizes the newest jemalloc heap dump of every node of a `--heap-profile` run (see aws-bench)
into `<run_dir>/heap/<node>.txt`: total, top allocation sites by first non-allocator frame (flat)
and by cumulative bytes.

    heap-report RUN_DIR [--top N]

Reads `<run_dir>/hosts/<node>/jeprof/*.heap` and the node binaries `<run_dir>/espresso-node.bin`
(postgres) and `espresso-node-sqlite.bin`; the dump's MAPPED_LIBRARIES names which one a node ran.
Needs `readelf` and `nm` (binutils, in the devshell). `jeprof` is not used: it assumes ELF LOAD
segments have vaddr == file offset, which does not hold for our PIE binaries.
"""

import argparse
import bisect
import re
import subprocess
import sys
from collections import defaultdict
from collections.abc import Callable
from pathlib import Path
from typing import NamedTuple

BINARIES = {
    "espresso-node-postgres": "espresso-node.bin",
    "espresso-node-sqlite": "espresso-node-sqlite.bin",
}
MAX_NAME = 160
# Frames of the allocator and of std containers that only forward an allocation request.
ALLOCATOR_FRAME = re.compile(
    r"^(prof_|_rjem_|je_|do_rallocx|tikv_jemalloc|<?alloc::alloc|<?alloc::raw_vec|__rust_|<tikv_jemallocator"
    r"|alloc::vec::Vec<.*>::(with_capacity|reserve|push|extend)|<alloc::vec::Vec|core::ptr"
    r"|alloc::boxed|alloc::sync::Arc<.*>::new|<alloc::alloc|hashbrown::raw|alloc::slice"
    r"|<T as alloc::slice)"
)
MAPPING = re.compile(
    r"^([0-9a-f]+)-([0-9a-f]+) \S+ ([0-9a-f]+) \S+ \S+\s+(/\S*)$", re.MULTILINE
)
STACK = re.compile(r"^@ ([^\n]+)\n\s+t\*: \d+: (\d+)", re.MULTILINE)


class Segment(NamedTuple):
    start: int  # file offset
    end: int
    delta: int  # vaddr - file offset


class Mapping(NamedTuple):
    start: int  # runtime address
    end: int
    offset: int  # file offset of `start`
    path: str


class Stack(NamedTuple):
    addrs: list[int]
    nbytes: int


class Report(NamedTuple):
    total: int
    flat: dict[str, int]
    cumulative: dict[str, int]


def newest_dump(dumps: list[Path]) -> Path:
    """Newest by mtime: `prof_final` writes the last one at exit."""
    return max(dumps, key=lambda p: (p.stat().st_mtime, p.name))


def parse_segments(readelf_out: str) -> list[Segment]:
    """LOAD segments from `readelf -lW`: `LOAD offset vaddr paddr filesz memsz flags align`."""
    segments = []
    for line in readelf_out.splitlines():
        fields = line.split()
        if fields and fields[0] == "LOAD":
            offset, vaddr, filesz = (
                int(fields[1], 16),
                int(fields[2], 16),
                int(fields[4], 16),
            )
            segments.append(Segment(offset, offset + filesz, vaddr - offset))
    return segments


def parse_symbols(nm_out: str) -> tuple[list[int], list[str]]:
    """Code symbols of `nm -n -C --defined-only` as parallel (addresses, names), address-sorted."""
    pairs = []
    for line in nm_out.splitlines():
        fields = line.split(maxsplit=2)
        if len(fields) == 3 and fields[1] in "tTwW":
            pairs.append((int(fields[0], 16), fields[2]))
    return [a for a, _ in pairs], [n for _, n in pairs]


def parse_mappings(dump: str) -> list[Mapping]:
    return [
        Mapping(int(m[1], 16), int(m[2], 16), int(m[3], 16), m[4])
        for m in MAPPING.finditer(dump)
    ]


def parse_stacks(dump: str) -> list[Stack]:
    stacks = [
        Stack([int(a, 16) for a in m[1].split()], int(m[2]))
        for m in STACK.finditer(dump)
    ]
    return [s for s in stacks if s.nbytes > 0]


def mapped_binary(mappings: list[Mapping]) -> str:
    """Basename (a `BINARIES` key) of the node binary the dump was taken from."""
    names = {Path(m.path).name for m in mappings} & BINARIES.keys()
    if len(names) != 1:
        sys.exit(
            f"dump maps {sorted(names)} of {sorted(BINARIES)}; expected exactly one"
        )
    return names.pop()


def short(name: str) -> str:
    name = re.sub(r"::h[0-9a-f]{16}$", "", name)
    return name if len(name) < MAX_NAME else name[: MAX_NAME - 3] + "..."


def make_symbolizer(
    mappings: list[Mapping],
    segments: list[Segment],
    symbols: tuple[list[int], list[str]],
) -> Callable[[int], str | None]:
    """Runtime address -> file offset (mappings) -> vaddr (LOAD segments) -> symbol."""
    addrs, names = symbols

    def symbolize(addr: int) -> str | None:
        for m in mappings:
            if not m.start <= addr < m.end:
                continue
            offset = addr - m.start + m.offset
            for seg in segments:
                if seg.start <= offset < seg.end:
                    # Frames are return addresses: look up the call site.
                    i = bisect.bisect_right(addrs, offset + seg.delta - 1) - 1
                    return short(names[i]) if i >= 0 else None
        return None

    return symbolize


def aggregate(stacks: list[Stack], symbolize: Callable[[int], str | None]) -> Report:
    flat: dict[str, int] = defaultdict(int)
    cumulative: dict[str, int] = defaultdict(int)
    for stack in stacks:
        frames = [f for f in map(symbolize, stack.addrs) if f]
        for frame in set(frames):
            cumulative[frame] += stack.nbytes
        site = next(
            (f for f in frames if not ALLOCATOR_FRAME.match(f)),
            frames[0] if frames else "?",
        )
        flat[site] += stack.nbytes
    return Report(sum(s.nbytes for s in stacks), flat, cumulative)


def render(report: Report, top: int) -> str:
    def table(title: str, sizes: dict[str, int]) -> list[str]:
        rows = sorted(sizes.items(), key=lambda kv: -kv[1])[:top]
        return [
            "",
            f"-- {title} (top {top})",
            *(
                f"{b / 2**20:8.1f} MiB {100 * b / report.total:5.1f}%  {name}"
                for name, b in rows
            ),
        ]

    return "\n".join(
        [
            f"total in use (sampled estimate): {report.total / 2**20:.0f} MiB",
            *table("first non-allocator frame", report.flat),
            *table("cumulative", report.cumulative),
            "",
        ]
    )


def run_tool(*argv: str) -> str:
    return subprocess.run(argv, capture_output=True, text=True, check=True).stdout


def symbolize_dump(dump: Path, run_dir: Path, top: int) -> str:
    text = dump.read_text()
    mappings = parse_mappings(text)
    name = mapped_binary(mappings)
    binary = run_dir / BINARIES[name]
    symbolize = make_symbolizer(
        [m for m in mappings if Path(m.path).name == name],
        parse_segments(run_tool("readelf", "-lW", str(binary))),
        parse_symbols(run_tool("nm", "-n", "-C", "--defined-only", str(binary))),
    )
    return render(aggregate(parse_stacks(text), symbolize), top)


def report(run_dir: Path, top: int) -> None:
    out = run_dir / "heap"
    out.mkdir(exist_ok=True)
    nodes = sorted(d.parent.name for d in run_dir.glob("hosts/*/jeprof"))
    if not nodes:
        sys.exit(f"{run_dir}: no hosts/*/jeprof; run with --heap-profile")
    for node in nodes:
        dumps = list((run_dir / "hosts" / node / "jeprof").glob("*.heap"))
        if not dumps:
            print(f"{node}: no dumps", file=sys.stderr)
            continue
        dump = newest_dump(dumps)
        (out / f"{node}.txt").write_text(symbolize_dump(dump, run_dir, top))
        print(f"{node}: {dump.name} -> {out / node}.txt")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("run_dir", type=Path)
    parser.add_argument("--top", type=int, default=30, help="rows per table")
    args = parser.parse_args()
    report(args.run_dir, args.top)


if __name__ == "__main__":
    main()
