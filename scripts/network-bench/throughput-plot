#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["matplotlib", "numpy"]
# ///
"""Plots a run into `<run_dir>/throughput.png`, three to five panels over the same time axis:

- decided MB/s (consensus counters) against the MB/s the query node makes transactions available
  (`t_included` of `load.jsonl`), with the submitted rate as reference, and a tick per view
  timeout. Each step starts at a vertical line, is labelled with its target rate (`(r)` for a
  refine step, `stop` for a step stopped early) and drawn as a dashed target segment; the shaded
  band is its measured window, tinted when the step failed.
- mean block size (left, with genesis `max_block_size` dashed) and block interval (right) over
  the last SMOOTH_S.
- p50 submit until header on a validator over the last SMOOTH_S (left, log scale) and the
  transactions in flight (right).
- only with a non-empty `clients.jsonl`: p50 of how long after a validator showed a range's last
  block the light-client readers held it over the last SMOOTH_S (left, log scale) and the MB/s
  they fetched (right).

A run with `chaos.jsonl` (also an empty one, `--chaos-kinds none`) gets a view timeout floor panel
at the bottom: view timeouts per FLOOR_BIN_S, then the `stub`, `no-propose` and `no-vote1` node
log events per FLOOR_BIN_S, stacked by latency region (the FLOOR_GROUPS largest, the rest as
`other`). A run with faults also gets a panel on top with one lane per faulted node: a bar for each phase
of a fault (down, recovering, catching up) with a marker per event, ending in a red x when the
node did not recover; a mass restart is a dotted vertical line across the lanes. The other panels shade each fault until its node recovered. A run
without `consensus.jsonl` samples (it failed) has no decided, block or timeout series, and its
`run.json` is missing: the load starts at the first step.

    throughput-plot RUN_DIR
"""

import argparse
import json
import math
import re
from collections import Counter
from collections.abc import Sequence
from pathlib import Path

import chaos as ch
import matplotlib
import numpy as np
import tomllib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D

SMOOTH_S = 10
FLOOR_BIN_S = 10
FLOOR_GROUPS = 6
FLOOR_EVENTS = ("stub", "no-propose", "no-vote1")
GROUP_COLORS = ("#2a78d6", "#eb6834", "#2a9d8f", "#6b4fa0", "#e8a317", "#c8352c")
OTHER_COLOR = "#b9b7b1"
SURFACE = "#fcfcfb"
INK = "#52514e"
MUTED = "#898781"
DECIDED = "#2a78d6"
QUERY = "#eb6834"
BAND = "#f0efec"
BAND_FAILED = "#fbe3e2"
BAND_FAILED_INK = "#c8352c"
PHASES = (("down", "#6b4fa0"), ("recovering", "#e8a317"), ("catching up", "#2a9d8f"))
PHASE_COLOR = dict(PHASES)
EVENT_MARKERS = {"fault": "o", "started": "^", "rejoined": "s", "caught_up": "D"}
FAULT_SPAN = "#e8a317"
SIZE_UNITS = {"": 1, "b": 1, "kb": 1e3, "mb": 1e6, "gb": 1e9}
SIZE_UNITS |= {"kib": 2**10, "mib": 2**20, "gib": 2**30}


def decided_mb_s(counters: list[dict]) -> tuple[np.ndarray, np.ndarray]:
    """Rate between consecutive counter samples, at the later sample's time."""
    steps = np.array(ch.counter_increases(ch.counter_series(counters, "decided_bytes")))
    steps = steps.reshape(-1, 3)
    return steps[:, 1], steps[:, 2] / (steps[:, 1] - steps[:, 0]) / 1e6


def binned_bytes_mb_s(
    times: np.ndarray, sizes: np.ndarray, t0: float, t1: float, bin_s: float = 1.0
) -> tuple[np.ndarray, np.ndarray]:
    """MB/s of the events (`sizes` bytes each) whose time falls in each `bin_s` bin of
    `[t0, t1]`, at the bin's end."""
    bins = math.ceil((t1 - t0) / bin_s)
    edges = np.linspace(t0, t0 + bins * bin_s, bins + 1)
    total, _ = np.histogram(times, edges, weights=sizes)
    return edges[1:], total / bin_s / 1e6


def binned_mb_s(
    times: list[float], tx_size: int, t0: float, t1: float, bin_s: float = 1.0
) -> tuple[np.ndarray, np.ndarray]:
    """`binned_bytes_mb_s` of transactions of `tx_size` bytes."""
    return binned_bytes_mb_s(
        np.asarray(times), np.full(len(times), tx_size), t0, t1, bin_s
    )


def moving_mean(y: np.ndarray, w: int = SMOOTH_S) -> np.ndarray:
    """Centered mean; the window shrinks at the edges instead of reading zeros."""
    box = np.ones(w)
    return np.convolve(y, box, "same") / np.convolve(np.ones_like(y), box, "same")


def block_series(
    block_ts: np.ndarray, counters: list[dict], w: int = SMOOTH_S
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """Mean block interval (s) and size (MB) over the `w` s before each counter sample, from the
    first sample `w` s in; NaN where no block fell in the window."""
    total = np.array(ch.counter_total(counters, "decided_bytes")).T
    ts, decided = total
    keep = ts - w >= ts[0]
    ts, decided = ts[keep], decided[keep]
    before = np.interp(ts - w, *total)
    blocks = np.searchsorted(block_ts, ts, "right") - np.searchsorted(
        block_ts, ts - w, "right"
    )
    with np.errstate(divide="ignore", invalid="ignore"):
        interval = np.where(blocks > 0, w / blocks, np.nan)
        size = np.where(blocks > 0, (decided - before) / blocks / 1e6, np.nan)
    return ts, interval, size


def rolling_median(
    at: np.ndarray, values: np.ndarray, grid: np.ndarray, w: int = SMOOTH_S
) -> np.ndarray:
    """Median of the `values` whose time `at` falls in the `w` s before each grid point; NaN
    where none does."""
    order = np.argsort(at)
    at, values = at[order], values[order]
    lo = np.searchsorted(at, grid - w, "right")
    hi = np.searchsorted(at, grid, "right")
    return np.array(
        [np.median(values[a:b]) if b > a else np.nan for a, b in zip(lo, hi)]
    )


def in_flight(starts: np.ndarray, ends: np.ndarray, grid: np.ndarray) -> np.ndarray:
    """Transactions with `start <= t < end` at each grid point."""
    started = np.searchsorted(np.sort(starts), grid, "right")
    ended = np.searchsorted(np.sort(ends), grid, "right")
    return started - ended


def client_lag(
    clients: list[dict], on_validator: dict[int, float]
) -> tuple[np.ndarray, np.ndarray]:
    """Per served range: when the reader finished it and its lag in ms behind the validator
    that first showed its last block. Ranges of blocks no validator showed are left out."""
    served = [
        c
        for c in clients
        if c["status"] == "ok" and on_validator.get(c["end"] - 1) is not None
    ]
    done = np.array([c["t_done"] for c in served])
    lag = np.array([c["t_done"] - on_validator[c["end"] - 1] for c in served])
    return done, lag * 1000


def timeout_increments(counters: list[dict]) -> tuple[np.ndarray, np.ndarray]:
    """Sample times and the timeout count growth at each, as the floor counts it."""
    steps = np.array(ch.counter_increases(ch.counter_series(counters, "timeouts")))
    steps = steps.reshape(-1, 3)
    return steps[:, 1], steps[:, 2]


def timeout_times(counters: list[dict]) -> np.ndarray:
    """Counter sample times at which the view timeout count grew."""
    ts, growth = timeout_increments(counters)
    return ts[growth > 0]


def bin_counts(
    times: np.ndarray, weights: np.ndarray, t0: float, t1: float, bin_s: float
) -> tuple[np.ndarray, np.ndarray]:
    """Bin starts and the summed `weights` of the `times` within each `bin_s` bin of
    `[t0, t1]`."""
    bins = math.ceil((t1 - t0) / bin_s)
    edges = np.linspace(t0, t0 + bins * bin_s, bins + 1)
    total, _ = np.histogram(times, edges, weights=weights)
    return edges[:-1], total


def region_groups(regions: dict[str, str], top: int = FLOOR_GROUPS) -> dict[str, str]:
    """Node to group: its region when among the `top` regions by node count (ties by name),
    else `other`."""
    sizes = Counter(regions.values())
    kept = {r for r, _ in sorted(sizes.items(), key=lambda kv: (-kv[1], kv[0]))[:top]}
    if len(sizes) <= top:
        return dict(regions)
    return {n: r if r in kept else "other" for n, r in regions.items()}


def binned_by_group(
    events: list[tuple[float, str, str]],
    groups: dict[str, str],
    label: str,
    t0: float,
    t1: float,
) -> tuple[np.ndarray, dict[str, np.ndarray]]:
    """Bin starts and per group the FLOOR_BIN_S counts of the `events` (ts, node, label) whose
    label name (before `[`) is `label`."""
    times: dict[str, list[float]] = {g: [] for g in dict.fromkeys(groups.values())}
    for ts, node, name in events:
        if name.partition("[")[0] == label:
            times[groups[node]].append(ts)
    binned = {
        g: bin_counts(np.array(ts), np.ones(len(ts)), t0, t1, FLOOR_BIN_S)
        for g, ts in times.items()
    }
    return bin_counts(np.array([]), np.array([]), t0, t1, FLOOR_BIN_S)[0], {
        g: counts for g, (_, counts) in binned.items()
    }


def max_block_mb(genesis: Path) -> float:
    """Genesis `chain_config.max_block_size` in MB, as the node parses it (decimal units)."""
    text = tomllib.loads(genesis.read_text())["chain_config"]["max_block_size"]
    match = re.fullmatch(r"\s*([\d.]+)\s*([a-z]*)\s*", text.lower())
    if match is None or match[2] not in SIZE_UNITS:
        raise ValueError(f"unexpected max_block_size {text!r}")
    return float(match[1]) * SIZE_UNITS[match[2]] / 1e6


def draw_lanes(
    lanes_ax: plt.Axes, rows: list[ch.FaultRow], end: float, minutes
) -> None:
    """One lane per faulted node, in the order of its first fault."""
    nodes = list(dict.fromkeys(r.node for r in rows))
    for row in rows:
        y = nodes.index(row.node)
        for phase, start, stop in ch.phase_segments(row, end):
            lanes_ax.hlines(
                y, minutes(start), minutes(stop), color=PHASE_COLOR[phase], lw=6
            )
        marks = {k: ts for k in EVENT_MARKERS if (ts := getattr(row, k)) is not None}
        for event, ts in marks.items():
            lanes_ax.plot(
                minutes(ts), y, EVENT_MARKERS[event], color=INK, ms=4, zorder=3
            )
        if row.timeout is not None:
            lanes_ax.plot(
                minutes(row.timeout),
                y,
                "x",
                color=BAND_FAILED_INK,
                ms=9,
                mew=2,
                clip_on=False,
            )
        if row.kind not in ch.MASS_KINDS:
            lanes_ax.text(
                minutes(row.fault),
                y - 0.45,
                row.kind,
                fontsize=6,
                color=MUTED,
                va="bottom",
            )
    for kind, at in dict.fromkeys(
        (r.kind, r.fault) for r in rows if r.kind in ch.MASS_KINDS
    ):
        lanes_ax.axvline(minutes(at), color=MUTED, ls=":", lw=1, zorder=1)
        lanes_ax.text(minutes(at), -0.6, kind, fontsize=6, color=MUTED, va="bottom")
    lanes_ax.set_yticks(range(len(nodes)), nodes, color=INK, fontsize=7)
    lanes_ax.set_ylim(len(nodes) - 0.4, -0.7)
    lanes_ax.spines[["top", "right"]].set_visible(False)
    lanes_ax.legend(
        handles=[
            *(Line2D([], [], color=color, lw=6, label=name) for name, color in PHASES),
            *(
                Line2D([], [], color=INK, marker=m, ls="", ms=4, label=e)
                for e, m in EVENT_MARKERS.items()
            ),
            Line2D([], [], color=BAND_FAILED_INK, marker="x", ls="", label="timeout"),
        ],
        loc="lower left",
        bbox_to_anchor=(0, 1),
        ncol=8,
        fontsize=8,
        frameon=False,
        labelcolor=INK,
    )


def draw_floor(
    axes: Sequence[plt.Axes],
    counters: list[dict],
    events: list[tuple[float, str, str]],
    groups: dict[str, str],
    t0: float,
    t1: float,
    minutes,
) -> None:
    """Timeouts per bin on the first axis, then one stacked-by-group axis per `FLOOR_EVENTS`."""
    width = FLOOR_BIN_S / 60
    ts, grown = (
        timeout_increments(counters) if len(counters) > 1 else (np.array([]),) * 2
    )
    starts, total = bin_counts(ts, grown, t0, t1, FLOOR_BIN_S)
    axes[0].bar(
        minutes(starts), total, width, align="edge", color=BAND_FAILED_INK, lw=0
    )
    axes[0].set_ylabel(f"view timeouts\nper {FLOOR_BIN_S} s", color=INK, fontsize=8)
    names = sorted(set(groups.values()), key=lambda g: (g == "other", g))
    colors = {
        g: OTHER_COLOR if g == "other" else GROUP_COLORS[i % len(GROUP_COLORS)]
        for i, g in enumerate(names)
    }
    for ax, label in zip(axes[1:], FLOOR_EVENTS):
        starts, counts = binned_by_group(events, groups, label, t0, t1)
        bottom = np.zeros(len(starts))
        for group in names:
            ax.bar(
                minutes(starts),
                counts[group],
                width,
                bottom=bottom,
                align="edge",
                color=colors[group],
                lw=0,
                label=group,
            )
            bottom += counts[group]
        ax.set_ylabel(f"{label}\nper {FLOOR_BIN_S} s", color=INK, fontsize=8)
    if names:
        axes[1].legend(
            loc="lower left",
            bbox_to_anchor=(0, 1),
            ncol=FLOOR_GROUPS + 1,
            fontsize=7,
            frameon=False,
            labelcolor=INK,
        )
    for ax in axes:
        ax.set_ylim(0, max(1, ax.get_ylim()[1]))
        ax.spines[["top", "right"]].set_visible(False)


def read_log_events(
    run_dir: Path, nodes: list[str], t0: float, t1: float
) -> list[tuple[float, str, str]]:
    """(ts, node, label) of the `FLOOR_EVENTS` in the logs of `nodes`."""
    return [
        (ts, node, label)
        for node in nodes
        for ts, label in ch.node_log_events(run_dir, node, t0, t1)
        if label.partition("[")[0] in FLOOR_EVENTS
    ]


def last_time(
    steps: list[dict], txs: list[dict], events: Sequence[ch.ChaosEvent]
) -> float:
    """The end of a run without counter samples: its last step, submit or chaos event."""
    return max(
        [s["t_end"] for s in steps]
        + [tx["t_submit"] for tx in txs]
        + [e["ts"] for e in events]
    )


def read_jsonl(path: Path) -> list[dict]:
    with path.open() as f:
        return [json.loads(line) for line in f]


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("run_dir", type=Path)
    run_dir = parser.parse_args(argv).run_dir

    cfg = json.loads((run_dir / "config.json").read_text())
    tx_size = cfg["tx_size"]
    steps = json.loads((run_dir / "steps.json").read_text())
    counters = read_jsonl(run_dir / "consensus.jsonl")
    txs = read_jsonl(run_dir / "load.jsonl")
    heights = read_jsonl(run_dir / "heights.jsonl")
    events = ch.read_events(run_dir)
    clients_file = run_dir / "clients.jsonl"
    clients = read_jsonl(clients_file) if clients_file.exists() else []
    run_path = run_dir / "run.json"
    t0 = (
        json.loads(run_path.read_text())["t0"]
        if run_path.exists()
        else steps[0]["t_start"]
    )
    # A run that failed has no counter samples.
    sampled = len(counters) > 1
    t1 = counters[-1]["ts"] if sampled else last_time(steps, txs, events)

    none = np.array([])
    dec_t, dec = decided_mb_s(counters) if sampled else (none, none)
    sub_t, sub = binned_mb_s([tx["t_submit"] for tx in txs], tx_size, t0, t1)
    inc = [tx["t_included"] for tx in txs if tx["t_included"] is not None]
    inc_t, query = binned_mb_s(inc, tx_size, t0, t1)
    on_validator = {h["height"]: h["validator"] for h in heights if h["validator"]}
    blk_t, interval, size = (
        block_series(np.sort(list(on_validator.values())), counters)
        if sampled
        else (none, none, none)
    )
    decided_txs = [tx for tx in txs if on_validator.get(tx["height"]) is not None]
    seen = np.array([on_validator[tx["height"]] for tx in decided_txs])
    latency = seen - np.array([tx["t_submit"] for tx in decided_txs])
    grid = np.linspace(t0, t1, math.ceil(t1 - t0) + 1)
    lat = rolling_median(seen, latency * 1000, grid)
    # A tx that never showed on the query node resolved at its timeout.
    ends = [
        tx["t_included"]
        if tx["t_included"] is not None
        else tx["t_submit"] + cfg["tx_timeout_s"]
        for tx in txs
    ]
    flight = in_flight(np.array([tx["t_submit"] for tx in txs]), np.array(ends), grid)
    rows = ch.fault_rows(events)

    def minutes[T: (np.ndarray, float)](t: T) -> T:
        return (t - t0) / 60

    lane_count = len({r.node for r in rows})
    lane_ratio = (max(1.0, 0.3 * lane_count),) if rows else ()
    client_ratio = (1,) if clients else ()
    floor_ratio = (0.6, 0.8, 0.8, 0.8) if (run_dir / "chaos.jsonl").exists() else ()
    fig, panels = plt.subplots(
        len(lane_ratio) + 3 + len(client_ratio) + len(floor_ratio),
        1,
        figsize=(
            13,
            3.3 * (3 + len(client_ratio))
            + 0.4 * lane_count
            + 1.6 * sum(floor_ratio) ** 0.5 * bool(floor_ratio),
        ),
        sharex=True,
        height_ratios=(*lane_ratio, 2, 1, 1, *client_ratio, *floor_ratio),
        facecolor=SURFACE,
    )
    lane_panel = panels[: len(lane_ratio)]
    floor_panels = panels[len(panels) - len(floor_ratio) :]
    ax, blk_ax, lat_ax, *client_panel = panels[
        len(lane_ratio) : len(panels) - len(floor_ratio)
    ]
    data_panels = (ax, blk_ax, lat_ax, *client_panel, *floor_panels)
    for panel in panels:
        panel.set_facecolor(SURFACE)
        panel.tick_params(colors=INK)
        panel.grid(alpha=0.3)
    if rows:
        draw_lanes(lane_panel[0], rows, t1, minutes)
        for start, stop in (ch.fault_span(r, t1) for r in rows):
            for panel in data_panels:
                panel.axvspan(
                    minutes(start), minutes(stop), color=FAULT_SPAN, alpha=0.1, lw=0
                )
    for i, step in enumerate(steps):
        start, end = minutes(step["t_start"]), minutes(step["t_end"])
        failed = step["consensus_fails"] or step["query_fails"]
        for panel in data_panels:
            panel.axvspan(
                minutes(step["t_mid"]),
                end,
                color=BAND_FAILED if failed else BAND,
                zorder=0,
                label="_nolegend_" if i or panel is not ax else "measured window",
            )
            panel.axvline(start, color=MUTED, lw=0.6, alpha=0.5, zorder=0)
        ax.hlines(
            step["rate_mb_s"],
            start,
            end,
            color=INK,
            lw=1,
            linestyles="--",
            label="_nolegend_" if i else "step target",
        )
        label = f"{step['rate_mb_s']:.0f}{' (r)' if step['refine'] else ''}"
        if step.get("stopped_early"):
            label += " stop"
        ax.text(
            (start + end) / 2,
            1.01,
            label,
            transform=ax.get_xaxis_transform(),
            ha="center",
            va="bottom",
            fontsize=8,
            color=INK,
        )
    ax.plot(
        minutes(sub_t),
        moving_mean(sub),
        color=MUTED,
        lw=0.8,
        label=f"submitted, {SMOOTH_S} s mean",
    )
    if sampled:
        ax.plot(
            minutes(dec_t), dec, color=DECIDED, lw=0.8, alpha=0.3, label="decided, 1 s"
        )
        ax.plot(
            minutes(dec_t),
            moving_mean(dec),
            color=DECIDED,
            lw=2,
            label=f"decided, {SMOOTH_S} s mean",
        )
    ax.plot(
        minutes(inc_t),
        moving_mean(query),
        color=QUERY,
        lw=2,
        label=f"query node, {SMOOTH_S} s mean",
    )
    timeouts = timeout_times(counters) if sampled else none
    if len(timeouts):
        ax.plot(
            minutes(timeouts),
            np.full(len(timeouts), 0.97),
            "|",
            color=BAND_FAILED_INK,
            ms=10,
            mew=1.5,
            transform=ax.get_xaxis_transform(),
            label="view timeout",
        )
    ax.set_xlim(minutes(t0), minutes(t1))
    ax.set_ylim(bottom=0)
    ax.set_ylabel("MB/s", color=INK)
    ax.spines[["top", "right"]].set_visible(False)
    ax.legend(loc="upper left", ncol=4, fontsize=8, frameon=False, labelcolor=INK)

    cap = max_block_mb(run_dir / "genesis.toml")
    blk_ax.plot(
        minutes(blk_t),
        size,
        color=DECIDED,
        lw=1.5,
        label=f"block size, {SMOOTH_S} s window",
    )
    if not sampled:
        blk_ax.text(
            0.5,
            0.5,
            "no consensus counters collected",
            transform=blk_ax.transAxes,
            ha="center",
            color=MUTED,
        )
    blk_ax.axhline(cap, color=DECIDED, lw=1, ls="--", label="max_block_size")
    blk_ax.set_ylim(0, cap * 1.15)
    blk_ax.set_ylabel("MB per block", color=DECIDED)
    interval_ax = blk_ax.twinx()
    interval_ax.plot(
        minutes(blk_t),
        interval,
        color=QUERY,
        lw=1.5,
        label=f"block interval, {SMOOTH_S} s window",
    )
    interval_ax.set_ylim(bottom=0)
    interval_ax.set_ylabel("s per block", color=QUERY)
    interval_ax.tick_params(colors=INK)
    twin_legend(blk_ax, interval_ax)

    lat_ax.plot(
        minutes(grid),
        lat,
        color=DECIDED,
        lw=1.5,
        label=f"consensus latency p50, {SMOOTH_S} s window",
    )
    lat_ax.set_yscale("log")
    lat_ax.set_ylabel("ms", color=DECIDED)
    flight_ax = lat_ax.twinx()
    flight_ax.plot(minutes(grid), flight, color=MUTED, lw=1, label="txs in flight")
    flight_ax.set_ylim(bottom=0)
    flight_ax.set_ylabel("txs in flight", color=MUTED)
    flight_ax.tick_params(colors=INK)
    twin_legend(lat_ax, flight_ax)

    if client_panel:
        (cli_ax,) = client_panel
        done, lag = client_lag(clients, on_validator)
        cli_ax.plot(
            minutes(grid),
            rolling_median(done, lag, grid),
            color=DECIDED,
            lw=1.5,
            label=f"reader lag p50, {SMOOTH_S} s window",
        )
        cli_ax.set_yscale("log")
        cli_ax.set_ylabel("ms", color=DECIDED)
        fetch_ax = cli_ax.twinx()
        fetch_t, fetched = binned_bytes_mb_s(
            np.array([c["t_done"] for c in clients]),
            np.array([c["bytes"] for c in clients]),
            t0,
            t1,
        )
        fetch_ax.plot(
            minutes(fetch_t),
            moving_mean(fetched),
            color=QUERY,
            lw=1,
            label=f"readers fetched, {SMOOTH_S} s mean",
        )
        fetch_ax.set_ylim(bottom=0)
        fetch_ax.set_ylabel("MB/s", color=QUERY)
        fetch_ax.tick_params(colors=INK)
        twin_legend(cli_ax, fetch_ax)
    if len(floor_panels):
        manifest_path = run_dir / "manifest.json"
        manifest = (
            json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
        )
        regions = ch.node_regions(run_dir, manifest)
        groups = region_groups(regions)
        log = read_log_events(run_dir, list(regions), t0, t1)
        draw_floor(floor_panels, counters, log, groups, t0, t1, minutes)
    panels[-1].set_xlabel("minutes since run start", color=INK)

    run = run_dir.resolve()
    fig.suptitle(f"{run.parent.parent.name}/{run.name}", color=INK)
    fig.tight_layout()
    fig.savefig(run_dir / "throughput.png", dpi=130, facecolor=SURFACE)


def twin_legend(left: plt.Axes, right: plt.Axes) -> None:
    """One legend for both axes of a panel, above it, so it never covers the lines."""
    handles, labels = left.get_legend_handles_labels()
    more, more_labels = right.get_legend_handles_labels()
    left.legend(
        handles + more,
        labels + more_labels,
        loc="lower left",
        bbox_to_anchor=(0, 1),
        ncol=4,
        fontsize=8,
        frameon=False,
        labelcolor=INK,
    )


if __name__ == "__main__":
    main()
