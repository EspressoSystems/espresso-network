def collect_hosts(
    remote: Remote, hosts: list[HostInfo], out: Path, subdir: str = ""
) -> None:
    """Logs, inspect, chrony, disk and journal sizes, host samples and (node0) Postgres
    statistics into `out/hosts/<name>/<subdir>`. Best effort per host: one that cannot be
    reached is reported and the rest are still collected."""

    def collect(name: str) -> None:
        role = remote.hosts[name]["role"]
        script = (
            COLLECT_SCRIPT + (PG_STATS_SCRIPT if role == "query" else "") + "true\n"
        )
        # The copy runs even when the script failed or timed out: files already on the
        # host (host.jsonl) are still wanted.
        try:
            remote.ssh(name, bounded(script))
        except RemoteError as exc:
            log.warning("collect script %s failed: %s", name, exc)
        try:
            remote.rsync_from(
                name,
                f"{BENCH_DIR}/",
                out / "hosts" / name / subdir,
                *COLLECT_EXCLUDES,
                "--exclude=__pycache__",
            )
        except RemoteError as exc:
            log.warning("collect %s rsync failed: %s", name, exc)

    remote.parallel(collect, [h["name"] for h in hosts])


def cmd_status(args: argparse.Namespace, system: System) -> int:
    if args.dir is not None and args.all:
        raise Refused("status takes FLEET or --all, not both")
    if args.dir is not None and args.region is not None:
        raise Refused("--region sweeps a region with --all; FLEET has its own")
    now = utc_now(system.clock)
    if args.all:
        return status_all(system, args, now)
    return status_run(system, fleet_arg(args.dir, OUT_ROOT), now)


def cmd_list(args: argparse.Namespace, system: System) -> int:
    print("\n".join(format_fleets(fleet_rows(OUT_ROOT), utc_now(system.clock))))
    return EXIT_OK


class FleetRow(TypedDict):
    """One fleet dir for `list`. `fleet` is None without `fleet.json`; `last` and `result`
    belong to the run with the highest `run_index`."""

    name: str
    fleet: FleetManifest | None
    runs: int
    last: Manifest | None
    result: nb.BenchResult | None


def fleet_rows(out_root: Path) -> list[FleetRow]:
    """Newest first by `created_at`, dirs without `fleet.json` last."""
    rows = [fleet_row(path) for path in fleet_dirs(out_root)]
    known = sorted(
        ((row["fleet"]["created_at"], row) for row in rows if row["fleet"] is not None),
        key=lambda pair: pair[0],
        reverse=True,
    )
    return [row for _, row in known] + [row for row in rows if row["fleet"] is None]


def fleet_row(fleet_dir: Path) -> FleetRow:
    runs = run_dirs(fleet_dir)
    last = max(runs, key=run_index) if runs else None
    result_path = last / "result.json" if last else None
    return {
        "name": fleet_dir.name,
        "fleet": read_fleet_or_none(fleet_dir),
        "runs": len(runs),
        "last": nb.read_json(last / "manifest.json") if last else None,
        "result": (
            nb.read_json(result_path) if result_path and result_path.exists() else None
        ),
    }


def read_fleet_or_none(fleet_dir: Path) -> FleetManifest | None:
    path = fleet_dir / FLEET_JSON
    return nb.read_json(path) if path.exists() else None


def format_fleets(rows: list[FleetRow], now: datetime) -> list[str]:
    footer = "AWS view: aws-bench status --all"
    if not rows:
        return ["no local fleets", footer]
    lines = [
        "| fleet | phase | created | expires | left | cost | runs | last |",
        "|---|---|---|---|---|---|---|---|",
    ]
    for row in rows:
        fleet = row["fleet"]
        cells = [row["name"], *(fleet_cells(row, fleet, now) if fleet else ["?"] * 7)]
        lines.append("| " + " | ".join(cells) + " |")
    return [*lines, footer]


def fleet_cells(row: FleetRow, fleet: FleetManifest, now: datetime) -> list[str]:
    return [
        fleet["phase"],
        fleet["created_at"][:16],
        expires(fleet),
        time_left(fleet, now),
        fleet_cost(fleet),
        str(row["runs"]),
        last_run(row),
    ]


def fleet_cost(fleet: FleetManifest) -> str:
    """`cost_usd` holds `actual` only once `down` has priced the fleet."""
    if "cost_usd" in fleet and "actual" in fleet["cost_usd"]:
        return f"${fleet['cost_usd']['actual']:.2f}"
    return f"<=${fleet['estimate']['bound_usd']:.2f}"


def time_left(fleet: FleetManifest, now: datetime) -> str:
    if fleet["phase"] not in SELECTABLE_PHASES or "expires_at" not in fleet:
        return "-"
    left = datetime.fromisoformat(fleet["expires_at"]) - now
    if left.total_seconds() <= 0:
        return "expired"
    return f"{int(left.total_seconds() // 60)}m"


def last_run(row: FleetRow) -> str:
    """The same verdict and rate as the run's INDEX.md row, else the run's phase."""
    result, last = row["result"], row["last"]
    if result is not None:
        mb_s = nb.fmt_num(result["capacity"]["overall"]["mb_s"])
        return f"{nb.verdict_word(result['validity'])} {mb_s} MB/s"
    return last["phase"] if last is not None else "-"


def cmd_collect(args: argparse.Namespace, system: System) -> int:
    """Collects again from the live hosts into `hosts/<name>/collect-<k>/`, leaving the files
    of the run itself untouched. Only the fleet's last run can be collected, while no run is
    active: the hosts hold the files of the last run only, and `left-running` is where a fleet
    stays after a failed destroy. Without RUN_DIR, the last run of the only selectable
    fleet."""
    if args.dir is None:
        picked = pick_fleet(OUT_ROOT)
        runs = run_dirs(picked)
        if not runs:
            raise Refused(f"{picked.name} has no runs to collect")
        args.dir = runs[-1]
    run_dir: Path = args.dir
    fleet_dir = fleet_of(run_dir)
    manifest: FleetManifest = nb.read_json(fleet_dir / FLEET_JSON)
    hosts = provisioned_hosts(manifest)
    if run_dir.name != run_dirs(fleet_dir)[-1].name:
        raise Refused(
            f"{run_dir.name} is not the last run of {fleet_dir.name}: the hosts hold "
            f"{run_dirs(fleet_dir)[-1].name}'s files"
        )
    if manifest["phase"] not in ("idle", "left-running"):
        raise Refused(
            f"fleet {fleet_dir.name} is {manifest['phase']}: collect needs it idle"
        )
    setup_logging(fleet_dir)
    remote = Remote(system.run, fleet_dir, ssh_key_path(fleet_dir), hosts)
    subdir = f"collect-{next_collect_index(run_dir)}"
    collect_hosts(remote, list(hosts.values()), run_dir, subdir)
    missing = [
        name for name in hosts if not any((run_dir / "hosts" / name / subdir).glob("*"))
    ]
    if missing:
        log.error("nothing collected from %s", ", ".join(missing))
        return EXIT_FAILED
    log.info("collected %d hosts into hosts/<name>/%s", len(hosts), subdir)
    return EXIT_OK


def cmd_render(args: argparse.Namespace, system: System) -> int:
    """Analyzes the collected files again, offline; `--baseline` adds the comparison."""
    run_dir: Path = args.dir
    agent = finished_agent_state(run_dir)
    if not (run_dir / "run.json").exists() and agent is not None:
        manifest: Manifest = nb.read_json(run_dir / "manifest.json")
        started = datetime.fromisoformat(manifest["created_at"]).timestamp()
        nb.write_json(
            run_dir / "run.json",
            run_json(manifest, manifest["config"]["tag"], agent, started, agent["t1"]),
        )
    if not (run_dir / "run.json").exists():
        raise Refused(
            f"{run_dir} has no run.json: the run produced no result, see summary.md"
        )
    setup_logging(run_dir)
    baseline = nb.load_baseline(args.baseline) if args.baseline else None
    plot_throughput(system.run, run_dir)
    result = write_report(run_dir, baseline)
    log_result(result)
    plot_traces(system.run, run_dir)
    refresh_index_row(run_dir, result)
    log.info("wrote %s", run_dir / "summary.md")
    return EXIT_OK if result["validity"]["valid"] else EXIT_INVALID


def refresh_index_row(run_dir: Path, result: nb.BenchResult) -> None:
    """Re-derives the measured cells of `index-row.json` from the new result; exit code, cost
    and user stay as the run recorded them."""
    path = run_dir / INDEX_ROW_JSON
    if not path.exists():
        return
    row = nb.read_json(path)
    cost_path = run_dir / "cost.json"
    cost = nb.read_json(cost_path) if cost_path.exists() else None
    manifest: Manifest = nb.read_json(run_dir / MANIFEST_JSON)
    cells = index_cells(manifest, run_dir.name, result, int(row["exit"]), cost)
    nb.write_json(path, {**cells, "user": row["user"]})


def status_run(system: System, fleet_dir: Path, now: datetime) -> int:
    run = system.run
    manifest: FleetManifest = nb.read_json(fleet_dir / FLEET_JSON)
    name = manifest["name"]
    print(
        f"- fleet {name}: phase {manifest['phase']}, created {manifest['created_at'][:16]}"
    )
    for path in sorted((fleet_dir / RUNS_DIR).glob("*/manifest.json")):
        print(f"- {path.parent.name}: phase {nb.read_json(path)['phase']}")
    if manifest["phase"] in LIVE_PHASES:
        print(
            f"- expires {manifest['expires_at'][:16]} UTC, "
            f"{minutes_left(manifest, now):.0f} min left"
        )
        lock_path = fleet_dir / FLEET_LOCK
        if lock_path.exists():
            lock: FleetLock = nb.read_json(lock_path)
            print(f"- lock: {describe_lock(lock, lock_holder_alive(system, lock))}")
    if manifest["phase"] == "planned":
        print("- no instances: planned only")
        return EXIT_OK
    cost_path = fleet_dir / "cost.json"
    if manifest["phase"] in TERMINAL_PHASES and cost_path.exists():
        cost = nb.read_json(cost_path)
        print(f"- cost: ${cost['actual']:.2f} actual, bound ${cost['bound']:.2f}")
        return EXIT_OK
    region = manifest_region(manifest)
    instances = describe_instances(run, region, f"Name=tag:{TAG_RUN},Values={name}")
    hosts = manifest.get("hosts_info", {})
    by_id = {info["instance_id"]: host for host, info in hosts.items()}
    for instance in instances:
        print(
            f"- {by_id.get(instance['id'], instance['id'])}: {instance['state']}, "
            f"{instance['type']}, launched {instance['launch'][:16]}"
        )
    ctl = hosts.get("ctl")
    if ctl and any(
        i["id"] == ctl["instance_id"] and i["state"] == "running" for i in instances
    ):
        remote = Remote(run, fleet_dir, ssh_key_path(fleet_dir), hosts)
        state = read_agent_state(remote)
        agent = (
            "no state file"
            if state is None
            else f"{state['phase']}, {state.get('progress', state['detail'])}"
        )
        print(f"- agent: {agent}")
    if "pg_volume_id" in manifest:
        volume = manifest["pg_volume_id"]
        print(f"- pg volume {volume}: {volume_state(run, region, volume)}")
    if "rds" in manifest:
        rds = manifest["rds"]
        print(f"- rds {rds['identifier']}: {rds_state(run, region, rds)}")
    print(f"- cost: {status_cost(run, manifest, instances, now)}")
    return EXIT_OK


def volume_state(run: Runner, region: str, volume: str) -> str:
    state = aws_json(
        run,
        "ec2",
        "describe-volumes",
        "--volume-ids",
        volume,
        "--query",
        "Volumes[0].State",
        region=region,
        tolerate="InvalidVolume.NotFound",
    )
    return state or "gone"


def rds_state(run: Runner, region: str, rds: RdsInfo) -> str:
    """`available, parameters in-sync`; `gone` once the schedule or a destroy has deleted the
    instance."""
    out = aws_json(
        run,
        "rds",
        "describe-db-instances",
        "--db-instance-identifier",
        rds["identifier"],
        region=region,
        tolerate="DBInstanceNotFound",
    )
    if not out:
        return "gone"
    instance = out["DBInstances"][0]
    applied = instance["DBParameterGroups"][0]["ParameterApplyStatus"]
    return f"{instance['DBInstanceStatus']}, parameters {applied}"


def status_cost(
    run: Runner, manifest: FleetManifest, instances: list[Instance], now: datetime
) -> str:
    bound = f"bound ${manifest['estimate']['bound_usd']:.2f}"
    if not instances:
        return f"no instances, {bound}"
    if all(i["state"] == "terminated" for i in instances):
        return f"${actual_cost(run, manifest, now)['actual']:.2f} actual, {bound}"
    launched = min(datetime.fromisoformat(i["launch"]) for i in instances)
    usd = manifest_cost(manifest, (now - launched).total_seconds())
    return f"${usd:.2f} so far, {bound}"


def run_prices(run: Runner, region: str, runs: list[TaggedRun]) -> dict[str, float]:
    return fetch_prices(run, region, {i["type"] for r in runs for i in r["instances"]})


def print_other_regions(region: str) -> None:
    """The regions of local fleets that may still hold resources and that a sweep of `region`
    does not see."""
    fleets = (read_fleet_or_none(path) for path in fleet_dirs(OUT_ROOT))
    others = {
        manifest_region(f)
        for f in fleets
        if f is not None and f["phase"] not in TERMINAL_PHASES
    } - {region}
    if others:
        print(f"other regions with local fleets: {', '.join(sorted(others))}")


def status_all(system: System, args: argparse.Namespace, now: datetime) -> int:
    region = args.region or REGION
    caller_account(system.run, region)
    print_other_regions(region)
    runs = find_runs(system.run, region, OUT_ROOT, now, system.user())
    if not runs:
        print(f"no espresso-bench resources in {region}")
        return EXIT_OK
    print("\n".join(format_runs(runs, now, run_prices(system.run, region, runs))))
    return EXIT_OK


def cmd_down(args: argparse.Namespace, system: System) -> int:
    if args.yes and args.dir is None:
        raise Refused(
            "down --yes needs FLEET: a destroy without a prompt names its target"
        )
    fleet_dir = fleet_arg(args.dir, OUT_ROOT)
    manifest = read_fleet(fleet_dir)
    name = manifest["name"]
    if manifest["phase"] == "planned":
        raise Refused(f"{name} was only planned: nothing was created")
    if manifest["phase"] in TERMINAL_PHASES:
        raise Refused(f"{name} is already {manifest['phase']}")
    prompt = (
        f"Destroy the fleet of {name} ({manifest['phase']}, expires "
        f"{expires(manifest)} UTC) in {ACCOUNT}?"
    )
    if not (args.yes or system.ask(prompt)):
        raise Refused("not confirmed; nothing was destroyed")
    setup_logging(fleet_dir)
    cfg = config_from_manifest(manifest["config"])
    tf = Terraform(system.run, fleet_dir / "terraform", terraform_env())
    fleet = FleetState(
        system, cfg, fleet_dir, tf, Interrupts(system.clock, system.forward)
    )
    if manifest["phase"] == "running":
        # `Remote` inside `best_effort`: a refused ControlPath must not block the destroy.
        best_effort(
            "stop agent",
            lambda: stop_agent(
                Remote(
                    system.run,
                    fleet_dir,
                    ssh_key_path(fleet_dir),
                    provisioned_hosts(manifest),
                )
            ),
        )
    update_manifest(fleet.manifest_path, "destroying")
    if not destroy_fleet(fleet):
        update_manifest(fleet.manifest_path, "left-running")
        log.error(LEFTOVER_MESSAGE, fleet_dir)
        return EXIT_LEFTOVER
    cost = close_fleet(fleet, True)
    release_fleet_lock(fleet_dir)
    log_down(fleet_dir, cost)
    return EXIT_OK


def run_dirs(fleet_dir: Path) -> list[Path]:
    return sorted((fleet_dir / RUNS_DIR).glob("*"))


def log_down(fleet_dir: Path, cost: dict[str, float] | None) -> None:
    """The fleet's actual cost, then one row per run."""
    runs = run_dirs(fleet_dir)
    if cost is None:
        log.info("destroyed %s; %d runs", fleet_dir.name, len(runs))
    else:
        log.info(
            "destroyed; actual cost $%.2f (bound $%.2f); %d runs",
            cost["actual"],
            cost["bound"],
            len(runs),
        )
    for run_dir in runs:
        result_path = run_dir / "result.json"
        status = (
            nb.verdict_word(nb.read_json(result_path)["validity"])
            if result_path.exists()
            else "failed"
        )
        cost_path = run_dir / "cost.json"
        usd = f"${nb.read_json(cost_path)['usd']:.2f}" if cost_path.exists() else "-"
        log.info("- %s: %s, %s", run_dir.name, status, usd)


def cmd_destroy(args: argparse.Namespace, system: System) -> int:
    now = utc_now(system.clock)
    caller_account(system.run, args.region)
    print_other_regions(args.region)
    runs = find_runs(system.run, args.region, OUT_ROOT, now, system.user())
    orphans = [r for r in runs if r["orphan"] is not None]
    if not orphans:
        print(f"no orphaned espresso-bench resources in {args.region}")
        return EXIT_OK
    print("\n".join(format_runs(orphans, now)))
    instances = sum(len(r["instances"]) for r in orphans)
    others = sum(len(r["arns"]) - len(r["instances"]) for r in orphans)
    prompt = (
        f"Terminate {instances} instances and delete {others} other resources "
        f"of {len(orphans)} runs in {ACCOUNT}?"
    )
    if not (args.yes or system.ask(prompt)):
        raise Refused("not confirmed; nothing was destroyed")
    try:
        for orphan in orphans:
            log.info("sweeping %s", orphan["name"])
            sweep(system, args.region, orphan["name"])
            mark_swept(OUT_ROOT / orphan["name"])
        # `sweep` removes the role of a fleet that still has rds resources.
        swept_rds = rds_fleets(arn for o in orphans for arn in o["arns"])
        with_role = {o["name"] for o in orphans if has_role(o)} - swept_rds
        if with_role:
            sweep_iam(system.run, args.region, with_role)
    except Refused as exc:
        log.error("sweep failed, resources may remain: %s", exc)
        return EXIT_LEFTOVER
    log.info("swept %d runs", len(orphans))
    return EXIT_OK


def cmd_prune(args: argparse.Namespace, system: System) -> int:
    """Deletes whole fleet dirs, results included; `INDEX.md` keeps their rows."""
    now = utc_now(system.clock)
    caller_account(system.run, args.region)
    found = find_runs(system.run, args.region, OUT_ROOT, now, system.user())
    tagged = {r["name"] for r in found}
    dirs = fleet_dirs(OUT_ROOT)
    locked = {path.name for path in dirs if (path / FLEET_LOCK).exists()}
    rows = [(path, read_fleet_or_none(path)) for path in dirs]
    cutoff = now - timedelta(days=args.older_than)
    delete, kept = prune_plan(rows, tagged, locked, cutoff, args.region)
    runs = {path: len(run_dirs(path)) for path, _ in delete}
    print("\n".join(format_prune(delete, runs, kept)))
    if not delete:
        print("nothing to prune")
        return EXIT_OK
    prompt = f"Delete {len(delete)} fleet dirs ({sum(runs.values())} runs, results included)?"
    if not (args.yes or system.ask(prompt)):
        raise Refused("not confirmed; nothing was deleted")
    for path, _ in delete:
        shutil.rmtree(path)
        log.info("deleted %s", path)
    return EXIT_OK


def prune_plan(
    rows: list[tuple[Path, FleetManifest | None]],
    tagged: set[str],
    locked: set[str],
    cutoff: datetime,
    region: str,
) -> tuple[list[tuple[Path, FleetManifest]], list[tuple[Path, str]]]:
    """The dirs created before `cutoff` to delete, and the ones kept with the reason. A dir
    without `fleet.json` has no age and is always kept. `tagged` and `locked` hold dir names;
    `tagged` comes from `region`, so a fleet of another region is kept."""
    delete: list[tuple[Path, FleetManifest]] = []
    kept: list[tuple[Path, str]] = []
    for path, fleet in rows:
        if fleet is None:
            kept.append((path, f"no {FLEET_JSON}"))
        elif datetime.fromisoformat(fleet["created_at"]) < cutoff:
            reason = prune_blocker(path.name, fleet, tagged, locked, region)
            if reason is None:
                delete.append((path, fleet))
            else:
                kept.append((path, reason))
    return delete, kept


def prune_blocker(
    name: str, fleet: FleetManifest, tagged: set[str], locked: set[str], region: str
) -> str | None:
    # `applying` is written before `tofu apply`, so a `planned` fleet never created anything.
    if fleet["phase"] not in ("planned", "done", "swept"):
        return f"phase {fleet['phase']}"
    if manifest_region(fleet) != region:
        return f"region {manifest_region(fleet)}"
    if name in locked:
        return "locked"
    if name in tagged:
        return "tagged resources remain"
    return None


def format_prune(
    delete: list[tuple[Path, FleetManifest]],
    runs: dict[Path, int],
    kept: list[tuple[Path, str]],
) -> list[str]:
    lines = []
    if delete:
        lines += [
            "| delete | phase | created | runs | cost |",
            "|---|---|---|---|---|",
        ]
        for path, fleet in delete:
            cells = [
                path.name,
                fleet["phase"],
                fleet["created_at"][:16],
                str(runs[path]),
                fleet_cost(fleet),
            ]
            lines.append("| " + " | ".join(cells) + " |")
    if kept:
        lines += ["| keep | reason |", "|---|---|"]
        lines += [f"| {path.name} | {reason} |" for path, reason in kept]
    return lines


def has_role(tagged: TaggedRun) -> bool:
    return any(arn_parts(arn)[0] == "role" for arn in tagged["arns"])


def mark_swept(fleet_dir: Path) -> None:
    if (fleet_dir / FLEET_JSON).exists():
        update_manifest(fleet_dir / FLEET_JSON, "swept")
        remove_ssh_key(fleet_dir)


def manifest_region(manifest: FleetManifest) -> str:
    return config_from_manifest(manifest["config"]).region


def config_from_manifest(saved: dict[str, Any]) -> RunConfig:
    """Inverse of `config_to_json`."""
    fields: dict[str, Any] = {
        **saved,
        "load": nb.load_config(dict(saved["load"])),
        "db_modes": tuple(saved["db_modes"]),
        "fleet": None if saved["fleet"] is None else Path(saved["fleet"]),
        "node_type": saved["node_type"],
        "ctl_type": saved["ctl_type"],
    }
    # Dirs from before the flag have no such key.
    if "node_env" in saved:
        fields["node_env"] = tuple(saved["node_env"])
    fields.setdefault("region", LEGACY_REGION)
    fields.setdefault("consensus_storage", LEGACY_CONSENSUS_STORAGE)
    fields["search"] = search_config(saved.get("search"))
    return RunConfig(**fields)


def provisioned_hosts(manifest: FleetManifest) -> dict[str, HostInfo]:
    if "hosts_info" not in manifest:
        raise Refused(
            f"{manifest['name']} has no hosts: the fleet was never provisioned"
        )
    return manifest["hosts_info"]


def next_collect_index(run_dir: Path) -> int:
    indices = [
        int(path.name.removeprefix("collect-"))
        for path in (run_dir / "hosts").glob("*/collect-*")
    ]
    return max(indices, default=0) + 1


def find_runs(
    run: Runner, region: str, out_root: Path, now: datetime, user: str
) -> list[TaggedRun]:
    """Every run with a resource tagged `espresso-bench-run`, with the reason
    it counts as an orphan (if it does)."""
    out = aws_json(
        run,
        "resourcegroupstaggingapi",
        "get-resources",
        "--tag-filters",
        f"Key={TAG_RUN}",
        "--query",
        "ResourceTagMappingList[].{arn:ResourceARN,tags:Tags}",
        region=region,
    )
    instances = describe_instances(run, region, f"Name=tag-key,Values={TAG_RUN}")
    volumes = describe_volumes(run, region, f"Name=tag-key,Values={TAG_RUN}")
    runs = group_runs(out, instances, volumes, list_scheduler_roles(run, region))
    for tagged in runs:
        phase = local_phase(out_root, tagged["name"])
        tagged["orphan"] = classify_orphan(tagged, phase, now, user) or role_orphan(
            tagged, phase
        )
    return runs


def describe_instances(run: Runner, region: str, *filters: str) -> list[Instance]:
    return aws_json(
        run,
        "ec2",
        "describe-instances",
        "--filters",
        *filters,
        "--query",
        "Reservations[].Instances[].{id:InstanceId,type:InstanceType,"
        "state:State.Name,launch:LaunchTime,reason:StateTransitionReason}",
        region=region,
    )


def describe_volumes(run: Runner, region: str, *filters: str) -> list[str]:
    """Ids of the volumes EC2 has; the tag API keeps listing a deleted volume for a while."""
    return aws_json(
        run,
        "ec2",
        "describe-volumes",
        "--filters",
        *filters,
        "--query",
        "Volumes[].VolumeId",
        region=region,
    )


def arn_parts(arn: str) -> tuple[str, str]:
    """(`instance`, `i-0abc`) of `arn:aws:ec2:eu-west-1:1:instance/i-0abc`; rds ARNs separate
    kind and id with a colon: (`db`, `name`) of `arn:aws:rds:eu-west-1:1:db:name`."""
    resource = arn.split(":", 5)[5]
    kind, _, resource_id = resource.partition("/" if "/" in resource else ":")
    return kind, resource_id


def group_runs(
    mappings: list[dict[str, Any]],
    instances: list[Instance],
    volumes: Iterable[str],
    roles: Iterable[str] = (),
) -> list[TaggedRun]:
    """Groups tag-API `{arn, tags}` mappings by run, sorted by owner then name. A terminated
    instance still shows up in both APIs for about an hour and is dropped, and so is a volume
    that is not in `volumes`, the ids EC2 has. `roles` are the ARNs
    of scheduler IAM roles: the tag API does not list them, and a fleet whose other resources
    are gone still counts through its role."""
    live = {i["id"]: i for i in instances if i["state"] != "terminated"}
    existing = set(volumes)
    runs: dict[str, TaggedRun] = {}
    for mapping in mappings:
        kind, resource_id = arn_parts(mapping["arn"])
        if kind == "instance" and resource_id not in live:
            continue
        if kind == "volume" and resource_id not in existing:
            continue
        tags = {tag["Key"]: tag["Value"] for tag in mapping["tags"]}
        tagged = runs.setdefault(tags[TAG_RUN], empty_tagged_run(tags[TAG_RUN]))
        tagged["owner"] = tags.get(TAG_OWNER, tagged["owner"])
        tagged["expires"] = later(tags.get(TAG_EXPIRES), tagged["expires"])
        tagged["arns"].append(mapping["arn"])
        if kind == "instance":
            tagged["instances"].append(live[resource_id])
    for arn in roles:
        fleet = role_fleet(arn)
        tagged = runs.setdefault(fleet, empty_tagged_run(fleet))
        tagged["arns"].append(arn)
    return sorted(runs.values(), key=lambda r: (r["owner"] or "", r["name"]))


def empty_tagged_run(name: str) -> TaggedRun:
    return {
        "name": name,
        "owner": None,
        "expires": None,
        "arns": [],
        "instances": [],
        "orphan": None,
    }


def later(a: str | None, b: str | None) -> str | None:
    """The later of two ISO timestamps."""
    if a is None or b is None:
        return a or b
    return max(a, b, key=datetime.fromisoformat)


def role_fleet(role_arn: str) -> str:
    """`fleet1` of `arn:aws:iam::1:role/espresso-bench/espresso-bench-fleet1`."""
    return arn_parts(role_arn)[1].rpartition("/")[2].removeprefix(RDS_PREFIX)


def local_phase(out_root: Path, name: str) -> str | None:
    """The fleet's manifest phase, or None when this machine no longer has its state: no
    `fleet.json`, or a terminal phase without terraform state. A live fleet has no tfstate
    during `tofu apply`."""
    fleet_dir = out_root / name
    if not (fleet_dir / FLEET_JSON).exists():
        return None
    phase = nb.read_json(fleet_dir / FLEET_JSON)["phase"]
    if (
        phase in TERMINAL_PHASES
        and not (fleet_dir / "terraform" / "terraform.tfstate").exists()
    ):
        return None
    return phase


def classify_orphan(
    tagged: TaggedRun, phase: str | None, now: datetime, user: str
) -> str | None:
    """Why `destroy --orphans` may sweep the run. A run of another owner without local state
    is that owner's live run, so only its expiry can condemn it."""
    if tagged["expires"] is not None and now > datetime.fromisoformat(
        tagged["expires"]
    ):
        return "past expiry"
    if phase in TERMINAL_PHASES:
        return f"run is {phase}"
    if phase is None and tagged["owner"] == user:
        return "no local state"
    return None


def role_orphan(tagged: TaggedRun, phase: str | None) -> str | None:
    """A scheduler role left behind by a fleet with no other resource and no local state.
    Another machine's `up` is exposed for the seconds between creating its role and its
    first tagged resource."""
    only_roles = all(arn_parts(arn)[0] == "role" for arn in tagged["arns"])
    return "role without resources" if only_roles and phase is None else None


def accrued_usd(
    instances: list[Instance], now: datetime, prices: dict[str, float]
) -> float:
    """Instance-hours since launch at `prices`."""
    return sum(
        (now - datetime.fromisoformat(i["launch"])).total_seconds()
        / 3600
        * prices[i["type"]]
        for i in instances
    )


def format_runs(
    runs: list[TaggedRun], now: datetime, prices: dict[str, float] | None = None
) -> list[str]:
    """One row per run; the instance USD column only with `prices`."""
    header = ["run", "owner", "launched", "expires", "resources", "orphan"]
    if prices is not None:
        header.insert(5, "instance USD")
    lines = ["| " + " | ".join(header) + " |", "|---" * len(header) + "|"]
    for tagged in runs:
        instances = tagged["instances"]
        launched = min((i["launch"] for i in instances), default="-")[:16]
        kinds = Counter(arn_parts(arn)[0] for arn in tagged["arns"])
        cells = [
            tagged["name"],
            tagged["owner"] or "-",
            launched,
            (tagged["expires"] or "-")[:16],
            ", ".join(f"{n} {kind}" for kind, n in sorted(kinds.items())),
            tagged["orphan"] or "",
        ]
        if prices is not None:
            cost = f"{accrued_usd(instances, now, prices):.2f}" if instances else "-"
            cells.insert(5, cost)
        lines.append("| " + " | ".join(cells) + " |")
    return lines


def write_run_json(run: Run) -> None:
    """`run.json` as `netbench.analyze` reads it, from the agent's final state."""
    agent = run.agent
    assert agent is not None
    nb.write_json(
        run.run_dir / "run.json",
        run_json(
            run.manifest,
            run.cfg.tag,
            agent,
            run.started,
            run.fleet.system.clock.time(),
        ),
    )


def run_json(
    manifest: Manifest, tag: str, agent: AgentState, started: float, now: float
) -> dict[str, Any]:
    return {
        "meta": {
            "sha": manifest["git_rev"],
            "ref": tag,
            "event": "aws",
            "run_id": None,
            "run_url": None,
            "pr": None,
            "local": False,
        },
        "config_hash": manifest["config_hash"],
        "started": started,
        "wall_s": now - started,
        "ready_s": agent["ready_s"],
        "t0": agent["t0"],
        "t1": agent["t1"],
        "teardown": [],
        "error": None,
    }


def finished_agent_state(run_dir: Path) -> AgentState | None:
    """The collected `agent-state.json` when the load finished, whatever the driver did after."""
    path = run_dir / "agent-state.json"
    if not path.exists():
        return None
    state: AgentState = nb.read_json(path)
    return state if state["phase"] == "done" else None


def write_report(run_dir: Path, baseline: nb.Baseline | None = None) -> nb.BenchResult:
    """Analyzes a collected run dir into `result.json` and `summary.md`; the same inputs give
    the same output, so `render` can call it again offline."""
    manifest: Manifest = nb.read_json(run_dir / "manifest.json")
    cfg = nb.load_config(nb.read_json(run_dir / "config.json"))
    prepare_analysis(run_dir, manifest)
    result = nb.analyze(run_dir, cfg, nb.read_json(run_dir / "topology.json"))
    run = nb.read_json(run_dir / "run.json")
    stats, evidence = load_evidence(run_dir, manifest, run["t0"], run["t1"])
    result["hosts"] = stats
    result["deployment"] = deployment_meta(manifest, evidence)
    result["validity"] = check_validity_aws(result, manifest, evidence)
    nb.write_json(run_dir / "result.json", result)
    comparison = nb.compare(result, baseline) if baseline else None
    chart = throughput_chart(run_dir)
    summary = nb.render(result, comparison, chart) + reproduce_section(manifest)
    (run_dir / "summary.md").write_text(summary)
    return result


def sanitize_argv(argv: list[str]) -> list[str]:
    """Drops the flags of `ARGV_DROP_*` and the value of `--fleet` (a local dir), in both the
    `--flag value` and `--flag=value` forms."""
    out: list[str] = []
    skip_value = False
    for i, tok in enumerate(argv):
        if skip_value:
            skip_value = False
            continue
        flag, has_value, _ = tok.partition("=")
        if flag in ARGV_DROP_FLAG:
            continue
        if flag in ARGV_DROP_VALUE:
            skip_value = not has_value
            continue
        if flag == "--fleet":
            out.append(flag)
            skip_value = not has_value and i + 1 < len(argv) and argv[i + 1][0] != "-"
            continue
        out.append(tok)
    return out


def pin_tag(argv: list[str], tag: str) -> list[str]:
    """`argv` with `--tag` set to `tag`, replacing the given one."""
    out: list[str] = []
    skip_value = False
    for tok in argv:
        if skip_value:
            skip_value = False
        elif tok == "--tag":
            skip_value = True
        elif not tok.startswith("--tag="):
            out.append(tok)
    return [*out, "--tag", tag]


def reproduce_section(manifest: Manifest) -> str:
    """The command(s) that made this run, sanitized and pinned to the run's image tag, with
    the digest the tag resolved to; empty for a manifest from before they were recorded.
    Then `argv` is missing or, for a fleet run, still the `up` command."""
    if "argv" not in manifest or manifest["argv"][0] != "run":
        return ""
    tag = manifest["config"]["tag"]
    run_argv = sanitize_argv(manifest["argv"])
    if "fleet_argv" in manifest:
        commands = [pin_tag(sanitize_argv(manifest["fleet_argv"]), tag), run_argv]
    else:
        commands = [pin_tag(run_argv, tag)]
    node = manifest["images"]["espresso-node"]
    lines = [
        *(f"just bench aws {shlex.join(argv)}" for argv in commands),
        f"# espresso-node {node['revision'] or '-'} {node['digest']}",
    ]
    return "\n".join(["", "", "### Reproduce", "", "```", *lines, "```", ""])


def throughput_chart(run_dir: Path) -> str:
    if not (run_dir / "throughput.png").is_file():
        return ""
    return "![throughput, blocks and latency](throughput.png)"


def search_config(saved: dict[str, Any] | None) -> nb.SearchConfig | None:
    return None if saved is None else nb.SearchConfig(**saved)


def prepare_analysis(run_dir: Path, manifest: Manifest) -> None:
    """The files `netbench.analyze` reads that the local bench produces itself. Its process and
    host statistics come from node0, the host with Postgres. The AWS harness runs no
    calibration; zeros keep the schema."""
    node0 = run_dir / "hosts" / "node0"
    shutil.copyfile(node0 / "host.jsonl", run_dir / "host.jsonl")
    zero: nb.Calibration = {
        "sha256_1t_mb_s": 0.0,
        "sha256_mt_mb_s": 0.0,
        "fsync_per_s": 0.0,
    }
    nb.write_json(run_dir / "calibration.json", {"before": zero, "after": zero})
    runner = runner_info(
        (node0 / "lscpu.txt").read_text(),
        (node0 / "meminfo.txt").read_text(),
        (node0 / "uname.txt").read_text(),
        manifest["ami_id"],
    )
    nb.write_json(run_dir / "sysinfo.json", {"runner": runner, "raw": {}})


def runner_info(lscpu: str, meminfo: str, uname: str, ami_id: str) -> nb.RunnerInfo:
    fields = {
        key.strip(): value.strip()
        for key, _, value in (line.partition(":") for line in lscpu.splitlines())
        if value.strip()
    }
    mem = re.search(r"^MemTotal:\s*(\d+) kB", meminfo, re.MULTILINE)
    if mem is None:
        raise ValueError(f"no MemTotal line in {meminfo!r}")
    cpus = int(fields["CPU(s)"])
    return {
        "cpu_model": fields["Model name"],
        "nproc": cpus,
        "affinity": cpus,
        "cgroup_cpu_max": None,
        "mhz": [float(fields["CPU max MHz"])] if "CPU max MHz" in fields else [],
        "flags": fields["Flags"].split(),
        "mem_total_bytes": int(mem.group(1)) * 1024,
        "kernel": uname.strip(),
        "image_os": "ubuntu",
        "image_version": ami_id,
        "runner_name": None,
    }


# Devices whose counters double count a parent (partitions, device mapper) or carry no I/O of
# interest, and the interfaces that are not the host's own network.
DISK_SKIP = re.compile(r"^(loop|ram|dm-)|p\d+$|^(sd|vd|xvd)[a-z]+\d+$")
NET_SKIP = re.compile(r"^(lo|docker\d+|veth.*|br-.*)$")


def counter_mb_s(
    samples: list[dict[str, Any]],
    key: str,
    fields: tuple[str, ...],
    skip: re.Pattern[str],
) -> float:
    def total(sample: dict[str, Any]) -> int:
        return sum(
            counters[f]
            for device, counters in sample[key].items()
            if not skip.search(device)
            for f in fields
        )

    span = samples[-1]["ts"] - samples[0]["ts"]
    return (total(samples[-1]) - total(samples[0])) / span / 1e6


def host_sample_stats(
    samples: list[dict[str, Any]], t0: float, t1: float
) -> tuple[nb.HostSample, float]:
    """`netbench.host_stats` plus disk and network MB/s over the window, and the fraction of
    the samples the window should hold that exist."""
    inside = [s for s in samples if t0 <= s["ts"] <= t1]
    coverage = min(1.0, len(inside) / ((t1 - t0) / HOST_SAMPLE_S))
    stats: nb.HostSample = {
        **nb.host_stats(samples, t0, t1),
        "disk_mb_s": 0.0,
        "net_mb_s": 0.0,
    }
    if len(inside) >= 2:
        stats["disk_mb_s"] = counter_mb_s(
            inside, "disk", ("read_bytes", "write_bytes"), DISK_SKIP
        )
        stats["net_mb_s"] = counter_mb_s(
            inside, "net", ("rx_bytes", "tx_bytes"), NET_SKIP
        )
    return stats, coverage


def parse_du_bytes(text: str) -> int:
    """`du -sb <dir>`: `<bytes>\\t<dir>`."""
    return int(text.split()[0])


def parse_clock_offset_ms(tracking: str) -> float:
    """`chronyc tracking`: `System time : 0.000012 seconds fast of NTP time`."""
    match = re.search(
        r"^System time\s*:\s*([\d.]+) seconds (?:fast|slow)", tracking, re.MULTILINE
    )
    if match is None:
        raise ValueError(
            f"no System time line in chronyc tracking output: {tracking!r}"
        )
    return float(match.group(1)) * 1000


def collect_ebs_balance(
    run: Runner,
    manifest: FleetManifest,
    t0: float,
    t1: float,
    out: Path,
) -> None:
    """`get-metric-data` for node0's EBS balance over `[t0 - period, t1 + period]` into
    `out/cloudwatch/ec2-node0.json`. Every mode: node0 carries the journal and, with the
    container or volume placements, Postgres."""
    instance_id = manifest["hosts_info"]["node0"]["instance_id"]
    start, end = metric_window(t0, t1)
    metrics = {qid: (metric, "Minimum") for qid, metric in EBS_BALANCE_METRICS.items()}
    queries = metric_queries("AWS/EC2", ("InstanceId", instance_id), metrics)
    stdout = get_metric_data(run, manifest_region(manifest), queries, start, end)
    balance: Ec2Balance = {
        "instance_id": instance_id,
        "period_s": CLOUDWATCH_PERIOD_S,
        "start": start,
        "end": end,
        "metrics": parse_metric_results(stdout, EBS_BALANCE_METRICS),
    }
    path = out / EC2_NODE0_FILE
    path.parent.mkdir(exist_ok=True)
    nb.write_json(path, balance)
    log.info("node0 EBS balance: %s", path)


def metric_window(t0: float, t1: float) -> tuple[float, float]:
    return t0 - CLOUDWATCH_PERIOD_S, t1 + CLOUDWATCH_PERIOD_S


def collect_rds_metrics(
    run: Runner, region: str, rds: RdsInfo, t0: float, t1: float, out: Path
) -> None:
    """`cloudwatch/rds.json`, in the format of `cloudwatch/ec2-node0.json`."""
    start, end = metric_window(t0, t1)
    dimension = ("DBInstanceIdentifier", rds["identifier"])
    queries = metric_queries("AWS/RDS", dimension, RDS_METRICS)
    stdout = get_metric_data(run, region, queries, start, end)
    names = {query_id: metric for query_id, (metric, _) in RDS_METRICS.items()}
    path = out / RDS_CLOUDWATCH_FILE
    path.parent.mkdir(exist_ok=True)
    nb.write_json(
        path,
        {
            "identifier": rds["identifier"],
            "period_s": CLOUDWATCH_PERIOD_S,
            "start": start,
            "end": end,
            "metrics": parse_metric_results(stdout, names),
        },
    )


def collect_rds_logs(
    run: Runner, region: str, rds: RdsInfo, t0: float, t1: float, out: Path
) -> None:
    """Every database log written since the load started. The upper bound is left open: the
    log of the current hour is still written after the window and holds most of it."""
    since_ms = int(t0 * 1000)
    listing = aws_json(
        run,
        "rds",
        "describe-db-log-files",
        "--db-instance-identifier",
        rds["identifier"],
        "--file-last-written",
        str(since_ms),
        region=region,
    )
    files = [f for f in listing["DescribeDBLogFiles"] if f["LastWritten"] >= since_ms]
    directory = out / RDS_LOGS_DIR
    directory.mkdir(exist_ok=True)
    for file in files:
        portion = aws_json(
            run,
            "rds",
            "download-db-log-file-portion",
            "--db-instance-identifier",
            rds["identifier"],
            "--log-file-name",
            file["LogFileName"],
            "--starting-token",
            "0",
            region=region,
        )
        (directory / Path(file["LogFileName"]).name).write_text(portion["LogFileData"])
    log.info("rds logs: %d files in %s", len(files), directory)


def metric_queries(
    namespace: str, dimension: tuple[str, str], metrics: dict[str, tuple[str, str]]
) -> list[dict[str, Any]]:
    """`--metric-data-queries` for one resource, `metrics` mapping query Id to (metric,
    stat)."""
    name, value = dimension
    return [
        {
            "Id": query_id,
            "MetricStat": {
                "Metric": {
                    "Namespace": namespace,
                    "MetricName": metric,
                    "Dimensions": [{"Name": name, "Value": value}],
                },
                "Period": CLOUDWATCH_PERIOD_S,
                "Stat": stat,
            },
        }
        for query_id, (metric, stat) in metrics.items()
    ]


def get_metric_data(
    run: Runner,
    region: str,
    queries: list[dict[str, Any]],
    start: float,
    end: float,
) -> dict[str, Any]:
    return aws_json(
        run,
        "cloudwatch",
        "get-metric-data",
        "--start-time",
        datetime.fromtimestamp(start, UTC).isoformat(),
        "--end-time",
        datetime.fromtimestamp(end, UTC).isoformat(),
        "--metric-data-queries",
        json.dumps(queries),
        region=region,
    )


def parse_metric_results(
    data: dict[str, Any], names: dict[str, str]
) -> dict[str, MetricSeries]:
    """Series per metric name from `get-metric-data`, `names` mapping query Id to metric; a
    metric without datapoints gets empty lists, any other status than `Complete` (e.g.
    `Forbidden`) raises."""
    results = {r["Id"]: r for r in data["MetricDataResults"]}
    series: dict[str, MetricSeries] = {}
    for query_id, metric in names.items():
        result = results[query_id]
        if result["StatusCode"] != "Complete":
            raise RemoteError(f"get-metric-data {metric}: {result['StatusCode']}")
        series[metric] = {
            "timestamps": [
                datetime.fromisoformat(ts).timestamp() for ts in result["Timestamps"]
            ],
            "values": result["Values"],
        }
    return series


def metric_min(path: Path, t0: float, t1: float) -> dict[str, float | None]:
    """Minimum per metric over the periods that overlap the load `[t0, t1]`, of a
    `cloudwatch/*.json` file: `ec2-node0.json` or `rds.json`."""
    balance: Ec2Balance = nb.read_json(path)
    period = balance["period_s"]
    return {
        metric: min(
            (
                value
                for ts, value in zip(series["timestamps"], series["values"])
                if ts + period > t0 and ts < t1
            ),
            default=None,
        )
        for metric, series in balance["metrics"].items()
    }


def ebs_balance_reasons(balance_min: dict[str, float | None]) -> list[str]:
    if not balance_min:
        return ["node0 EBS balance not collected"]
    reasons: list[str] = []
    for metric, low in balance_min.items():
        if low is not None and low < EBS_BALANCE_FULL_PCT:
            reasons.append(f"node0 {metric} fell to {low:.0f}% during the load")
    return reasons


def rds_reasons(rds_min: dict[str, float | None]) -> list[str]:
    """A missing datapoint is noisy, not invalid: CloudWatch can lag or omit a minute."""
    if not rds_min:
        return ["rds metrics not collected"]
    reasons: list[str] = []
    balance = set(EBS_BALANCE_METRICS.values())
    for metric, low in rds_min.items():
        if metric in balance:
            if low is not None and low < EBS_BALANCE_FULL_PCT:
                reasons.append(f"rds {metric} fell to {low:.0f}% during the load")
        elif low is None:
            reasons.append(f"rds {metric} has no datapoint in the load window")
    return reasons


def load_evidence(
    run_dir: Path, manifest: Manifest, t0: float, t1: float
) -> tuple[dict[str, nb.HostSample], Evidence]:
    """Reads `hosts/<name>/` as `collect_hosts` left it. A file that is missing (a host that
    could not be collected) is absent from the maps, and coverage is 0 without host samples."""
    stats: dict[str, nb.HostSample] = {}
    evidence: Evidence = {
        "coverage": {},
        "journal_bytes": {},
        "clock_offset_ms": {},
        "digest_mismatch": {},
        "ebs_balance_min": {},
    }
    balance = run_dir / EC2_NODE0_FILE
    if balance.exists():
        evidence["ebs_balance_min"] = metric_min(balance, t0, t1)
    if manifest["query_db"] == "rds":
        metrics = run_dir / RDS_CLOUDWATCH_FILE
        evidence["rds_min"] = metric_min(metrics, t0, t1) if metrics.exists() else {}
    for spec in manifest["hosts"]:
        name = spec["name"]
        host_dir = run_dir / "hosts" / name
        samples = host_dir / "host.jsonl"
        evidence["coverage"][name] = 0.0
        if samples.exists():
            stats[name], evidence["coverage"][name] = host_sample_stats(
                list(nb.read_jsonl(samples)), t0, t1
            )
        journal = host_dir / "du-journal.txt"
        if spec["role"] != "ctl" and journal.exists():
            evidence["journal_bytes"][name] = parse_du_bytes(journal.read_text())
        ready_path = host_dir / "ready.json"
        ready = nb.read_json(ready_path) if ready_path.exists() else None
        tracking = [
            text
            for text in (
                None if ready is None else ready["chronyc_tracking"],
                (host_dir / "chrony.txt").read_text()
                if (host_dir / "chrony.txt").exists()
                else None,
            )
            if text is not None
        ]
        if tracking:
            evidence["clock_offset_ms"][name] = max(
                map(parse_clock_offset_ms, tracking)
            )
        settings = host_dir / "pg-settings.json"
        # Empty when psql failed at collect time; treated like a missing file.
        if settings.exists() and settings.read_text().strip():
            evidence["pg_settings"] = nb.read_json(settings)
        samples = host_dir / "pg-stats.jsonl"
        if samples.exists():
            evidence["ssl_backends"] = sum_ssl_backends(nb.read_jsonl(samples), t0, t1)
        if ready is not None:
            evidence["digest_mismatch"][name] = digest_mismatches(
                ready["digests"], manifest["images"]
            )
    return stats, evidence


def sum_ssl_backends(
    samples: Iterable[dict[str, Any]], t0: float, t1: float
) -> Counter[str]:
    """The backend counts of the samples taken inside `[t0, t1]`, summed."""
    total: Counter[str] = Counter()
    for sample in samples:
        if t0 <= sample["ts"] <= t1:
            total.update(sample["ssl_backends"])
    return total


def deployment_meta(manifest: Manifest, evidence: Evidence) -> nb.DeploymentMeta:
    config = manifest["config"]
    images = manifest["images"]
    return {
        "provider": "aws",
        "account": ACCOUNT,
        "region": manifest_region(manifest),
        "az": manifest["az"],
        "ami": manifest["ami_id"],
        "hosts": {
            h["name"]: {"instance_type": h["instance_type"], "role": h["role"]}
            for h in manifest["hosts"]
        },
        "images": {n: f"{i['ref']}@{i['digest']}" for n, i in images.items()},
        "image_revision": images["espresso-node"]["revision"],
        "start_spread_s": manifest["start_spread_s"],
        "clock_offset_ms_max": max(evidence["clock_offset_ms"].values(), default=0.0),
        "cost_usd": manifest["cost_usd"],
        "query_db": query_db_meta(manifest, evidence),
        **({"latency": manifest["latency"]} if "latency" in manifest else {}),
        # Manifests from before the flag have no such key.
        **({"node_env": config["node_env"]} if config.get("node_env") else {}),
        **(
            {"max_block_size": config["max_block_size"]}
            if "max_block_size" in config
            else {}
        ),
    }


def rds_identifier(fleet_name: str) -> str:
    return f"{RDS_PREFIX}{fleet_name}"


def query_db_meta(manifest: Manifest, evidence: Evidence) -> nb.QueryDbMeta:
    """Where node0's Postgres ran. `tls` is whether every backend negotiated TLS during the
    load; no backend counts as off."""
    mode = manifest["query_db"]
    tls = "ssl_backends" in evidence and pg_tls(evidence["ssl_backends"]) is True
    tuning = {key: conf for key, (conf, _) in run_pg_tuning(manifest).items()}
    engine, store = db_store(manifest)
    meta: nb.QueryDbMeta = {
        "mode": mode,
        "engine": engine,
        "store": store,
        "tls": tls,
        "tuning": tuning,
    }
    if mode == "rds":
        meta["instance_class"] = manifest["rds_spec"]["instance_class"]
    return meta


def db_store(manifest: Manifest) -> tuple[str, dict[str, Any]]:
    """The engine and backing store of node0's Postgres."""
    mode = manifest["query_db"]
    tag = manifest["images"]["postgres"]["ref"].rpartition(":")[2]
    match mode:
        case "colocated":
            node0 = next(h for h in manifest["hosts"] if h["name"] == "node0")
            return f"postgres {tag}", {
                "type": "root",
                "gb": node0["root_gb"],
                "iops": node0["root_iops"],
                "mbps": node0["root_mbps"],
            }
        case "volume":
            return f"postgres {tag}", {
                "type": "ebs",
                "volume_id": manifest["pg_volume_id"],
                **manifest["pg_volume"],
            }
        case "rds":
            rds = manifest["rds_spec"]
            return f"postgres {rds['engine_version']}", {
                "type": "rds-gp3",
                "identifier": rds_identifier(manifest["fleet"]),
                "gb": rds["gb"],
                "iops": rds["iops"],
                "mbps": rds["mbps"],
            }
        case _:
            raise ValueError(f"no query db metadata for {mode}")


def check_validity_aws(
    result: nb.BenchResult, manifest: Manifest, evidence: Evidence
) -> nb.Validity:
    """`result["validity"]` (netbench's own rules) plus the fleet rules: invalid on missing host
    samples, a digest that differs from the manifest or a clock offset above
    CLOCK_OFFSET_INVALID_MS; noisy on start spread, clock offset, ctl
    CPU, journal size, steal or node0's EBS balance below 95% (or not collected)."""
    invalid: list[str] = []
    noisy: list[str] = []
    for host, frac in evidence["coverage"].items():
        if frac < nb.SCRAPE_OK_MIN:
            invalid.append(f"{host} host samples cover only {frac:.0%} of the window")
    for host, names in evidence["digest_mismatch"].items():
        if names:
            invalid.append(
                f"{host} pulled another digest than the manifest for {', '.join(names)}"
            )
    offset = max(evidence["clock_offset_ms"].values(), default=0.0)
    if offset > CLOCK_OFFSET_INVALID_MS:
        invalid.append(
            f"clock offset {offset:.0f} ms > {CLOCK_OFFSET_INVALID_MS:.0f} ms"
        )
    elif offset > CLOCK_OFFSET_NOISY_MS:
        noisy.append(f"clock offset {offset:.0f} ms > {CLOCK_OFFSET_NOISY_MS:.0f} ms")
    spread = manifest["start_spread_s"]
    if spread >= START_SPREAD_NOISY_S:
        noisy.append(f"nodes started {spread:.1f} s apart")
    hosts = result["hosts"]
    if "ctl" in hosts and hosts["ctl"]["util_mean"] > CTL_CPU_NOISY_FRAC:
        noisy.append(f"ctl CPU busy {hosts['ctl']['util_mean']:.0%}")
    for name, stats in hosts.items():
        # node0's steal is already judged by netbench.check_validity through result["host"].
        if name != "node0" and stats["steal_pct"] > nb.STEAL_NOISY_PCT:
            noisy.append(
                f"{name} steal {stats['steal_pct']:.1f}% > {nb.STEAL_NOISY_PCT:.0f}%"
            )
    if "pg_settings" in evidence:
        settings = evidence["pg_settings"]
        tuning = run_pg_tuning(manifest)
        for key in check_pg_tuning(settings, tuning):
            noisy.append(
                f"node0 postgres {key}={settings[key]} differs from the tuned {tuning[key][0]}"
            )
    if "ssl_backends" in evidence and pg_tls(evidence["ssl_backends"]) is False:
        noisy.append("node0 postgres backends connected without TLS")
    specs = {h["name"]: h for h in manifest["hosts"]}
    if manifest_storage(manifest["config"]) == "journal":
        for name, size in evidence["journal_bytes"].items():
            limit = _journal_max_bytes(specs[name])
            if size > JOURNAL_NOISY_FRACTION * limit:
                noisy.append(
                    f"{name} journal {size / 1e9:.1f} GB near its {limit / 1e9:.1f} GB limit"
                )
    noisy += ebs_balance_reasons(evidence["ebs_balance_min"])
    if "rds_min" in evidence:
        noisy += rds_reasons(evidence["rds_min"])
    base = result["validity"]
    return {
        "valid": base["valid"] and not invalid,
        "noisy": base["noisy"] or bool(noisy),
        "reasons": base["reasons"] + invalid + noisy,
    }


def write_failure_summary(run_dir: Path, manifest: Manifest, error: str | None) -> None:
    """A run without a result: the error (`netbench.wait_ready` includes the last heights) and
    the last log lines of every node container that was collected."""
    lines = ["## Network benchmark", "", f"**invalid**: {error}", ""]
    for spec in manifest["hosts"]:
        path = run_dir / "hosts" / spec["name"] / "espresso-node.log.gz"
        if path.exists():
            try:
                with gzip.open(path, "rt", errors="replace") as log_file:
                    tail_lines = log_file.read().splitlines()[-FAILURE_LOG_LINES:]
                tail = [line[:300] for line in tail_lines]
            except (OSError, EOFError) as exc:  # a log cut off by a timed-out collect
                tail = [f"log unreadable: {exc}"]
            lines += [f"Last log lines of {spec['name']}:", "", "```", *tail, "```", ""]
    (run_dir / "summary.md").write_text("\n".join(lines))


def tagged_resources(run: Runner, region: str, name: str | None = None) -> list[str]:
    """ARNs of resources tagged `espresso-bench-run`, of one run when `name` is given."""
    tag = f"Key={TAG_RUN}" + (f",Values={name}" if name is not None else "")
    return aws_json(
        run,
        "resourcegroupstaggingapi",
        "get-resources",
        "--tag-filters",
        tag,
        "--query",
        "ResourceTagMappingList[].ResourceARN",
        region=region,
    )


class AwsStep(TypedDict):
    action: Literal["aws"]
    # `aws_json` arguments.
    args: list[str]
    tolerate: str | None


class ResourceStep(TypedDict):
    action: Literal["delete_rds", "delete_security_group"]
    resource: str


SweepStep = AwsStep | ResourceStep


def sweep_plan(arns: list[str]) -> list[SweepStep]:
    """The deletions for `arns` in dependency order: the delete schedule group (so it cannot
    fire mid-sweep), instances, the rds instance (waiting for it) with its subnet and parameter
    groups, volumes, security group (the rds network interfaces hold it until the instance is
    gone) and key pair."""
    by_kind: defaultdict[str, list[str]] = defaultdict(list)
    for arn in arns:
        kind, resource_id = arn_parts(arn)
        by_kind[kind].append(resource_id)

    def delete(
        service: str, verb: str, id_flag: str, resource_id: str, tolerate: str | None
    ) -> AwsStep:
        args = [service, verb, id_flag, resource_id]
        return AwsStep(action="aws", args=args, tolerate=tolerate)

    plan: list[SweepStep] = [
        delete(
            "scheduler",
            "delete-schedule-group",
            "--name",
            group,
            "ResourceNotFoundException",
        )
        for group in by_kind["schedule-group"]
    ]
    if instances := by_kind["instance"]:
        ids = ["--instance-ids", *instances]
        for verb in (["terminate-instances"], ["wait", "instance-terminated"]):
            args = ["ec2", *verb, *ids]
            plan.append(AwsStep(action="aws", args=args, tolerate=None))
    plan += [
        ResourceStep(action="delete_rds", resource=identifier)
        for identifier in by_kind["db"]
    ]
    plan += [
        delete(
            "rds",
            "delete-db-subnet-group",
            "--db-subnet-group-name",
            group,
            "DBSubnetGroupNotFound",
        )
        for group in by_kind["subgrp"]
    ]
    plan += [
        delete(
            "rds",
            "delete-db-parameter-group",
            "--db-parameter-group-name",
            group,
            "DBParameterGroupNotFound",
        )
        for group in by_kind["pg"]
    ]
    # Root volumes normally vanish with their instance.
    plan += [
        delete("ec2", "delete-volume", "--volume-id", volume, "InvalidVolume.NotFound")
        for volume in by_kind["volume"]
    ]
    plan += [
        ResourceStep(action="delete_security_group", resource=group)
        for group in by_kind["security-group"]
    ]
    plan += [
        delete("ec2", "delete-key-pair", "--key-pair-id", key, None)
        for key in by_kind["key-pair"]
    ]
    return plan


def sweep(system: System, region: str, name: str | None) -> list[str]:
    """Deletes what `tagged_resources` finds as `sweep_plan` orders it, then the scheduler role
    of an rds fleet. Returns every ARN found."""
    arns = tagged_resources(system.run, region, name)
    for step in sweep_plan(arns):
        if step["action"] == "aws":
            aws_json(
                system.run, *step["args"], region=region, tolerate=step["tolerate"]
            )
        elif step["action"] == "delete_rds":
            delete_rds(system.run, region, step["resource"])
        else:
            delete_security_group(system, region, step["resource"])
    if fleets := rds_fleets(arns):
        sweep_iam(system.run, region, fleets)
    return arns


def rds_fleets(arns: Iterable[str]) -> set[str]:
    """Names of the fleets that own an rds instance or delete schedule group among `arns`."""
    return {
        resource_id.removeprefix(RDS_PREFIX)
        for kind, resource_id in map(arn_parts, arns)
        if kind in ("db", "schedule-group")
    }


def delete_rds(run: Runner, region: str, identifier: str) -> None:
    """Deletes the instance and waits until it is gone. One the schedule or a destroy is
    already deleting is only waited for."""
    status = aws_json(
        run,
        "rds",
        "describe-db-instances",
        "--db-instance-identifier",
        identifier,
        "--query",
        "DBInstances[0].DBInstanceStatus",
        region=region,
        tolerate="DBInstanceNotFound",
    )
    if not status:
        return
    if status != "deleting":
        aws_json(
            run,
            "rds",
            "delete-db-instance",
            "--db-instance-identifier",
            identifier,
            "--skip-final-snapshot",
            "--delete-automated-backups",
            region=region,
            tolerate="DBInstanceNotFound",
        )
    log.info("waiting for rds %s to be deleted", identifier)
    aws_json(
        run,
        "rds",
        "wait",
        "db-instance-deleted",
        "--db-instance-identifier",
        identifier,
        region=region,
    )


def role_region(role_arn: str) -> str:
    """`eu-central-1` of `arn:aws:iam::1:role/espresso-bench/eu-central-1/espresso-bench-f`;
    the old path `espresso-bench/` has no region. IAM is global, so the path keeps a sweep from
    seeing the roles of other regions."""
    path = arn_parts(role_arn)[1].rpartition("/")[0]
    return path.removeprefix(IAM_ROLE_PATH.strip("/")).strip("/") or LEGACY_REGION


def list_scheduler_roles(run: Runner, region: str) -> list[str]:
    """ARNs of the IAM roles under `IAM_ROLE_PATH` of `region`. A profile without
    `iam:ListRoles` sees none; only rds fleets create roles, and they need IAM rights anyway."""
    out = aws_json(
        run,
        "iam",
        "list-roles",
        "--path-prefix",
        IAM_ROLE_PATH,
        "--query",
        "Roles[].Arn",
        region=region,
        tolerate="AccessDenied",
    )
    if out is None:
        log.warning("iam:ListRoles denied: scheduler roles are not listed")
        return []
    return [arn for arn in out if role_region(arn) == region]


def sweep_iam(run: Runner, region: str, fleets: set[str]) -> None:
    """Deletes the scheduler role of each fleet in `fleets` that has one, inline policies
    first."""
    for arn in list_scheduler_roles(run, region):
        if role_fleet(arn) not in fleets:
            continue
        role = arn_parts(arn)[1].rpartition("/")[2]
        listed = aws_json(
            run,
            "iam",
            "list-role-policies",
            "--role-name",
            role,
            "--query",
            "PolicyNames",
            region=region,
            tolerate="NoSuchEntity",
        )
        for policy in listed or []:
            aws_json(
                run,
                "iam",
                "delete-role-policy",
                "--role-name",
                role,
                "--policy-name",
                policy,
                region=region,
                tolerate="NoSuchEntity",
            )
        aws_json(
            run,
            "iam",
            "delete-role",
            "--role-name",
            role,
            region=region,
            tolerate="NoSuchEntity",
        )


def delete_security_group(system: System, region: str, group: str) -> None:
    for attempt in range(1, SG_DELETE_RETRIES + 1):
        try:
            aws_json(
                system.run,
                "ec2",
                "delete-security-group",
                "--group-id",
                group,
                region=region,
            )
            return
        except Refused as exc:
            if "DependencyViolation" not in str(exc) or attempt == SG_DELETE_RETRIES:
                raise
            log.debug("security group %s still in use, retrying", group)
            system.clock.sleep(SG_DELETE_BACKOFF_S)


TERMINATION_TIME = re.compile(r"\((\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) GMT\)")


def actual_cost(
    run: Runner, manifest: FleetManifest, now: datetime
) -> dict[str, float]:
    """expected, bound and actual USD, with the run's wall time in `duration_s`. Actual is the
    estimate's price lines at the time between the first launch and the last termination,
    from `describe-instances` (terminated instances stay listed for about an hour)."""
    region = manifest_region(manifest)
    rows = describe_instances(
        run, region, f"Name=tag:{TAG_RUN},Values={manifest['name']}"
    )
    if not rows:
        raise RemoteError(f"no instances tagged {manifest['name']} to price")
    launches = [datetime.fromisoformat(row["launch"]) for row in rows]
    ends = []
    for row in rows:
        if row.get("reason") is None:
            continue
        match = TERMINATION_TIME.search(row["reason"])
        if match is None:
            raise ValueError(f"no termination time in {row['reason']!r}")
        ends.append(datetime.fromisoformat(match.group(1)).replace(tzinfo=UTC))
    if not ends:
        raise ValueError(f"no termination reason for {manifest['name']}")
    duration_s = (max(ends) - min(launches)).total_seconds()
    estimate = manifest["estimate"]
    rds_s = (
        rds_billed_s(run, manifest, min(launches), now)
        if "rds_spec" in manifest
        else None
    )
    return {
        "expected": estimate["expected_usd"],
        "bound": estimate["bound_usd"],
        "actual": manifest_cost(manifest, duration_s, rds_s),
        "duration_s": duration_s,
    }


def rds_billed_s(
    run: Runner, manifest: FleetManifest, first_launch: datetime, now: datetime
) -> float:
    """Create to delete. The instance is created alongside the hosts, so a fleet that failed
    before `prepare_rds` recorded its creation time counts from the first launch."""
    created = first_launch
    if "rds" in manifest and "created_at" in manifest["rds"]:
        created = datetime.fromisoformat(manifest["rds"]["created_at"])
    deleted = rds_delete_time(
        run, manifest_region(manifest), rds_identifier(manifest["name"]), now
    )
    return (deleted - created).total_seconds()


def rds_delete_time(
    run: Runner, region: str, identifier: str, fallback: datetime
) -> datetime:
    """When RDS logged the deletion, whether the schedule or `tofu destroy` did it; `fallback`
    (the driver's clock after the destroy) when it logged none."""
    out = aws_json(
        run,
        "rds",
        "describe-events",
        "--source-type",
        "db-instance",
        "--source-identifier",
        identifier,
        "--event-categories",
        "deletion",
        "--duration",
        str(RDS_EVENTS_MINUTES),
        region=region,
    )
    deleted = [
        datetime.fromisoformat(event["Date"])
        for event in out["Events"]
        if "deleted" in event["Message"].lower()
    ]
    return max(deleted, default=fallback)


def manifest_cost(
    manifest: FleetManifest, duration_s: float, rds_duration_s: float | None = None
) -> float:
    """USD of the whole fleet running `duration_s` at the estimate's prices. The rds instance, if any, runs
    `rds_duration_s` (default `duration_s`)."""
    lines = _cost_lines(
        manifest["hosts"],
        duration_s,
        manifest.get("pg_volume"),
        estimate_instance_prices(manifest["estimate"]),
    )
    if "rds_spec" in manifest:
        lines += rds_cost_lines(
            manifest["rds_spec"],
            duration_s if rds_duration_s is None else rds_duration_s,
        )
    return sum(line["usd"] for line in lines)


