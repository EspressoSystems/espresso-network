def _pull_and_record_digest(name: str, ref: str) -> str:
    """Pulls by the requested digest, then records what `docker image inspect` says was
    actually pulled, into /opt/bench/digests.json; ready.json's manifest check needs the
    pulled digest, not the requested one, to ever be able to fail."""
    inspect_format = "{{json .RepoDigests}}"
    return (
        f"docker pull {ref}\n"
        f"pulled=$(docker image inspect --format {shlex.quote(inspect_format)} "
        f"{shlex.quote(ref)} | jq -r '.[0]')\n"
        f'jq --arg name {shlex.quote(name)} --arg digest "$pulled" '
        "'. + {($name): $digest}' "
        f"{BENCH_DIR}/digests.json > {BENCH_DIR}/digests.json.tmp\n"
        f"mv {BENCH_DIR}/digests.json.tmp {BENCH_DIR}/digests.json"
    )


# The key must be 0600 and owned by the postgres user of the official image (uid 999).
QUERY_SETUP = f"""mkdir -p /data/pg {PG_TLS_DIR}
openssl req -x509 -newkey rsa:2048 -nodes -days 30 -subj /CN=postgres \\
  -keyout {PG_TLS_DIR}/server.key -out {PG_TLS_DIR}/server.crt
chown 999:999 {PG_TLS_DIR}/server.key {PG_TLS_DIR}/server.crt
chmod 0600 {PG_TLS_DIR}/server.key"""


def render_user_data(host: HostSpec, images: dict[str, ImageInfo], ttl_s: int) -> str:
    needed = ROLE_IMAGES[host["role"]]
    pulls = "\n".join(
        _pull_and_record_digest(name, f"{images[name]['ref']}@{images[name]['digest']}")
        for name in needed
    )
    query = host["role"] == "query"
    ttl_min = max(1, -(-ttl_s // 60))
    template = string.Template(USER_DATA_TEMPLATE.read_text())
    return template.substitute(
        TTL_MIN=str(ttl_min),
        EXTRA_PACKAGES=" postgresql-client openssl" if query else "",
        QUERY_SETUP=QUERY_SETUP if query else "",
        DOCKER_PULLS=pulls,
    )


def _docker_create(name: str, argv: list[str], entrypoint: str | None = None) -> str:
    """`argv` is everything after `docker create --name <name> --network host --restart no
    [--entrypoint <entrypoint>]`. Only creates: commit 6's `start_nodes` runs `docker start` on
    every host at one wall-clock time. `docker create` prints the container id on stdout;
    captured straight into containers.json, the map `agent-host` reads to find each container's
    cgroup."""
    flags = ["docker", "create", "--name", name, "--network", "host", "--restart", "no"]
    if entrypoint is not None:
        flags += ["--entrypoint", entrypoint]
    create = " ".join(flags + [shlex.quote(a) for a in argv])
    return (
        f"id=$({create})\n"
        f"jq --arg n {shlex.quote(name)} --arg i \"$id\" '. + {{($n): $i}}' "
        f"{BENCH_DIR}/containers.json > {BENCH_DIR}/containers.json.tmp\n"
        f"mv {BENCH_DIR}/containers.json.tmp {BENCH_DIR}/containers.json\n\n"
    )


def render_start_sh(
    host: HostSpec,
    images: dict[str, ImageInfo],
    memory_mib: int,
    query_db: DbMode = "colocated",
    leader_trace: bool = False,
    consensus_storage: ConsensusStorage = "fs",
) -> str:
    """Deviates from the plan signature (drops unused `hosts`, `cfg`): every value start.sh
    needs is already in `host`, `images` and the host's `memory_mib`, or in ctl.env/node.env
    rendered separately. With `query_db` rds there is no postgres container."""
    script = (
        "#!/usr/bin/env bash\nset -eEu -o pipefail\n\n"
        f"echo '{{}}' > {BENCH_DIR}/containers.json\n\n"
    )
    if host["role"] == "ctl":
        anvil = images["foundry"]
        # The foundry image's ENTRYPOINT is `sh -c`; without --entrypoint, `anvil ...` becomes
        # `sh -c anvil`, dropping every flag, so anvil binds 127.0.0.1 instead of 0.0.0.0.
        script += _docker_create(
            "anvil",
            [
                f"{anvil['ref']}@{anvil['digest']}",
                "--host",
                "0.0.0.0",
                "--port",
                str(env_port("ESPRESSO_L1_PORT")),
                "--chain-id",
                "31337",
                "--accounts",
                "20",
                "--balance",
                "1000000000",
                "--block-time",
                "1",
            ],
            entrypoint="anvil",
        )
        for name, binary in (
            ("deploy", "/bin/deploy"),
            ("orchestrator", "/bin/orchestrator"),
            ("state-relay-server", "/bin/state-relay-server"),
        ):
            image = images[name]
            argv = [
                "--env-file",
                f"{BENCH_DIR}/ctl.env",
                f"{image['ref']}@{image['digest']}",
                binary,
            ]
            if name == "deploy":
                argv += list(DEPLOY_FLAGS)
            script += _docker_create(name, argv)
        return script
    if host["role"] == "query" and query_db != "rds":
        pg = images["postgres"]
        endpoint = pg_endpoint()
        script += _docker_create(
            "postgres",
            [
                "-v",
                "/data/pg:/var/lib/postgresql",
                "-v",
                f"{PG_TLS_DIR}:/tls:ro",
                f"--shm-size={PG_SHM_SIZE}",
                "-e",
                f"POSTGRES_USER={endpoint['user']}",
                "-e",
                f"POSTGRES_PASSWORD={endpoint['password']}",
                "-e",
                f"POSTGRES_DB={endpoint['database']}",
                f"{pg['ref']}@{pg['digest']}",
                *render_postgres_args(memory_mib),
            ],
        )
    node = images["espresso-node"]
    role: NodeRole = "query" if host["role"] == "query" else "validator"
    modules = (*STORAGE_MODULES[consensus_storage, role], *API_MODULES[role])
    argv = [
        "--env-file",
        f"{BENCH_DIR}/node.env",
        "-v",
        "/data/journal:/store",
        "-v",
        f"{BENCH_DIR}/genesis.toml:{BENCH_DIR}/genesis.toml:ro",
    ]
    if host["role"] == "query":
        # After reset_script wiped /data/pg and pg_store_script mounted the run's placement.
        script += f"mkdir -p {PAYLOAD_HOST_DIR}\n\n"
        argv += ["-v", f"{PAYLOAD_HOST_DIR}:{PAYLOAD_CONTAINER_DIR}"]
    if leader_trace:
        script += f"mkdir -p {TRACE_HOST_DIR}\n\n"
        argv += ["-v", f"{TRACE_HOST_DIR}:{TRACE_CONTAINER_DIR}"]
    argv.append(f"{node['ref']}@{node['digest']}")
    argv.append("/bin/espresso-node")
    for module in modules:
        argv += ["--", module]
    script += _docker_create("espresso-node", argv)
    return script


def geometric_steps(start: float, factor: float, top: float) -> tuple[float, ...]:
    """`start`, `start*factor`, ... below `top`, then `top` itself."""
    steps = []
    rate = start
    while rate < top:
        steps.append(round(rate, 1))
        rate *= factor
    return (*steps, top)


def aws_load() -> nb.BenchConfig:
    return nb.BenchConfig(
        steps=geometric_steps(STEP_START_MB_S, STEP_FACTOR, STEP_TOP_MB_S),
        workers=SUBMIT_WORKERS,
        heartbeat_tx_s=HEARTBEAT_TX_S,
    )


def add_run_flags(parser: argparse.ArgumentParser, tag_required: bool = True) -> None:
    defaults = RunConfig(tag="")
    load = defaults.load
    parser.add_argument(
        "--tag", required=tag_required, help="ghcr tag pushed by CI, no default"
    )
    parser.add_argument(
        "--allocator",
        choices=ALLOCATORS,
        help="espresso-node built with this allocator, espresso-node-alloc:<tag>-<allocator>",
    )
    parser.add_argument("--nodes", type=int, default=defaults.nodes)
    parser.add_argument("--node-type", default=defaults.node_type)
    parser.add_argument("--ctl-type", default=defaults.ctl_type)
    steps = ", ".join(f"{rate:g}" for rate in load.steps)
    parser.add_argument(
        "--steps",
        type=nb.parse_rates,
        help=f"MB/s per step, increasing; default {steps} (x1.5 up to 200)",
    )
    parser.add_argument(
        "--step-s",
        type=int,
        help=f"default {load.step_s}, with --search {SEARCH_STEP_S}",
    )
    parser.add_argument(
        "--cap-s",
        type=float,
        help=f"default {load.cap_s:g}, with --search {SEARCH_CAP_S:g}",
    )
    parser.add_argument(
        "--tx-timeout-s",
        type=int,
        help=f"default {load.tx_timeout_s}, with --search {SEARCH_TX_TIMEOUT_S}",
    )
    parser.add_argument("--submit-workers", type=positive_int, default=load.workers)
    first_ns, last_ns = load.namespaces
    parser.add_argument(
        "--namespaces",
        type=positive_int,
        default=last_ns - first_ns + 1,
        help=f"namespaces the load spreads over, round robin from {first_ns}",
    )
    parser.add_argument(
        "--heartbeat-tx-s",
        type=float,
        default=load.heartbeat_tx_s,
        help="8-byte transactions per second for the whole run, 0 for none",
    )
    parser.add_argument("--warmup-s", type=int, default=load.warmup_s)
    parser.add_argument(
        "--keep-going",
        action="store_true",
        help="run every step whatever its verdict, then wait for the query node to catch up",
    )
    add_search_flags(parser)
    parser.add_argument("--root-gb", default=defaults.root_gb)
    parser.add_argument("--pg-iops", type=int, default=defaults.pg_iops)
    parser.add_argument("--pg-mbps", type=int, default=defaults.pg_mbps)
    parser.add_argument("--max-usd", type=float, default=defaults.max_usd)
    parser.add_argument(
        "--region",
        default=REGION,
        help="AWS region of the fleet; commands on the fleet read it from its manifest",
    )


