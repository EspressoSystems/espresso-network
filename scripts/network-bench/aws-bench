    return parser.parse_args(argv)


def cmd_plan(args: argparse.Namespace, system: System) -> int:
    cfg = dataclasses.replace(
        config_from_args(args), db_modes=args.db_modes, ttl_min=args.ttl_min
    )
    fleet_dir, *_ = plan_fleet(args, cfg, system)
    log.info("rendered %s (phase=planned)", fleet_dir)
    return EXIT_OK


def estimate_or_refuse(
    cfg: RunConfig,
    hosts: list[HostSpec],
    fleet_dir: Path,
    now: float,
    instance_prices: dict[str, float],
    fleet: bool = False,
    rds: RdsSpec | None = None,
) -> Estimate:
    if fleet:
        if cfg.ttl_min == "auto":
            raise Refused(
                "up needs --ttl-min N minutes: a fleet has no worst case to derive it from"
            )
        ttl_s = int(cfg.ttl_min) * 60.0
        estimate = cost_estimate(
            hosts, cfg, rds, ttl_s, ttl_s, instance_prices=instance_prices
        )
        expires = datetime.fromtimestamp(now + estimate["ttl_s"], UTC)
        log.info(format_fleet_summary(estimate, cfg.max_usd, expires))
    else:
        estimate = cost_estimate(
            hosts, cfg, rds, *shot_seconds(cfg), instance_prices=instance_prices
        )
        log.info(format_estimate_summary(estimate, cfg.max_usd))
        for line in format_node_summary(cfg):
            log.info(line)
        if cfg.search:
            log.info(format_search_summary(cfg))
    for line in format_estimate_lines(estimate):
        log.debug(line)
    if estimate["bound_usd"] > cfg.max_usd:
        append_event(
            fleet_dir,
            "planned",
            "refused",
            f"bound ${estimate['bound_usd']:.2f} exceeds --max-usd ${cfg.max_usd:.2f}",
        )
        raise Refused(
            f"hard bound ${estimate['bound_usd']:.2f} exceeds --max-usd "
            f"${cfg.max_usd:.2f}; pass --max-usd {estimate['bound_usd']:.2f} or shrink the run"
        )
    return estimate


class Interrupts:
    """The first SIGINT/SIGTERM/SIGHUP sets `event`; `check` turns it into `Interrupted` at the
    next phase boundary or wait, so a `tofu apply` or rsync in flight finishes. Every later
    signal, armed or not, forwards SIGINT to the `tofu` subprocesses in flight: tofu stops
    gracefully and writes its state on the first, exits on the next. After `disarm` signals are otherwise
    logged and ignored, except that the third one sets `skip_collect`."""

    def __init__(self, clock: nb.Clock, forward: Forward) -> None:
        self.clock = clock
        self.forward = forward
        self.event = threading.Event()
        self.skip_collect = threading.Event()
        self.signals = 0
        self.armed = True
        self.phase = "starting"

    def install(self, trap: Trap) -> None:
        trap((signal.SIGINT, signal.SIGTERM, signal.SIGHUP), self._handle)

    def _handle(self, signum: int, frame: Any) -> None:
        self.signals += 1
        if self.signals > 1 and (sent := self.forward(signal.SIGINT)):
            log.warning("signal %d: forwarded SIGINT to %s", signum, ", ".join(sent))
        if self.signals >= SKIP_COLLECT_SIGNALS:
            self.skip_collect.set()
            log.warning("signal %d: skipping the rest of the collection", signum)
        elif not self.armed:
            log.warning("signal %d ignored: teardown in progress", signum)
        elif self.event.is_set():
            log.warning("still waiting for the current step (%s)", self.phase)
        else:
            self.event.set()
            log.warning(
                "interrupt received; stopping after the current step (%s)", self.phase
            )

    def check(self) -> None:
        if self.armed and self.event.is_set():
            raise Interrupted("interrupted")

    def wait(self, event: threading.Event, seconds: float) -> bool:
        return self.clock.wait(event, seconds)

    def sleep(self, seconds: float) -> None:
        if not self.armed:
            self.clock.sleep(seconds)
            return
        self.wait(self.event, seconds)
        self.check()

    def disarm(self) -> None:
        self.armed = False


class Remote:
    """ssh and rsync to the fleet through the injectable Runner. ControlMaster sockets live in
    `<fleet>/ssh/<public ip>` and host keys in `<fleet>/known_hosts`. The socket path budget is
    `SOCKET_PATH_MAX`: a relative `OUT_ROOT/<name>` peaks at 53 + len(name) bytes, 93 for the
    longest valid name, while an absolute path usually overflows."""

    def __init__(
        self, run: Runner, fleet_dir: Path, ssh_key: Path, hosts: dict[str, HostInfo]
    ):
        if (peak := control_path_peak(fleet_dir)) > SOCKET_PATH_MAX:
            raise Refused(
                f"ssh ControlPath under {fleet_dir} reaches {peak} bytes, over the "
                f"{SOCKET_PATH_MAX} byte unix socket limit: pass a relative path"
            )
        self.run = run
        self.hosts = hosts
        (fleet_dir / "ssh").mkdir(exist_ok=True)
        self.ssh_opts = [
            "-i",
            str(ssh_key),
            "-o",
            "ControlMaster=auto",
            "-o",
            "ControlPersist=10m",
            "-o",
            f"ControlPath={fleet_dir / 'ssh' / '%h'}",
            "-o",
            f"UserKnownHostsFile={fleet_dir / 'known_hosts'}",
            "-o",
            "StrictHostKeyChecking=accept-new",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=10",
            "-o",
            "ServerAliveInterval=15",
            "-o",
            "ServerAliveCountMax=4",
        ]

    def _target(self, host: str) -> str:
        return f"{SSH_USER}@{self.hosts[host]['public_ip']}"

    def ssh(
        self, host: str, command: str, check: bool = True
    ) -> subprocess.CompletedProcess[str]:
        result = self.run(["ssh", *self.ssh_opts, self._target(host), command])
        if check and result.returncode != 0:
            raise RemoteError(
                f"{host}: `{command}` exited {result.returncode}: {result.stderr.strip()}"
            )
        return result

    def rsync_to(self, host: str, sources: list[Path], dest: str) -> None:
        self._rsync(host, [*map(str, sources), f"{self._target(host)}:{dest}"])

    def rsync_from(self, host: str, remote: str, local: Path, *flags: str) -> None:
        local.mkdir(parents=True, exist_ok=True)
        self._rsync(host, [*flags, f"{self._target(host)}:{remote}", str(local)])

    def _rsync(self, host: str, args: list[str]) -> None:
        # sudo on the far side: /opt/bench is root-owned.
        result = self.run(
            [
                "rsync",
                "-az",
                "-e",
                shlex.join(["ssh", *self.ssh_opts]),
                "--rsync-path",
                "sudo rsync",
                f"--timeout={RSYNC_IO_TIMEOUT_S}",
                *args,
            ]
        )
        if result.returncode != 0:
            raise RemoteError(f"{host}: rsync failed: {result.stderr.strip()}")

    def parallel(
        self, fn: Callable[[str], _T], names: Iterable[str], workers: int | None = None
    ) -> dict[str, _T]:
        """`fn(name)` for every name on a pool of `workers` (default REMOTE_POOL_SIZE) threads.
        Waits for all, then raises the first failure."""
        names = list(names)
        size = workers or REMOTE_POOL_SIZE
        with ThreadPoolExecutor(min(size, max(1, len(names)))) as pool:
            futures = {name: pool.submit(fn, name) for name in names}
        return {name: future.result() for name, future in futures.items()}


def control_path_peak(fleet_dir: Path) -> int:
    """Longest socket path ssh binds for `ControlPath=<fleet_dir>/ssh/%h`. Hosts are IPv4
    addresses (at most 15 bytes), and OpenSSH first binds `<path>.<16 random chars>`."""
    return len(os.fsencode(fleet_dir / "ssh" / "255.255.255.255")) + 17


@dataclass
class FleetState:
    """The fleet from `tofu apply` on. `remote` is set once `tofu output` gave the hosts."""

    system: System
    cfg: RunConfig
    fleet_dir: Path
    tf: Terraform
    interrupts: Interrupts
    remote: Remote | None = None

    @property
    def manifest_path(self) -> Path:
        return self.fleet_dir / FLEET_JSON

    @property
    def manifest(self) -> FleetManifest:
        return nb.read_json(self.manifest_path)


@dataclass
class Run:
    """One measurement on a fleet. `error` is set by whichever phase failed first;
    `interrupted` marks a Ctrl-C, which also asks before destroying."""

    fleet: FleetState
    run_dir: Path
    cfg: RunConfig
    started: float
    agent: AgentState | None = None
    agent_started: bool = False
    error: str | None = None
    interrupted: bool = False
    publish_remote: str | None = None

    @property
    def manifest_path(self) -> Path:
        return self.run_dir / "manifest.json"

    @property
    def manifest(self) -> Manifest:
        return nb.read_json(self.manifest_path)


def cmd_run(args: argparse.Namespace, system: System) -> int:
    if args.fleet is not None:
        args.fleet = fleet_arg(None if args.fleet is PICK else args.fleet, OUT_ROOT)
        return cmd_run_fleet(args, system)
    if args.tag is None:
        raise Refused(
            "run needs --tag, or --fleet [FLEET] to measure on a fleet from `up`"
        )
    cfg = dataclasses.replace(fleet_config_from_args(args), db_modes=(args.query_db,))
    interrupts = Interrupts(system.clock, system.forward)
    try:
        fleet_dir, run_dir, tf = prepare_run(args, cfg, system)
    except KeyboardInterrupt:
        raise Refused("interrupted; nothing was created") from None
    started = system.clock.time()
    interrupts.install(system.trap)
    try:
        fleet = FleetState(system, cfg, fleet_dir, tf, interrupts)
        bench_run = Run(
            fleet,
            run_dir,
            cfg,
            started,
            publish_remote=None if args.no_publish else args.results_remote,
        )
        with recording(bench_run):
            up_fleet(fleet)
        run_on_fleet(bench_run, cloudwatch=False)
        return teardown(bench_run)
    except Exception:
        log.exception("unexpected error")
        log.error(LEFTOVER_MESSAGE, fleet_dir)
        return EXIT_LEFTOVER


def prepare_run(
    args: argparse.Namespace, cfg: RunConfig, system: System
) -> tuple[Path, Path, Terraform]:
    """Everything before the first AWS write: `plan_fleet` and the prompt. Any failure or
    Ctrl-C leaves nothing to destroy."""
    fleet_dir, run_dir, tf, hosts, _ = plan_fleet(args, cfg, system)
    confirm_create(system.ask, cfg, fleet_dir, len(hosts))
    stamp_expiry(fleet_dir, tf, utc_now(system.clock))
    return fleet_dir, run_dir, tf


def confirm_create(ask: Ask, cfg: RunConfig, fleet_dir: Path, count: int) -> None:
    extras = ""
    if "volume" in cfg.db_modes:
        extras += ", 1 extra volume"
    if "rds" in cfg.db_modes:
        extras += ", 1 rds instance, 1 subnet group, 1 parameter group, 1 schedule"
        extras += ", 1 iam role"
    prompt = (
        f"Create {count} instances{extras}, 1 security group, 1 key pair in {ACCOUNT}?"
    )
    if not (cfg.yes or ask(prompt)):
        append_event(fleet_dir, "planned", "refused", "not confirmed")
        raise Refused("not confirmed; nothing was created")


def expiry_stamp(moment: datetime) -> str:
    return moment.strftime("%Y-%m-%dT%H:%M:%SZ")


def stamp_expiry(
    fleet_dir: Path,
    tf: Terraform,
    confirmed_at: datetime,
    margin_s: float = PROVISION_S,
) -> None:
    """The `espresso-bench-expires` tag counts from the apply, not from the render: a run that
    waited at the prompt must not look expired. Re-plans because a plan file fixes variables.
    A single shot adds the provisioning time; a fleet passes 0, so that `run --fleet` never
    counts on time after the earliest possible self-terminate. The rds delete is scheduled
    from the end of the hosts, without that margin."""
    manifest: FleetManifest = nb.read_json(fleet_dir / FLEET_JSON)
    expires = confirmed_at + timedelta(seconds=manifest["estimate"]["ttl_s"] + margin_s)
    stamp = expiry_stamp(expires)
    tfvars_path = fleet_dir / "terraform" / "terraform.tfvars.json"
    tfvars = nb.read_json(tfvars_path)
    updated = {**tfvars, "expires_at": stamp}
    if "rds" in tfvars:
        hosts_end = expires - timedelta(seconds=margin_s)
        updated["rds"] = {**tfvars["rds"], "delete_at": rds_schedule_at(hosts_end)}
    nb.write_json(tfvars_path, updated)
    update_manifest(fleet_dir / FLEET_JSON, manifest["phase"], expires_at=stamp)
    tf.plan()


def plan_fleet(
    args: argparse.Namespace, cfg: RunConfig, system: System
) -> tuple[Path, Path, Terraform, list[HostSpec], Preflight]:
    """Preflight, cost check, render, `tofu init` and `plan`. Shared by `plan` and `run`; makes
    no AWS write. The preflight summary is logged before the cost line."""
    fleet_dir, hosts, pre, estimate = plan_new_fleet(
        args, cfg, system, idle_fleet=False
    )
    fleet = render_fleet_dir(system, cfg, fleet_dir, hosts, pre, estimate, args.argv)
    run_dir = render_run(fleet_dir, fleet, cfg, SINGLE_RUN, args.argv)
    return fleet_dir, run_dir, init_terraform(system.run, fleet_dir), hosts, pre


def plan_new_fleet(
    args: argparse.Namespace, cfg: RunConfig, system: System, idle_fleet: bool
) -> tuple[Path, list[HostSpec], Preflight, Estimate]:
    """New fleet dir with logging, preflight and cost check: the prefix of `plan_fleet` and
    `prepare_up`."""
    hosts = plan_hosts(cfg)
    fleet_dir = new_fleet_dir(system, OUT_ROOT)
    setup_logging(fleet_dir)
    log.debug("argv %s", args.argv)
    pre = preflight(system, cfg, hosts)
    log_preflight(cfg, pre, hosts)
    estimate = estimate_or_refuse(
        cfg,
        hosts,
        fleet_dir,
        system.clock.time(),
        pre["instance_prices"],
        fleet=idle_fleet,
        rds=rds_spec(cfg, pre),
    )
    return fleet_dir, hosts, pre, estimate


def init_terraform(run: Runner, fleet_dir: Path) -> Terraform:
    tf = Terraform(run, fleet_dir / "terraform", terraform_env())
    tf.init()
    (fleet_dir / "terraform" / "plan.txt").write_text(tf.plan())
    return tf


def enter_phase(fleet: FleetState, manifest: Path, name: str, message: str) -> None:
    fleet.interrupts.check()
    fleet.interrupts.phase = name
    update_manifest(manifest, name)
    log.info("%s: %s", name, message)


@contextmanager
def recording(run: Run) -> Iterator[None]:
    """Records a failure in `run.error` instead of raising: the fleet costs money until
    teardown, whatever failed."""
    try:
        yield
    except Exception as exc:  # noqa: BLE001 - failure() logs it
        run.error, interrupted = failure(exc)
        run.interrupted = run.interrupted or interrupted


def failure(exc: Exception) -> tuple[str, bool]:
    """Logs a failure of a fleet step; the error message and whether it was an interrupt."""
    if isinstance(exc, Interrupted):
        log.error("interrupted")
        return "interrupted", True
    if isinstance(exc, (TfFailed, RemoteError, nb.NetworkError)):
        log.error("error: %s", exc)
        return str(exc), False
    log.exception("unexpected error")
    return f"{type(exc).__name__}: {exc}", False


def up_fleet(fleet: FleetState) -> None:
    """`tofu apply` until every host is reachable and cloud-init is done. Raises; `remote` is
    set as soon as the hosts are known, so a failed wait can still be collected."""
    enter_phase(fleet, fleet.manifest_path, "applying", "tofu apply")
    fleet.tf.apply()
    remote = connect(fleet)
    enter_phase(
        fleet,
        fleet.manifest_path,
        "waiting-hosts",
        f"ssh and cloud-init on {len(remote.hosts)} hosts",
    )
    wait_hosts(remote, fleet.manifest, fleet.fleet_dir, fleet.interrupts)
    if fleet.cfg.tcp_cc == "bbr3":
        install_xanmod(fleet, remote)
    prepare_stores(fleet)
    if "rds_spec" in fleet.manifest:
        enter_phase(
            fleet,
            fleet.manifest_path,
            "preparing-rds",
            "parameter group, delete schedule, pg_isready",
        )
        prepare_rds(fleet)
    update_manifest(fleet.manifest_path, "idle")


def run_on_fleet(run: Run, cloudwatch: bool) -> None:
    """One measurement, then collect. Never raises. A `run.error` from `up_fleet` skips the
    load; the collect still runs against whatever hosts are known."""
    if run.error is None:
        update_manifest(run.fleet.manifest_path, "running")
        measure_run(run)
    try:
        finish_run(run, cloudwatch)
    except Exception as exc:  # the fleet costs money until teardown, whatever failed
        log.exception("finish failed")
        run.error = run.error or f"finish failed: {type(exc).__name__}: {exc}"


def report_run(run: Run) -> nb.BenchResult | None:
    """The report of the collected run. Never raises."""
    try:
        return report(run)
    except Exception as exc:
        log.exception("report failed")
        run.error = run.error or f"finish failed: {type(exc).__name__}: {exc}"
        return None


def measure_run(run: Run) -> None:
    """Everything from `shipping` to the end of the load. Never raises: a failure is recorded
    in `run.error` so that `finish_run` and `teardown` always run against the live fleet."""
    fleet = run.fleet
    with recording(run):
        remote = fleet.remote
        assert remote is not None, "up_fleet must run first"
        manifest = fleet.manifest
        render_host_files(run.run_dir, run.cfg, manifest, remote.hosts)
        enter_phase(
            fleet, run.manifest_path, "shipping", "files, host monitors, containers"
        )
        git_rev = ship_agents(remote)
        # A single shot renders its run manifest before `connect` learns the volume id.
        volume = (
            {"pg_volume_id": manifest["pg_volume_id"]}
            if run.cfg.query_db == "volume"
            else {}
        )
        update_manifest(run.manifest_path, "shipping", git_rev=git_rev, **volume)
        ship(remote, run.run_dir)
        start_hostmon(remote)
        create_containers(remote)
        if run.cfg.latency != "off":
            enter_phase(
                fleet, run.manifest_path, "shaping", "tc netem per peer, ping probes"
            )
            shaping = latency_shaping(run.cfg, len(_node_names(remote.hosts)))
            shape_nodes(remote, shaping)
            verify_shaping(remote, shaping, run.manifest_path)
        enter_phase(
            fleet,
            run.manifest_path,
            "services",
            "anvil, deploy, orchestrator, relay, postgres",
        )
        start_support(
            remote, genesis_contracts(run.run_dir), fleet.interrupts, run.cfg.query_db
        )
        enter_phase(fleet, run.manifest_path, "nodes", "synchronized docker start")
        at = fleet_time(remote) + DOCKER_START_LEAD_S
        spread = start_nodes(remote, node_hosts(remote.hosts), at)
        update_manifest(run.manifest_path, "measuring", start_spread_s=spread)
        log.info("measuring: nodes started within %.2f s of each other", spread)
        start_agent(remote)
        run.agent_started = True
        run.agent = poll_agent(remote, run.run_dir, run.cfg, fleet.interrupts)


def connect(fleet: FleetState) -> Remote:
    manifest = fleet.manifest
    output = fleet.tf.output()
    hosts_info = parse_hosts_output(output, manifest["hosts"])
    nb.write_json(fleet.fleet_dir / "hosts.json", hosts_info)
    rds = {"rds": parse_rds_output(output)} if "rds_spec" in manifest else {}
    update_manifest(
        fleet.manifest_path,
        "provisioned",
        hosts_info=hosts_info,
        **pg_volume_fields(output, manifest),
        **rds,
    )
    fleet.remote = Remote(
        fleet.system.run,
        fleet.fleet_dir,
        ssh_key_path(fleet.fleet_dir),
        hosts_info,
    )
    return fleet.remote


CollectStep = Literal[
    "stop_agent",
    "freeze",
    "collect_hosts",
    "rsync_out",
    "ebs_balance",
    "rds_metrics",
    "rds_logs",
]
RdsCollect = Callable[[Runner, str, RdsInfo, float, float, Path], None]


def collect_plan(
    error: str | None, agent_started: bool, query_db: DbMode, cloudwatch: bool
) -> list[CollectStep]:
    """The collection steps in order. `skip_collect` is not an input: it can be set by a signal
    during any step, so `finish_run` checks it before each one."""
    steps: list[CollectStep] = ["stop_agent"] if error is not None else []
    steps += ["freeze", "collect_hosts"]
    if agent_started:
        steps.append("rsync_out")
    if cloudwatch:
        steps += cloudwatch_steps(query_db)
    if query_db == "rds":
        steps.append("rds_logs")
    return steps


def cloudwatch_steps(query_db: DbMode) -> list[CollectStep]:
    return ["ebs_balance", "rds_metrics"] if query_db == "rds" else ["ebs_balance"]


def finish_run(run: Run, cloudwatch: bool) -> None:
    """Stops the load if it still runs, freezes and collects every host. CloudWatch is part of
    it only on a fleet that stays up; a single shot fetches it after the destroy. Signals are
    ignored from here on: teardown must not be cut short."""
    interrupts = run.fleet.interrupts
    interrupts.disarm()
    remote = run.fleet.remote
    if remote is not None:
        update_manifest(run.manifest_path, "collecting")
        log.info("collecting: stop, freeze, logs, host samples, final rsync")
        actions: dict[CollectStep, tuple[str, Callable[[], object]]] = {
            "stop_agent": ("stop agent", lambda: stop_agent(remote)),
            "freeze": ("freeze", lambda: freeze(remote)),
            "collect_hosts": (
                "collect",
                lambda: collect_hosts(remote, list(remote.hosts.values()), run.run_dir),
            ),
            "rsync_out": (
                "final rsync",
                lambda: remote.rsync_from("ctl", f"{BENCH_DIR}/out/", run.run_dir),
            ),
            **cloudwatch_actions(run),
            "rds_logs": rds_step(run, "rds logs", collect_rds_logs),
        }
        plan = collect_plan(run.error, run.agent_started, run.cfg.query_db, cloudwatch)
        run_steps(interrupts, [actions[name] for name in plan])


def run_steps(
    interrupts: Interrupts, steps: list[tuple[str, Callable[[], object]]]
) -> None:
    for what, action in steps:
        if interrupts.skip_collect.is_set():
            log.warning("%s skipped", what)
        else:
            best_effort(what, action)


def cloudwatch_actions(run: Run) -> dict[CollectStep, tuple[str, Callable[[], object]]]:
    return {
        "ebs_balance": ("node0 EBS balance", lambda: collect_node0_ebs_balance(run)),
        "rds_metrics": rds_step(run, "rds metrics", collect_rds_metrics),
    }


def collect_cloudwatch(run: Run) -> None:
    """The CloudWatch part of the collection, for a single shot after its destroy: only the
    manifest ids are needed, and the wait for the lag is no longer billed."""
    if run.fleet.remote is None:
        return
    actions = cloudwatch_actions(run)
    run_steps(
        run.fleet.interrupts,
        [actions[name] for name in cloudwatch_steps(run.cfg.query_db)],
    )


def collect_node0_ebs_balance(run: Run) -> None:
    """Waits until CloudWatch has the end of the load window, then fetches node0's EBS balance."""
    agent = published_window(run, "node0 EBS balance")
    if agent is None:
        return
    collect_ebs_balance(
        run.fleet.system.run,
        run.fleet.manifest,
        agent["t0"],
        agent["t1"],
        run.run_dir,
    )


def published_window(run: Run, what: str) -> AgentState | None:
    """The agent state once CloudWatch has published the load window; None without a window
    or when the collection was skipped meanwhile."""
    agent = run.agent or finished_agent_state(run.run_dir)
    if agent is None:
        log.warning("no load window: %s not collected", what)
        return None
    interrupts = run.fleet.interrupts
    wait_s = agent["t1"] + CLOUDWATCH_LAG_S - run.fleet.system.clock.time()
    if wait_s > 0:
        log.info("waiting %.0f s for CloudWatch to publish the load window", wait_s)
        if interrupts.wait(interrupts.skip_collect, wait_s):
            return None
    return agent


def rds_step(
    run: Run, what: str, collect: RdsCollect
) -> tuple[str, Callable[[], object]]:
    return what, lambda: collect_rds(run, what, collect)


def collect_rds(run: Run, what: str, collect: RdsCollect) -> None:
    """One RDS part of the load window into the run dir, once CloudWatch has published it."""
    agent = published_window(run, what)
    if agent is None:
        return
    fleet = run.fleet
    collect(
        fleet.system.run,
        fleet.cfg.region,
        fleet.manifest["rds"],
        agent["t0"],
        agent["t1"],
        run.run_dir,
    )


def best_effort(what: str, action: Callable[[], object]) -> None:
    """Collection runs against a fleet that is about to be destroyed: one unreachable host
    must not stop the others. Missing files surface as `check_validity_aws` findings."""
    try:
        action()
    except (RemoteError, Refused) as exc:
        log.warning("%s failed: %s", what, exc)
    except Exception:
        log.exception("%s failed unexpectedly", what)


def report(run: Run) -> nb.BenchResult | None:
    # A driver-side error after the load finished still leaves a complete run to analyze.
    run.agent = run.agent or finished_agent_state(run.run_dir)
    if run.agent is not None:
        try:
            write_run_json(run)
            plot_throughput(run.fleet.system.run, run.run_dir)
            result = write_report(run.run_dir)
        except Exception as exc:
            log.exception("report failed")
            run.error = f"report failed: {type(exc).__name__}: {exc}"
        else:
            log_result(result)
            plot_traces(run.fleet.system.run, run.run_dir)
            return result
    write_failure_summary(run.run_dir, run.manifest, run.error)
    return None


def plot_traces(runner: Runner, run_dir: Path) -> None:
    """Renders the leader traces of a `--leader-trace` run."""
    try:
        manifest: Manifest = nb.read_json(run_dir / "manifest.json")
        leader_trace = config_from_manifest(manifest["config"]).leader_trace
    except Exception as exc:  # noqa: BLE001
        log.warning("trace-plots failed: %s: %s", type(exc).__name__, exc)
        return
    if leader_trace:
        run_plot(runner, "trace-plots", run_dir)


def plot_throughput(runner: Runner, run_dir: Path) -> None:
    run_plot(runner, "throughput-plot", run_dir)


def run_plot(runner: Runner, script_name: str, run_dir: Path) -> None:
    """Any failure only warns: the run's result does not depend on its plots."""
    try:
        done = runner(
            [
                "timeout",
                str(TRACE_PLOTS_TIMEOUT_S),
                str(SCRIPT_DIR / script_name),
                str(run_dir),
            ]
        )
        if done.returncode != 0:
            last = (done.stderr.strip().splitlines() or [""])[-1]
            log.warning("%s exited %d: %s", script_name, done.returncode, last)
    except Exception as exc:  # noqa: BLE001
        log.warning("%s failed: %s: %s", script_name, type(exc).__name__, exc)


def log_result(result: nb.BenchResult) -> None:
    log.info(nb.status_line(result))
    log.info(nb.capacity_line(result["capacity"]).replace("**", ""))


def teardown(run: Run) -> int:
    """Always attempts the destroy, then fetches CloudWatch and reports. An exception in the
    destroy or the bookkeeping is logged and leaves the exit code to the result if the destroy
    worked, else to `EXIT_LEFTOVER`."""
    destroyed = False
    result = None
    try:
        destroyed = down_fleet(run.fleet)
    except Exception:
        log.exception("destroy failed")
    try:
        collect_cloudwatch(run)
        result = report_run(run)
        code = record_outcome(run, result, destroyed)
    except Exception:
        log.exception("teardown failed")
        code = exit_code(run.error, result, destroyed)
    if not destroyed:
        log.error(LEFTOVER_MESSAGE, run.fleet.fleet_dir)
    return code


def down_fleet(fleet: FleetState) -> bool:
    """Destroys the fleet. True when destroyed."""
    best_effort(
        "mark destroying", lambda: update_manifest(fleet.manifest_path, "destroying")
    )
    log.info("destroying: tofu destroy")
    return destroy_fleet(fleet)


def record_outcome(run: Run, result: nb.BenchResult | None, destroyed: bool) -> int:
    fleet = run.fleet
    cost = close_fleet(fleet, destroyed)
    code = exit_code(run.error, result, destroyed)
    update_manifest(run.manifest_path, "done" if destroyed else "left-running")
    record_index(run, result, code, write_run_cost(run, cost))
    if cost is not None:
        log.info(
            "destroyed; actual cost $%.2f (bound $%.2f); run dir %s",
            cost["actual"],
            cost["bound"],
            run.run_dir,
        )
    auto_publish(run)
    return code


def close_fleet(fleet: FleetState, destroyed: bool) -> dict[str, float] | None:
    """Bookkeeping after `down_fleet`: the ssh key, the fleet's cost and its final phase."""
    cost = None
    if destroyed:
        remove_ssh_key(fleet.fleet_dir)
        cost = final_cost(fleet)
    update_manifest(fleet.manifest_path, "done" if destroyed else "left-running")
    return cost


def exit_code(
    error: str | None, result: nb.BenchResult | None, fleet_gone: bool
) -> int:
    if not fleet_gone:
        return EXIT_LEFTOVER
    if error is not None or result is None:
        return EXIT_FAILED
    return EXIT_OK if result["validity"]["valid"] else EXIT_INVALID


def final_cost(fleet: FleetState) -> dict[str, float] | None:
    try:
        cost = actual_cost(
            fleet.system.run, fleet.manifest, utc_now(fleet.system.clock)
        )
    except (RemoteError, Refused, ValueError) as exc:
        log.warning("actual cost unavailable: %s", exc)
        return None
    nb.write_json(fleet.fleet_dir / "cost.json", cost)
    update_manifest(fleet.manifest_path, "destroyed", cost_usd=cost)
    for path in (fleet.fleet_dir / RUNS_DIR).glob("*/manifest.json"):
        nb.write_json(path, {**nb.read_json(path), "cost_usd": cost})
    return cost


def destroy_verdict(attempt: int, ok: bool) -> Literal["done", "retry", "sweep"]:
    """What follows `tofu destroy` attempt number `attempt` (1-based)."""
    if ok:
        return "done"
    return "retry" if attempt < DESTROY_RETRIES else "sweep"


def destroy_fleet(fleet: FleetState) -> bool:
    """`tofu destroy` with retries, then a tag sweep. False when `tofu destroy` never worked,
    even if the sweep found and terminated everything: the state file is then out of date."""
    for attempt in itertools.count(1):
        verdict = destroy_verdict(attempt, try_destroy(fleet, attempt))
        if verdict == "done":
            return True
        if verdict == "sweep":
            break
        fleet.system.clock.sleep(DESTROY_BACKOFF_S)
    log.warning(
        "tofu destroy failed; sweeping resources tagged %s", fleet.fleet_dir.name
    )
    try:
        swept = sweep(fleet.system, fleet.cfg.region, fleet.fleet_dir.name)
    except Refused as exc:
        log.error("sweep failed: %s", exc)
    else:
        log.warning("sweep terminated %d resources: %s", len(swept), ", ".join(swept))
    return False


def try_destroy(fleet: FleetState, attempt: int) -> bool:
    try:
        fleet.tf.destroy()
    except TfFailed as exc:
        log.warning("destroy attempt %d/%d failed: %s", attempt, DESTROY_RETRIES, exc)
        return False
    return True


def cmd_up(args: argparse.Namespace, system: System) -> int:
    """Plans, confirms and provisions a fleet, then leaves it `idle` for `run --fleet`. A
    failure destroys it again (exit 3, or 4 when resources may remain)."""
    cfg = fleet_config_from_args(args)
    interrupts = Interrupts(system.clock, system.forward)
    try:
        fleet_dir, tf = prepare_up(args, cfg, system)
    except KeyboardInterrupt:
        raise Refused("interrupted; nothing was created") from None
    interrupts.install(system.trap)
    fleet = FleetState(system, cfg, fleet_dir, tf, interrupts)
    try:
        up_fleet(fleet)
    except Exception as exc:  # noqa: BLE001 - failure() logs it
        failure(exc)
        return abort_up(fleet)
    announce_idle(fleet)
    return EXIT_OK


def prepare_up(
    args: argparse.Namespace, cfg: RunConfig, system: System
) -> tuple[Path, Terraform]:
    """Everything before the first AWS write, as `prepare_run`, without a run dir."""
    fleet_dir, hosts, pre, estimate = plan_new_fleet(args, cfg, system, idle_fleet=True)
    render_fleet_dir(system, cfg, fleet_dir, hosts, pre, estimate, args.argv)
    tf = init_terraform(system.run, fleet_dir)
    confirm_create(system.ask, cfg, fleet_dir, len(hosts))
    stamp_expiry(fleet_dir, tf, utc_now(system.clock), margin_s=0.0)
    return fleet_dir, tf


def announce_idle(fleet: FleetState) -> None:
    manifest = fleet.manifest
    left = minutes_left(manifest, utc_now(fleet.system.clock))
    log.info("idle: fleet %s; %.0f min left", fleet.fleet_dir, left)
    log.info(
        "run: aws-bench run --fleet %s --query-db %s",
        fleet.fleet_dir,
        manifest["db_modes"][0],
    )


def abort_up(fleet: FleetState) -> int:
    fleet.interrupts.disarm()
    destroyed = down_fleet(fleet)
    code = EXIT_FAILED if destroyed else EXIT_LEFTOVER
    close_fleet(fleet, destroyed)
    if not destroyed:
        log.error(LEFTOVER_MESSAGE, fleet.fleet_dir)
    return code


def read_fleet(fleet_dir: Path) -> FleetManifest:
    path = fleet_dir / FLEET_JSON
    if not path.exists():
        raise Refused(f"{fleet_dir} is not a fleet dir: no {FLEET_JSON}")
    return nb.read_json(path)


def fleet_dirs(out_root: Path) -> list[Path]:
    if not out_root.exists():
        return []
    return sorted(path for path in out_root.iterdir() if path.is_dir())


def pick_fleet(out_root: Path) -> Path:
    """The only fleet under `out_root` in a `SELECTABLE_PHASES` phase."""
    fleets = [
        (path, read_fleet(path))
        for path in fleet_dirs(out_root)
        if (path / FLEET_JSON).exists()
    ]
    selectable = [f for f in fleets if f[1]["phase"] in SELECTABLE_PHASES]
    if len(selectable) == 1:
        return selectable[0][0]
    if not selectable:
        raise Refused(
            f"no selectable fleet in {out_root}, name one: {describe_fleets(fleets)}"
        )
    raise Refused(
        f"{len(selectable)} selectable fleets in {out_root}, name one: "
        f"{describe_fleets(selectable)}"
    )


def describe_fleets(fleets: list[tuple[Path, FleetManifest]]) -> str:
    if not fleets:
        return "none"
    return ", ".join(
        f"{path.name} ({manifest['phase']}, expires {expires(manifest)})"
        for path, manifest in fleets
    )


def expires(manifest: FleetManifest) -> str:
    return manifest["expires_at"][:16] if "expires_at" in manifest else "-"


def fleet_arg(arg: str | None, out_root: Path) -> Path:
    """The fleet dir `arg` names: a path when it contains `/`, else a name under `out_root`.
    `None` picks the only selectable fleet."""
    if arg is None:
        return pick_fleet(out_root)
    if not arg:
        raise Refused(
            "empty fleet name; omit the value to pick the only selectable fleet"
        )
    fleet_dir = Path(arg) if "/" in arg else out_root / arg
    read_fleet(fleet_dir)
    return fleet_dir


def open_fleet(system: System, fleet_dir: Path, interrupts: Interrupts) -> FleetState:
    """The `FleetState` of a fleet `up` provisioned, with ssh to its hosts."""
    manifest = read_fleet(fleet_dir)
    cfg = config_from_manifest(manifest["config"])
    tf = Terraform(system.run, fleet_dir / "terraform", terraform_env())
    fleet = FleetState(system, cfg, fleet_dir, tf, interrupts)
    fleet.remote = Remote(
        system.run,
        fleet_dir,
        ssh_key_path(fleet_dir),
        provisioned_hosts(manifest),
    )
    return fleet


def minutes_left(manifest: FleetManifest, now: datetime) -> float:
    expires = datetime.fromisoformat(manifest["expires_at"])
    return (expires - now).total_seconds() / 60


def cmd_run_fleet(args: argparse.Namespace, system: System) -> int:
    """One more measurement on a fleet `up` left idle. The fleet stays up in every outcome:
    idle again, or `dirty` and locked when the pull or reset failed."""
    reject_fleet_flags(args.argv)
    fleet_dir: Path = args.fleet
    manifest = read_fleet(fleet_dir)
    setup_logging(fleet_dir)
    log.debug("argv %s", args.argv)
    log.info("fleet %s (%s)", manifest["name"], manifest["phase"])
    interrupts = Interrupts(system.clock, system.forward)
    interrupts.install(system.trap)
    fleet = open_fleet(system, fleet_dir, interrupts)
    cfg = fleet_run_config(args, manifest)
    run_dir, estimate = admit_run(system, fleet_dir, manifest, cfg, args.argv)
    bench_run = Run(
        fleet,
        run_dir,
        cfg,
        system.clock.time(),
        publish_remote=None if args.no_publish else args.results_remote,
    )
    log.info(
        "run %s: incremental cost $%.2f (%.0f min worst), %.0f min left on the fleet",
        run_dir.name,
        estimate["worst_usd"],
        estimate["worst_s"] / 60,
        minutes_left(manifest, utc_now(system.clock)),
    )
    for line in format_node_summary(cfg):
        log.info(line)
    try:
        with recording(bench_run):
            if tag_changed(manifest, cfg):
                pull_tag(bench_run)
            enter_phase(
                fleet,
                bench_run.manifest_path,
                "resetting",
                "stop containers, wipe journal and postgres data",
            )
            assert fleet.remote is not None
            reset_chain(fleet.remote, cfg.query_db, manifest, interrupts)
            if cfg.query_db == "rds":
                reset_rds_store(fleet.remote, fleet_dir, interrupts)
        reset_failed = bench_run.error is not None
        run_on_fleet(bench_run, cloudwatch=True)
        result = report_run(bench_run)
        return end_fleet_run(bench_run, result, reset_failed)
    except Exception:
        log.exception("unexpected error")
        return EXIT_FAILED


def fleet_config_from_args(args: argparse.Namespace) -> RunConfig:
    return dataclasses.replace(
        config_from_args(args),
        db_modes=args.db_modes,
        query_db=args.query_db,
        ttl_min=args.ttl_min,
        fleet=args.fleet,
        force=args.force,
    )


def fleet_run_config(args: argparse.Namespace, saved: FleetManifest) -> RunConfig:
    """The fleet's own config with the flags that belong to one run: image tag and allocator, load, database mode, node env."""
    base = config_from_manifest(saved["config"])
    cli = fleet_config_from_args(args)
    load = dataclasses.replace(cli.load, submit_nodes=submit_nodes(args, base.nodes))
    cfg = dataclasses.replace(
        base,
        tag=base.tag if cli.tag is None else cli.tag,
        allocator=cli.allocator,
        load=load,
        yes=cli.yes,
        query_db=cli.query_db,
        node_env=cli.node_env,
        max_block_size=cli.max_block_size,
        leader_trace=cli.leader_trace,
        latency=cli.latency,
        intra_latency=cli.intra_latency,
        tcp_cc=cli.tcp_cc,
        mtu=cli.mtu,
        consensus_storage=cli.consensus_storage,
        fleet=cli.fleet,
        force=cli.force,
        search=cli.search,
    )
    check_submit_nodes(cfg)
    check_search(cfg)
    check_fleet_disks(saved, cfg)
    return cfg


def reject_fleet_flags(argv: list[str]) -> None:
    given = sorted({tok.partition("=")[0] for tok in argv} & set(FLEET_ONLY_FLAGS))
    if given:
        raise Refused(
            f"{', '.join(given)} shape the fleet: with --fleet they come from its {FLEET_JSON}"
        )


def admit_run(
    system: System,
    fleet_dir: Path,
    manifest: FleetManifest,
    cfg: RunConfig,
    argv: list[str],
) -> tuple[Path, RunEstimate]:
    """Takes the lock, checks that the fleet can take the run and creates its dir. Any refusal
    releases the lock again and has issued no ssh command."""
    take_fleet_lock(system, fleet_dir, cfg.query_db, cfg.force)
    try:
        estimate = check_run_allowed(manifest, cfg, utc_now(system.clock))
        fleet = retagged(system.http_get, manifest, cfg)
        run_dir = render_run(fleet_dir, fleet, cfg, cfg.query_db, argv, estimate)
        return run_dir, estimate
    except BaseException:
        release_fleet_lock(fleet_dir)
        raise


def retagged(
    http_get: HttpGet, manifest: FleetManifest, cfg: RunConfig
) -> FleetManifest:
    """The fleet manifest with the digests `cfg.tag` resolves to; the manifest itself when the
    tag is the fleet's, which needs no registry access."""
    if not tag_changed(manifest, cfg):
        return manifest
    images = resolve_images(http_get, cfg, None, manifest["arch"])
    return {**manifest, "images": images}


def take_fleet_lock(
    system: System, fleet_dir: Path, run_name: str, force: bool
) -> FleetLock:
    """Creates `fleet.lock` exclusively. `force` replaces a lock whose holder is gone."""
    path = fleet_dir / FLEET_LOCK
    lock: FleetLock = {
        "pid": system.pid,
        "hostname": system.hostname(),
        "run": run_name,
        "taken_at": stamp(),
    }
    if force and path.exists():
        holder: FleetLock = nb.read_json(path)
        if lock_holder_alive(system, holder):
            raise Refused(f"cannot --force: {describe_lock(holder, True)}")
        path.unlink()
    try:
        with path.open("x") as f:
            json.dump(lock, f)
    except FileExistsError:
        holder = nb.read_json(path)
        alive = lock_holder_alive(system, holder)
        hint = (
            ""
            if alive
            else f"; if it is gone, run: aws-bench run --fleet {fleet_dir} --force "
            f"(resets the fleet), or: aws-bench down {fleet_dir}"
        )
        raise Refused(
            f"fleet is locked: {describe_lock(holder, alive)}{hint}"
        ) from None
    return lock


def release_fleet_lock(fleet_dir: Path) -> None:
    (fleet_dir / FLEET_LOCK).unlink(missing_ok=True)


def lock_holder_alive(system: System, lock: FleetLock) -> bool:
    """A lock from another host is assumed alive: its pid cannot be checked from here."""
    if lock["hostname"] != system.hostname():
        return True
    return system.pid_alive(lock["pid"])


def describe_lock(lock: FleetLock, alive: bool) -> str:
    state = "alive" if alive else "dead"
    return (
        f"run {lock['run']}, pid {lock['pid']} ({state}) on {lock['hostname']}, "
        f"since {lock['taken_at'][:16]}"
    )


def check_run_allowed(
    manifest: FleetManifest, cfg: RunConfig, now: datetime
) -> RunEstimate:
    """Raises `Refused` unless the fleet is idle (or, with `--force`, dirty or stale), has the
    database mode and lives long enough for the run's worst case, the `/run/nologin` lock-out
    and the destroy."""
    name, phase = manifest["name"], manifest["phase"]
    if phase not in (LIVE_PHASES if cfg.force else ("idle",)):
        raise Refused(f"fleet {name} is {phase}, not idle")
    if cfg.query_db not in manifest["db_modes"]:
        raise Refused(
            f"--query-db {cfg.query_db} was not provisioned: fleet {name} has "
            f"{', '.join(manifest['db_modes'])}"
        )
    remaining_s = (datetime.fromisoformat(manifest["expires_at"]) - now).total_seconds()
    if remaining_s <= 0:
        raise Refused(
            f"fleet {name} expired at {manifest['expires_at']}: see `aws-bench status "
            f"{cfg.fleet}` and `aws-bench destroy --orphans`"
        )
    estimate = estimate_run(manifest, cfg)
    needed_s = estimate["worst_s"] + NOLOGIN_LEAD_S + DESTROY_S
    if "rds" in manifest["db_modes"]:
        needed_s += RDS_DELETE_S
    if remaining_s < needed_s:
        raise Refused(
            f"{remaining_s / 60:.0f} min left on fleet {name}, this run needs up to "
            f"{needed_s / 60:.0f}: up a new fleet with a longer --ttl-min"
        )
    return estimate


def pull_tag(run: Run) -> None:
    """Moves the hosts to the images of this run, then makes them the fleet's, so that a later
    run with the same tag pulls nothing."""
    fleet = run.fleet
    assert fleet.remote is not None
    images = run.manifest["images"]
    enter_phase(
        fleet,
        run.manifest_path,
        "pulling",
        f"tag {image_label(run.cfg)} by digest on {len(fleet.remote.hosts)} hosts",
    )
    pull_images(fleet.remote, images, fleet.fleet_dir)
    saved = fleet.manifest
    update_manifest(
        fleet.manifest_path,
        saved["phase"],
        images=images,
        config={**saved["config"], "tag": run.cfg.tag, "allocator": run.cfg.allocator},
    )


def pull_images(remote: Remote, images: dict[str, ImageInfo], fleet_dir: Path) -> None:
    """Pulls every role image by digest on every host and compares what docker reports with
    `images`. Only when all hosts match are `digests.json` and `ready.json` rewritten (and
    `hosts/<host>/ready.json` refreshed), so a mismatch leaves the records as `up` wrote them."""

    def pull(host: str) -> dict[str, str]:
        role = remote.hosts[host]["role"]
        refs = {
            name: f"{images[name]['ref']}@{images[name]['digest']}"
            for name in ROLE_IMAGES[role]
        }
        stdout = remote.ssh(host, pull_command(pull_script(refs))).stdout
        return json.loads(stdout)

    pulled = remote.parallel(pull, remote.hosts)
    wrong = {
        host: bad
        for host, digests in pulled.items()
        if (bad := digest_mismatches(digests, images))
    }
    if wrong:
        raise RemoteError(
            "pulled digests differ from the resolved ones: "
            + "; ".join(f"{host}: {', '.join(bad)}" for host, bad in wrong.items())
        )

    def record(host: str) -> None:
        text = remote.ssh(host, pull_command(record_script(pulled[host]))).stdout
        (fleet_dir / "hosts" / host / "ready.json").write_text(text)

    remote.parallel(record, remote.hosts)


def pull_command(script: str) -> str:
    return f"sudo timeout -k 10 {PULL_MAX_S:.0f} bash -c {shlex.quote(script)}"


def pull_script(refs: dict[str, str]) -> str:
    """Prints `{name: repo@sha256:..}` as `docker image inspect` reports each pulled ref."""
    lines = ["set -eu", "out='{}'"]
    for name, ref in refs.items():
        lines.append(_pull_one(name, ref))
    return "\n".join([*lines, 'echo "$out"'])


def _pull_one(name: str, ref: str) -> str:
    inspect_format = "{{json .RepoDigests}}"
    merge = "'$out + {($name): $digest}'"
    return (
        f"docker pull {shlex.quote(ref)} >&2\n"
        f"pulled=$(docker image inspect --format {shlex.quote(inspect_format)} "
        f"{shlex.quote(ref)} | jq -r '.[0]')\n"
        f'out=$(jq -cn --argjson out "$out" --arg name {shlex.quote(name)} '
        f'--arg digest "$pulled" {merge})'
    )


def record_script(digests: dict[str, str]) -> str:
    """Rewrites `digests.json` and the `digests` of `ready.json`; prints the new `ready.json`."""
    return (
        "set -eu\n"
        f"printf %s {shlex.quote(json.dumps(digests))} > {BENCH_DIR}/digests.json.tmp\n"
        f"mv {BENCH_DIR}/digests.json.tmp {BENCH_DIR}/digests.json\n"
        f"jq --slurpfile d {BENCH_DIR}/digests.json '.digests = $d[0]' "
        f"{BENCH_DIR}/ready.json > {BENCH_DIR}/ready.json.tmp\n"
        f"mv {BENCH_DIR}/ready.json.tmp {BENCH_DIR}/ready.json\n"
        f"cat {BENCH_DIR}/ready.json\n"
    )


def pg_volume_spec(cfg: RunConfig) -> VolumeSpec | None:
    """The volume terraform attaches to the query host, if any run on this fleet may use it."""
    if "volume" not in cfg.db_modes:
        return None
    return {"gb": PG_GB, "iops": cfg.pg_iops, "mbps": cfg.pg_mbps}


def pg_volume_fields(output: dict[str, Any], manifest: FleetManifest) -> dict[str, str]:
    """`pg_volume_id` from `tofu output -json` when the fleet has a Postgres volume."""
    if "pg_volume" not in manifest:
        return {}
    volume_id = output["pg_volume_id"]["value"]
    if volume_id is None:
        raise RemoteError(
            "tofu output has no pg_volume_id although a pg volume was planned"
        )
    return {"pg_volume_id": volume_id}


def volume_device(volume_id: str) -> str:
    """The stable NVMe name of an EBS volume: `/dev/sdf` is not what the kernel calls it, and
    the nvme index is not stable across boots."""
    return (
        f"{VOLUME_BY_ID}/nvme-Amazon_Elastic_Block_Store_{volume_id.replace('-', '')}"
    )


def mount_pg_volume_script(volume_id: str) -> str:
    """Mounts the volume on /data/pg with the root filesystem's options, so that the placement
    differs from `colocated` by the device only. The root copy that `colocated` left under the
    mountpoint is emptied first: mounted over, it would keep using root space unseen."""
    return (
        "if ! mountpoint -q /data/pg; then\n"
        "  find /data/pg -mindepth 1 -delete\n"
        f'  mount -t ext4 -o "$(findmnt -no OPTIONS /)" {volume_device(volume_id)} /data/pg\n'
        "fi\n"
    )


def format_pg_volume_script(volume_id: str) -> str:
    """Waits for the device, then makes the filesystem once. Eager inode and journal init keeps
    the kernel's background zeroing out of the measurement."""
    device = volume_device(volume_id)
    return (
        "set -eu\n"
        "udevadm settle\n"
        f"for _ in $(seq {PG_VOLUME_WAIT_S}); do [ -b {device} ] && break; sleep 1; done\n"
        f"[ -b {device} ] || {{ echo {device} missing after {PG_VOLUME_WAIT_S} s >&2; exit 1; }}\n"
        f"mkfs.ext4 -q -F -E lazy_itable_init=0,lazy_journal_init=0 {device}\n"
        + mount_pg_volume_script(volume_id)
    )


def pg_store_script(mode: DbMode, manifest: FleetManifest) -> str:
    """Runs on the query host after its containers are gone and before /data/pg is wiped:
    `colocated` must not inherit a volume mounted by an earlier run."""
    if mode == "colocated":
        return "if mountpoint -q /data/pg; then umount /data/pg; fi\n"
    if mode == "volume":
        if "pg_volume_id" not in manifest:
            raise Refused(f"fleet {manifest['name']} has no pg volume")
        return mount_pg_volume_script(manifest["pg_volume_id"])
    if mode == "rds":
        return ""
    raise ValueError(f"no store reset for query db mode {mode!r}")


def prepare_stores(fleet: FleetState) -> None:
    """What `up` does to the query host's storage once cloud-init is done: makes and mounts the
    Postgres volume. The volume is reused by every run; `reset_chain` only empties it."""
    manifest = fleet.manifest
    if "pg_volume_id" not in manifest:
        return
    remote = fleet.remote
    assert remote is not None, "connect must run first"
    enter_phase(
        fleet,
        fleet.manifest_path,
        "preparing-stores",
        f"mkfs and mount {manifest['pg_volume_id']} on the query host",
    )
    script = format_pg_volume_script(manifest["pg_volume_id"])
    for name, host in remote.hosts.items():
        if host["role"] == "query":
            remote.ssh(name, bounded(script))


def reset_script(role: str, pg_store: str = "") -> str:
    """Stops the agents, removes every container and wipes what a run leaves on a host, keeping
    what `up` put there. On the query host it also empties the Postgres data directory, after
    `pg_store` has put the run's placement under /data/pg."""
    keep = " ".join(f"! -name {name}" for name in RESET_KEEP)
    script = (
        "set -eu\n"
        "for unit in bench-agent bench-host; do "
        "if systemctl is-active --quiet $unit; then systemctl stop $unit; fi; done\n"
        "ids=$(docker ps -aq)\n"
        f'if [ -n "$ids" ]; then docker stop -t {int(FREEZE_STOP_TIMEOUT_S)} $ids; '
        "docker rm -f $ids; fi\n"
        "find /data/journal -mindepth 1 -delete\n"
        f"{latency.TC_IFACE}\n{latency.TC_CLEAR}\n{latency.RESTORE_BASELINE}\n"
        f"find {BENCH_DIR} -mindepth 1 -maxdepth 1 {keep} -exec rm -rf {{}} +\n"
    )
    if role == "query":
        script += pg_store + "find /data/pg -mindepth 1 -delete\n"
    return script


def reset_chain(
    remote: Remote, mode: DbMode, manifest: FleetManifest, interrupts: Interrupts
) -> None:
    """Every host in parallel: back to the state `up` left. Idempotent, so `run --force` can
    repeat it after a failure. Anvil restarts from genesis afterwards, so every run starts at
    height 0."""
    pg_store = pg_store_script(mode, manifest)

    def reset(host: str) -> None:
        interrupts.check()
        role = remote.hosts[host]["role"]
        remote.ssh(host, bounded(reset_script(role, pg_store)))

    remote.parallel(reset, remote.hosts)


def reset_rds_store(remote: Remote, fleet_dir: Path, interrupts: Interrupts) -> None:
    """Drops and recreates the database the query service fills, so the run starts on an empty
    one. `pg.json` goes first because a colocated run leaves another endpoint on node0;
    `WITH (FORCE)` ends the backends of a run that did not shut down cleanly."""
    interrupts.check()
    ship_rds_endpoint(remote, fleet_dir)
    commands = " ".join(f"-c {shlex.quote(sql)}" for sql in RDS_RESET_SQL)
    remote.ssh(
        "node0",
        pg_shell(
            f"export PGDATABASE=postgres\n"
            f"timeout {GATE_TIMEOUT_S:.0f} psql -v ON_ERROR_STOP=1 {commands}\n"
        ),
    )


def write_run_cost(
    run: Run, actual: dict[str, float] | None = None
) -> dict[str, float]:
    """The fleet's billed cost once known, else the hourly rate over the run's wall time."""
    rate = estimate_rate(run.fleet.manifest["estimate"])
    if actual is None:
        duration_s = run.fleet.system.clock.time() - run.started
        usd = rate * duration_s / 3600
    else:
        duration_s, usd = actual["duration_s"], actual["actual"]
    cost = {"usd_per_hour": rate, "duration_s": duration_s, "usd": usd}
    nb.write_json(run.run_dir / "cost.json", cost)
    return cost


def end_fleet_run(run: Run, result: nb.BenchResult | None, reset_failed: bool) -> int:
    fleet = run.fleet
    code = exit_code(run.error, result, True)
    try:
        cost = write_run_cost(run)
        update_manifest(run.manifest_path, "done")
        record_index(run, result, code, cost)
    finally:
        settle_fleet(fleet, reset_failed)
    auto_publish(run)
    log.info(
        "run dir %s; fleet %s, %.0f min left",
        run.run_dir,
        fleet.manifest["phase"],
        minutes_left(fleet.manifest, utc_now(fleet.system.clock)),
    )
    return code


def settle_fleet(fleet: FleetState, dirty: bool) -> None:
    """Back to `idle` and unlocked, or `dirty` with the lock kept so that only `--force` or
    `down` can follow a failed reset."""
    if dirty:
        update_manifest(fleet.manifest_path, "dirty")
        log.error(
            "pull or reset failed, fleet is dirty and locked; run: "
            "aws-bench run --fleet %s --force, or: aws-bench down %s",
            fleet.fleet_dir,
            fleet.fleet_dir,
        )
        return
    update_manifest(fleet.manifest_path, "idle")
    release_fleet_lock(fleet.fleet_dir)


def log_preflight(cfg: RunConfig, pre: Preflight, hosts: list[HostSpec]) -> None:
    log.info(
        "account %s (%s) %s, az %s, ami %s (%s)",
        pre["account"],
        PROFILE,
        cfg.region,
        pre["az"],
        pre["ami_id"],
        pre["arch"],
    )
    images = ", ".join(f"{n}@{i['digest'][:15]}" for n, i in pre["images"].items())
    log.info("images %s: %s", image_label(cfg), images)
    types = {h["role"]: h["instance_type"] for h in hosts}
    log.info(
        "hosts: ctl %s; %d x %s (node0 validator+query, postgres)",
        types["ctl"],
        len(hosts) - 1,
        types["query"],
    )
    if "rds" in cfg.db_modes:
        log.info(
            "query db rds: %s postgres %s gp3 %d GB %d IOPS %d MB/s",
            RDS_CLASS,
            pre["rds_engine_version"],
            PG_GB,
            cfg.pg_iops,
            cfg.pg_mbps,
        )


def render_fleet_dir(
    system: System,
    cfg: RunConfig,
    fleet_dir: Path,
    hosts: list[HostSpec],
    pre: Preflight,
    estimate: Estimate,
    argv: list[str],
) -> FleetManifest:
    """The fleet dir, everything known before `tofu apply`. Files that need the hosts'
    addresses (env files, start.sh, topology) are written by `render_host_files` after it."""
    ssh_pub = generate_ssh_key(system.run, fleet_dir)
    cidr = operator_cidr(system.http_get)
    git_rev = git_head(system.run)
    rds = rds_spec(cfg, pre)
    write_fleet_manifest(
        fleet_dir, cfg, hosts, plan_peers(hosts), estimate, "planned", argv
    )
    fleet = update_manifest(
        fleet_dir / FLEET_JSON,
        "planned",
        az=pre["az"],
        arch=pre["arch"],
        memory_mib=pre["memory_mib"],
        ami_id=pre["ami_id"],
        images=pre["images"],
        git_rev=git_rev,
        ssh_public_key=ssh_pub,
        cost_usd={
            "expected": estimate["expected_usd"],
            "bound": estimate["bound_usd"],
        },
        **({} if rds is None else {"rds_spec": rds}),
    )
    for host in hosts:
        host_dir = fleet_dir / "hosts" / host["name"]
        host_dir.mkdir(parents=True)
        (host_dir / "user-data.sh").write_text(
            render_user_data(host, pre["images"], int(estimate["ttl_s"]))
        )
    tf_dir = fleet_dir / "terraform"
    shutil.copytree(TERRAFORM_SRC, tf_dir)
    # Absolute: `tofu -chdir` changes the directory `file()` resolves user_data_path against.
    tfvars = render_tfvars(
        cfg,
        fleet_dir.resolve(),
        fleet_dir.name,
        system.user(),
        hosts,
        ssh_pub,
        cidr,
        "",
        git_rev,
        pre["az"],
        pre["ami_id"],
    )
    if rds is not None:
        expires = utc_now(system.clock) + timedelta(seconds=estimate["ttl_s"])
        tfvars.update(rds_tfvars(rds, secrets.token_urlsafe(24), expires))
    # The tfvars and state carry the rds password.
    tf_dir.chmod(0o700)
    write_private_json(tf_dir / "terraform.tfvars.json", tfvars)
    return fleet


def render_run(
    fleet_dir: Path,
    fleet: FleetManifest,
    cfg: RunConfig,
    name: str,
    argv: list[str],
    run_estimate: RunEstimate | None = None,
) -> Path:
    """`runs/<nn>-<name>/` with its manifest, genesis and load config. Without a
    `run_estimate` this is the run of a single shot, which also provisions."""
    genesis = render_genesis(
        (SCRIPT_DIR / "genesis.toml").read_bytes(), cfg.nodes, cfg.max_block_size
    )
    run_dir = new_run_dir(fleet_dir, name)
    meta = latency_meta(cfg, fleet["hosts"]) if cfg.latency != "off" else None
    manifest = build_run_manifest(
        fleet,
        cfg,
        run_index(run_dir),
        run_config_hash(cfg, fleet["hosts"], fleet["images"], genesis, meta),
        run_estimate,
        argv,
    )
    if meta is not None:
        manifest["latency"] = meta
    nb.write_json(run_dir / "manifest.json", manifest)
    append_event(run_dir, "planned", "manifest-written", None)
    (run_dir / "genesis.toml").write_bytes(genesis)
    nb.write_json(run_dir / "config.json", dataclasses.asdict(cfg.load))
    log.info("run dir %s", run_dir)
    return run_dir


def latency_shaping(cfg: RunConfig, node_count: int) -> latency.Shaping:
    """Data problems (missing CSV pair, unknown location) are refused before any AWS write."""
    try:
        return latency.shaping(
            cfg.latency, node_count, cfg.intra_latency, cfg.tcp_cc, cfg.mtu
        )
    except (KeyError, ValueError, OSError) as exc:
        raise Refused(f"latency {cfg.latency}: {type(exc).__name__}: {exc}") from exc


def latency_meta(cfg: RunConfig, hosts: list[HostSpec]) -> nb.LatencyMeta:
    shaping = latency_shaping(cfg, sum(host["role"] != "ctl" for host in hosts))
    meta = cast(nb.LatencyMeta, shaping.meta())
    log.info(
        "latency %s: %s; intra %g ms %s; tcp %s; mtu %d",
        meta["profile"],
        ", ".join(f"{label} {count}" for label, count in meta["nodes"].items()),
        shaping.profile.intra_ms[shaping.assignment[0]],
        "on" if cfg.intra_latency else "off",
        shaping.tcp_cc,
        shaping.mtu,
    )
    return meta


def run_config_hash(
    cfg: RunConfig,
    hosts: list[HostSpec],
    images: dict[str, ImageInfo],
    genesis: bytes,
    latency_meta: nb.LatencyMeta | None = None,
) -> str:
    """Load config plus what else changes the measured system: image digests, the fleet's
    shape, the query database placement, the rendered genesis and the latency matrix."""
    digests = {name: image["digest"] for name, image in sorted(images.items())}
    return nb.config_hash(
        cfg.load,
        [
            genesis,
            json.dumps(digests).encode(),
            json.dumps(hosts, sort_keys=True).encode(),
            cfg.query_db.encode(),
            *([json.dumps(sorted(cfg.node_env)).encode()] if cfg.node_env else []),
            *([b"leader-trace"] if cfg.leader_trace else []),
            # Absent for journal, which older runs used, to keep their hashes.
            *(
                [f"consensus-storage={cfg.consensus_storage}".encode()]
                if cfg.consensus_storage != "journal"
                else []
            ),
            *(
                [json.dumps(dataclasses.asdict(cfg.search), sort_keys=True).encode()]
                if cfg.search
                else []
            ),
            *(
                [
                    json.dumps(
                        {
                            "latency": cfg.latency,
                            "intra": cfg.intra_latency,
                            "matrix": latency_meta["matrix_sha256"],
                        }
                    ).encode()
                ]
                if latency_meta is not None
                else []
            ),
        ],
    )


def ssh_key_path(fleet_dir: Path) -> Path:
    return fleet_dir / "ssh" / "id_ed25519"


def generate_ssh_key(run: Runner, fleet_dir: Path) -> str:
    key = ssh_key_path(fleet_dir)
    key.parent.mkdir(exist_ok=True)
    result = run(
        [
            "ssh-keygen",
            "-q",
            "-t",
            "ed25519",
            "-N",
            "",
            "-C",
            fleet_dir.name,
            "-f",
            str(key),
        ]
    )
    if result.returncode != 0:
        raise Refused(f"ssh-keygen failed: {result.stderr.strip()}")
    return key.with_name(key.name + ".pub").read_text().strip()


def remove_ssh_key(fleet_dir: Path) -> None:
    """Deletes the private half of the key; the `.pub` stays for the record."""
    key = ssh_key_path(fleet_dir)
    if not key.exists():
        return
    key.unlink()
    log.info("ssh key removed")


def operator_cidr(http_get: HttpGet) -> str:
    try:
        status, _, body = http_get(CHECKIP_URL, {})
    except OSError as exc:
        raise Refused(f"cannot detect this machine's IP ({exc})")
    if status != 200:
        raise Refused(f"cannot detect this machine's IP (status {status})")
    return f"{body.decode().strip()}/32"


def git_head(run: Runner) -> str:
    result = run(["git", "rev-parse", "--short", "HEAD"])
    if result.returncode != 0:
        raise Refused(f"git rev-parse --short HEAD failed: {result.stderr.strip()}")
    return result.stdout.strip()


def parse_hosts_output(
    output: dict[str, Any], specs: list[HostSpec]
) -> dict[str, HostInfo]:
    value = output["hosts"]["value"]
    return {
        spec["name"]: {
            "name": spec["name"],
            "role": spec["role"],
            "public_ip": value[spec["name"]]["public_ip"],
            "private_ip": value[spec["name"]]["private_ip"],
            "private_dns": value[spec["name"]]["private_dns"],
            "instance_id": value[spec["name"]]["instance_id"],
        }
        for spec in specs
    }


def parse_rds_output(output: dict[str, Any]) -> RdsInfo:
    value = output["rds"]["value"]
    if value is None:
        raise RemoteError("tofu output rds is null, but the fleet has an rds instance")
    return {
        "identifier": value["identifier"],
        "endpoint": value["endpoint"],
        "port": value["port"],
        "engine_version": value["engine_version"],
    }


def describe_rds(run: Runner, region: str, identifier: str) -> dict[str, Any]:
    return aws_json(
        run,
        "rds",
        "describe-db-instances",
        "--db-instance-identifier",
        identifier,
        region=region,
    )["DBInstances"][0]


def wait_rds_in_sync(fleet: FleetState, identifier: str) -> dict[str, Any]:
    """The description of the instance once it is `available` with an `in-sync` parameter
    group. A group that reports `pending-reboot` gets one reboot."""
    rebooted = False
    clock = fleet.system.clock
    deadline = clock.monotonic() + RDS_SYNC_TIMEOUT_S
    while True:
        instance = describe_rds(fleet.system.run, fleet.cfg.region, identifier)
        state = instance["DBInstanceStatus"]
        applied = instance["DBParameterGroups"][0]["ParameterApplyStatus"]
        if state == "available" and applied == "in-sync":
            return instance
        if state == "available" and applied == "pending-reboot" and not rebooted:
            log.info("rds %s: parameter group pending-reboot, rebooting", identifier)
            aws_json(
                fleet.system.run,
                "rds",
                "reboot-db-instance",
                "--db-instance-identifier",
                identifier,
                region=fleet.cfg.region,
            )
            rebooted = True
        if clock.monotonic() >= deadline:
            raise RemoteError(
                f"rds {identifier} is {state} with parameters {applied} "
                f"{RDS_SYNC_TIMEOUT_S:.0f} s after apply"
            )
        fleet.interrupts.sleep(RDS_POLL_S)


def prepare_rds(fleet: FleetState) -> None:
    """After `wait_hosts`: parameters applied, database reachable from
    node0. Writes `rds.json` and the `pg.json` node0 keeps between runs."""
    remote = fleet.remote
    assert remote is not None, "connect must run first"
    rds = fleet.manifest["rds"]
    instance = wait_rds_in_sync(fleet, rds["identifier"])
    rds = {**rds, "created_at": instance["InstanceCreateTime"]}
    update_manifest(fleet.manifest_path, fleet.manifest["phase"], rds=rds)
    tfvars = nb.read_json(fleet.fleet_dir / "terraform" / "terraform.tfvars.json")
    write_private_json(
        fleet.fleet_dir / RDS_FILE,
        {**rds, "username": RDS_USER, "password": tfvars["rds_password"]},
    )
    ship_rds_endpoint(remote, fleet.fleet_dir)
    gate(remote, "node0", "pg_isready", pg_shell("pg_isready"), fleet.interrupts)


def ship_rds_endpoint(remote: Remote, fleet_dir: Path) -> None:
    """The rds endpoint as node0's `pg.json`, which `pg_shell` and the samplers read."""
    path = fleet_dir / "hosts" / "node0" / "pg.json"
    write_private_json(path, rds_endpoint(fleet_dir))
    remote.rsync_to("node0", [path], PG_JSON)


def rds_endpoint(fleet_dir: Path) -> PgEndpoint:
    rds = nb.read_json(fleet_dir / RDS_FILE)
    return {
        "host": rds["endpoint"],
        "port": rds["port"],
        "user": rds["username"],
        "password": rds["password"],
        "database": RDS_DATABASE,
    }


def query_endpoint(cfg: RunConfig, run_dir: Path) -> PgEndpoint:
    """Where node0's query service finds Postgres for this run."""
    return rds_endpoint(fleet_of(run_dir)) if cfg.query_db == "rds" else pg_endpoint()


def topology(hosts: dict[str, HostInfo]) -> nb.Topology:
    """Private URLs: the load runs on ctl, inside the VPC."""
    names = _node_names(hosts)
    return {
        "nodes": {name: _node_url(hosts[name]) for name in names},
        "roles": {
            name: "validator, query, postgres" if name == "node0" else "validator"
            for name in names
        },
        "query_node": "node0",
    }


def trace_env(cfg: RunConfig) -> tuple[str, ...]:
    if not cfg.leader_trace:
        return ()
    return (f"ESPRESSO_NODE_LEADER_TRACE_DIR={TRACE_CONTAINER_DIR}",)


def node_hosts(hosts: dict[str, HostInfo]) -> list[HostInfo]:
    return [hosts[name] for name in _node_names(hosts)]


def render_host_files(
    run_dir: Path,
    cfg: RunConfig,
    manifest: FleetManifest,
    hosts: dict[str, HostInfo],
) -> None:
    for spec in manifest["hosts"]:
        host_dir = run_dir / "hosts" / spec["name"]
        host_dir.mkdir(parents=True, exist_ok=True)
        (host_dir / "start.sh").write_text(
            render_start_sh(
                spec,
                manifest["images"],
                manifest["memory_mib"][spec["instance_type"]],
                query_db=cfg.query_db,
                leader_trace=cfg.leader_trace,
                consensus_storage=cfg.consensus_storage,
            )
        )
        if spec["role"] == "ctl":
            (host_dir / "ctl.env").write_text(render_ctl_env(hosts, cfg, dotenv()))
        else:
            pg = query_endpoint(cfg, run_dir) if spec["role"] == "query" else None
            node_env = host_dir / "node.env"
            if cfg.query_db == "rds" and pg is not None:
                node_env.touch(mode=0o600)
                node_env.chmod(0o600)
            node_env.write_text(
                render_node_env(
                    spec,
                    hosts,
                    pg,
                    (*trace_env(cfg), *cfg.node_env),
                    cfg.consensus_storage,
                )
            )
            if pg is not None:
                write_private_json(host_dir / "pg.json", pg)
    topo = topology(hosts)
    nb.write_json(run_dir / "topology.json", topo)
    nb.write_json(
        run_dir / "hosts" / "ctl" / "agent.json",
        {
            "cfg": dataclasses.asdict(cfg.load),
            "search": None if cfg.search is None else dataclasses.asdict(cfg.search),
            "topology": topo,
            "ready_timeout_s": READY_TIMEOUT_S,
        },
    )


def genesis_contracts(run_dir: Path) -> list[str]:
    """Addresses `deploy` must have created for the nodes to start: the fee and stake table
    contracts the genesis chain_config points at."""
    text = (run_dir / "genesis.toml").read_text()
    found = re.findall(r'(?m)^(?:fee|stake_table)_contract = "(0x[0-9a-fA-F]+)"$', text)
    if not found:
        raise ValueError("no contract addresses in genesis.toml")
    return sorted(set(found))


def retry_verdict(
    ok: bool, now: float, deadline: float
) -> Literal["ok", "retry", "timeout"]:
    """Outcome of one attempt of a poll-until-ready loop: `ok`, or retry until `deadline` on
    the clock `now` reads."""
    if ok:
        return "ok"
    return "timeout" if now >= deadline else "retry"


def wait_ssh(remote: Remote, host: str, interrupts: Interrupts) -> None:
    deadline = interrupts.clock.monotonic() + SSH_READY_TIMEOUT_S
    delay = SSH_RETRY_S
    while True:
        result = remote.ssh(host, "true", check=False)
        verdict = retry_verdict(
            result.returncode == 0, interrupts.clock.monotonic(), deadline
        )
        if verdict == "ok":
            return
        if verdict == "timeout":
            raise RemoteError(
                f"{host}: ssh not reachable after {SSH_READY_TIMEOUT_S:.0f} s: "
                f"{result.stderr.strip()}"
            )
        interrupts.sleep(delay)
        delay = min(delay * 1.5, SSH_RETRY_MAX_S)


def install_xanmod(fleet: FleetState, remote: Remote) -> None:
    """XanMod carries BBR v3 as `tcp_bbr`. Node hosts only; the ctl host keeps its kernel."""
    names = _node_names(remote.hosts)
    log.info("kernel: XanMod on %d node hosts", len(names))

    def install(host: str) -> None:
        remote.ssh(
            host,
            f"sudo timeout {XANMOD_INSTALL_TIMEOUT_S} bash -c {shlex.quote(XANMOD_SCRIPT)}",
        )
        reboot(remote, host, fleet.interrupts)
        release = remote.ssh(host, "uname -r").stdout.strip()
        if "xanmod" not in release:
            raise RemoteError(f"{host}: kernel {release!r} after reboot is not XanMod")
        # The reboot cancelled user-data's `shutdown -P`.
        expires = datetime.fromisoformat(fleet.manifest["expires_at"])
        left_s = (expires - utc_now(fleet.system.clock)).total_seconds()
        remote.ssh(host, f"sudo shutdown -P +{max(1, math.ceil(left_s / 60))}")

    remote.parallel(install, names)


def reboot(remote: Remote, host: str, interrupts: Interrupts) -> None:
    """Returns once the host answers ssh with another boot id; ssh may still reach the old boot
    for a moment after the reboot command."""
    boot_id = "cat /proc/sys/kernel/random/boot_id"
    before = remote.ssh(host, boot_id).stdout
    remote.ssh(host, "sudo systemctl reboot", check=False)
    deadline = interrupts.clock.monotonic() + SSH_READY_TIMEOUT_S
    while True:
        result = remote.ssh(host, boot_id, check=False)
        up = result.returncode == 0 and result.stdout != before
        verdict = retry_verdict(up, interrupts.clock.monotonic(), deadline)
        if verdict == "ok":
            return
        if verdict == "timeout":
            raise RemoteError(
                f"{host}: not rebooted after {SSH_READY_TIMEOUT_S:.0f} s: "
                f"{result.stderr.strip()}"
            )
        interrupts.sleep(SSH_RETRY_S)


def wait_hosts(
    remote: Remote, manifest: FleetManifest, fleet_dir: Path, interrupts: Interrupts
) -> None:
    """Per host: ssh reachable, `cloud-init status --wait`, then `ready.json` saved. Pulled
    digests that differ from the manifest are only logged here; `check_validity_aws` marks the
    run invalid."""

    def ready(host: str) -> None:
        wait_ssh(remote, host, interrupts)
        wait_cloud_init(remote, host)
        text = remote.ssh(host, f"cat {BENCH_DIR}/ready.json").stdout
        host_dir = fleet_dir / "hosts" / host
        (host_dir / "ready.json").write_text(text)
        bad = digest_mismatches(json.loads(text)["digests"], manifest["images"])
        if bad:
            log.warning("%s pulled other digests than the manifest: %s", host, bad)

    remote.parallel(ready, remote.hosts)


def wait_cloud_init(remote: Remote, host: str) -> None:
    waited = remote.ssh(
        host,
        f"sudo timeout {CLOUD_INIT_TIMEOUT_S} cloud-init status --wait",
        check=False,
    )
    if waited.returncode not in CLOUD_INIT_OK_RCS:
        raise RemoteError(
            f"{host}: cloud-init status --wait exited {waited.returncode}: "
            f"{waited.stderr.strip()}"
        )
    status = json.loads(
        remote.ssh(host, "cloud-init status --format json", check=False).stdout
    )["status"]
    if status != "done":
        raise RemoteError(f"{host}: cloud-init finished as {status!r}, not 'done'")


def digest_mismatches(
    pulled: dict[str, str], images: dict[str, ImageInfo]
) -> list[str]:
    """`pulled` maps image name to `repo@sha256:..` as `docker image inspect` reports."""
    return [
        name
        for name, ref in sorted(pulled.items())
        if ref.rpartition("@")[2] != images[name]["digest"]
    ]


def ship_agents(remote: Remote) -> str:
    """The laptop's current `aws-bench`, `netbench.py`, `latency.py` and `bbr-hold.sh` to every host, whatever
    `up` put there. Returns the git revision they were shipped from."""
    files = [
        SCRIPT_DIR / "netbench.py",
        SCRIPT_DIR / "latency.py",
        SCRIPT_DIR / "aws-bench",
        SCRIPT_DIR / "aws" / "bbr-hold.sh",
    ]
    remote.parallel(
        lambda host: remote.rsync_to(host, files, f"{BENCH_DIR}/"), remote.hosts
    )
    return git_head(remote.run)


def ship(remote: Remote, run_dir: Path) -> None:
    def send(host: str) -> None:
        host_dir = run_dir / "hosts" / host
        files = [host_dir / f for f in SHIPPED_HOST_FILES if (host_dir / f).exists()]
        files.append(run_dir / "genesis.toml")
        remote.rsync_to(host, files, f"{BENCH_DIR}/")

    remote.parallel(send, remote.hosts)


def start_hostmon(remote: Remote) -> None:
    def start(host: str) -> None:
        role = remote.hosts[host]["role"]
        pg = f" --pg {PG_JSON}" if role == "query" else ""
        remote.ssh(
            host,
            f"sudo systemd-run --unit bench-host --collect -p TimeoutStopSec=3 {AGENT_PYTHON} {BENCH_DIR}/aws-bench "
            f"agent-host {BENCH_DIR}/host.jsonl --role {role}{pg}",
        )

    remote.parallel(start, remote.hosts)


def shape_nodes(remote: Remote, shaping: latency.Shaping) -> None:
    names = _node_names(remote.hosts)
    peer_ips = {i: remote.hosts[name]["private_ip"] for i, name in enumerate(names)}
    scripts = {
        name: latency.tc_script(
            i, peer_ips, shaping.delays, shaping.tcp_cc, shaping.mtu
        )
        for i, name in enumerate(names)
    }
    remote.parallel(lambda name: remote.ssh(name, bounded(scripts[name])), names)


def verify_shaping(
    remote: Remote, shaping: latency.Shaping, manifest_path: Path
) -> None:
    """Pings from node0 and fails when a measured RTT leaves the tolerance of its expected delay
    or a ping prints no summary. The probes are written to the manifest either way."""
    names = _node_names(remote.hosts)
    probes: list[dict[str, Any]] = []
    failures: list[str] = []
    for probe in latency.probe_pairs(shaping.assignment, shaping.delays, shaping.intra):
        target = remote.hosts[names[probe.dst]]["private_ip"]
        result = remote.ssh(
            names[probe.src], bounded(f"ping -c 5 -i 0.2 -n -q {target}"), check=False
        )
        label = f"probe node{probe.src}->node{probe.dst} {probe.tier}"
        try:
            measured = latency.parse_ping_avg_ms(result.stdout)
        except ValueError:
            failures.append(f"{label}: no ping summary, rc {result.returncode}")
            probes.append(
                {
                    **dataclasses.asdict(probe),
                    "measured_ms": None,
                    "ok": False,
                    "rc": result.returncode,
                    "stdout": result.stdout,
                }
            )
            continue
        log.info(
            "%s: expected %.1f ms, measured %.1f ms",
            label,
            probe.expected_ms,
            measured,
        )
        error = latency.probe_error(probe, measured)
        if error is not None:
            failures.append(error)
        probes.append(
            {**dataclasses.asdict(probe), "measured_ms": measured, "ok": error is None}
        )
    failures += mtu_mismatches(remote, names, shaping.mtu)
    meta = {**shaping.meta(), "probes": probes}
    update_manifest(manifest_path, "shaping", latency=meta)
    if failures:
        raise ShapingMismatch("; ".join(failures))


def mtu_mismatches(remote: Remote, names: list[str], mtu: int) -> list[str]:
    """The default-route interface MTU of every node, against the one shaping set."""
    found = {
        name: remote.ssh(
            name, f'{latency.TC_IFACE}; cat "/sys/class/net/$IFACE/mtu"', check=False
        ).stdout.strip()
        for name in names
    }
    return [f"{name}: mtu {got or '?'}, expected {mtu}" for name, got in found.items() if got != str(mtu)]


def create_containers(remote: Remote) -> None:
    """start.sh only runs `docker create`, so `start_nodes` can start every node at once."""
    remote.parallel(
        lambda host: remote.ssh(host, f"sudo bash {BENCH_DIR}/start.sh"), remote.hosts
    )


def gate(
    remote: Remote,
    host: str,
    what: str,
    command: str,
    interrupts: Interrupts,
    timeout_s: float = GATE_TIMEOUT_S,
) -> None:
    deadline = interrupts.clock.monotonic() + timeout_s
    while True:
        result = remote.ssh(host, command, check=False)
        verdict = retry_verdict(
            result.returncode == 0, interrupts.clock.monotonic(), deadline
        )
        if verdict == "ok":
            return
        if verdict == "timeout":
            raise RemoteError(
                f"gate `{what}` on {host} not passed after {timeout_s:.0f} s: "
                f"{(result.stdout + result.stderr).strip()}"
            )
        interrupts.sleep(GATE_RETRY_S)


def rpc_check(method: str, params: list[str], jq_filter: str) -> str:
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params})
    return (
        f"curl -sf -X POST -H 'Content-Type: application/json' --data {shlex.quote(body)} "
        f"http://localhost:{env_port('ESPRESSO_L1_PORT')} | jq -e {shlex.quote(jq_filter)}"
    )


class GateStart(TypedDict):
    kind: Literal["gate"]
    host: str
    # `docker start` target; None for a check on a container that is already running.
    container: str | None
    what: str
    gate_cmd: str
    timeout_s: float


class DeployStart(TypedDict):
    """`deploy` exits instead of serving: `docker wait` for at most `timeout_s`."""

    kind: Literal["deploy"]
    host: str
    container: str
    what: str
    timeout_s: float


SupportStart = GateStart | DeployStart


def support_plan(query_db: DbMode, contracts: list[str]) -> list[SupportStart]:
    """The support services in start order, each with the check that gates the next. The rds
    instance is only checked: it is already running."""
    plan: list[SupportStart] = [
        GateStart(
            kind="gate",
            host="ctl",
            container="anvil",
            what="anvil eth_chainId",
            gate_cmd=rpc_check("eth_chainId", [], ".result"),
            timeout_s=GATE_TIMEOUT_S,
        ),
        DeployStart(
            kind="deploy",
            host="ctl",
            container="deploy",
            what="deploy",
            timeout_s=DEPLOY_TIMEOUT_S,
        ),
    ]
    for address in contracts:
        check = rpc_check("eth_getCode", [address, "latest"], '.result != "0x"')
        plan.append(
            GateStart(
                kind="gate",
                host="ctl",
                container=None,
                what=f"eth_getCode {address}",
                gate_cmd=check,
                timeout_s=GATE_TIMEOUT_S,
            )
        )
    plan += [
        GateStart(
            kind="gate",
            host="ctl",
            container="orchestrator",
            what="orchestrator healthcheck",
            gate_cmd=f"curl -sf http://localhost:{env_port('ESPRESSO_ORCHESTRATOR_PORT')}/healthcheck",
            timeout_s=GATE_TIMEOUT_S,
        ),
        GateStart(
            kind="gate",
            host="ctl",
            container="state-relay-server",
            what="relay healthcheck",
            gate_cmd=f"curl -sf http://localhost:{env_port('ESPRESSO_STATE_RELAY_SERVER_PORT')}/healthcheck",
            timeout_s=GATE_TIMEOUT_S,
        ),
        GateStart(
            kind="gate",
            host="node0",
            container=None if query_db == "rds" else "postgres",
            what="pg_isready",
            gate_cmd=pg_shell("pg_isready"),
            timeout_s=GATE_TIMEOUT_S,
        ),
    ]
    for what, sql in (
        ("pg_stat_statements", PG_EXTENSION_SQL),
        (
            "pg stats reset",
            "CHECKPOINT; SELECT pg_stat_reset_shared(NULL); SELECT pg_stat_statements_reset()",
        ),
    ):
        plan.append(
            GateStart(
                kind="gate",
                host="node0",
                container=None,
                what=what,
                gate_cmd=pg_shell(f"psql -c {shlex.quote(sql)}"),
                timeout_s=GATE_TIMEOUT_S,
            )
        )
    return plan


def start_support(
    remote: Remote,
    contracts: list[str],
    interrupts: Interrupts,
    query_db: DbMode = "colocated",
) -> None:
    """On ctl, in order and each gated on a check: anvil, contract deployment, orchestrator,
    relay; then Postgres on node0 (the rds instance is only gated, it is already running)."""
    for step in support_plan(query_db, contracts):
        host = step["host"]
        if step["container"] is not None:
            remote.ssh(host, f"sudo docker start {step['container']}")
        if step["kind"] == "deploy":
            wait_deploy(remote, host, step["container"], step["timeout_s"])
        else:
            gate(
                remote,
                host,
                step["what"],
                step["gate_cmd"],
                interrupts,
                step["timeout_s"],
            )


def wait_deploy(remote: Remote, host: str, container: str, timeout_s: float) -> None:
    waited = remote.ssh(
        host, f"sudo timeout {timeout_s} docker wait {container}", check=False
    )
    if waited.returncode == TIMEOUT_RC:
        raise RemoteError(f"{container} still running after {timeout_s} s")
    if waited.returncode != 0:
        raise RemoteError(
            f"docker wait {container} exited {waited.returncode}: {waited.stderr.strip()}"
        )
    if waited.stdout.strip() != "0":
        raise RemoteError(
            f"{container} exited with status {waited.stdout.strip()}; "
            f"see docker logs on {host}"
        )


def fleet_time(remote: Remote) -> float:
    """Epoch seconds on ctl. Every host is chrony-synced to the same source, so a start time on
    ctl's clock is a start time on all clocks; the laptop's clock is not."""
    return float(remote.ssh("ctl", "date +%s.%N").stdout)


def start_nodes(remote: Remote, hosts: list[HostInfo], at: float) -> float:
    """`docker start` of every node at fleet time `at`. Returns the spread in seconds between
    the earliest and latest `.State.StartedAt`."""
    wait = (
        "python3 -c 'import sys, time; time.sleep(max(0.0, float(sys.argv[1]) - time.time()))' "
        f"{at!r}"
    )
    inspect = "sudo docker inspect -f '{{.State.StartedAt}}' espresso-node"

    def start(node: str) -> float:
        remote.ssh(node, f"{wait} && sudo docker start espresso-node")
        return parse_docker_time(remote.ssh(node, inspect).stdout)

    # One thread per node: each ssh call sleeps until `at`, so a smaller pool would start the
    # rest only after the first batch returned.
    started = remote.parallel(start, [h["name"] for h in hosts], workers=len(hosts))
    return max(started.values()) - min(started.values())


def parse_docker_time(text: str) -> float:
    """`.State.StartedAt`: RFC 3339 with nanoseconds, e.g. 2026-09-29T15:00:00.123456789Z."""
    stamp, _, frac = text.strip().removesuffix("Z").partition(".")
    moment = datetime.fromisoformat(f"{stamp}.{frac[:6].ljust(6, '0')}+00:00")
    return moment.timestamp()


