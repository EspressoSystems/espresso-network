def pg_tuning(memory_mib: int) -> PgTuning:
    """Settings for a Postgres on a host of `memory_mib`: key -> (postgresql.conf text for the
    container's `-c` flags, the same value as pg_settings.setting reports it and the RDS
    parameter group takes it). node0 also runs espresso-node and the journal's page cache, so
    shared_buffers is a quarter of the host, effective_cache_size three quarters,
    maintenance_work_mem 1/16 and autovacuum_work_mem 1/64, each floored to whole MB. No caps:
    the priced types span 16 to 64 GiB, where these stay below a third of the host (Postgres 18
    has no 1 GB vacuum limit). work_mem and wal_buffers stay fixed: per-query and WAL sizing
    does not grow with the host. The last group pins what RDS defaults differently from
    postgres."""
    return {
        "shared_buffers": _pg_pages(memory_mib // 4),
        "effective_cache_size": _pg_pages(memory_mib * 3 // 4),
        "huge_pages": ("off", "off"),
        "work_mem": ("64MB", "65536"),
        "maintenance_work_mem": _pg_kib(memory_mib // 16),
        "max_wal_size": ("16GB", "16384"),
        "min_wal_size": ("4GB", "4096"),
        "checkpoint_timeout": ("15min", "900"),
        "checkpoint_completion_target": ("0.9", "0.9"),
        # VID shares and payloads do not compress: pglz on them was two thirds of the Postgres CPU
        # in run lulu-20260930-1649 (perf). lz4 gives up on such input at once.
        "wal_compression": ("lz4", "lz4"),
        "default_toast_compression": ("lz4", "lz4"),
        "random_page_cost": ("1.1", "1.1"),
        "effective_io_concurrency": ("200", "200"),
        "autovacuum_vacuum_cost_limit": ("2000", "2000"),
        "autovacuum_max_workers": ("4", "4"),
        "autovacuum_work_mem": _pg_kib(memory_mib // 64),
        "autovacuum_naptime": ("1min", "60"),
        "autovacuum_vacuum_scale_factor": ("0.2", "0.2"),
        "autovacuum_analyze_scale_factor": ("0.1", "0.1"),
        "track_io_timing": ("off", "off"),
        # Serial ~6 MB block transactions overflow 16MB: wal_buffers_full 821466 in run
        # lulu-20260930-1207, a backend WAL write every ~32 kB on average.
        "wal_buffers": ("256MB", "32768"),
        "max_connections": ("100", "100"),
    }


def _pg_size(mb: int) -> str:
    return f"{mb // 1024}GB" if mb % 1024 == 0 else f"{mb}MB"


def _pg_pages(mb: int) -> tuple[str, str]:
    """A size in 8 kB pages, the unit of shared_buffers and effective_cache_size."""
    return _pg_size(mb), str(mb * 128)


def _pg_kib(mb: int) -> tuple[str, str]:
    return _pg_size(mb), str(mb * 1024)


