def render_genesis(template: bytes, n: int, max_block_size: str) -> bytes:
    """`n` validators need a stake table at least as large; contract addresses stay as the
    template's, since they are deterministic from the deployer nonce. `max_block_size` goes
    into both chain configs."""
    capacity = max(10, n)
    text = template.decode()
    text, size_n = re.subn(
        r'(?m)^max_block_size = ".*"$', f'max_block_size = "{max_block_size}"', text
    )
    if size_n != 2:
        raise ValueError(
            f"expected 2 max_block_size fields in genesis template, replaced {size_n}"
        )
    text, stake_n = re.subn(
        r"(?m)^stake_table_capacity = \d+$", f"stake_table_capacity = {capacity}", text
    )
    text, cap_n = re.subn(r"(?m)^capacity = \d+$", f"capacity = {capacity}", text)
    if stake_n + cap_n != 2:
        raise ValueError(
            f"expected 2 capacity fields in genesis template, replaced {stake_n + cap_n}"
        )
    return text.encode()


def parse_dotenv(text: str) -> dict[str, str]:
    """The subset of .env syntax this repo's .env uses: KEY=VALUE lines, `#` comments, optional
    surrounding double quotes, `${OTHER_KEY}` references to a key already defined above, no
    multi-line values. `docker --env-file` does not expand `${...}`, so this does it once here;
    a reference to an undefined key raises `KeyError` instead of reaching a container literally.
    """
    env: dict[str, str] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        if not sep:
            raise ValueError(f".env line has no '=': {line!r}")
        env[key.strip()] = string.Template(value.strip().strip('"')).substitute(env)
    return env


@cache
def dotenv() -> dict[str, str]:
    return parse_dotenv((REPO_ROOT / ".env").read_text())


def env_port(key: str) -> int:
    return int(dotenv()[key])


def _node_names(hosts: dict[str, HostInfo]) -> list[str]:
    return sorted(
        (name for name in hosts if name != "ctl"),
        key=lambda name: int(name.removeprefix("node")),
    )


def _node_url(info: HostInfo) -> str:
    return f"http://{info['private_ip']}:{NODE_API_PORT}"


def _journal_max_bytes(host: HostSpec) -> int:
    """Usable disk after RESERVED_GB, times JOURNAL_MAX_BYTES_FRACTION; halved on the query
    role, which shares the disk with Postgres."""
    usable_gb = host["root_gb"] - RESERVED_GB
    fraction = JOURNAL_MAX_BYTES_FRACTION
    if host["role"] == "query":
        fraction *= QUERY_JOURNAL_FRACTION
    return int(usable_gb * 1_000_000_000 * fraction)


def render_node_env(
    host: HostSpec,
    hosts: dict[str, HostInfo],
    pg: PgEndpoint | None,
    node_env: Iterable[str] = (),
    consensus_storage: ConsensusStorage = "fs",
) -> str:
    self_info = hosts[host["name"]]
    ctl_info = hosts["ctl"]
    node_names = _node_names(hosts)
    i = node_names.index(host["name"])
    peer_urls = [_node_url(hosts[node_names[j]]) for j in peers(i, len(node_names))]
    env = {
        "ESPRESSO_NODE_KEY_MNEMONIC": BENCH_MNEMONIC,
        "ESPRESSO_NODE_KEY_INDEX": str(KEY_INDEX_BASE + i),
        "ESPRESSO_NODE_CLIQUENET_BIND_ADDRESS": f"0.0.0.0:{CLIQUENET_PORT}",
        "ESPRESSO_NODE_CLIQUENET_ADVERTISE_ADDRESS": f"{self_info['private_ip']}:{CLIQUENET_PORT}",
        "ESPRESSO_NODE_LIBP2P_BIND_ADDRESS": f"0.0.0.0:{LIBP2P_PORT}",
        "ESPRESSO_NODE_LIBP2P_ADVERTISE_ADDRESS": f"{self_info['private_dns']}:{LIBP2P_PORT}",
        "ESPRESSO_NODE_API_PORT": str(NODE_API_PORT),
        "ESPRESSO_NODE_TONIC_PORT": str(NODE_TONIC_PORT),
        "ESPRESSO_NODE_ORCHESTRATOR_URL": f"http://{ctl_info['private_ip']}:{env_port('ESPRESSO_ORCHESTRATOR_PORT')}",
        "ESPRESSO_L1_PROVIDER": f"http://{ctl_info['private_ip']}:{env_port('ESPRESSO_L1_PORT')}",
        "ESPRESSO_L1_WS_PROVIDER": f"ws://{ctl_info['private_ip']}:{env_port('ESPRESSO_L1_PORT')}",
        "ESPRESSO_STATE_RELAY_SERVER_URL": f"http://{ctl_info['private_ip']}:{env_port('ESPRESSO_STATE_RELAY_SERVER_PORT')}",
        "ESPRESSO_NODE_GENESIS_FILE": f"{BENCH_DIR}/genesis.toml",
        "ESPRESSO_NODE_IS_DA": "true",
        "ESPRESSO_NODE_TELEMETRY_LOGS_ENABLE": "false",
        "ESPRESSO_NODE_TELEMETRY_METRICS_ENABLE": "false",
        "RUST_LOG": "info,libp2p=off",
        "RUST_LOG_FORMAT": "json",
        "ESPRESSO_NODE_STORAGE_PATH": "/store/espresso",
        "ESPRESSO_NODE_IDENTITY_NODE_NAME": host["name"],
    }
    if consensus_storage == "journal":
        env["ESPRESSO_NODE_JOURNAL_MAX_BYTES"] = str(_journal_max_bytes(host))
    # A required value left empty risks a clap parse error; omit rather than pass "".
    if peer_urls:
        env["ESPRESSO_NODE_STATE_PEERS"] = ",".join(peer_urls)
    if host["role"] == "query":
        if pg is None:
            raise ValueError(
                f"{host['name']} runs the query service and needs a PgEndpoint"
            )
        env.update(
            {
                "ESPRESSO_NODE_POSTGRES_HOST": pg["host"],
                "ESPRESSO_NODE_POSTGRES_PORT": str(pg["port"]),
                "ESPRESSO_NODE_POSTGRES_USER": pg["user"],
                "ESPRESSO_NODE_POSTGRES_PASSWORD": pg["password"],
                "ESPRESSO_NODE_POSTGRES_DATABASE": pg["database"],
            }
        )
    for pair in node_env:
        key, _, value = pair.partition("=")
        env[key] = value
    return "".join(f"{key}={value}\n" for key, value in env.items())


