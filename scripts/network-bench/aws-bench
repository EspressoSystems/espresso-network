def bounded(command: str) -> str:
    """`command` as root under `timeout`: a hung docker or systemctl call must not block
    teardown."""
    return f"sudo timeout -k 10 {COLLECT_HOST_TIMEOUT_S:.0f} bash -c {shlex.quote(command)}"


