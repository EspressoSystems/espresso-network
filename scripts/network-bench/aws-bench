    publish_p.set_defaults(func=cmd_publish)

    destroy_p = sub.add_parser("destroy", help="sweep orphaned runs")
    destroy_p.add_argument("--orphans", action="store_true", required=True)
    destroy_p.add_argument("--yes", action="store_true")
    add_region_flag(destroy_p, REGION)
    destroy_p.set_defaults(func=cmd_destroy)

    prune_p = sub.add_parser(
        "prune", help="delete old local fleet dirs that hold no AWS resources"
