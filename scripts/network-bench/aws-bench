def config_from_args(args: argparse.Namespace) -> RunConfig:
    submit_nodes = (
        args.submit_nodes if args.submit_nodes is not None else args.nodes - 1
    )
    load = nb.BenchConfig(
        genesis=str(args.genesis),
        tx_size=args.tx_size,
        steps=args.steps,
        step_s=args.step_s,
        submit_nodes=submit_nodes,
        workers=args.workers,
        cap_s=args.cap_s,
        tx_timeout_s=args.tx_timeout_s,
        warmup_s=args.warmup_s,
        seed=args.seed,
        latency_target_ms=args.latency_target_ms,
        query_lag_target_ms=args.query_lag_target_ms,
    )
    return RunConfig(
        tag=args.tag,
        nodes=args.nodes,
        node_type=args.node_type,
        ctl_type=args.ctl_type,
        az=args.az,
        region=args.region,
        profile=args.profile,
        account=args.account,
        load=load,
        ready_timeout_s=args.ready_timeout_s,
        max_block_size=args.max_block_size,
        root_gb=args.root_gb,
        pg_iops=args.pg_iops,
        pg_mbps=args.pg_mbps,
        operator_cidr=args.operator_cidr,
