    "run": "fleet/run",
    "utc": "utc",
    "git": "git",
    "tag": "tag@rev",
    "nodes": "N",
    "db": "db",
    "storage": "storage",
    "latency": "latency",
    "node_type": "node",
    "rate": "rate MB/s",
    "decided": "decided MB/s",
    "bound": "bound",
    "lag_p99": "lag p99 ms",
