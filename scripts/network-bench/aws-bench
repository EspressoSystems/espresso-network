# Callers need the return code and stderr, unlike scripts/release's Runner, to report a
# failed `tofu` or `aws` call.
class Runner(Protocol):
    def __call__(
        self, argv: list[str], env: dict[str, str] | None = None
    ) -> subprocess.CompletedProcess[str]: ...


SignalHandler = Callable[[int, Any], None]
Trap = Callable[[tuple[signal.Signals, ...], SignalHandler], None]
Ask = Callable[[str], bool]
Which = Callable[[str], str | None]
HttpReply = tuple[int, Mapping[str, str], bytes]
HttpGet = Callable[[str, dict[str, str]], HttpReply]
# Sends a signal to the in-flight subprocesses; returns their `command_label`s.
Forward = Callable[[int], list[str]]


@dataclass(frozen=True)
class System:
    run: Runner
    clock: nb.Clock
    trap: Trap
    which: Which
    ask: Ask
    http_get: HttpGet
    http_pool: nb.HttpFactory
    user: Callable[[], str]
    hostname: Callable[[], str]
    pid: int
    pid_alive: Callable[[int], bool]
    forward: Forward


Command = Callable[[argparse.Namespace, System], int]


def _trap(signals: tuple[signal.Signals, ...], handler: SignalHandler) -> None:
    for sig in signals:
        signal.signal(sig, handler)


def _ask(prompt: str) -> bool:
    if not sys.stdin.isatty():
        return False
    return input(f"{prompt} [y/N] ").strip().lower() == "y"


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def host_system() -> System:
    children = Children(os.killpg)
    return System(
        run=partial(_run, children),
        clock=nb.SYSTEM_CLOCK,
        trap=_trap,
        which=shutil.which,
        ask=_ask,
        http_get=_http_get,
        http_pool=nb.HttpPool,
        user=getpass.getuser,
        hostname=socket.gethostname,
        pid=os.getpid(),
        pid_alive=_pid_alive,
        forward=children.forward,
    )


def utc_now(clock: nb.Clock) -> datetime:
    return datetime.fromtimestamp(clock.time(), UTC)


def stamp() -> str:
    """Wall-clock time for records only; decisions use `utc_now`."""
    return datetime.now(UTC).isoformat()


class Children:
    """`_run`'s subprocesses in flight, by pid, each leading its own process group. No lock:
    `forward` runs in the signal handler, which could interrupt its holder."""

    def __init__(self, kill: Callable[[int, int], None]) -> None:
        self.kill = kill
        self.running: dict[int, list[str]] = {}

    def forward(self, signum: int) -> list[str]:
        """Signals the `tofu` children only, e.g. `tofu apply`; never raises."""
        sent = []
        for pid, argv in list(self.running.items()):
            if argv[0] != "tofu":
                continue
            try:
                self.kill(pid, signum)
            except OSError:
                continue
            step = next((a for a in argv[1:] if not a.startswith("-")), "")
            sent.append(f"tofu {step}")
        return sent


def _run(
    children: Children, argv: list[str], env: dict[str, str] | None = None
) -> subprocess.CompletedProcess[str]:
    """`env` is added to the inherited environment."""
    log.debug("+ %s", " ".join(argv))
    # A new session keeps the terminal's Ctrl-C away from tofu and rsync: the driver gets it
    # first, then decides (see `Interrupts`).
    with subprocess.Popen(
        argv,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
        env=None if env is None else {**os.environ, **env},
    ) as proc:
        children.running[proc.pid] = argv
        try:
            stdout, stderr = proc.communicate()
        except BaseException:
            proc.kill()
            raise
        finally:
            del children.running[proc.pid]
    return subprocess.CompletedProcess(argv, proc.returncode, stdout, stderr)


def aws_argv(*args: str, region: str) -> list[str]:
    return ["aws", "--profile", PROFILE, *args, "--region", region, "--output", "json"]


def aws_json(run: Runner, *args: str, region: str, tolerate: str | None = None) -> Any:
    """The parsed stdout of an `aws` call, None for an empty one or a stderr containing
    `tolerate` (an already-deleted resource)."""
    result = run(aws_argv(*args, region=region))
    if result.returncode != 0:
        if tolerate and tolerate in result.stderr:
            return None
        raise Refused(f"aws {' '.join(args[:2])} failed: {result.stderr.strip()}")
    return json.loads(result.stdout) if result.stdout.strip() else None


def payload_factor(nodes: int) -> float:
    """Payload bytes node0 stores per offered byte: its own copy plus a share of the
    others'."""
    return 1 + 3 / nodes


def node_root_gb(cfg: RunConfig, query: bool) -> int:
    """`--root-gb` if given, else sized from the bytes offered over the whole ramp (an upper
    bound, the staircase stops early without keep_going) at 1 MB per MB/s-second; with
    `--search` from `--offered-gb`."""
    if cfg.root_gb != "auto":
        return int(cfg.root_gb)
    if cfg.search:
        return search_root_gb(cfg, query)
    payload_gb = sum(cfg.load.steps) * cfg.load.step_s / 1000
    factor = QUERY_DISK_FACTOR if query else VALIDATOR_DISK_FACTOR
    return max(NODE_ROOT_GB_MIN, math.ceil(RESERVED_GB + factor * payload_gb))


def search_root_gb(cfg: RunConfig, query: bool) -> int:
    """Validators keep the journal; node0's halved journal cap must hold `payload_factor x
    offered` below the noisy mark, which also leaves a colocated Postgres its payloads."""
    assert cfg.search
    offered = cfg.search.offered_gb
    if query:
        cap = (
            JOURNAL_MAX_BYTES_FRACTION * QUERY_JOURNAL_FRACTION * JOURNAL_NOISY_FRACTION
        )
        need = RESERVED_GB + payload_factor(cfg.nodes) * offered / cap
    else:
        need = RESERVED_GB + VALIDATOR_DISK_FACTOR * offered
    # round: float noise must not add a GB to an exact size.
    return max(NODE_ROOT_GB_MIN, math.ceil(round(need, 6)))


def check_search(cfg: RunConfig) -> None:
    """Refuses, before any AWS call, a search that cannot run as configured."""
    search = cfg.search
    if search is None:
        return
    if cfg.load.keep_going:
        raise Refused("--search cannot run with --keep-going")
    first_gb = search.start_mb_s * (cfg.load.warmup_s + cfg.load.step_s) / 1000
    if search.offered_gb < first_gb:
        raise Refused(
            f"--offered-gb {search.offered_gb:g} is below the {first_gb:.1f} GB of the "
            f"warmup and first probe at {search.start_mb_s:g} MB/s"
        )
    stored_gb = payload_factor(cfg.nodes) * search.offered_gb
    if {"volume", "rds"} & set(cfg.db_modes) and stored_gb > PG_FILL_MAX * PG_GB:
        raise Refused(
            f"--offered-gb {search.offered_gb:g} stores {stored_gb:.0f} GB on node0, more "
            f"than {PG_FILL_MAX:.0%} of the {PG_GB} GiB Postgres volume"
        )


def check_fleet_disks(manifest: FleetManifest, cfg: RunConfig) -> None:
    """Refuses a search whose offered bytes the fleet's root disks, sized at `up`, cannot hold."""
    if cfg.search is None:
        return
    for host in manifest["hosts"]:
        if host["role"] == "ctl":
            continue
        need = node_root_gb(cfg, host["role"] == "query")
        if host["root_gb"] < need:
            raise Refused(
                f"{host['name']} has a {host['root_gb']} GB root disk, --offered-gb "
                f"{cfg.search.offered_gb:g} needs {need}: up a fleet with --search and "
                f"that --offered-gb, or lower it"
            )


def check_rds_config(cfg: RunConfig) -> None:
    """Refuses, before any AWS call, an rds fleet whose volume would be measured instead of the
    placement."""
    if "rds" not in cfg.db_modes:
        return
    if (cfg.pg_iops, cfg.pg_mbps) != (RDS_IOPS, RDS_MBPS):
        raise Refused(
            f"rds needs --pg-iops {RDS_IOPS} and --pg-mbps {RDS_MBPS}, got "
            f"{cfg.pg_iops} and {cfg.pg_mbps}: larger provisioned tiers are not priced"
        )


def rds_spec(cfg: RunConfig, pre: Preflight) -> RdsSpec | None:
    if "rds" not in cfg.db_modes:
        return None
    return {
        "instance_class": RDS_CLASS,
        "engine_version": pre["rds_engine_version"],
        "gb": PG_GB,
        "iops": cfg.pg_iops,
        "mbps": cfg.pg_mbps,
    }


def plan_hosts(cfg: RunConfig) -> list[HostSpec]:
    check_rds_config(cfg)
    check_search(cfg)
    if cfg.nodes < 2:
        raise Refused(f"--nodes must be at least 2: {cfg.nodes}")
    check_submit_nodes(cfg)
    hosts: list[HostSpec] = [
        {
            "name": "ctl",
            "role": "ctl",
            "instance_type": cfg.ctl_type,
            "root_gb": CTL_ROOT_GB,
            "root_iops": GP3_BASELINE_IOPS,
            "root_mbps": GP3_BASELINE_MBPS,
        }
    ]
    for i in range(cfg.nodes):
        query = i == 0
        hosts.append(
            {
                "name": f"node{i}",
                "role": "query" if query else "validator",
                "instance_type": cfg.node_type,
                "root_gb": node_root_gb(cfg, query),
                "root_iops": cfg.pg_iops if query else VALIDATOR_ROOT_IOPS,
                "root_mbps": cfg.pg_mbps if query else VALIDATOR_ROOT_MBPS,
            }
        )
    return hosts


def peers(i: int, n: int) -> list[int]:
    """Up to 3 other validators for node i's `STATE_PEERS`, never itself. node0 gets the first
    `min(3, n - 1)` validators, so it can catch up on state it lacks instead of skewing query
    lag; other nodes get the next `min(3, n - 2)` validators after i in the fixed cycle
    `1, .., n-1`, wrapping around, excluding node0 (query load).
    """
    if i == 0:
        return list(range(1, min(3, n - 1) + 1))
    if n <= 2:
        return []
    count = min(3, n - 2)
    return [(i - 1 + k) % (n - 1) + 1 for k in range(1, count + 1)]


def plan_peers(hosts: list[HostSpec]) -> dict[str, list[str]]:
    nodes = [h["name"] for h in hosts if h["role"] != "ctl"]
    return {
        nodes[i]: [nodes[j] for j in peers(i, len(nodes))] for i in range(len(nodes))
    }


def load_seconds(
    load: nb.BenchConfig, search: nb.SearchConfig | None = None, worst: bool = False
) -> float:
    """warmup, every step, the refine step, the drain before it and the wait for the last
    transactions. With keep_going: no refine step, the drain after the last step at its cap.
    With `search`: `max_probes` probes of the longest kind each followed by a drain.
    `worst` sizes a drain at its cap plus the grace; else at its expected time."""
    drain_s = nb.DRAIN_MAX_S + nb.DRAIN_GRACE_S if worst else DRAIN_EXPECTED_S
    if search:
        if worst:
            probe_s = 2 * load.step_s + drain_s
            return load.warmup_s + search.max_probes * probe_s + load.tx_timeout_s
        return (
            load.warmup_s
            + SEARCH_EXPECTED_PROBES * load.step_s
            + SEARCH_EXPECTED_DRAINS * drain_s
            + load.tx_timeout_s
        )
    if load.keep_going:
        final_s = nb.final_drain_max_s(load.tx_timeout_s) + nb.DRAIN_GRACE_S
        return (
            load.warmup_s + len(load.steps) * load.step_s + final_s + load.tx_timeout_s
        )
    return (
        load.warmup_s
        + (len(load.steps) + 1) * load.step_s
        + drain_s
        + load.tx_timeout_s
    )


def shot_seconds(cfg: RunConfig) -> tuple[float, float]:
    """(expected_s, worst_s) of a single shot: provision, one run, destroy."""
    expected_s, worst_s = _measure_seconds(cfg)
    expected_s += PROVISION_S + DESTROY_S
    worst_s += PROVISION_S + DESTROY_S
    if cfg.tcp_cc == "bbr3":
        expected_s += KERNEL_EXPECTED_S
        worst_s += XANMOD_INSTALL_TIMEOUT_S + SSH_READY_TIMEOUT_S
    if "rds" in cfg.db_modes:
        expected_s += RDS_CREATE_S
        worst_s += RDS_CREATE_MAX_S
    return expected_s, worst_s


def run_seconds(cfg: RunConfig, pull: bool = False) -> tuple[float, float]:
    """(expected_s, worst_s) of one run on a live fleet. `pull` is set when the run moves the
    hosts to other images."""
    expected_s, worst_s = _measure_seconds(cfg)
    expected_s += RESET_EXPECTED_S
    worst_s += RESET_MAX_S
    if pull:
        expected_s += PULL_EXPECTED_S
        worst_s += PULL_MAX_S
    return expected_s, worst_s


def _measure_seconds(cfg: RunConfig) -> tuple[float, float]:
    """Services, ready, load and collect. `worst_s` swaps in the timeouts that bound a laptop
    disconnect: the ready timeout and the collection cap."""
    expected_load = load_seconds(cfg.load, cfg.search, worst=False)
    worst_load = load_seconds(cfg.load, cfg.search, worst=True)
    return (
        SERVICES_S + expected_load + READY_EXPECTED_S + COLLECT_EXPECTED_S,
        SERVICES_S + worst_load + READY_TIMEOUT_S + COLLECT_MAX_S,
    )


def cost_estimate(
    hosts: list[HostSpec],
    cfg: RunConfig,
    rds: RdsSpec | None,
    expected_s: float,
    worst_s: float,
    instance_prices: dict[str, float],
) -> Estimate:
    """The bound adds the boot before the shutdown timer is armed, and the rds delete."""
    ttl_s = ttl_seconds(cfg, worst_s)
    volume = pg_volume_spec(cfg)
    lines = _cost_lines(hosts, expected_s, volume, instance_prices)
    bound_lines = _cost_lines(hosts, ttl_s + BOOT_ALLOWANCE_S, volume, instance_prices)
    if rds is not None:
        lines += rds_cost_lines(rds, expected_s)
        bound_lines += rds_cost_lines(rds, ttl_s + RDS_DELETE_S)
    return {
        "expected_s": expected_s,
        "worst_s": worst_s,
        "ttl_s": ttl_s,
        "lines": lines,
        "expected_usd": sum(line["usd"] for line in lines),
        "bound_usd": sum(line["usd"] for line in bound_lines),
    }


def ttl_seconds(cfg: RunConfig, worst_s: float) -> float:
    if cfg.ttl_min == "auto":
        return worst_s + TTL_MARGIN_S
    ttl_s = int(cfg.ttl_min) * 60.0
    if ttl_s < worst_s:
        raise Refused(
            f"--ttl-min {cfg.ttl_min} is below the worst case of {math.ceil(worst_s / 60)} min"
        )
    return ttl_s


def estimate_rate(estimate: Estimate) -> float:
    """USD per hour of the fleet: the estimate's lines without the one-off egress."""
    usd = sum(line["usd"] for line in estimate["lines"] if line["item"] != "egress")
    return usd / (estimate["expected_s"] / 3600)


def image_label(cfg: RunConfig) -> str:
    return cfg.tag if cfg.allocator is None else f"{cfg.tag} ({cfg.allocator})"


def tag_changed(manifest: FleetManifest, cfg: RunConfig) -> bool:
    """`--tag` or `--allocator` differ from the fleet's; manifests from before `--allocator`
    lack it."""
    saved = manifest["config"]
    return cfg.tag != saved["tag"] or cfg.allocator != saved.get("allocator")


def estimate_run(manifest: FleetManifest, cfg: RunConfig) -> RunEstimate:
    expected_s, worst_s = run_seconds(cfg, tag_changed(manifest, cfg))
    rate = estimate_rate(manifest["estimate"])
    return {
        "expected_s": expected_s,
        "worst_s": worst_s,
        "usd_per_hour": rate,
        "expected_usd": rate * expected_s / 3600,
        "worst_usd": rate * worst_s / 3600,
    }


def estimate_instance_prices(estimate: Estimate) -> dict[str, float]:
    """The instance prices an estimate was made at, from its lines."""
    prefix = "instance "
    return {
        line["item"].removeprefix(prefix): line["usd_per_unit"]
        for line in estimate["lines"]
        if line["item"].startswith(prefix)
    }


def _cost_lines(
    hosts: list[HostSpec],
    duration_s: float,
    pg_volume: VolumeSpec | None,
    instance_prices: dict[str, float],
) -> list[CostLine]:
    """The pg volume, if any, bills at the root volumes' gp3 rates."""
    hours = duration_s / 3600
    lines: list[CostLine] = []
    by_type = Counter(host["instance_type"] for host in hosts)
    for instance_type, count in sorted(by_type.items()):
        lines.append(
            _line(
                f"instance {instance_type}",
                count * hours,
                "host-hour",
                instance_prices[instance_type],
            )
        )
    disks = [(h["root_gb"], h["root_iops"], h["root_mbps"]) for h in hosts]
    if pg_volume is not None:
        disks.append((pg_volume["gb"], pg_volume["iops"], pg_volume["mbps"]))
    gb_hours = sum(gb for gb, _, _ in disks) * hours
    lines.append(
        _line(
            "gp3 storage",
            gb_hours,
            "gb-hour",
            PRICES["gp3_gb_month_usd"] / HOURS_PER_MONTH,
        )
    )
    iops_hours = sum(max(0, iops - GP3_BASELINE_IOPS) for _, iops, _ in disks) * hours
    if iops_hours:
        lines.append(
            _line(
                "gp3 iops",
                iops_hours,
                "iops-hour",
                PRICES["gp3_iops_month_usd"] / HOURS_PER_MONTH,
            )
        )
    mbps_hours = sum(max(0, mbps - GP3_BASELINE_MBPS) for _, _, mbps in disks) * hours
    if mbps_hours:
        lines.append(
            _line(
                "gp3 throughput",
                mbps_hours,
                "mbps-hour",
                PRICES["gp3_mbps_month_usd"] / HOURS_PER_MONTH,
            )
        )
    ipv4_hours = len(hosts) * hours
    lines.append(
        _line("public ipv4", ipv4_hours, "host-hour", PRICES["public_ipv4_hour_usd"])
    )
    egress_gb = len(hosts) * EGRESS_MB_PER_HOST / 1024
    lines.append(_line("egress", egress_gb, "gb", PRICES["egress_gb_usd"]))
    return lines


def rds_cost_lines(rds: RdsSpec, duration_s: float) -> list[CostLine]:
    """RDS bills from create to delete, so the caller passes its own duration."""
    hours = duration_s / 3600
    return [
        _line(
            f"rds instance {rds['instance_class']}",
            hours,
            "hour",
            PRICES[rds["instance_class"]],
        ),
        _line(
            "rds gp3 storage",
            rds["gb"] * hours,
            "gb-hour",
            PRICES["rds_gp3_gb_month_usd"] / HOURS_PER_MONTH,
        ),
    ]


def _line(item: str, qty: float, unit: str, usd_per_unit: float) -> CostLine:
    return {
        "item": item,
        "qty": qty,
        "unit": unit,
        "usd_per_unit": usd_per_unit,
        "usd": qty * usd_per_unit,
    }


def format_estimate_summary(estimate: Estimate, max_usd: float) -> str:
    return (
        f"cost: expected ${estimate['expected_usd']:.2f} "
        f"({round(estimate['expected_s'] / 60)} min), "
        f"hard bound ${estimate['bound_usd']:.2f}, limit ${max_usd:.2f}"
    )


def format_search_summary(cfg: RunConfig) -> str:
    assert cfg.search
    search = cfg.search
    return (
        f"search from {nb.fmt_num(search.start_mb_s)} MB/s: climb x{nb.CLIMB_FACTOR:g}, "
        f"bisect to {nb.fmt_num(search.resolution_mb_s)} MB/s, confirm "
        f"{2 * cfg.load.step_s} s; at most {search.max_probes} probes, "
        f"{nb.fmt_num(search.offered_gb)} GB offered"
    )


def format_node_summary(cfg: RunConfig) -> list[str]:
    """Run settings that shape the nodes and Postgres and appear in no other preamble line."""

    validators = STORAGE_MODULES[cfg.consensus_storage, "validator"]
    # node0's first storage module backs consensus, its last the query service.
    node0 = STORAGE_MODULES[cfg.consensus_storage, "query"]
    return [
        f"storage validators: consensus {validators[0]}",
        (
            f"storage node0:      consensus {node0[0]}, query {node0[-1]} "
            f"({cfg.query_db})"
        ),
        (
            f"nodes: max block {cfg.max_block_size}; submit {cfg.load.submit_nodes} nodes; "
            f"leader-trace {'on' if cfg.leader_trace else 'off'}"
        ),
        f"node-env: {' '.join(cfg.node_env) or 'none'}",
    ]


def format_fleet_summary(estimate: Estimate, max_usd: float, expires: datetime) -> str:
    return (
        f"cost: fleet ${estimate_rate(estimate):.2f}/h, bound ${estimate['bound_usd']:.2f} "
        f"at TTL {round(estimate['ttl_s'] / 60)} min "
        f"(self-terminate {expires:%H:%M} UTC), limit ${max_usd:.2f}"
    )


def format_estimate_lines(estimate: Estimate) -> list[str]:
    return [
        f"  {line['item']}: {line['qty']:g} {line['unit']} @ ${line['usd_per_unit']:.4f} "
        f"= ${line['usd']:.2f}"
        for line in estimate["lines"]
    ]


def default_run_name(user: str, now: datetime) -> str:
    return f"{user}-{now.strftime('%Y%m%d-%H%M%S')}"


def new_fleet_dir(system: System, out_root: Path) -> Path:
    name = default_run_name(system.user(), utc_now(system.clock))
    if not NAME_RE.match(name):
        raise Refused(f"fleet name must match {NAME_RE.pattern}: {name!r}")
    fleet_dir = out_root / name
    if fleet_dir.exists():
        raise Refused(f"fleet {name} already exists at {fleet_dir}")
    fleet_dir.mkdir(parents=True)
    return fleet_dir


def new_run_dir(fleet_dir: Path, name: str) -> Path:
    run_dir = fleet_dir / RUNS_DIR / f"{len(run_dirs(fleet_dir)) + 1:02d}-{name}"
    run_dir.mkdir(parents=True)
    return run_dir


def run_index(run_dir: Path) -> int:
    return int(run_dir.name.partition("-")[0])


def fleet_of(run_dir: Path) -> Path:
    if run_dir.parent.name != RUNS_DIR:
        raise Refused(
            f"{run_dir} is not a run dir: expected <fleet>/{RUNS_DIR}/<nn>-<name>"
        )
    return run_dir.parent.parent


def setup_logging(directory: Path) -> None:
    for handler in list(log.handlers):
        log.removeHandler(handler)
        handler.close()
    log.setLevel(logging.DEBUG)
    log.propagate = False
    file_handler = logging.FileHandler(directory / "driver.log")
    file_handler.setLevel(logging.DEBUG)
    file_handler.setFormatter(
        logging.Formatter("%(asctime)s %(levelname)s %(message)s")
    )
    log.addHandler(file_handler)
    stream_handler = logging.StreamHandler(sys.stderr)
    stream_handler.setLevel(logging.INFO)
    stream_handler.setFormatter(logging.Formatter("%(message)s"))
    log.addHandler(stream_handler)


def append_event(directory: Path, phase: str, event: str, detail: str | None) -> None:
    record = {
        "ts": stamp(),
        "phase": phase,
        "event": event,
        "detail": detail,
    }
    with (directory / "events.jsonl").open("a") as f:
        f.write(json.dumps(record) + "\n")


def config_to_json(cfg: RunConfig) -> dict[str, Any]:
    data = dataclasses.asdict(cfg)
    data["fleet"] = None if cfg.fleet is None else str(cfg.fleet)
    return data


def write_fleet_manifest(
    fleet_dir: Path,
    cfg: RunConfig,
    hosts: list[HostSpec],
    peers_by_node: dict[str, list[str]],
    estimate: Estimate,
    phase: str,
    argv: list[str],
) -> FleetManifest:
    fleet: FleetManifest = {
        "name": fleet_dir.name,
        "created_at": stamp(),
        "argv": argv,
        "config": config_to_json(cfg),
        "hosts": hosts,
        "peers": peers_by_node,
        "phase": phase,
        "estimate": estimate,
        "db_modes": list(cfg.db_modes),
    }
    volume = pg_volume_spec(cfg)
    if volume is not None:
        fleet["pg_volume"] = volume
    nb.write_json(fleet_dir / FLEET_JSON, fleet)
    append_event(fleet_dir, phase, "manifest-written", None)
    return fleet


def build_run_manifest(
    fleet: FleetManifest,
    cfg: RunConfig,
    index: int,
    config_hash: str,
    run_estimate: RunEstimate | None,
    argv: list[str],
) -> Manifest:
    """A copy of the fleet manifest, so that `render` needs only the run dir, plus what is
    specific to this measurement."""
    manifest: Manifest = {
        **fleet,
        "config": config_to_json(cfg),
        "created_at": stamp(),
        "phase": "planned",
        "fleet": fleet["name"],
        "index": index,
        "query_db": cfg.query_db,
        "config_hash": config_hash,
        "argv": sanitize_argv(argv),
    }
    if run_estimate is not None:
        manifest["run_estimate"] = run_estimate
    if cfg.fleet is not None:
        manifest["fleet_argv"] = sanitize_argv(fleet["argv"])
    return manifest


def update_manifest(path: Path, phase: str, **extra: Any) -> Manifest:
    """Advances the `phase` of a `fleet.json` or run `manifest.json` and merges in whatever
    the caller now knows (`az`, `hosts_info`, `start_spread_s`, ...); every previous key is
    kept. The event lands in the `events.jsonl` next to the file."""
    merged: dict[str, Any] = {**nb.read_json(path), "phase": phase}
    merged.update(extra)
    nb.write_json(path, merged)
    append_event(path.parent, phase, "manifest-written", None)
    return cast(Manifest, merged)


def tools_on_path(which: Which, names: Iterable[str]) -> None:
    missing = [name for name in names if which(name) is None]
    if missing:
        raise Refused(f"missing tools on PATH: {', '.join(missing)}")


def caller_account(run: Runner, region: str) -> str:
    """The account guard: the first AWS call preflight makes, so a mismatch is caught before
    any other `aws` call (a wrong profile must never touch the right account by accident)."""
    account = aws_json(run, "sts", "get-caller-identity", region=region)["Account"]
    if account != ACCOUNT:
        raise Refused(
            f"caller account {account} is not {ACCOUNT}: is profile {PROFILE} the benchmark "
            f"account's?"
        )
    return account


def resolve_ami(run: Runner, region: str, arch: Arch) -> str:
    ami_id = aws_json(
        run,
        "ec2",
        "describe-images",
        "--owners",
        UBUNTU_OWNER_ID,
        "--filters",
        f"Name=name,Values=ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-{arch}-server-*",
        "--query",
        "sort_by(Images, &CreationDate)[-1].ImageId",
        region=region,
    )
    if ami_id is None:
        raise Refused(f"no Ubuntu 24.04 {arch} AMI found in {region}")
    return ami_id


def instance_specs(
    run: Runner, region: str, types: set[str]
) -> tuple[Arch, dict[str, int]]:
    """The one architecture every type runs, as Ubuntu and OCI name it, and the memory in MiB
    of each type."""
    described = aws_json(
        run,
        "ec2",
        "describe-instance-types",
        "--instance-types",
        *sorted(types),
        region=region,
    )["InstanceTypes"]
    memory = {t["InstanceType"]: t["MemoryInfo"]["SizeInMiB"] for t in described}
    archs = {
        t["InstanceType"]: {
            EC2_ARCHS[a]
            for a in t["ProcessorInfo"]["SupportedArchitectures"]
            if a in EC2_ARCHS
        }
        for t in described
    }
    distinct = {arch for found in archs.values() for arch in found}
    if len(distinct) != 1 or any(len(a) != 1 for a in archs.values()):
        listed = ", ".join(
            f"{t} {'/'.join(sorted(a))}" for t, a in sorted(archs.items())
        )
        raise Refused(f"instance types must share one architecture: {listed}")
    return distinct.pop(), memory


def instance_price(run: Runner, region: str, instance_type: str) -> float:
    """On-demand Linux USD per hour of `instance_type` in `region`, from the Pricing API."""
    filters = {
        "instanceType": instance_type,
        "regionCode": region,
        "operatingSystem": "Linux",
        "tenancy": "Shared",
        "preInstalledSw": "NA",
        "capacitystatus": "Used",
    }
    listed = aws_json(
        run,
        "pricing",
        "get-products",
        "--service-code",
        "AmazonEC2",
        "--filters",
        *(f"Type=TERM_MATCH,Field={k},Value={v}" for k, v in filters.items()),
        region=PRICING_REGION,
    )["PriceList"]
    if len(listed) != 1:
        raise Refused(
            f"{instance_type} in {region}: {len(listed)} on-demand Linux prices, expected 1"
        )
    (term,) = json.loads(listed[0])["terms"]["OnDemand"].values()
    (dimension,) = term["priceDimensions"].values()
    return float(dimension["pricePerUnit"]["USD"])


def fetch_prices(run: Runner, region: str, types: set[str]) -> dict[str, float]:
    return {t: instance_price(run, region, t) for t in sorted(types)}


def capable_az(run: Runner, region: str, types: set[str]) -> str:
    az_sets = []
    for instance_type in sorted(types):
        offerings = aws_json(
            run,
            "ec2",
            "describe-instance-type-offerings",
            "--location-type",
            "availability-zone",
            "--filters",
            f"Name=instance-type,Values={instance_type}",
            region=region,
        )["InstanceTypeOfferings"]
        az_sets.append({o["Location"] for o in offerings})
    capable = set.intersection(*az_sets) if az_sets else set()
    if not capable:
        raise Refused(
            f"no AZ in {region} offers every instance type: {', '.join(sorted(types))}"
        )
    return min(capable)


def image_refs(cfg: RunConfig, postgres_tag: str | None = None) -> dict[str, str]:
    """`postgres_tag` pins the container to the minor RDS runs, so both placements run the
    same one."""
    images = {c: f"{GHCR_ORG}/{c}:{cfg.tag}" for c in IMAGE_COMPONENTS}
    if cfg.allocator is not None:
        images["espresso-node"] = f"{ALLOC_REPOSITORY}:{cfg.tag}-{cfg.allocator}"
    images.update(SUPPORT_IMAGES)
    if postgres_tag is not None:
        repository = SUPPORT_IMAGES["postgres"].rpartition(":")[0]
        images["postgres"] = f"{repository}:{postgres_tag}"
    return images


def resolve_images(
    http_get: HttpGet, cfg: RunConfig, rds_minor: str | None, arch: Arch
) -> dict[str, ImageInfo]:
    return {
        name: resolve_image(http_get, ref, f"linux/{arch}")
        for name, ref in image_refs(cfg, rds_minor).items()
    }


def rds_orderable(run: Runner, cfg: RunConfig, az: str) -> str:
    """The highest engine minor of `RDS_ENGINE_VERSION` that `RDS_CLASS` can run on gp3 in
    `az`."""
    options = aws_json(
        run,
        "rds",
        "describe-orderable-db-instance-options",
        "--engine",
        "postgres",
        "--db-instance-class",
        RDS_CLASS,
        region=cfg.region,
    )["OrderableDBInstanceOptions"]
    versions = [
        option["EngineVersion"] for option in options if _rds_option_fits(option, az)
    ]
    if not versions:
        raise Refused(
            f"{RDS_CLASS} cannot run postgres {RDS_ENGINE_VERSION} on {PG_GB} GiB gp3 with "
            f"{cfg.pg_iops} IOPS and {cfg.pg_mbps} MiB/s in {az}"
        )
    return max(versions, key=lambda v: tuple(int(part) for part in v.split(".")))


def _rds_option_fits(option: dict[str, Any], az: str) -> bool:
    return (
        option["EngineVersion"].startswith(f"{RDS_ENGINE_VERSION}.")
        and option["StorageType"] == "gp3"
        and az in {zone["Name"] for zone in option["AvailabilityZones"]}
    )


def parse_ref(ref: str) -> tuple[str, str, str]:
    """`registry/repository:tag` -> (registry API host, repository, tag)."""
    host, _, rest = ref.partition("/")
    repository, _, tag = rest.rpartition(":")
    # The docker.io registry API is only served at registry-1.docker.io.
    return "registry-1.docker.io" if host == "docker.io" else host, repository, tag


def _http_get(url: str, headers: dict[str, str]) -> HttpReply:
    def once() -> HttpReply:
        request = urllib.request.Request(url, headers=headers, method="GET")
        try:
            with urllib.request.urlopen(request, timeout=10) as response:
                reply_headers = cast(Mapping[str, str], response.headers)
                return response.status, reply_headers, response.read()
        except urllib.error.HTTPError as exc:
            with exc:
                return exc.code, cast(Mapping[str, str], exc.headers), exc.read()

    for _ in range(REGISTRY_GET_ATTEMPTS - 1):
        try:
            return once()
        except (urllib.error.URLError, TimeoutError) as exc:
            log.warning("GET %s failed (%s), retrying", url, exc)
    return once()


def _bearer_token(http_get: HttpGet, www_authenticate: str, ref: str) -> str:
    params = dict(re.findall(r'(\w+)="([^"]*)"', www_authenticate))
    realm = params["realm"]
    query = urllib.parse.urlencode({k: v for k, v in params.items() if k != "realm"})
    status, _, body = http_get(f"{realm}?{query}", {})
    if status != 200:
        raise Refused(f"token request for {ref} to {realm} failed with status {status}")
    token = json.loads(body)
    return token["token"] if "token" in token else token["access_token"]


def resolve_image(http_get: HttpGet, ref: str, platform: str) -> ImageInfo:
    """Anonymous token challenge, then the manifest (an index for a multi-arch image, or a
    single manifest otherwise) and its config blob, for the digest of `platform` (e.g.
    `linux/arm64`) and the `org.opencontainers.image.revision` label. Works against ghcr and
    docker hub unmodified: both implement the same OCI distribution spec."""
    host, repository, tag = parse_ref(ref)
    base = f"https://{host}/v2/{repository}"
    manifest_url = f"{base}/manifests/{tag}"
    headers = {"Accept": ", ".join(MANIFEST_MEDIA_TYPES)}
    status, resp_headers, body = http_get(manifest_url, headers)
    if status == 401:
        headers["Authorization"] = (
            f"Bearer {_bearer_token(http_get, resp_headers['WWW-Authenticate'], ref)}"
        )
        status, resp_headers, body = http_get(manifest_url, headers)
    if status == 404:
        raise Refused(f"image not found: {ref}")
    if status in (401, 403):
        raise Refused(
            f"image is private or inaccessible anonymously: {ref} (status {status})"
        )
    if status != 200:
        raise Refused(f"unexpected status {status} resolving {ref}")
    manifest = json.loads(body)
    media_type = manifest.get("mediaType", resp_headers.get("Content-Type", ""))
    if media_type in INDEX_MEDIA_TYPES:
        # buildx attestations (SBOM, provenance) show up as extra manifests with
        # platform.os == "unknown" and must not be mistaken for a real platform.
        entries = [m for m in manifest["manifests"] if m["platform"]["os"] != "unknown"]
        platforms = [
            f"{m['platform']['os']}/{m['platform']['architecture']}" for m in entries
        ]
        if platform not in platforms:
            raise Refused(
                f"no {platform} platform for {ref}: has {', '.join(platforms)}"
            )
        digest = entries[platforms.index(platform)]["digest"]
        child_status, _, child_body = http_get(f"{base}/manifests/{digest}", headers)
        if child_status != 200:
            raise Refused(
                f"failed to fetch the {platform} manifest for {ref}: status {child_status}"
            )
        config_digest = json.loads(child_body)["config"]["digest"]
    else:
        digest = resp_headers["Docker-Content-Digest"]
        config_digest = manifest["config"]["digest"]
        platforms = []
    status, _, config_body = http_get(f"{base}/blobs/{config_digest}", headers)
    if status != 200:
        raise Refused(f"failed to fetch the config blob for {ref}: status {status}")
    config = json.loads(config_body)
    if not platforms:
        single = f"{config['os']}/{config['architecture']}"
        if single != platform:
            raise Refused(f"no {platform} platform for {ref}: has {single}")
        platforms = [single]
    revision = (config.get("config", {}).get("Labels") or {}).get(
        "org.opencontainers.image.revision"
    )
    return {"ref": ref, "digest": digest, "revision": revision, "platforms": platforms}


def preflight(system: System, cfg: RunConfig, hosts: list[HostSpec]) -> Preflight:
    run = system.run
    tools_on_path(
        system.which, ["tofu", "aws", "ssh", "scp", "rsync", "git", "ssh-keygen"]
    )
    account = caller_account(run, cfg.region)
    types = {h["instance_type"] for h in hosts}
    arch, memory_mib = instance_specs(run, cfg.region, types)
    if cfg.tcp_cc == "bbr3" and arch != "amd64":
        raise Refused("--tcp-cc bbr3 needs the XanMod kernel, which is x86_64 only")
    prices = fetch_prices(run, cfg.region, types)
    az = capable_az(run, cfg.region, types)
    ami_id = resolve_ami(run, cfg.region, arch)
    rds_minor = rds_orderable(run, cfg, az) if "rds" in cfg.db_modes else None
    images = resolve_images(system.http_get, cfg, rds_minor, arch)
    pre: Preflight = {
        "account": account,
        "az": az,
        "arch": arch,
        "memory_mib": memory_mib,
        "instance_prices": prices,
        "ami_id": ami_id,
        "images": images,
    }
    if rds_minor is not None:
        pre["rds_engine_version"] = rds_minor
    return pre


def terraform_env() -> dict[str, str]:
