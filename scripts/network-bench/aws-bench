def add_account_flags(parser: argparse.ArgumentParser) -> None:
    """For `status --all` and `destroy --orphans`, which have no manifest to read them from."""
    defaults = RunConfig(tag="")
    parser.add_argument("--region", default=defaults.region)
    parser.add_argument("--profile", default=defaults.profile)
    parser.add_argument("--account", default=defaults.account)
    parser.add_argument("--out-root", type=Path, default=defaults.out_root)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", required=True)

    plan_p = sub.add_parser(
        "plan",
        help="render the run dir and print the cost estimate",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    add_run_flags(plan_p)
    plan_p.add_argument("--offline", action="store_true", help="use no AWS credentials")
    plan_p.set_defaults(func=cmd_plan, yes=False, keep=False, allow_dirty=False)

    run_p = sub.add_parser(
        "run",
        help="plan, confirm, provision, load, measure, collect, destroy",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    add_run_flags(run_p)
    run_p.add_argument("--yes", action="store_true")
    run_p.add_argument(
        "--keep", action="store_true", help="skip destroy; the TTL still applies"
    )
    run_p.add_argument("--allow-dirty", action="store_true")
    run_p.set_defaults(func=cmd_run, offline=False)

    status_p = sub.add_parser(
        "status", help="list tagged resources or one run's progress"
    )
    status_p.add_argument("dir", type=Path, nargs="?")
    status_p.add_argument("--all", action="store_true")
    add_account_flags(status_p)
    status_p.set_defaults(func=cmd_status)

    collect_p = sub.add_parser(
        "collect", help="re-collect logs and samples from live hosts"
    )
    collect_p.add_argument("dir", type=Path)
    collect_p.set_defaults(func=cmd_collect)

    render_p = sub.add_parser(
        "render", help="re-analyze a run dir and rewrite its summary"
    )
    render_p.add_argument("dir", type=Path)
    render_p.add_argument("--baseline", type=Path)
    render_p.set_defaults(func=cmd_render)

    destroy_p = sub.add_parser(
        "destroy", help="tear down a run's fleet, or sweep orphans"
    )
    destroy_p.add_argument("dir", type=Path, nargs="?")
    destroy_p.add_argument("--orphans", action="store_true")
    destroy_p.add_argument("--yes", action="store_true")
    add_account_flags(destroy_p)
    destroy_p.set_defaults(func=cmd_destroy)

    agent_drive_p = sub.add_parser("agent-drive", help="ctl only: run the load driver")
    agent_drive_p.add_argument("config", type=Path)
    agent_drive_p.add_argument("out", type=Path)
    agent_drive_p.set_defaults(func=cmd_agent_drive)

    agent_host_p = sub.add_parser(
        "agent-host", help="every host: sample /proc and cgroups"
    )
    agent_host_p.add_argument("out", type=Path)
    agent_host_p.add_argument(
        "--role", required=True, choices=("ctl", "query", "validator")
    )
    agent_host_p.set_defaults(func=cmd_agent_host)

    return parser.parse_args(argv)


def cmd_plan(
    args: argparse.Namespace,
    run: Runner = _run,
    which: Callable[[str], str | None] = shutil.which,
) -> int:
    cfg = config_from_args(args)
    now = time.time()
    if cfg.offline:
        run_dir = new_run_dir(cfg.out_root, cfg.name)
        setup_logging(run_dir)
        log.debug("argv %s", args.argv)
        hosts = plan_hosts(cfg)
        estimate = estimate_or_refuse(
            run, cfg, hosts, region_minor_prices(cfg.region), run_dir, now
        )
        render_run_dir(
            run, cfg, run_dir, hosts, offline_preflight(cfg), estimate, args.argv, which
        )
    else:
        run_dir, _, _, _ = plan_fleet(args, cfg, run, now)
    log.info("rendered %s (phase=planned)", run_dir)
    return EXIT_OK


def offline_preflight(cfg: RunConfig) -> Preflight:
    """Placeholders for what `preflight` reads from AWS and the registry, so that `plan --offline`
    renders every file."""
    placeholder = "sha256:" + "0" * 64
    images: dict[str, ImageInfo] = {
        name: {
            "ref": ref,
            "digest": placeholder,
            "revision": None,
            "platforms": ["linux/arm64"],
        }
        for name, ref in image_refs(cfg).items()
    }
    return {
        "account": cfg.account,
        "vpc_id": "",
        "az": "",
        "ami_id": "",
        "images": images,
        "vcpu_needed": 0,
        "vcpu_in_use": 0,
        "vcpu_quota": 0.0,
        "git_diff": None,
    }


def estimate_or_refuse(
    run: Runner,
    cfg: RunConfig,
    hosts: list[HostSpec],
    minor: dict[str, float],
    run_dir: Path,
    now: float,
) -> Estimate:
    prices = resolve_prices(run, cfg, cfg.out_root / "prices.json", now)
    estimate = estimate_cost(hosts, cfg, prices, minor)
    log.info(format_estimate_summary(estimate, cfg.max_usd))
    for line in format_estimate_lines(estimate):
        log.debug(line)
    if estimate["bound_usd"] > cfg.max_usd:
        append_event(
            run_dir,
            "planned",
            "refused",
            f"bound ${estimate['bound_usd']:.2f} exceeds --max-usd ${cfg.max_usd:.2f}",
        )
        raise Refused(
            f"hard bound ${estimate['bound_usd']:.2f} exceeds --max-usd "
            f"${cfg.max_usd:.2f}; pass --max-usd {estimate['bound_usd']:.2f} or shrink the run"
        )
    return estimate


class Interrupts:
    """The first SIGINT/SIGTERM/SIGHUP sets `event`; `check` turns it into `Interrupted` at the
    next phase boundary or wait, so a `tofu apply` or rsync in flight always finishes. After
    `disarm` signals are logged and ignored, except that the third one sets `skip_collect`."""

    def __init__(self) -> None:
        self.event = threading.Event()
        self.skip_collect = threading.Event()
        self.signals = 0
        self.armed = True
        self.phase = "starting"

    def install(self) -> None:
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, self._handle)

    def _handle(self, signum: int, frame: Any) -> None:
        self.signals += 1
        if self.signals >= SKIP_COLLECT_SIGNALS:
            self.skip_collect.set()
            log.warning("signal %d: skipping the rest of the collection", signum)
        elif not self.armed:
            log.warning("signal %d ignored: teardown in progress", signum)
        elif self.event.is_set():
            log.warning("still waiting for the current step (%s)", self.phase)
        else:
            self.event.set()
            log.warning(
                "interrupt received; stopping after the current step (%s)", self.phase
            )

    def check(self) -> None:
        if self.armed and self.event.is_set():
            raise Interrupted("interrupted")

    def sleep(self, seconds: float) -> None:
        if not self.armed:
            time.sleep(seconds)
            return
        self.event.wait(seconds)
        self.check()

    def disarm(self) -> None:
        self.armed = False


class Remote:
    """ssh and rsync to the fleet through the injectable Runner. ControlMaster sockets live in
    `<run>/ssh/` and host keys in `<run>/known_hosts`. Pass `run_dir` relative (as `out_root`
    is by default): an absolute path can exceed the 104 byte unix socket limit."""

    def __init__(
        self, run: Runner, run_dir: Path, ssh_key: Path, hosts: dict[str, HostInfo]
    ):
        self.run = run
        self.hosts = hosts
        (run_dir / "ssh").mkdir(exist_ok=True)
        self.ssh_opts = [
            "-i",
            str(ssh_key.expanduser()),
            "-o",
            "ControlMaster=auto",
            "-o",
            "ControlPersist=10m",
            "-o",
            f"ControlPath={run_dir / 'ssh' / '%C'}",
            "-o",
            f"UserKnownHostsFile={run_dir / 'known_hosts'}",
            "-o",
            "StrictHostKeyChecking=accept-new",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=10",
            "-o",
            "ServerAliveInterval=15",
            "-o",
            "ServerAliveCountMax=4",
        ]

    def _target(self, host: str) -> str:
        return f"{SSH_USER}@{self.hosts[host]['public_ip']}"

    def ssh(
        self, host: str, command: str, check: bool = True
    ) -> subprocess.CompletedProcess[str]:
        result = self.run(["ssh", *self.ssh_opts, self._target(host), command])
        if check and result.returncode != 0:
            raise RemoteError(
                f"{host}: `{command}` exited {result.returncode}: {result.stderr.strip()}"
            )
        return result

    def rsync_to(self, host: str, sources: list[Path], dest: str) -> None:
        self._rsync(host, [*map(str, sources), f"{self._target(host)}:{dest}"])

    def rsync_from(self, host: str, remote: str, local: Path, *flags: str) -> None:
        local.mkdir(parents=True, exist_ok=True)
        self._rsync(host, [*flags, f"{self._target(host)}:{remote}", str(local)])

    def _rsync(self, host: str, args: list[str]) -> None:
        # sudo on the far side: /opt/bench is root-owned.
        result = self.run(
            [
                "rsync",
                "-az",
                "-e",
                shlex.join(["ssh", *self.ssh_opts]),
                "--rsync-path",
                "sudo rsync",
                f"--timeout={RSYNC_IO_TIMEOUT_S}",
                *args,
            ]
        )
        if result.returncode != 0:
            raise RemoteError(f"{host}: rsync failed: {result.stderr.strip()}")

    def parallel(
        self, fn: Callable[[str], _T], names: Iterable[str], workers: int | None = None
    ) -> dict[str, _T]:
        """`fn(name)` for every name on a pool of `workers` (default REMOTE_POOL_SIZE) threads.
        Waits for all, then raises the first failure."""
        names = list(names)
        size = workers or REMOTE_POOL_SIZE
        with ThreadPoolExecutor(min(size, max(1, len(names)))) as pool:
            futures = {name: pool.submit(fn, name) for name in names}
        return {name: future.result() for name, future in futures.items()}


@dataclass
class Fleet:
    """One run's mutable state after `tofu apply` was reached. `error` is set by whichever phase
    failed first; `interrupted` marks a Ctrl-C, which also asks before destroying."""

    run: Runner
    cfg: RunConfig
    run_dir: Path
    tf: Terraform
    interrupts: Interrupts
    started: float
    remote: Remote | None = None
    agent: AgentState | None = None
    agent_started: bool = False
    error: str | None = None
    interrupted: bool = False

    @property
    def manifest(self) -> Manifest:
        return nb.read_json(self.run_dir / "manifest.json")


def prompt_destroy(timeout_s: float) -> bool:
    """Default yes: an unattended run still tears down."""
    if not sys.stdin.isatty():
        return True
    print(
        f"Destroy the fleet now? [Y/n] (yes in {timeout_s:.0f} s) ", end="", flush=True
    )
    ready, _, _ = select.select([sys.stdin], [], [], timeout_s)
    return not ready or sys.stdin.readline().strip().lower() != "n"


def cmd_run(
    args: argparse.Namespace,
    run: Runner = _run,
    interrupts: Interrupts | None = None,
    ask_destroy: Callable[[float], bool] = prompt_destroy,
) -> int:
    cfg = config_from_args(args)
    started = time.time()
    try:
        run_dir, tf = prepare_run(args, cfg, run, started)
    except KeyboardInterrupt:
        raise Refused("interrupted; nothing was created") from None
    if interrupts is None:
        interrupts = Interrupts()
        interrupts.install()
    try:
        fleet = Fleet(run, cfg, run_dir, tf, interrupts, started)
        measure(fleet)
        try:
            result = finish(fleet)
        except (
            Exception
        ) as exc:  # the fleet costs money until teardown, whatever failed
            log.exception("finish failed")
            fleet.error = fleet.error or f"finish failed: {type(exc).__name__}: {exc}"
            result = None
        return teardown(fleet, result, ask_destroy)
    except Exception:
        log.exception("unexpected error")
        log.error(LEFTOVER_MESSAGE, run_dir)
        return EXIT_LEFTOVER


def prepare_run(
    args: argparse.Namespace, cfg: RunConfig, run: Runner, started: float
) -> tuple[Path, Terraform]:
    """Everything before the first AWS write: `plan_fleet` and the prompt. Any failure or
    Ctrl-C leaves nothing to destroy."""
    run_dir, tf, hosts, _ = plan_fleet(args, cfg, run, started)
    prompt = (
        f"Create {len(hosts)} instances, 1 security group, 1 key pair in {cfg.account}?"
    )
    if not confirm(prompt, cfg.yes, sys.stdin.isatty()):
        append_event(run_dir, "planned", "refused", "not confirmed")
        raise Refused("not confirmed; nothing was created")
    stamp_expiry(run_dir, tf, datetime.now(UTC))
    return run_dir, tf


def stamp_expiry(run_dir: Path, tf: Terraform, confirmed_at: datetime) -> None:
    """The `espresso-bench-expires` tag counts from the apply, not from the render: a run that
    waited at the prompt must not look expired. Re-plans because a plan file fixes variables."""
    manifest: Manifest = nb.read_json(run_dir / "manifest.json")
    expires = confirmed_at + timedelta(
        seconds=manifest["estimate"]["ttl_s"] + PROVISION_S
    )
    stamp = expires.strftime("%Y-%m-%dT%H:%M:%SZ")
    tfvars_path = run_dir / "terraform" / "terraform.tfvars.json"
    tfvars = nb.read_json(tfvars_path)
    nb.write_json(tfvars_path, {**tfvars, "expires_at": stamp})
    update_manifest(run_dir, manifest["phase"], expires_at=stamp)
    tf.plan()


def plan_fleet(
    args: argparse.Namespace, cfg: RunConfig, run: Runner, now: float
) -> tuple[Path, Terraform, list[HostSpec], Preflight]:
    """Preflight, cost check, render, `tofu init` and `plan`. Shared by `plan` and `run`; makes
    no AWS write. The preflight summary is logged before the cost line."""
    minor = region_minor_prices(cfg.region)
    hosts = plan_hosts(cfg)
    run_dir = new_run_dir(cfg.out_root, cfg.name)
    setup_logging(run_dir)
    log.debug("argv %s", args.argv)
    pre = preflight(run, cfg, hosts)
    log_preflight(cfg, pre, hosts)
    estimate = estimate_or_refuse(run, cfg, hosts, minor, run_dir, now)
    render_run_dir(run, cfg, run_dir, hosts, pre, estimate, args.argv)
    tf = Terraform(run, cfg.tf, run_dir / "terraform", terraform_env())
    tf.init()
    (run_dir / "terraform" / "plan.txt").write_text(tf.plan())
    return run_dir, tf, hosts, pre


def enter_phase(fleet: Fleet, name: str, message: str) -> None:
    fleet.interrupts.check()
    fleet.interrupts.phase = name
    update_manifest(fleet.run_dir, name)
    log.info("%s: %s", name, message)


def measure(fleet: Fleet) -> None:
    """Everything from `tofu apply` to the end of the load. Never raises: a failure is recorded
    in `fleet.error` so that `finish` and `teardown` always run against the live fleet."""
    try:
        enter_phase(fleet, "applying", "tofu apply")
        fleet.tf.apply()
        remote = connect(fleet)
        manifest = fleet.manifest
        enter_phase(
            fleet, "waiting-hosts", f"ssh and cloud-init on {len(remote.hosts)} hosts"
        )
        wait_hosts(remote, manifest, fleet.run_dir, fleet.interrupts)
        enter_phase(fleet, "shipping", "files, host monitors, containers")
        ship(remote, fleet.run_dir)
        start_hostmon(remote)
        create_containers(remote)
        enter_phase(fleet, "services", "anvil, deploy, orchestrator, relay, postgres")
        start_support(remote, genesis_contracts(fleet.run_dir), fleet.interrupts)
        enter_phase(fleet, "nodes", "synchronized docker start")
        at = fleet_time(remote) + DOCKER_START_LEAD_S
        spread = start_nodes(remote, node_hosts(remote.hosts), at)
        update_manifest(fleet.run_dir, "measuring", start_spread_s=spread)
        log.info("measuring: nodes started within %.2f s of each other", spread)
        start_agent(remote)
        fleet.agent_started = True
        fleet.agent = poll_agent(remote, fleet.run_dir, fleet.cfg, fleet.interrupts)
    except Interrupted:
        fleet.interrupted = True
        fleet.error = "interrupted"
        log.error("interrupted")
    except (TfFailed, RemoteError, nb.NetworkError) as exc:
        fleet.error = str(exc)
        log.error("error: %s", exc)
    except Exception as exc:  # the fleet costs money until teardown, whatever failed
        log.exception("unexpected error")
        fleet.error = f"{type(exc).__name__}: {exc}"


def connect(fleet: Fleet) -> Remote:
    manifest = fleet.manifest
    hosts_info = parse_hosts_output(fleet.tf.output(), manifest["hosts"])
    nb.write_json(fleet.run_dir / "hosts.json", hosts_info)
    update_manifest(fleet.run_dir, "provisioned", hosts_info=hosts_info)
    render_host_files(fleet.run_dir, fleet.cfg, manifest, hosts_info)
    fleet.remote = Remote(
        fleet.run,
        fleet.run_dir,
        ssh_key_path(fleet.cfg.ssh_key, fleet.run_dir),
        hosts_info,
    )
    return fleet.remote


def finish(fleet: Fleet) -> nb.BenchResult | None:
    """Stops the load if it still runs, freezes and collects every host, then reports. Signals
    are ignored from here on: teardown must not be cut short."""
    fleet.interrupts.disarm()
    remote = fleet.remote
    if remote is not None:
        update_manifest(fleet.run_dir, "collecting")
        log.info("collecting: stop, freeze, logs, host samples, final rsync")

        def step(what: str, action: Callable[[], object]) -> None:
            if fleet.interrupts.skip_collect.is_set():
                log.warning("%s skipped", what)
            else:
                best_effort(what, action)

        if fleet.error is not None:
            step("stop agent", lambda: stop_agent(remote))
        step("freeze", lambda: freeze(remote))
        step(
            "collect",
            lambda: collect_hosts(remote, list(remote.hosts.values()), fleet.run_dir),
        )
        if fleet.agent_started:
            step(
                "final rsync",
                lambda: remote.rsync_from("ctl", f"{BENCH_DIR}/out/", fleet.run_dir),
            )
    return report(fleet)


def best_effort(what: str, action: Callable[[], object]) -> None:
    """Collection runs against a fleet that is about to be destroyed: one unreachable host
    must not stop the others. Missing files surface as `check_validity_aws` findings."""
    try:
        action()
    except RemoteError as exc:
        log.warning("%s failed: %s", what, exc)
    except Exception:
        log.exception("%s failed unexpectedly", what)


def report(fleet: Fleet) -> nb.BenchResult | None:
    # A driver-side error after the load finished still leaves a complete run to analyze.
    fleet.agent = fleet.agent or finished_agent_state(fleet.run_dir)
    if fleet.agent is not None:
        try:
            write_run_json(fleet)
            result = write_report(fleet.run_dir)
        except Exception as exc:
            log.exception("report failed")
            fleet.error = f"report failed: {type(exc).__name__}: {exc}"
        else:
            log_result(result)
            return result
    write_failure_summary(fleet.run_dir, fleet.manifest, fleet.error)
    return None


def log_result(result: nb.BenchResult) -> None:
    log.info(nb.status_line(result))
    log.info(nb.capacity_line(result["capacity"]).replace("**", ""))


def teardown(
    fleet: Fleet, result: nb.BenchResult | None, ask_destroy: Callable[[float], bool]
) -> int:
    """Always attempts the destroy. An exception in the bookkeeping afterwards is logged and
    leaves the exit code to the result if the destroy worked, else to `EXIT_LEFTOVER`."""
    run_dir = fleet.run_dir
    best_effort("mark destroying", lambda: update_manifest(run_dir, "destroying"))
    destroyed = False
    try:
        destroyed = destroy_unless_kept(fleet, ask_destroy)
        code = record_outcome(fleet, result, destroyed)
    except Exception:
        log.exception("teardown failed")
        code = exit_code(fleet, result, destroyed)
    if not destroyed:
        log.error(LEFTOVER_MESSAGE, run_dir)
    return code


def destroy_unless_kept(fleet: Fleet, ask_destroy: Callable[[float], bool]) -> bool:
    if fleet.cfg.keep:
        log.info(
            "--keep: fleet stays up until its TTL, ssh key kept; then run: aws-bench destroy %s",
            fleet.run_dir,
        )
        return False
    if fleet.cfg.yes or not fleet.interrupted or ask_destroy(DESTROY_PROMPT_TIMEOUT_S):
        log.info("destroying: tofu destroy")
        return destroy_fleet(fleet)
    return False


def record_outcome(fleet: Fleet, result: nb.BenchResult | None, destroyed: bool) -> int:
    cfg, run_dir = fleet.cfg, fleet.run_dir
    cost = None
    if destroyed:
        remove_ssh_key(cfg.ssh_key, run_dir)
        cost = final_cost(fleet)
    code = exit_code(fleet, result, destroyed)
    update_manifest(run_dir, "done" if destroyed else "left-running")
    append_index(cfg.out_root, fleet.manifest, result, code, destroyed, cost)
    if cost is not None:
        log.info(
            "destroyed; actual cost $%.2f (bound $%.2f); run dir %s",
            cost["actual"],
            cost["bound"],
            run_dir,
        )
    return code


def exit_code(fleet: Fleet, result: nb.BenchResult | None, fleet_gone: bool) -> int:
    if not fleet_gone:
        return EXIT_LEFTOVER
    if fleet.error is not None or result is None:
        return EXIT_FAILED
    return EXIT_OK if result["validity"]["valid"] else EXIT_INVALID


def final_cost(fleet: Fleet) -> dict[str, float] | None:
    try:
        cost = actual_cost(fleet.run, fleet.manifest)
    except (RemoteError, ValueError) as exc:
        log.warning("actual cost unavailable: %s", exc)
        return None
    nb.write_json(fleet.run_dir / "cost.json", cost)
    update_manifest(fleet.run_dir, "destroyed", cost_usd=cost)
    return cost


def destroy_fleet(fleet: Fleet) -> bool:
    """`tofu destroy` with retries, then a tag sweep. False when `tofu destroy` never worked,
    even if the sweep found and terminated everything: the state file is then out of date."""
    for attempt in range(1, DESTROY_RETRIES + 1):
        try:
            fleet.tf.destroy()
            return True
        except TfFailed as exc:
            log.warning(
                "destroy attempt %d/%d failed: %s", attempt, DESTROY_RETRIES, exc
            )
            if attempt < DESTROY_RETRIES:
                time.sleep(DESTROY_BACKOFF_S)
    log.warning("tofu destroy failed; sweeping resources tagged %s", fleet.run_dir.name)
    try:
        swept = sweep(
            fleet.run, fleet.cfg.region, fleet.run_dir.name, fleet.cfg.profile
        )
    except RemoteError as exc:
        log.error("sweep failed: %s", exc)
    else:
        log.warning("sweep terminated %d resources: %s", len(swept), ", ".join(swept))
    return False


def log_preflight(cfg: RunConfig, pre: Preflight, hosts: list[HostSpec]) -> None:
    log.info(
        "account %s (%s) %s, az %s, ami %s",
        pre["account"],
        cfg.profile,
        cfg.region,
        pre["az"],
        pre["ami_id"],
    )
    images = ", ".join(f"{n}@{i['digest'][:15]}" for n, i in pre["images"].items())
    log.info("images %s: %s", cfg.tag, images)
    log.info(
        "hosts: ctl %s; %d x %s (node0 validator+query, postgres)",
        cfg.ctl_type,
        cfg.nodes,
        cfg.node_type,
    )
    log.info(
        "vcpu: %d needed, %d in use, quota %.0f",
        pre["vcpu_needed"],
        pre["vcpu_in_use"],
        pre["vcpu_quota"],
    )
    phases = ", ".join(
        f"{name} {worst / 60:.0f}m" for name, (_, worst) in phase_seconds(cfg).items()
    )
    log.info("phases (worst case): %s", phases)


def render_run_dir(
    run: Runner,
    cfg: RunConfig,
    run_dir: Path,
    hosts: list[HostSpec],
    pre: Preflight,
    estimate: Estimate,
    argv: list[str],
    which: Callable[[str], str | None] = shutil.which,
) -> None:
    """Everything known before `tofu apply`. Files that need the hosts' addresses (env files,
    start.sh, topology) are written by `render_host_files` after it."""
    ssh_pub = resolve_ssh_pub(run, cfg, run_dir, which)
    cidr = operator_cidr(cfg)
    git_rev = git_head(run)
    genesis = render_genesis(
        Path(cfg.load.genesis).read_bytes(), cfg.nodes, cfg.max_block_size
    )
    write_manifest(run_dir, cfg, hosts, plan_peers(hosts), estimate, "planned", argv)
    update_manifest(
        run_dir,
        "planned",
        az=pre["az"],
        ami_id=pre["ami_id"],
        images=pre["images"],
        git_rev=git_rev,
        ssh_public_key=ssh_pub,
        config_hash=run_config_hash(cfg, hosts, pre["images"], genesis),
        cost_usd={"expected": estimate["expected_usd"], "bound": estimate["bound_usd"]},
    )
    (run_dir / "genesis.toml").write_bytes(genesis)
    nb.write_json(run_dir / "config.json", dataclasses.asdict(cfg.load))
    for host in hosts:
        host_dir = run_dir / "hosts" / host["name"]
        host_dir.mkdir(parents=True)
        (host_dir / "user-data.sh").write_text(
            render_user_data(host, pre["images"], int(estimate["ttl_s"]))
        )
    if pre["git_diff"] is not None:
        (run_dir / "diff.patch").write_text(pre["git_diff"])
    tf_dir = run_dir / "terraform"
    shutil.copytree(TERRAFORM_SRC, tf_dir)
    # Absolute: `tofu -chdir` changes the directory `file()` resolves user_data_path against.
    tfvars = render_tfvars(
        cfg,
        run_dir.resolve(),
        run_dir.name,
        getpass.getuser(),
        hosts,
        ssh_pub,
        cidr,
        "",
        git_rev,
        pre["az"],
        pre["ami_id"],
    )
    nb.write_json(tf_dir / "terraform.tfvars.json", tfvars)


def run_config_hash(
    cfg: RunConfig, hosts: list[HostSpec], images: dict[str, ImageInfo], genesis: bytes
) -> str:
    """Load config plus what else changes the measured system: image digests, the fleet's
    shape and the rendered genesis."""
    digests = {name: image["digest"] for name, image in sorted(images.items())}
    return nb.config_hash(
        cfg.load,
        [
            genesis,
            json.dumps(digests).encode(),
            json.dumps(hosts, sort_keys=True).encode(),
        ],
    )


def ssh_key_path(ssh_key: str, run_dir: Path) -> Path:
    if ssh_key == SSH_KEY_AUTO:
        return run_dir / "ssh" / "id_ed25519"
    return Path(ssh_key).expanduser()


def resolve_ssh_pub(
    run: Runner, cfg: RunConfig, run_dir: Path, which: Callable[[str], str | None]
) -> str:
    """The public key for `var.ssh_public_key`. Offline runs use the placeholder unless
    `auto` can be generated locally."""
    if cfg.ssh_key == SSH_KEY_AUTO:
        if cfg.offline and which("ssh-keygen") is None:
            return OFFLINE_SSH_PUB
        return generate_ssh_key(run, run_dir)
    if cfg.offline:
        return OFFLINE_SSH_PUB
    return read_ssh_pub(Path(cfg.ssh_key))


def generate_ssh_key(run: Runner, run_dir: Path) -> str:
    key = ssh_key_path(SSH_KEY_AUTO, run_dir)
    key.parent.mkdir(exist_ok=True)
    result = run(
        [
            "ssh-keygen",
            "-q",
            "-t",
            "ed25519",
            "-N",
            "",
            "-C",
            run_dir.name,
            "-f",
            str(key),
        ]
    )
    if result.returncode != 0:
        raise Refused(f"ssh-keygen failed: {result.stderr.strip()}")
    return key.with_name(key.name + ".pub").read_text().strip()


def remove_ssh_key(ssh_key: str, run_dir: Path) -> None:
    """Deletes the private half of an `auto` key; the `.pub` stays for the record."""
    key = ssh_key_path(ssh_key, run_dir)
    if ssh_key != SSH_KEY_AUTO or not key.exists():
        return
    key.unlink()
    log.info("ssh key removed")


def read_ssh_pub(ssh_key: Path) -> str:
    key = ssh_key.expanduser()
    pub = key.with_name(key.name + ".pub")
    for path in (key, pub):
        if not path.exists():
            raise Refused(f"ssh key file not found: {path} (see --ssh-key)")
    return pub.read_text().strip()


def operator_cidr(cfg: RunConfig) -> str:
    if cfg.operator_cidr != "auto":
        return cfg.operator_cidr
    if cfg.offline:
        return OFFLINE_CIDR
    try:
        with urllib.request.urlopen(CHECKIP_URL, timeout=10) as response:
            return f"{response.read().decode().strip()}/32"
    except OSError as exc:
        raise Refused(f"cannot detect this machine's IP ({exc}); pass --operator-cidr")


def git_head(run: Runner) -> str:
    result = run(["git", "rev-parse", "HEAD"])
    if result.returncode != 0:
        raise Refused(f"git rev-parse HEAD failed: {result.stderr.strip()}")
    return result.stdout.strip()


def parse_hosts_output(
    output: dict[str, Any], specs: list[HostSpec]
) -> dict[str, HostInfo]:
    value = output["hosts"]["value"]
    return {
        spec["name"]: {
            "name": spec["name"],
            "role": spec["role"],
            "public_ip": value[spec["name"]]["public_ip"],
            "private_ip": value[spec["name"]]["private_ip"],
            "private_dns": value[spec["name"]]["private_dns"],
            "instance_id": value[spec["name"]]["instance_id"],
        }
        for spec in specs
    }


def topology(hosts: dict[str, HostInfo]) -> nb.Topology:
    """Private URLs: the load runs on ctl, inside the VPC."""
    names = _node_names(hosts)
    return {
        "nodes": {name: _node_url(hosts[name]) for name in names},
        "roles": {
            name: "validator, query, postgres" if name == "node0" else "validator"
            for name in names
        },
        "query_node": "node0",
    }


def node_hosts(hosts: dict[str, HostInfo]) -> list[HostInfo]:
    return [hosts[name] for name in _node_names(hosts)]


def render_host_files(
    run_dir: Path, cfg: RunConfig, manifest: Manifest, hosts: dict[str, HostInfo]
) -> None:
    dotenv = parse_dotenv((REPO_ROOT / ".env").read_text())
    for spec in manifest["hosts"]:
        host_dir = run_dir / "hosts" / spec["name"]
        (host_dir / "start.sh").write_text(render_start_sh(spec, manifest["images"]))
        if spec["role"] == "ctl":
            (host_dir / "ctl.env").write_text(render_ctl_env(hosts, cfg, dotenv))
        else:
            (host_dir / "node.env").write_text(render_node_env(spec, hosts))
    topo = topology(hosts)
    nb.write_json(run_dir / "topology.json", topo)
    nb.write_json(
        run_dir / "hosts" / "ctl" / "agent.json",
        {
            "cfg": dataclasses.asdict(cfg.load),
            "topology": topo,
            "ready_timeout_s": cfg.ready_timeout_s,
        },
    )


def genesis_contracts(run_dir: Path) -> list[str]:
    """Addresses `deploy` must have created for the nodes to start: the fee and stake table
    contracts the genesis chain_config points at."""
    text = (run_dir / "genesis.toml").read_text()
    found = re.findall(r'(?m)^(?:fee|stake_table)_contract = "(0x[0-9a-fA-F]+)"$', text)
    if not found:
        raise ValueError("no contract addresses in genesis.toml")
    return sorted(set(found))


def wait_ssh(remote: Remote, host: str, interrupts: Interrupts) -> None:
    deadline = time.monotonic() + SSH_READY_TIMEOUT_S
    delay = SSH_RETRY_S
    while True:
        result = remote.ssh(host, "true", check=False)
        if result.returncode == 0:
            return
        if time.monotonic() >= deadline:
            raise RemoteError(
                f"{host}: ssh not reachable after {SSH_READY_TIMEOUT_S:.0f} s: "
                f"{result.stderr.strip()}"
            )
        interrupts.sleep(delay)
        delay = min(delay * 1.5, SSH_RETRY_MAX_S)


def wait_hosts(
    remote: Remote, manifest: Manifest, run_dir: Path, interrupts: Interrupts
) -> None:
    """Per host: ssh reachable, `cloud-init status --wait`, then `ready.json` saved. Pulled
    digests that differ from the manifest are only logged here; `check_validity_aws` marks the
    run invalid."""

    def ready(host: str) -> None:
        wait_ssh(remote, host, interrupts)
        wait_cloud_init(remote, host)
        text = remote.ssh(host, f"cat {BENCH_DIR}/ready.json").stdout
        host_dir = run_dir / "hosts" / host
        (host_dir / "ready.json").write_text(text)
        bad = digest_mismatches(json.loads(text)["digests"], manifest["images"])
        if bad:
            log.warning("%s pulled other digests than the manifest: %s", host, bad)

    remote.parallel(ready, remote.hosts)


def wait_cloud_init(remote: Remote, host: str) -> None:
    waited = remote.ssh(
        host,
        f"sudo timeout {CLOUD_INIT_TIMEOUT_S} cloud-init status --wait",
        check=False,
    )
    if waited.returncode not in CLOUD_INIT_OK_RCS:
        raise RemoteError(
            f"{host}: cloud-init status --wait exited {waited.returncode}: "
            f"{waited.stderr.strip()}"
        )
    status = json.loads(
        remote.ssh(host, "cloud-init status --format json", check=False).stdout
    )["status"]
    if status != "done":
        raise RemoteError(f"{host}: cloud-init finished as {status!r}, not 'done'")


def digest_mismatches(
    pulled: dict[str, str], images: dict[str, ImageInfo]
) -> list[str]:
    """`pulled` maps image name to `repo@sha256:..` as `docker image inspect` reports."""
    return [
        name
        for name, ref in sorted(pulled.items())
        if ref.rpartition("@")[2] != images[name]["digest"]
    ]


def ship(remote: Remote, run_dir: Path) -> None:
    def send(host: str) -> None:
        host_dir = run_dir / "hosts" / host
        files = [SCRIPT_DIR / "netbench.py", SCRIPT_DIR / "aws-bench"]
        files += [host_dir / f for f in SHIPPED_HOST_FILES if (host_dir / f).exists()]
        files.append(run_dir / "genesis.toml")
        remote.rsync_to(host, files, f"{BENCH_DIR}/")

    remote.parallel(send, remote.hosts)


def start_hostmon(remote: Remote) -> None:
    def start(host: str) -> None:
        role = remote.hosts[host]["role"]
        remote.ssh(
            host,
            f"sudo systemd-run --unit bench-host --collect {AGENT_PYTHON} {BENCH_DIR}/aws-bench "
            f"agent-host {BENCH_DIR}/host.jsonl --role {role}",
        )

    remote.parallel(start, remote.hosts)


def create_containers(remote: Remote) -> None:
    """start.sh only runs `docker create`, so `start_nodes` can start every node at once."""
    remote.parallel(
        lambda host: remote.ssh(host, f"sudo bash {BENCH_DIR}/start.sh"), remote.hosts
    )


def gate(
    remote: Remote,
    host: str,
    what: str,
    command: str,
    interrupts: Interrupts,
    timeout_s: float = GATE_TIMEOUT_S,
) -> None:
    deadline = time.monotonic() + timeout_s
    while True:
        result = remote.ssh(host, command, check=False)
        if result.returncode == 0:
            return
        if time.monotonic() >= deadline:
            raise RemoteError(
                f"gate `{what}` on {host} not passed after {timeout_s:.0f} s: "
                f"{(result.stdout + result.stderr).strip()}"
            )
        interrupts.sleep(GATE_RETRY_S)


def rpc_check(method: str, params: list[str], jq_filter: str) -> str:
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params})
    return (
        f"curl -sf -X POST -H 'Content-Type: application/json' --data {shlex.quote(body)} "
        f"http://localhost:{L1_PORT} | jq -e {shlex.quote(jq_filter)}"
    )


def start_support(remote: Remote, contracts: list[str], interrupts: Interrupts) -> None:
    """On ctl, in order and each gated on a check: anvil, contract deployment, orchestrator,
    relay; then Postgres on node0."""

    def start(host: str, container: str) -> None:
        remote.ssh(host, f"sudo docker start {container}")

    start("ctl", "anvil")
    gate(
        remote,
        "ctl",
        "anvil eth_chainId",
        rpc_check("eth_chainId", [], ".result"),
        interrupts,
    )
    start("ctl", "deploy")
    waited = remote.ssh(
        "ctl", f"sudo timeout {DEPLOY_TIMEOUT_S} docker wait deploy", check=False
    )
    if waited.returncode == TIMEOUT_RC:
        raise RemoteError(f"deploy still running after {DEPLOY_TIMEOUT_S} s")
    if waited.returncode != 0:
        raise RemoteError(
            f"docker wait deploy exited {waited.returncode}: {waited.stderr.strip()}"
        )
    if waited.stdout.strip() != "0":
        raise RemoteError(
            f"deploy exited with status {waited.stdout.strip()}; see docker logs on ctl"
        )
    for address in contracts:
        check = rpc_check("eth_getCode", [address, "latest"], '.result != "0x"')
        gate(remote, "ctl", f"eth_getCode {address}", check, interrupts)
    start("ctl", "orchestrator")
    gate(
        remote,
        "ctl",
        "orchestrator healthcheck",
        f"curl -sf http://localhost:{ORCHESTRATOR_PORT}/healthcheck",
        interrupts,
    )
    start("ctl", "state-relay-server")
    gate(
        remote,
        "ctl",
        "relay healthcheck",
        f"curl -sf http://localhost:{RELAY_PORT}/healthcheck",
        interrupts,
    )
    start("node0", "postgres")
    gate(
        remote,
        "node0",
        "pg_isready",
        "sudo docker exec postgres pg_isready -h 127.0.0.1 -p 5432 -U root -d espresso",
        interrupts,
    )
    gate(
        remote,
        "node0",
        "pg_stat_statements",
        f"sudo {shlex.join(PSQL)} -c {shlex.quote(PG_EXTENSION_SQL)}",
        interrupts,
    )


def fleet_time(remote: Remote) -> float:
    """Epoch seconds on ctl. Every host is chrony-synced to the same source, so a start time on
    ctl's clock is a start time on all clocks; the laptop's clock is not."""
    return float(remote.ssh("ctl", "date +%s.%N").stdout)


def start_nodes(remote: Remote, hosts: list[HostInfo], at: float) -> float:
    """`docker start` of every node at fleet time `at`. Returns the spread in seconds between
    the earliest and latest `.State.StartedAt`."""
    wait = (
        "python3 -c 'import sys, time; time.sleep(max(0.0, float(sys.argv[1]) - time.time()))' "
        f"{at!r}"
    )
    inspect = "sudo docker inspect -f '{{.State.StartedAt}}' espresso-node"

    def start(node: str) -> float:
        remote.ssh(node, f"{wait} && sudo docker start espresso-node")
        return parse_docker_time(remote.ssh(node, inspect).stdout)

    # One thread per node: each ssh call sleeps until `at`, so a smaller pool would start the
    # rest only after the first batch returned.
    started = remote.parallel(start, [h["name"] for h in hosts], workers=len(hosts))
    return max(started.values()) - min(started.values())


def parse_docker_time(text: str) -> float:
    """`.State.StartedAt`: RFC 3339 with nanoseconds, e.g. 2026-09-29T15:00:00.123456789Z."""
    stamp, _, frac = text.strip().removesuffix("Z").partition(".")
    moment = datetime.fromisoformat(f"{stamp}.{frac[:6].ljust(6, '0')}+00:00")
    return moment.timestamp()


def start_agent(remote: Remote) -> None:
    remote.ssh(
        "ctl",
        f"sudo systemd-run --unit bench-agent --collect {AGENT_PYTHON} {BENCH_DIR}/aws-bench "
        f"agent-drive {BENCH_DIR}/agent.json {BENCH_DIR}/out",
    )


def bounded(command: str) -> str:
    """`command` as root under `timeout`: a hung docker or systemctl call must not block
    teardown."""
    return f"sudo timeout -k 10 {COLLECT_HOST_TIMEOUT_S:.0f} bash -c {shlex.quote(command)}"


def stop_agent(remote: Remote) -> None:
    """SIGTERM: the agent flushes its load output before exiting. Fine if it already exited."""
    remote.ssh("ctl", bounded("systemctl stop bench-agent"), check=False)


def read_agent_state(remote: Remote) -> AgentState | None:
    result = remote.ssh("ctl", f"cat {BENCH_DIR}/out/agent-state.json", check=False)
    return json.loads(result.stdout) if result.returncode == 0 else None


def poll_agent(
    remote: Remote, run_dir: Path, cfg: RunConfig, interrupts: Interrupts
) -> AgentState:
    """Until the agent reports `done`: reads its state every AGENT_POLL_S, logs its progress
    every AGENT_LOG_S and rsyncs its output every OUT_RSYNC_S."""
    begin = time.monotonic()
    deadline = begin + cfg.ready_timeout_s + load_seconds(cfg.load) + AGENT_SLACK_S
    next_log = begin + AGENT_LOG_S
    next_sync = begin + OUT_RSYNC_S
    state: AgentState | None = None
    unreachable = 0
    while True:
        interrupts.check()
        probe = remote.ssh(
            "ctl", "systemctl is-active --quiet bench-agent", check=False
        )
        if probe.returncode == SSH_FAILED_RC:
            unreachable += 1
            if unreachable > AGENT_POLL_SSH_FAILURES_MAX:
                raise RemoteError(
                    f"ctl unreachable for {unreachable} polls: {probe.stderr.strip()}"
                )
            log.warning("ctl unreachable, retrying: %s", probe.stderr.strip())
            interrupts.sleep(AGENT_POLL_S)
            continue
        unreachable = 0
        if probe.returncode not in (0, SYSTEMCTL_INACTIVE_RC, SYSTEMCTL_NO_UNIT_RC):
            raise RemoteError(
                f"systemctl is-active exited {probe.returncode}: {probe.stderr.strip()}"
            )
        active = probe.returncode == 0
        state = read_agent_state(remote) or state
        now = time.monotonic()
        if state is not None and state["phase"] == "done":
            return state
        if state is not None and state["phase"] == "error":
            raise RemoteError(f"agent failed: {state['error']}")
        if not active:
            raise RemoteError(
                f"agent exited in phase {state['phase'] if state else 'start'} "
                "without finishing"
            )
        if state is None and now - begin > AGENT_START_GRACE_S:
            raise RemoteError("agent wrote no state file")
        if now > deadline:
            raise RemoteError("agent did not finish within the expected time")
        if state is not None and now >= next_log:
            log.info("%s: %s", state["phase"], state.get("progress", state["detail"]))
            next_log = now + AGENT_LOG_S
        if now >= next_sync:
            best_effort(
                "partial rsync",
                lambda: remote.rsync_from("ctl", f"{BENCH_DIR}/out/", run_dir),
            )
            next_sync = now + OUT_RSYNC_S
        interrupts.sleep(AGENT_POLL_S)


# Containers `render_start_sh` creates per role that write to the journal or answer queries;
# postgres stays up so that `collect_hosts` can still ask it for statistics.
FREEZE_CONTAINERS = {
    "ctl": ("anvil", "orchestrator", "state-relay-server"),
    "query": ("espresso-node",),
    "validator": ("espresso-node",),
}


def freeze_command(names: tuple[str, ...]) -> str:
    """`docker stop` per container, ignoring only a container that does not exist."""
    return (
        f"for c in {' '.join(names)}; do "
        f"out=$(docker stop -t {int(FREEZE_STOP_TIMEOUT_S)} $c 2>&1) || "
        'case "$out" in *"No such container"*) ;; *) echo "$out" >&2; exit 1;; esac; '
        "done"
    )


def freeze(remote: Remote) -> None:
    def stop(host: str) -> None:
        names = FREEZE_CONTAINERS[remote.hosts[host]["role"]]
        remote.ssh(host, bounded(freeze_command(names)))

    remote.parallel(stop, remote.hosts)


COLLECT_SCRIPT = (
    f"cd {BENCH_DIR}\n"
    "systemctl stop bench-host\n"
    "for c in $(docker ps -a --format '{{.Names}}'); do "
    'docker logs "$c" 2>&1 | gzip > "$c.log.gz"; done\n'
    "docker inspect $(docker ps -aq) > inspect.json\n"
    "chronyc tracking > chrony.txt\n"
    "df -B1 / /data > df.txt\n"
    "du -sb /data/journal > du-journal.txt\n"
    "lscpu > lscpu.txt\n"
    "uname -r > uname.txt\n"
    "grep MemTotal /proc/meminfo > meminfo.txt\n"
    "cp /var/log/cloud-init-output.log .\n"
)
PG_STATS_SQL = (
    "select json_build_object('database_bytes', pg_database_size('espresso'), 'tables', "
    "(select coalesce(json_agg(t), '[]'::json) from (select relname, n_live_tup, "
    "pg_total_relation_size(relid) as total_bytes from pg_stat_user_tables "
    "order by total_bytes desc limit 20) t))"
)
PG_EXTENSION_SQL = "CREATE EXTENSION IF NOT EXISTS pg_stat_statements"
PG_STATEMENTS_SQL = (
    "select coalesce(json_agg(s), '[]'::json) from (select queryid, calls, total_exec_time, "
    "mean_exec_time, max_exec_time, rows, shared_blks_read, shared_blks_hit, "
    "temp_blks_written, wal_bytes, left(query, 300) as query from pg_stat_statements "
    "order by total_exec_time desc limit 50) s"
)
PG_SETTINGS_SQL = (
    "select json_object_agg(name, setting) from pg_settings where source <> 'default' "
    "or name in ('shared_buffers','max_wal_size','synchronous_commit','checkpoint_timeout',"
    "'wal_compression','effective_io_concurrency','work_mem','maintenance_work_mem','fsync',"
    "'full_page_writes')"
)


def _pg_dump(sql: str, filename: str) -> str:
    return f"{shlex.join(PSQL)} -At -c {shlex.quote(sql)} > {BENCH_DIR}/{filename}\n"


PG_STATS_SCRIPT = (
    _pg_dump(PG_STATS_SQL, "pg-stats.json")
    + _pg_dump(PG_STATEMENTS_SQL, "pg-statements.json")
    + _pg_dump(PG_SETTINGS_SQL, "pg-settings.json")
)
# Shipped inputs and the agent's output, which `poll_agent` and the final rsync fetch.
COLLECT_EXCLUDES = ("--exclude=/out/", "--exclude=/aws-bench", "--exclude=/netbench.py")


def collect_hosts(
    remote: Remote, hosts: list[HostInfo], out: Path, subdir: str = ""
) -> None:
    """Logs, inspect, chrony, disk and journal sizes, host samples and (node0) Postgres
    statistics into `out/hosts/<name>/<subdir>`. Best effort per host: one that cannot be
    reached is reported and the rest are still collected."""

    def collect(name: str) -> None:
        role = remote.hosts[name]["role"]
        script = (
            COLLECT_SCRIPT + (PG_STATS_SCRIPT if role == "query" else "") + "true\n"
        )
        try:
            remote.ssh(name, bounded(script))
            remote.rsync_from(
                name,
                f"{BENCH_DIR}/",
                out / "hosts" / name / subdir,
                *COLLECT_EXCLUDES,
                "--exclude=__pycache__",
            )
        except RemoteError as exc:
            log.warning("collect %s failed: %s", name, exc)

    remote.parallel(collect, [h["name"] for h in hosts])


def cmd_status(
    args: argparse.Namespace, run: Runner = _run, now: datetime | None = None
) -> int:
    if (args.dir is not None) == args.all:
        raise Refused("status takes either DIR or --all")
    now = now or datetime.now(UTC)
    if args.all:
        return status_all(run, args, now)
    return status_run(run, args.dir, now)


def cmd_collect(args: argparse.Namespace, run: Runner = _run) -> int:
    """Collects again from the live hosts into `hosts/<name>/collect-<k>/`, leaving the files
    of the run itself untouched."""
    run_dir: Path = args.dir
    manifest: Manifest = nb.read_json(run_dir / "manifest.json")
    hosts = provisioned_hosts(manifest)
    setup_logging(run_dir)
    remote = Remote(
        run, run_dir, ssh_key_path(manifest["config"]["ssh_key"], run_dir), hosts
    )
    subdir = f"collect-{next_collect_index(run_dir)}"
    collect_hosts(remote, list(hosts.values()), run_dir, subdir)
    missing = [
        name for name in hosts if not any((run_dir / "hosts" / name / subdir).glob("*"))
    ]
    if missing:
        log.error("nothing collected from %s", ", ".join(missing))
        return EXIT_FAILED
    log.info("collected %d hosts into hosts/<name>/%s", len(hosts), subdir)
    return EXIT_OK


def cmd_render(args: argparse.Namespace) -> int:
    """Analyzes the collected files again, offline; `--baseline` adds the comparison."""
    run_dir: Path = args.dir
    agent = finished_agent_state(run_dir)
    if not (run_dir / "run.json").exists() and agent is not None:
        manifest: Manifest = nb.read_json(run_dir / "manifest.json")
        started = datetime.fromisoformat(manifest["created_at"]).timestamp()
        nb.write_json(
            run_dir / "run.json",
            run_json(manifest, manifest["config"]["tag"], agent, started, agent["t1"]),
        )
    if not (run_dir / "run.json").exists():
        raise Refused(
            f"{run_dir} has no run.json: the run produced no result, see summary.md"
        )
    setup_logging(run_dir)
    baseline = nb.load_baseline(args.baseline) if args.baseline else None
    result = write_report(run_dir, baseline)
    log_result(result)
    log.info("wrote %s", run_dir / "summary.md")
    return EXIT_OK if result["validity"]["valid"] else EXIT_INVALID


def cmd_destroy(
    args: argparse.Namespace, run: Runner = _run, now: datetime | None = None
) -> int:
    if (args.dir is not None) == args.orphans:
        raise Refused("destroy takes either DIR or --orphans")
    if args.orphans:
        return destroy_orphans(run, args, now or datetime.now(UTC))
    return destroy_run(run, args)


def status_run(run: Runner, run_dir: Path, now: datetime) -> int:
    manifest: Manifest = nb.read_json(run_dir / "manifest.json")
    name = manifest["name"]
    print(
        f"- run {name}: phase {manifest['phase']}, created {manifest['created_at'][:16]}"
    )
    if manifest["phase"] == "planned":
        print("- no instances: planned only")
        return EXIT_OK
    cost_path = run_dir / "cost.json"
    if manifest["phase"] in TERMINAL_PHASES and cost_path.exists():
        cost = nb.read_json(cost_path)
        print(f"- cost: ${cost['actual']:.2f} actual, bound ${cost['bound']:.2f}")
        return EXIT_OK
    config = manifest["config"]
    instances = describe_instances(
        run, config["region"], config["profile"], f"Name=tag:{TAG_RUN},Values={name}"
    )
    hosts = manifest.get("hosts_info", {})
    by_id = {info["instance_id"]: host for host, info in hosts.items()}
    for instance in instances:
        print(
            f"- {by_id.get(instance['id'], instance['id'])}: {instance['state']}, "
            f"{instance['type']}, launched {instance['launch'][:16]}"
        )
    ctl = hosts.get("ctl")
    if ctl and any(
        i["id"] == ctl["instance_id"] and i["state"] == "running" for i in instances
    ):
        remote = Remote(run, run_dir, ssh_key_path(config["ssh_key"], run_dir), hosts)
        print(f"- agent: {format_agent(read_agent_state(remote))}")
    print(f"- cost: {status_cost(run, manifest, instances, now)}")
    return EXIT_OK


def format_agent(state: AgentState | None) -> str:
    if state is None:
        return "no state file"
    return f"{state['phase']}, {state.get('progress', state['detail'])}"


def status_cost(
    run: Runner, manifest: Manifest, instances: list[Instance], now: datetime
) -> str:
    bound = f"bound ${manifest['estimate']['bound_usd']:.2f}"
    if not instances:
        return f"no instances, {bound}"
    if all(i["state"] == "terminated" for i in instances):
        return f"${actual_cost(run, manifest)['actual']:.2f} actual, {bound}"
    launched = min(datetime.fromisoformat(i["launch"]) for i in instances)
    usd = manifest_cost(manifest, (now - launched).total_seconds())
    return f"${usd:.2f} so far, {bound}"


def status_all(run: Runner, args: argparse.Namespace, now: datetime) -> int:
    cfg = account_config(args)
    caller_account(run, cfg)
    runs = find_runs(run, cfg.region, cfg.profile, args.out_root, now)
    if not runs:
        print(f"no espresso-bench resources in {cfg.region}")
        return EXIT_OK
    prices = cached_prices(args.out_root / "prices.json", cfg.region)
    print("\n".join(format_runs(runs, prices, now)))
    return EXIT_OK


def destroy_run(run: Runner, args: argparse.Namespace) -> int:
    run_dir: Path = args.dir
    manifest: Manifest = nb.read_json(run_dir / "manifest.json")
    name = manifest["name"]
    if manifest["phase"] == "planned":
        raise Refused(f"{name} was only planned: nothing was created")
    if manifest["phase"] in TERMINAL_PHASES:
        raise Refused(f"{name} is already {manifest['phase']}")
    prompt = f"Destroy the fleet of {name} in {manifest['config']['account']}?"
    if not confirm(prompt, args.yes, sys.stdin.isatty()):
        raise Refused("not confirmed; nothing was destroyed")
    setup_logging(run_dir)
    cfg = config_from_manifest(manifest["config"])
    tf = Terraform(run, cfg.tf, run_dir / "terraform", terraform_env())
    fleet = Fleet(run, cfg, run_dir, tf, Interrupts(), time.time())
    update_manifest(run_dir, "destroying")
    if not destroy_fleet(fleet):
        update_manifest(run_dir, "left-running")
        log.error("resources may remain, run: aws-bench destroy %s", run_dir)
        return EXIT_LEFTOVER
    cost = final_cost(fleet)
    update_manifest(run_dir, "done")
    result = (
        nb.read_json(run_dir / "result.json")
        if (run_dir / "result.json").exists()
        else None
    )
    code = exit_code(fleet, result, True)
    append_index(run_dir.parent, fleet.manifest, result, code, True, cost)
    remove_ssh_key(cfg.ssh_key, run_dir)
    log.info("destroyed %s", name)
    return EXIT_OK


def destroy_orphans(run: Runner, args: argparse.Namespace, now: datetime) -> int:
    cfg = account_config(args)
    caller_account(run, cfg)
    runs = find_runs(run, cfg.region, cfg.profile, args.out_root, now)
    orphans = [r for r in runs if r["orphan"] is not None]
    if not orphans:
        print(f"no orphaned espresso-bench resources in {cfg.region}")
        return EXIT_OK
    prices = cached_prices(args.out_root / "prices.json", cfg.region)
    print("\n".join(format_runs(orphans, prices, now)))
    instances = sum(len(r["instances"]) for r in orphans)
    others = sum(len(r["arns"]) - len(r["instances"]) for r in orphans)
    prompt = (
        f"Terminate {instances} instances and delete {others} other resources "
        f"of {len(orphans)} runs in {cfg.account}?"
    )
    if not confirm(prompt, args.yes, sys.stdin.isatty()):
        raise Refused("not confirmed; nothing was destroyed")
    try:
        for orphan in orphans:
            log.info("sweeping %s", orphan["name"])
            sweep(run, cfg.region, orphan["name"], cfg.profile)
            mark_swept(args.out_root / orphan["name"])
    except RemoteError as exc:
        log.error("sweep failed, resources may remain: %s", exc)
        return EXIT_LEFTOVER
    log.info("swept %d runs", len(orphans))
    return EXIT_OK


def mark_swept(run_dir: Path) -> None:
    if (run_dir / "manifest.json").exists():
        manifest = update_manifest(run_dir, "swept")
        remove_ssh_key(manifest["config"]["ssh_key"], run_dir)


def account_config(args: argparse.Namespace) -> RunConfig:
    return RunConfig(
        tag="", region=args.region, profile=args.profile, account=args.account
    )


def config_from_manifest(saved: dict[str, Any]) -> RunConfig:
    """Inverse of `config_to_json`."""
    fields: dict[str, Any] = {
        **saved,
        "load": load_config(dict(saved["load"])),
        "out_root": Path(saved["out_root"]),
        "price": tuple(saved["price"]),
    }
    return RunConfig(**fields)


def provisioned_hosts(manifest: Manifest) -> dict[str, HostInfo]:
    if "hosts_info" not in manifest:
        raise Refused(
            f"{manifest['name']} has no hosts: the fleet was never provisioned"
        )
    return manifest["hosts_info"]


def next_collect_index(run_dir: Path) -> int:
    indices = [
        int(path.name.removeprefix("collect-"))
        for path in (run_dir / "hosts").glob("*/collect-*")
    ]
    return max(indices, default=0) + 1


def find_runs(
    run: Runner, region: str, profile: str, out_root: Path, now: datetime
) -> list[TaggedRun]:
    """Every run with a resource tagged `espresso-bench-run` in `region`, with the reason
    it counts as an orphan (if it does)."""
    out = aws_ok(
        run,
        profile,
        "resourcegroupstaggingapi",
        "get-resources",
        "--region",
        region,
        "--tag-filters",
        f"Key={TAG_RUN}",
        "--query",
        "ResourceTagMappingList[].{arn:ResourceARN,tags:Tags}",
        "--output",
        "json",
    )
    instances = describe_instances(
        run, region, profile, f"Name=tag-key,Values={TAG_RUN}"
    )
    runs = group_runs(json.loads(out), instances)
    user = getpass.getuser()
    for tagged in runs:
        phase = local_phase(out_root, tagged["name"])
        tagged["orphan"] = classify_orphan(tagged, phase, now, user)
    return runs


def describe_instances(
    run: Runner, region: str, profile: str, *filters: str
) -> list[Instance]:
    out = aws_ok(
        run,
        profile,
        "ec2",
        "describe-instances",
        "--region",
        region,
        "--filters",
        *filters,
        "--query",
        "Reservations[].Instances[].{id:InstanceId,type:InstanceType,"
        "state:State.Name,launch:LaunchTime,reason:StateTransitionReason}",
        "--output",
        "json",
    )
    return json.loads(out)


def arn_parts(arn: str) -> tuple[str, str]:
    """(`instance`, `i-0abc`) of `arn:aws:ec2:eu-west-1:1:instance/i-0abc`."""
    kind, _, resource_id = arn.rpartition(":")[2].partition("/")
    return kind, resource_id


def group_runs(
    mappings: list[dict[str, Any]], instances: list[Instance]
) -> list[TaggedRun]:
    """Groups tag-API `{arn, tags}` mappings by run, sorted by owner then name. A terminated
    instance still shows up in both APIs for about an hour and is dropped."""
    live = {i["id"]: i for i in instances if i["state"] != "terminated"}
    runs: dict[str, TaggedRun] = {}
    for mapping in mappings:
        kind, resource_id = arn_parts(mapping["arn"])
        if kind == "instance" and resource_id not in live:
            continue
        tags = {tag["Key"]: tag["Value"] for tag in mapping["tags"]}
        tagged = runs.setdefault(
            tags[TAG_RUN],
            {
                "name": tags[TAG_RUN],
                "owner": None,
                "expires": None,
                "arns": [],
                "instances": [],
                "orphan": None,
            },
        )
        tagged["owner"] = tags.get(TAG_OWNER, tagged["owner"])
        tagged["expires"] = tags.get(TAG_EXPIRES, tagged["expires"])
        tagged["arns"].append(mapping["arn"])
        if kind == "instance":
            tagged["instances"].append(live[resource_id])
    return sorted(runs.values(), key=lambda r: (r["owner"] or "", r["name"]))


def local_phase(out_root: Path, name: str) -> str | None:
    """The run's manifest phase, or None when this machine no longer has its state: no manifest,
    or a terminal phase without terraform state. A live run has no tfstate during `tofu apply`."""
    run_dir = out_root / name
    if not (run_dir / "manifest.json").exists():
        return None
    phase = nb.read_json(run_dir / "manifest.json")["phase"]
    if (
        phase in TERMINAL_PHASES
        and not (run_dir / "terraform" / "terraform.tfstate").exists()
    ):
        return None
    return phase


def classify_orphan(
    tagged: TaggedRun, phase: str | None, now: datetime, user: str
) -> str | None:
    """Why `destroy --orphans` may sweep the run. A run of another owner without local state
    is that owner's live run, so only its expiry can condemn it."""
    if tagged["expires"] is not None and now > datetime.fromisoformat(
        tagged["expires"]
    ):
        return "past expiry"
    if phase in TERMINAL_PHASES:
        return f"run is {phase}"
    if phase is None and tagged["owner"] == user:
        return "no local state"
    return None


def cached_prices(cache: Path, region: str) -> dict[str, float]:
    """USD per hour by instance type from the pricing cache `fetch_prices` writes."""
    if not cache.exists():
        return {}
    prefix = f"{region}:"
    return {
        key.removeprefix(prefix): entry["usd_hour"]
        for key, entry in json.loads(cache.read_text()).items()
        if key.startswith(prefix)
    }


def accrued_usd(
    instances: list[Instance], prices: dict[str, float], now: datetime
) -> float | None:
    """Instance-hours since launch at cached prices; None if a type has no price."""
    total = 0.0
    for instance in instances:
        if instance["type"] not in prices:
            return None
        launched = datetime.fromisoformat(instance["launch"])
        hours = (now - launched).total_seconds() / 3600
        total += hours * prices[instance["type"]]
    return total


def format_runs(
    runs: list[TaggedRun], prices: dict[str, float], now: datetime
) -> list[str]:
    lines = [
        "| run | owner | launched | expires | resources | instance USD | orphan |",
        "|---|---|---|---|---|---|---|",
    ]
    for tagged in runs:
        instances = tagged["instances"]
        launched = min((i["launch"] for i in instances), default="-")[:16]
        usd = accrued_usd(instances, prices, now)
        cost = "-" if not instances else "n/a" if usd is None else f"{usd:.2f}"
        cells = [
            tagged["name"],
            tagged["owner"] or "-",
            launched,
            (tagged["expires"] or "-")[:16],
            f"{len(instances)} instances, {len(tagged['arns']) - len(instances)} other",
            cost,
            tagged["orphan"] or "",
        ]
        lines.append("| " + " | ".join(cells) + " |")
    return lines


def write_run_json(fleet: Fleet) -> None:
    """`run.json` as `netbench.analyze` reads it, from the agent's final state."""
    agent = fleet.agent
    assert agent is not None
    nb.write_json(
        fleet.run_dir / "run.json",
        run_json(fleet.manifest, fleet.cfg.tag, agent, fleet.started, time.time()),
    )


def run_json(
    manifest: Manifest, tag: str, agent: AgentState, started: float, now: float
) -> dict[str, Any]:
    return {
        "meta": {
            "sha": manifest["git_rev"],
            "ref": tag,
            "event": "aws",
            "run_id": None,
            "run_url": None,
            "pr": None,
            "local": False,
        },
        "config_hash": manifest["config_hash"],
        "started": started,
        "wall_s": now - started,
        "ready_s": agent["ready_s"],
        "t0": agent["t0"],
        "t1": agent["t1"],
        "teardown": [],
        "error": None,
    }


def finished_agent_state(run_dir: Path) -> AgentState | None:
    """The collected `agent-state.json` when the load finished, whatever the driver did after."""
    path = run_dir / "agent-state.json"
    if not path.exists():
        return None
    state: AgentState = nb.read_json(path)
    return state if state["phase"] == "done" else None


def write_report(run_dir: Path, baseline: nb.Baseline | None = None) -> nb.BenchResult:
    """Analyzes a collected run dir into `result.json` and `summary.md`; the same inputs give
    the same output, so `render` can call it again offline."""
    manifest: Manifest = nb.read_json(run_dir / "manifest.json")
    cfg = load_config(nb.read_json(run_dir / "config.json"))
    prepare_analysis(run_dir, manifest)
    result = nb.analyze(run_dir, cfg, nb.read_json(run_dir / "topology.json"))
    run = nb.read_json(run_dir / "run.json")
    stats, evidence = load_evidence(run_dir, manifest, run["t0"], run["t1"])
    result["hosts"] = stats
    result["deployment"] = deployment_meta(manifest, evidence)
    result["validity"] = check_validity_aws(result, manifest, evidence)
    nb.write_json(run_dir / "result.json", result)
    comparison = nb.compare(result, baseline) if baseline else None
    (run_dir / "summary.md").write_text(nb.render(result, comparison))
    return result


def load_config(saved: dict[str, Any]) -> nb.BenchConfig:
    saved["namespaces"] = tuple(saved["namespaces"])
    saved["steps"] = tuple(saved["steps"])
    return nb.BenchConfig(**saved)


def prepare_analysis(run_dir: Path, manifest: Manifest) -> None:
    """The files `netbench.analyze` reads that the local bench produces itself. Its process and
    host statistics come from node0, the host with Postgres. The AWS harness runs no
    calibration; zeros keep the schema."""
    node0 = run_dir / "hosts" / "node0"
    shutil.copyfile(node0 / "host.jsonl", run_dir / "host.jsonl")
    zero: nb.Calibration = {
        "sha256_1t_mb_s": 0.0,
        "sha256_mt_mb_s": 0.0,
        "fsync_per_s": 0.0,
    }
    nb.write_json(run_dir / "calibration.json", {"before": zero, "after": zero})
    runner = runner_info(
        (node0 / "lscpu.txt").read_text(),
        (node0 / "meminfo.txt").read_text(),
        (node0 / "uname.txt").read_text(),
        manifest["ami_id"],
    )
    nb.write_json(run_dir / "sysinfo.json", {"runner": runner, "raw": {}})


def runner_info(lscpu: str, meminfo: str, uname: str, ami_id: str) -> nb.RunnerInfo:
    fields = {
        key.strip(): value.strip()
        for key, _, value in (line.partition(":") for line in lscpu.splitlines())
        if value.strip()
    }
    mem = re.search(r"^MemTotal:\s*(\d+) kB", meminfo, re.MULTILINE)
    if mem is None:
        raise ValueError(f"no MemTotal line in {meminfo!r}")
    cpus = int(fields["CPU(s)"])
    return {
        "cpu_model": fields["Model name"],
        "nproc": cpus,
        "affinity": cpus,
        "cgroup_cpu_max": None,
        "mhz": [float(fields["CPU max MHz"])] if "CPU max MHz" in fields else [],
        "flags": fields["Flags"].split(),
        "mem_total_bytes": int(mem.group(1)) * 1024,
        "kernel": uname.strip(),
        "image_os": "ubuntu",
        "image_version": ami_id,
        "runner_name": None,
    }


# Devices whose counters double count a parent (partitions, device mapper) or carry no I/O of
# interest, and the interfaces that are not the host's own network.
DISK_SKIP = re.compile(r"^(loop|ram|dm-)|p\d+$|^(sd|vd|xvd)[a-z]+\d+$")
NET_SKIP = re.compile(r"^(lo|docker\d+|veth.*|br-.*)$")


def counter_mb_s(
    samples: list[dict[str, Any]],
    key: str,
    fields: tuple[str, ...],
    skip: re.Pattern[str],
) -> float:
    def total(sample: dict[str, Any]) -> int:
        return sum(
            counters[f]
            for device, counters in sample[key].items()
            if not skip.search(device)
            for f in fields
        )

    span = samples[-1]["ts"] - samples[0]["ts"]
    return (total(samples[-1]) - total(samples[0])) / span / 1e6


def host_sample_stats(
    samples: list[dict[str, Any]], t0: float, t1: float
) -> tuple[nb.HostSample, float]:
    """`netbench.host_stats` plus disk and network MB/s over the window, and the fraction of
    the samples the window should hold that exist."""
    inside = [s for s in samples if t0 <= s["ts"] <= t1]
    coverage = min(1.0, len(inside) / ((t1 - t0) / HOST_SAMPLE_S))
    stats: nb.HostSample = {
        **nb.host_stats(samples, t0, t1),
        "disk_mb_s": 0.0,
        "net_mb_s": 0.0,
    }
    if len(inside) >= 2:
        stats["disk_mb_s"] = counter_mb_s(
            inside, "disk", ("read_bytes", "write_bytes"), DISK_SKIP
        )
        stats["net_mb_s"] = counter_mb_s(
            inside, "net", ("rx_bytes", "tx_bytes"), NET_SKIP
        )
    return stats, coverage


def parse_du_bytes(text: str) -> int:
    """`du -sb <dir>`: `<bytes>\\t<dir>`."""
    return int(text.split()[0])


def parse_clock_offset_ms(tracking: str) -> float:
    """`chronyc tracking`: `System time : 0.000012 seconds fast of NTP time`."""
    match = re.search(
        r"^System time\s*:\s*([\d.]+) seconds (?:fast|slow)", tracking, re.MULTILINE
    )
    if match is None:
        raise ValueError(
            f"no System time line in chronyc tracking output: {tracking!r}"
        )
    return float(match.group(1)) * 1000


def load_evidence(
    run_dir: Path, manifest: Manifest, t0: float, t1: float
) -> tuple[dict[str, nb.HostSample], Evidence]:
    """Reads `hosts/<name>/` as `collect_hosts` left it. A file that is missing (a host that
    could not be collected) is absent from the maps, and coverage is 0 without host samples."""
    stats: dict[str, nb.HostSample] = {}
    evidence: Evidence = {
        "coverage": {},
        "journal_bytes": {},
        "clock_offset_ms": {},
        "digest_mismatch": {},
    }
    for spec in manifest["hosts"]:
        name = spec["name"]
        host_dir = run_dir / "hosts" / name
        samples = host_dir / "host.jsonl"
        evidence["coverage"][name] = 0.0
        if samples.exists():
            stats[name], evidence["coverage"][name] = host_sample_stats(
                list(nb.read_jsonl(samples)), t0, t1
            )
        journal = host_dir / "du-journal.txt"
        if spec["role"] != "ctl" and journal.exists():
            evidence["journal_bytes"][name] = parse_du_bytes(journal.read_text())
        ready = host_dir / "ready.json"
        tracking = [
            text
            for text in (
                nb.read_json(ready)["chronyc_tracking"] if ready.exists() else None,
                (host_dir / "chrony.txt").read_text()
                if (host_dir / "chrony.txt").exists()
                else None,
            )
            if text is not None
        ]
        if tracking:
            evidence["clock_offset_ms"][name] = max(
                map(parse_clock_offset_ms, tracking)
            )
        if ready.exists():
            evidence["digest_mismatch"][name] = digest_mismatches(
                nb.read_json(ready)["digests"], manifest["images"]
            )
    return stats, evidence


def deployment_meta(manifest: Manifest, evidence: Evidence) -> nb.DeploymentMeta:
    config = manifest["config"]
    images = manifest["images"]
    return {
        "provider": "aws",
        "account": config["account"],
        "region": config["region"],
        "az": manifest["az"],
        "ami": manifest["ami_id"],
        "hosts": {
            h["name"]: {"instance_type": h["instance_type"], "role": h["role"]}
            for h in manifest["hosts"]
        },
        "images": {n: f"{i['ref']}@{i['digest']}" for n, i in images.items()},
        "image_revision": images["espresso-node"]["revision"],
        "start_spread_s": manifest["start_spread_s"],
        "clock_offset_ms_max": max(evidence["clock_offset_ms"].values(), default=0.0),
        "cost_usd": manifest["cost_usd"],
    }


def check_validity_aws(
    result: nb.BenchResult, manifest: Manifest, evidence: Evidence
) -> nb.Validity:
    """`result["validity"]` (netbench's own rules) plus the fleet rules: invalid on missing host
    samples, a digest that differs from the manifest or a clock offset above
    CLOCK_OFFSET_INVALID_MS; noisy on start spread, clock offset, ctl CPU, journal size or steal."""
    invalid: list[str] = []
    noisy: list[str] = []
    for host, frac in evidence["coverage"].items():
        if frac < nb.SCRAPE_OK_MIN:
            invalid.append(f"{host} host samples cover only {frac:.0%} of the window")
    for host, names in evidence["digest_mismatch"].items():
        if names:
            invalid.append(
                f"{host} pulled another digest than the manifest for {', '.join(names)}"
            )
    offset = max(evidence["clock_offset_ms"].values(), default=0.0)
    if offset > CLOCK_OFFSET_INVALID_MS:
        invalid.append(
            f"clock offset {offset:.0f} ms > {CLOCK_OFFSET_INVALID_MS:.0f} ms"
        )
    elif offset > CLOCK_OFFSET_NOISY_MS:
        noisy.append(f"clock offset {offset:.0f} ms > {CLOCK_OFFSET_NOISY_MS:.0f} ms")
    spread = manifest["start_spread_s"]
    if spread >= START_SPREAD_NOISY_S:
        noisy.append(f"nodes started {spread:.1f} s apart")
    hosts = result["hosts"]
    if "ctl" in hosts and hosts["ctl"]["util_mean"] > CTL_CPU_NOISY_FRAC:
        noisy.append(f"ctl CPU busy {hosts['ctl']['util_mean']:.0%}")
    for name, stats in hosts.items():
        # node0's steal is already judged by netbench.check_validity through result["host"].
        if name != "node0" and stats["steal_pct"] > nb.STEAL_NOISY_PCT:
            noisy.append(
                f"{name} steal {stats['steal_pct']:.1f}% > {nb.STEAL_NOISY_PCT:.0f}%"
            )
    specs = {h["name"]: h for h in manifest["hosts"]}
    for name, size in evidence["journal_bytes"].items():
        limit = _journal_max_bytes(specs[name])
        if size > JOURNAL_NOISY_FRACTION * limit:
            noisy.append(
                f"{name} journal {size / 1e9:.1f} GB near its {limit / 1e9:.1f} GB limit"
            )
    base = result["validity"]
    return {
        "valid": base["valid"] and not invalid,
        "noisy": base["noisy"] or bool(noisy),
        "reasons": base["reasons"] + invalid + noisy,
    }


def write_failure_summary(run_dir: Path, manifest: Manifest, error: str | None) -> None:
    """A run without a result: the error (`netbench.wait_ready` includes the last heights) and
    the last log lines of every node container that was collected."""
    lines = ["## Network benchmark", "", f"**invalid**: {error}", ""]
    for spec in manifest["hosts"]:
        path = run_dir / "hosts" / spec["name"] / "espresso-node.log.gz"
        if path.exists():
            try:
                tail = [line[:300] for line in log_tail(path, FAILURE_LOG_LINES)]
            except (OSError, EOFError) as exc:  # a log cut off by a timed-out collect
                tail = [f"log unreadable: {exc}"]
            lines += [f"Last log lines of {spec['name']}:", "", "```", *tail, "```", ""]
    (run_dir / "summary.md").write_text("\n".join(lines))


def log_tail(path: Path, count: int) -> list[str]:
    with gzip.open(path, "rt", errors="replace") as f:
        return f.read().splitlines()[-count:]


def tagged_resources(
    run: Runner, region: str, name: str | None = None, profile: str = RunConfig.profile
) -> list[str]:
    """ARNs of resources tagged `espresso-bench-run`, of one run when `name` is given."""
    tag = f"Key={TAG_RUN}" + (f",Values={name}" if name is not None else "")
    out = aws_ok(
        run,
        profile,
        "resourcegroupstaggingapi",
        "get-resources",
        "--region",
        region,
        "--tag-filters",
        tag,
        "--query",
        "ResourceTagMappingList[].ResourceARN",
        "--output",
        "json",
    )
    return list(json.loads(out))


def sweep(
    run: Runner, region: str, name: str | None, profile: str = RunConfig.profile
) -> list[str]:
    """Terminates the instances found by `tagged_resources`, then deletes their volumes,
    security group and key pair. Returns every ARN found."""
    arns = tagged_resources(run, region, name, profile)
    by_kind: defaultdict[str, list[str]] = defaultdict(list)
    for arn in arns:
        kind, resource_id = arn_parts(arn)
        by_kind[kind].append(resource_id)
    instances = by_kind["instance"]
    if instances:
        ids = ["--instance-ids", *instances]
        aws_ok(run, profile, "ec2", "terminate-instances", "--region", region, *ids)
        aws_ok(
            run, profile, "ec2", "wait", "instance-terminated", "--region", region, *ids
        )
    for volume in by_kind["volume"]:
        # Root volumes normally vanish with their instance.
        aws_ok(
            run,
            profile,
            "ec2",
            "delete-volume",
            "--region",
            region,
            "--volume-id",
            volume,
            tolerate="InvalidVolume.NotFound",
        )
    for group in by_kind["security-group"]:
        delete_security_group(run, region, group, profile)
    for key in by_kind["key-pair"]:
        aws_ok(
            run,
            profile,
            "ec2",
            "delete-key-pair",
            "--region",
            region,
            "--key-pair-id",
            key,
        )
    return arns


def delete_security_group(run: Runner, region: str, group: str, profile: str) -> None:
    for attempt in range(1, SG_DELETE_RETRIES + 1):
        try:
            aws_ok(
                run,
                profile,
                "ec2",
                "delete-security-group",
                "--region",
                region,
                "--group-id",
                group,
            )
            return
        except RemoteError as exc:
            if "DependencyViolation" not in str(exc) or attempt == SG_DELETE_RETRIES:
                raise
            log.debug("security group %s still in use, retrying", group)
            time.sleep(SG_DELETE_BACKOFF_S)


TERMINATION_TIME = re.compile(r"\((\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) GMT\)")


def actual_cost(run: Runner, manifest: Manifest) -> dict[str, float]:
    """expected, bound and actual USD, with the run's wall time in `duration_s`. Actual is the
    estimate's price lines at the time between the first launch and the last termination,
    from `describe-instances` (terminated instances stay listed for about an hour)."""
    config = manifest["config"]
    rows = describe_instances(
        run,
        config["region"],
        config["profile"],
        f"Name=tag:{TAG_RUN},Values={manifest['name']}",
    )
    if not rows:
        raise RemoteError(f"no instances tagged {manifest['name']} to price")
    launches = [datetime.fromisoformat(row["launch"]) for row in rows]
    ends = []
    for row in rows:
        if row.get("reason") is None:
            continue
        match = TERMINATION_TIME.search(row["reason"])
        if match is None:
            raise ValueError(f"no termination time in {row['reason']!r}")
        ends.append(datetime.fromisoformat(match.group(1)).replace(tzinfo=UTC))
    if not ends:
        raise ValueError(f"no termination reason for {manifest['name']}")
    duration_s = (max(ends) - min(launches)).total_seconds()
    estimate = manifest["estimate"]
    return {
        "expected": estimate["expected_usd"],
        "bound": estimate["bound_usd"],
        "actual": manifest_cost(manifest, duration_s),
        "duration_s": duration_s,
    }


def manifest_cost(manifest: Manifest, duration_s: float) -> float:
    """USD of the whole fleet running `duration_s`, at the prices the estimate recorded."""
    estimate = manifest["estimate"]
    prices: Prices = {
        "instances": {
            line["item"].removeprefix("instance "): {
                "usd_hour": line["usd_per_unit"],
                "source": line["source"],
            }
            for line in estimate["lines"]
            if line["item"].startswith("instance ")
        }
    }
    lines = _cost_lines(
        manifest["hosts"],
        prices,
        region_minor_prices(manifest["config"]["region"]),
        duration_s,
    )
    return sum(line["usd"] for line in lines)


INDEX_HEADER = (
    "| name | utc | git | tag@rev | N | rate MB/s | decided MB/s | kept up | lag p99 ms "
    "| status | exit | cost bound/actual | destroyed |\n"
    "|---|---|---|---|---|---|---|---|---|---|---|---|---|\n"
)


def index_row(
    manifest: Manifest,
    result: nb.BenchResult | None,
    code: int,
    destroyed: bool,
    cost: dict[str, float] | None,
) -> str:
    rate = decided = kept_up = lag = "-"
    status = "failed"
    if result is not None:
        status = nb.verdict_word(result["validity"])
        limits = result["capacity"]
        rate = nb.fmt_num(limits["overall"]["mb_s"])
        kept_up = (
            "yes"
            if limits["query_node"]["mb_s"] == limits["consensus"]["mb_s"]
            else "no"
        )
        passing = [s for s in result["steps"] if s["passed"]]
        if passing:
            decided = nb.fmt_num(passing[-1]["decided_mb_s"])
            quantiles = passing[-1]["query_lag_ms"]
            lag = f"{quantiles['p99']:.0f}" if quantiles else "-"
    revision = (manifest["images"]["espresso-node"]["revision"] or "-")[:10]
    actual = f"{cost['actual']:.2f}" if cost else "-"
    cells = [
        manifest["name"],
        manifest["created_at"][:16],
        manifest["git_rev"][:10],
        f"{manifest['config']['tag']}@{revision}",
        str(manifest["config"]["nodes"]),
        rate,
        decided,
        kept_up,
        lag,
        status,
        str(code),
        f"{manifest['estimate']['bound_usd']:.2f}/{actual}",
        "yes" if destroyed else "no",
    ]
    return "| " + " | ".join(cells) + " |\n"


def append_index(
    out_root: Path,
    manifest: Manifest,
    result: nb.BenchResult | None,
    code: int,
    destroyed: bool,
    cost: dict[str, float] | None,
) -> None:
    path = out_root / "INDEX.md"
    with path.open("a") as f:
        if f.tell() == 0:
            f.write(INDEX_HEADER)
        f.write(index_row(manifest, result, code, destroyed, cost))


class AgentReporter(logging.Handler):
    """Owns `agent-state.json`, rewritten atomically for the laptop's `poll_agent`. Attached to
    the `netbench` logger it also stores the latest INFO line as `progress`."""

    def __init__(self, path: Path):
        super().__init__(level=logging.INFO)
        self.path = path
        self.state: AgentState = {"phase": "waiting", "detail": "starting"}
        self._write_lock = threading.Lock()
        self.flush_state()

    def flush_state(self) -> None:
        with self._write_lock:
            tmp = self.path.with_suffix(".tmp")
            nb.write_json(tmp, self.state)
            os.replace(tmp, self.path)

    def set_phase(
        self, phase: Literal["waiting", "loading", "done", "error"], detail: str
    ) -> None:
        self.state["phase"] = phase
        self.state["detail"] = detail
        self.flush_state()

    def emit(self, record: logging.LogRecord) -> None:
        self.state["progress"] = record.getMessage()
        self.flush_state()


def raise_interrupt(signum: int, frame: Any) -> None:
    raise KeyboardInterrupt


def cmd_agent_drive(args: argparse.Namespace) -> int:
    """Runs on ctl under systemd-run: waits for the nodes, then `netbench.drive_load` against
    their private URLs. SIGTERM unwinds like Ctrl-C so `drive_load` flushes its output."""
    agent = nb.read_json(args.config)
    cfg = load_config(agent["cfg"])
    topo: nb.Topology = agent["topology"]
    args.out.mkdir(parents=True, exist_ok=True)
    reporter = AgentReporter(args.out / "agent-state.json")
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        handlers=[logging.FileHandler(args.out / "agent.log"), logging.StreamHandler()],
    )
    nb.log.addHandler(reporter)
    signal.signal(signal.SIGTERM, raise_interrupt)
    stop = threading.Event()
    sampler = threading.Thread(
        target=nb.sample_metrics,
        args=(topo["nodes"], nb.METRIC_PREFIXES, args.out / "metrics.jsonl", stop),
    )
    sampler.start()
    pool = nb.HttpPool()
    try:
        ready_s = nb.wait_ready(
            pool,
            topo["nodes"],
            nb.MIN_READY_HEIGHT,
            agent["ready_timeout_s"],
            lambda: True,
        )
        reporter.state["ready_s"] = ready_s
        reporter.set_phase("loading", f"ready after {ready_s:.0f} s")
        outcome = nb.drive_load(cfg, topo, args.out, lambda: True)
        reporter.state["t0"], reporter.state["t1"] = outcome["t0"], outcome["t1"]
        reporter.set_phase("done", "load finished")
        return EXIT_OK
    except (Exception, KeyboardInterrupt) as exc:
        cause = nb.innermost(exc)
        if isinstance(exc, KeyboardInterrupt):
            message = "interrupted"
        elif isinstance(exc, nb.NetworkError):
            message = str(exc)
        else:
            message = f"{type(cause).__name__}: {cause}"
        log.exception("agent failed")
        reporter.state["error"] = message
        reporter.set_phase("error", message)
        return EXIT_INVALID
    finally:
        pool.close()
        stop.set()
        sampler.join()


def diskstats(text: str) -> dict[str, dict[str, int]]:
    """/proc/diskstats; sector size is a kernel-wide constant (512 bytes), not per-device. The
    kernel's column count is fixed, so a short line means this parser is wrong, not that the
    line should be skipped."""
    sector_bytes = 512
    stats: dict[str, dict[str, int]] = {}
    for line in text.splitlines():
        fields = line.split()
        if len(fields) < 14:
            raise ValueError(f"diskstats line has fewer than 14 fields: {line!r}")
        stats[fields[2]] = {
            "read_bytes": int(fields[5]) * sector_bytes,
            "write_bytes": int(fields[9]) * sector_bytes,
            "io_ticks_ms": int(fields[12]),
            "reads": int(fields[3]),
            "writes": int(fields[7]),
            "read_ms": int(fields[6]),
            "write_ms": int(fields[10]),
            "in_flight": int(fields[11]),
            "weighted_ms": int(fields[13]),
        }
    return stats


def netdev(text: str) -> dict[str, dict[str, int]]:
    """/proc/net/dev; header lines have no `:` and are skipped. A device line with a `:` but
    fewer than 16 fields means this parser is wrong, not that the line should be skipped."""
    stats: dict[str, dict[str, int]] = {}
    for line in text.splitlines():
        name, sep, rest = line.partition(":")
        if not sep:
            continue
        fields = rest.split()
        if len(fields) < 16:
            raise ValueError(f"netdev line has fewer than 16 fields: {line!r}")
        stats[name.strip()] = {"rx_bytes": int(fields[0]), "tx_bytes": int(fields[8])}
    return stats


def parse_cpu_stat(text: str) -> int:
    """cgroup v2 cpu.stat, `usage_usec <n>` line."""
    for line in text.splitlines():
        key, sep, value = line.partition(" ")
        if sep and key == "usage_usec":
            return int(value)
    raise ValueError("usage_usec not found in cpu.stat")


def parse_memory_stat_anon(text: str) -> int:
    """cgroup v2 memory.stat, `anon <n>` line: the RSS-equivalent field. memory.current also
    counts page cache, which journal writes inflate well past actual process memory use."""
    for line in text.splitlines():
        key, sep, value = line.partition(" ")
        if sep and key == "anon":
            return int(value)
    raise ValueError("anon not found in memory.stat")


def container_stats(
    containers: dict[str, str], cgroup_root: Path = CGROUP_ROOT
) -> dict[str, dict[str, float]]:
    """name -> {cpu_s, rss}, read from system.slice/docker-<id>.scope. A container whose scope
    is already gone (exited, or not yet created) contributes nothing."""
    stats: dict[str, dict[str, float]] = {}
    for name, container_id in containers.items():
        scope = cgroup_root / "system.slice" / f"docker-{container_id}.scope"
        try:
            cpu_usec = parse_cpu_stat((scope / "cpu.stat").read_text())
            rss = parse_memory_stat_anon((scope / "memory.stat").read_text())
        except FileNotFoundError:
            continue
        stats[name] = {"cpu_s": cpu_usec / 1_000_000, "rss": rss}
    return stats


def load_containers(path: Path) -> dict[str, str]:
    """name -> container id, written incrementally by start.sh; empty before any container is
    created, so the sampler can start before `docker create` runs."""
    if not path.exists():
        return {}
    return json.loads(path.read_text())


def host_sample(
    containers: dict[str, str], cgroup_root: Path = CGROUP_ROOT
) -> dict[str, Any]:
    """Same shape as bench.sample_host's record, plus disk and net throughput counters and
    per-container cpu/mem in place of bench's per-process labels."""
    return {
        "ts": time.time(),
        "cpu": nb.usable_cpu_jiffies(),
        "load1": float(Path("/proc/loadavg").read_text().split()[0]),
        "psi_cpu": nb.psi("cpu"),
        "psi_io": nb.psi("io"),
        "mem_avail": nb.meminfo()["MemAvailable"],
        "procs": container_stats(containers, cgroup_root),
        "disk": diskstats(Path("/proc/diskstats").read_text()),
        "net": netdev(Path("/proc/net/dev").read_text()),
    }


def pg_sample_sql(has_checkpointer: bool) -> str:
    """One json object of cumulative counters. PG17 moved checkpoint counters from
    pg_stat_bgwriter to pg_stat_checkpointer; both are reported under the new names."""
    checkpoints = (
        "'num_timed', c.num_timed, 'num_requested', c.num_requested, "
        "'buffers_written', c.buffers_written"
        if has_checkpointer
        else "'num_timed', b.checkpoints_timed, 'num_requested', b.checkpoints_req, "
        "'buffers_written', b.buffers_checkpoint"
    )
    checkpointer = ", pg_stat_checkpointer c" if has_checkpointer else ""
    backends = (
        "from pg_stat_activity where datname = 'espresso' and pid <> pg_backend_pid()"
    )
    wal_keys = (
        "'wal_records','wal_bytes','wal_buffers_full','wal_write_time','wal_sync_time'"
    )
    return (
        "select (jsonb_build_object("
        "'xact_commit', d.xact_commit, 'xact_rollback', d.xact_rollback, "
        "'blks_read', d.blks_read, 'blks_hit', d.blks_hit, "
        "'tup_inserted', d.tup_inserted, 'tup_updated', d.tup_updated, "
        "'tup_deleted', d.tup_deleted, 'temp_bytes', d.temp_bytes, "
        "'deadlocks', d.deadlocks, 'active_time', d.active_time, "
        "'idle_in_transaction_time', d.idle_in_transaction_time, "
        f"{checkpoints}, "
        "'buffers_clean', b.buffers_clean, 'maxwritten_clean', b.maxwritten_clean, "
        f"'active_backends', (select count(*) {backends} and state = 'active'), "
        "'wait_events', (select coalesce(jsonb_object_agg(wt, n), '{}'::jsonb) from "
        f"(select coalesce(wait_event_type, 'none') as wt, count(*) as n {backends} "
        "group by 1) g), "
        "'database_bytes', pg_database_size('espresso')) "
        "|| (select jsonb_object_agg(key, value) from jsonb_each(to_jsonb(w)) "
        f"where key in ({wal_keys})))::text "
        f"from pg_stat_database d, pg_stat_bgwriter b, pg_stat_wal w{checkpointer} "
        "where d.datname = 'espresso'"
    )


def pg_sample(run: Runner, has_checkpointer: bool) -> dict[str, Any] | None:
    """None when psql fails (Postgres not up yet, or stopped at freeze)."""
    result = run([*PSQL, "-At", "-c", pg_sample_sql(has_checkpointer)])
    if result.returncode != 0:
        log.debug("pg sample failed: %s", result.stderr.strip())
        return None
    return {"ts": time.time(), **json.loads(result.stdout)}


def has_checkpointer_view(run: Runner) -> bool | None:
    probe = "select to_regclass('pg_stat_checkpointer') is not null"
    result = run([*PSQL, "-At", "-c", probe])
    if result.returncode != 0:
        log.debug("pg probe failed: %s", result.stderr.strip())
        return None
    return result.stdout.strip() == "t"


def sample_pg(out: Path, stop: threading.Event, run: Runner = _run) -> None:
    has_checkpointer = None
    with out.open("a", buffering=1) as f:
        while not stop.is_set():
            if has_checkpointer is None:
                has_checkpointer = has_checkpointer_view(run)
            if has_checkpointer is not None:
                sample = pg_sample(run, has_checkpointer)
                if sample is not None:
                    f.write(json.dumps(sample) + "\n")
            stop.wait(PG_SAMPLE_S)


def cmd_agent_host(args: argparse.Namespace, run: Runner = _run) -> int:
    containers_path = Path(BENCH_DIR) / "containers.json"
    stop = threading.Event()
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stop.set())
    pg_thread = None
    if args.role == "query":
        pg_out = args.out.with_name("pg-stats.jsonl")
        pg_thread = threading.Thread(target=sample_pg, args=(pg_out, stop, run))
        pg_thread.start()
    with args.out.open("a", buffering=1) as f:
        while not stop.is_set():
            f.write(json.dumps(host_sample(load_containers(containers_path))) + "\n")
            stop.wait(HOST_SAMPLE_S)
    if pg_thread is not None:
        pg_thread.join()
    return EXIT_OK


def main() -> int:
    argv = sys.argv[1:]
    args = parse_args(argv)
    args.argv = argv
    if args.command in ("status", "destroy"):
        logging.basicConfig(level=logging.INFO, format="%(message)s")
    try:
        return args.func(args)
    except Refused as exc:
        log.error("error: %s", exc)
        return EXIT_REFUSED
    except RemoteError as exc:
        log.error("error: %s", exc)
        return EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main())
