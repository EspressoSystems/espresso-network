def read_agent_log(remote: Remote, offset: int) -> str:
    """`agent.log` from byte `offset` on; empty before the agent created it."""
    result = remote.ssh(
        "ctl", f"tail -c +{offset + 1} {BENCH_DIR}/out/agent.log", check=False
    )
    return result.stdout if result.returncode == 0 else ""


AGENT_LOG_LINE = re.compile(r"^\S+ \S+ (?P<level>[A-Z]+) (?P<message>.*)$")


def agent_log_lines(chunk: str) -> tuple[list[tuple[int, str]], int]:
    """The complete lines of an `agent.log` chunk as (level, message), and the bytes they span;
    a trailing partial line waits for the next read. A line not in the agent's format, such as
    a traceback, keeps its text at INFO."""
    whole = chunk[: chunk.rfind("\n") + 1]
    lines = []
    for line in whole.splitlines():
        match = AGENT_LOG_LINE.match(line)
        if match is None:
            lines.append((logging.INFO, line))
        else:
            level = logging.getLevelNamesMapping()[match["level"]]
            lines.append((level, match["message"]))
    return lines, len(whole.encode())


def read_agent_state(remote: Remote) -> AgentState | None:
    result = remote.ssh("ctl", f"cat {BENCH_DIR}/out/agent-state.json", check=False)
    return json.loads(result.stdout) if result.returncode == 0 else None


class PollState(TypedDict):
    """`poll_agent` loop state. `begin`, `deadline` and the `next_*` times are on the clock's
    monotonic scale; `state` is the latest agent state read."""

    begin: float
    deadline: float
    next_sync: float
    next_node_check: float
    unreachable: int
    state: AgentState | None


class PollStep(TypedDict):
    """What `poll_agent` does after one probe: `error` raises, `done` returns `state["state"]`,
    `retry` warns that ctl was unreachable, `rsync` and `node_check` are due; then it sleeps."""

    state: PollState
    done: bool
    error: str | None
    rsync: bool
    node_check: bool
    retry: bool


def poll_result(
    state: PollState,
    *,
    done: bool = False,
    error: str | None = None,
    rsync: bool = False,
    node_check: bool = False,
    retry: bool = False,
) -> PollStep:
    return PollStep(
        state=state,
        done=done,
        error=error,
        rsync=rsync,
        node_check=node_check,
        retry=retry,
    )


def poll_step(
    state: PollState,
    probe_rc: int,
    probe_stderr: str,
    agent: AgentState | None,
    now: float,
) -> PollStep:
    """One decision of `poll_agent`. `probe_rc` and `probe_stderr` are of `systemctl is-active`
    on ctl; `agent` is the state file just read, None when absent or not read. Rules apply in
    order: unreachable ctl, unexpected rc, done, agent error, inactive unit, no state file,
    deadline, then rsync and node check due."""
    if probe_rc == SSH_FAILED_RC:
        unreachable = state["unreachable"] + 1
        state = {**state, "unreachable": unreachable}
        if unreachable > AGENT_POLL_SSH_FAILURES_MAX:
            return poll_result(
                state,
                error=f"ctl unreachable for {unreachable} polls: {probe_stderr.strip()}",
            )
        return poll_result(state, retry=True)
    if probe_rc not in AGENT_PROBE_RCS:
        return poll_result(
            state,
            error=f"systemctl is-active exited {probe_rc}: {probe_stderr.strip()}",
        )
    latest = agent if agent is not None else state["state"]
    state = {**state, "unreachable": 0, "state": latest}
    if latest is not None and latest["phase"] == "done":
        return poll_result(state, done=True)
    if latest is not None and latest["phase"] == "error":
        return poll_result(state, error=f"agent failed: {latest['error']}")
    if probe_rc != 0:
        phase = latest["phase"] if latest else "start"
        return poll_result(
            state, error=f"agent exited in phase {phase} without finishing"
        )
    if latest is None and now - state["begin"] > AGENT_START_GRACE_S:
        return poll_result(state, error="agent wrote no state file")
    if now > state["deadline"]:
        return poll_result(state, error="agent did not finish within the expected time")
    rsync_due = now >= state["next_sync"]
    if rsync_due:
        state = {**state, "next_sync": now + OUT_RSYNC_S}
    check_due = now >= state["next_node_check"]
    if check_due:
        state = {**state, "next_node_check": now + NODE_CHECK_S}
    return poll_result(state, rsync=rsync_due, node_check=check_due)


NODE_STATUS_COMMAND = (
    "sudo docker inspect -f '{{.State.Status}} {{.State.ExitCode}}' espresso-node"
)


def node_status(result: subprocess.CompletedProcess[str]) -> tuple[str, int] | None:
    """`(status, exit code)` of an `espresso-node` container from `NODE_STATUS_COMMAND`; None
    when ssh failed, which the next check retries."""
    if result.returncode == SSH_FAILED_RC:
        return None
    if result.returncode != 0:
        raise RemoteError(
            f"docker inspect exited {result.returncode}: {result.stderr.strip()}"
        )
    status, _, code = result.stdout.strip().partition(" ")
    if not code.isdigit():
        raise RemoteError(f"unparsable docker inspect output: {result.stdout!r}")
    return status, int(code)


def dead_nodes(statuses: dict[str, tuple[str, int] | None]) -> dict[str, int]:
    """Exit code per node whose container is not running; unreachable nodes are skipped."""
    return {
        name: status[1]
        for name, status in statuses.items()
        if status is not None and status[0] != "running"
    }


def manifest_storage(config: dict[str, Any]) -> ConsensusStorage:
    return config.get("consensus_storage", LEGACY_CONSENSUS_STORAGE)


def check_nodes(remote: Remote) -> None:
    """Raises when an `espresso-node` container is not running, with the log tail of the
    first such node."""
    names = [info["name"] for info in node_hosts(remote.hosts)]
    statuses = remote.parallel(
        lambda name: node_status(remote.ssh(name, NODE_STATUS_COMMAND, check=False)),
        names,
    )
    dead = dead_nodes(statuses)
    if not dead:
        return
    first, *others = dead
    logs = remote.ssh(
        first, "sudo docker logs --tail 20 espresso-node 2>&1", check=False
    )
    tail = logs.stdout if logs.returncode == 0 else logs.stderr
    also = "".join(f" (also {name} exit {dead[name]})" for name in others)
    raise RemoteError(
        f"{first} espresso-node exited {dead[first]}{also}: {tail.strip()}"
    )


def poll_agent(
    remote: Remote, run_dir: Path, cfg: RunConfig, interrupts: Interrupts
) -> AgentState:
    """Until the agent reports `done`: reads its state every AGENT_POLL_S, logs each new line of
    its `agent.log` and each new phase, and rsyncs its output every OUT_RSYNC_S."""
    clock = interrupts.clock
    begin = clock.monotonic()
    poll = PollState(
        begin=begin,
        deadline=begin
        + READY_TIMEOUT_S
        + load_seconds(cfg.load, cfg.search, worst=True)
        + AGENT_SLACK_S,
        next_sync=begin + OUT_RSYNC_S,
        next_node_check=begin + NODE_CHECK_S,
        unreachable=0,
        state=None,
    )
    offset, shown = 0, None
    while True:
        interrupts.check()
        probe = remote.ssh(
            "ctl", "systemctl is-active --quiet bench-agent", check=False
        )
        agent = (
            read_agent_state(remote) if probe.returncode in AGENT_PROBE_RCS else None
        )
        step = poll_step(poll, probe.returncode, probe.stderr, agent, clock.monotonic())
        poll = step["state"]
        latest = poll["state"]
        if latest is not None and (latest["phase"], latest["detail"]) != shown:
            shown = latest["phase"], latest["detail"]
            log.info("%s: %s", *shown)
        lines, read = agent_log_lines(read_agent_log(remote, offset))
        offset += read
        for level, message in lines:
            log.log(level, "%s: %s", latest["phase"] if latest else "waiting", message)
        if step["error"] is not None:
            raise RemoteError(step["error"])
        if step["done"]:
            assert latest is not None
            return latest
        if step["retry"]:
            log.warning("ctl unreachable, retrying: %s", probe.stderr.strip())
        if step["node_check"]:
            check_nodes(remote)
        if step["rsync"]:
            best_effort(
                "partial rsync",
                lambda: remote.rsync_from("ctl", f"{BENCH_DIR}/out/", run_dir),
            )
        interrupts.sleep(AGENT_POLL_S)


