def rds_schedule_at(expires: datetime) -> str:
    """The `at()` timestamp of the delete schedule: `RDS_REAPER_LEAD_S` before the hosts end."""
    reaper = expires - timedelta(seconds=RDS_REAPER_LEAD_S)
    return reaper.strftime("%Y-%m-%dT%H:%M:%S")


def rds_tfvars(rds: RdsSpec, password: str, expires: datetime) -> dict[str, Any]:
    """The `rds` and `rds_password` variables: the container's tuning and observability
    settings in the units of the parameter group."""
    # The RDS class is fixed whatever `--node-type`, and was sized against the reference values.
    tuning = {key: setting for key, (_, setting) in pg_tuning(PG_REFERENCE_MIB).items()}
    return {
        "rds": {
            **rds,
            "parameters": {**tuning, **PG_OBSERVABILITY},
            "delete_at": rds_schedule_at(expires),
        },
        "rds_password": password,
    }


def write_private_json(path: Path, data: Any) -> None:
