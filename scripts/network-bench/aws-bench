def main() -> int:
    argv = sys.argv[1:]
    args = parse_args(argv)
    args.argv = argv
    try:
        return args.func(args)
    except Refused as exc:
        log.error("error: %s", exc)
        return EXIT_REFUSED
    except TfFailed as exc:
        log.error("error: %s", exc)
        return EXIT_LEFTOVER if exc.stage == "destroy" else EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main())
