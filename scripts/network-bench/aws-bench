def submit_nodes(args: argparse.Namespace, nodes: int) -> int:
    return nodes if args.submit_nodes is None else args.submit_nodes


def check_submit_nodes(cfg: RunConfig) -> None:
    if cfg.load.submit_nodes > cfg.nodes:
        raise Refused(
            f"--submit-nodes must be at most --nodes ({cfg.nodes}): "
            f"{cfg.load.submit_nodes}"
        )


def block_size(text: str) -> str:
    if re.fullmatch(r"[1-9]\d*(kb|mb|gb)", text, re.IGNORECASE) is None:
        raise argparse.ArgumentTypeError(f"not a size like 50mb: {text}")
    return text


def env_pair(text: str) -> str:
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", text) is None:
        raise argparse.ArgumentTypeError(f"not KEY=VALUE: {text}")
    return text


def config_from_args(args: argparse.Namespace) -> RunConfig:
    keys = [pair.partition("=")[0] for pair in args.node_env]
    for key in keys:
        if keys.count(key) > 1:
            raise Refused(f"--node-env repeats {key}")
    check_latency_flags(args.latency, args.intra_latency, args.tcp_cc, args.mtu)
    search = search_from_args(args)
    load = load_from_args(args, search)
    return RunConfig(
        tag=args.tag,
        allocator=args.allocator,
        nodes=args.nodes,
        node_type=args.node_type,
        ctl_type=args.ctl_type,
        load=load,
        node_env=tuple(args.node_env),
        max_block_size=args.max_block_size,
        leader_trace=args.leader_trace,
        latency=args.latency,
        intra_latency=args.intra_latency,
        tcp_cc=args.tcp_cc,
        mtu=args.mtu,
        consensus_storage=args.consensus_storage,
        root_gb=args.root_gb,
        pg_iops=args.pg_iops,
        pg_mbps=args.pg_mbps,
        region=args.region,
        max_usd=args.max_usd,
        yes=args.yes,
        search=search,
    )


def search_from_args(args: argparse.Namespace) -> nb.SearchConfig | None:
    budgets = {
        "resolution_mb_s": args.resolution_mb_s,
        "max_probes": args.max_probes,
        "offered_gb": args.offered_gb,
    }
    given = {key: value for key, value in budgets.items() if value is not None}
    if args.search is None:
        if given:
            flags = ", ".join("--" + key.replace("_", "-") for key in given)
            raise Refused(f"{flags} needs --search")
        return None
    return nb.SearchConfig(start_mb_s=args.search, **given)


def load_from_args(
    args: argparse.Namespace, search: nb.SearchConfig | None
) -> nb.BenchConfig:
    """Flags not given take the ramp's defaults, or the search's. A search probes one rate at
    a time, so `--steps` takes at most one value, unused."""
    defaults = aws_load()
    if search is None:
        step_s, cap_s, tx_timeout_s = (
            defaults.step_s,
            defaults.cap_s,
            defaults.tx_timeout_s,
        )
        steps = defaults.steps
    else:
        step_s, cap_s, tx_timeout_s = SEARCH_STEP_S, SEARCH_CAP_S, SEARCH_TX_TIMEOUT_S
        if args.steps is not None and len(args.steps) > 1:
            raise Refused("--search takes one --steps value")
        steps = (search.start_mb_s,)
    return nb.BenchConfig(
        steps=steps if args.steps is None else args.steps,
        step_s=step_s if args.step_s is None else args.step_s,
        submit_nodes=submit_nodes(args, args.nodes),
        workers=args.submit_workers,
        namespaces=(
            defaults.namespaces[0],
            defaults.namespaces[0] + args.namespaces - 1,
        ),
        cap_s=cap_s if args.cap_s is None else args.cap_s,
        tx_timeout_s=tx_timeout_s if args.tx_timeout_s is None else args.tx_timeout_s,
        warmup_s=args.warmup_s,
        keep_going=args.keep_going,
        heartbeat_tx_s=args.heartbeat_tx_s,
    )


def positive_float(text: str) -> float:
    try:
        value = float(text)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"expected a number: {text}") from exc
    if not value > 0:
        raise argparse.ArgumentTypeError(f"expected a positive number: {text}")
    return value


def positive_int(text: str) -> int:
    if not (text.isdigit() and int(text) > 0):
        raise argparse.ArgumentTypeError(f"expected a positive integer: {text}")
    return int(text)


def ttl_min_arg(text: str) -> str:
    if text != "auto" and not (text.isdigit() and int(text) > 0):
        raise argparse.ArgumentTypeError(
            f"expected auto or a positive number of minutes: {text}"
        )
    return text


def days_arg(text: str) -> int:
    # At least a day, so a fleet whose `up` waits at its prompt in `planned` is never deleted.
    if not (text.isdigit() and int(text) >= 1):
        raise argparse.ArgumentTypeError(f"expected a number of days >= 1: {text}")
    return int(text)


def parse_db_modes(text: str) -> tuple[DbMode, ...]:
    modes = text.split(",")
    unknown = [mode for mode in modes if mode not in DB_MODES]
    if unknown:
        raise argparse.ArgumentTypeError(
            f"unknown db mode {', '.join(unknown)}; choose from {', '.join(DB_MODES)}"
        )
    return cast(tuple[DbMode, ...], tuple(dict.fromkeys(modes)))


