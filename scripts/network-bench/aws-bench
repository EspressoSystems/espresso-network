    `TF_PLUGIN_CACHE_DIR` has no HCL equivalent, so it stays here."""
    TF_PLUGIN_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    return {"TF_PLUGIN_CACHE_DIR": str(TF_PLUGIN_CACHE_DIR)}


class Terraform:
    """`tofu -chdir=<terraform_dir>` through the injectable Runner. `env` is passed to every tofu
    subprocess."""

    def __init__(self, run: Runner, terraform_dir: Path, env: dict[str, str]):
        self.run = run
        self.dir = terraform_dir
        self.env = env

    def _tofu(self, step: TfStep, *args: str) -> str:
        result = self.run(["tofu", f"-chdir={self.dir}", step, *args], self.env)
        if result.returncode != 0:
            message = tofu_error(result.stderr) or f"exit {result.returncode}"
            raise TfFailed(step, message)
        return result.stdout

    def init(self) -> None:
        self._tofu("init", "-input=false")

    def plan(self) -> str:
        return self._tofu("plan", "-input=false", "-out=plan.bin")

    def apply(self) -> None:
        self._tofu("apply", "-input=false", "-auto-approve", "plan.bin")

    def output(self) -> dict[str, Any]:
        return json.loads(self._tofu("output", "-json"))

    def destroy(self) -> None:
        self._tofu("destroy", "-input=false", "-auto-approve")


ANSI_SGR = re.compile(r"\x1b\[[0-9;]*m")


def tofu_error(stderr: str) -> str:
    """The first `Error:` block of tofu's stderr on one line, without colours and the `╷│╵`
    box; else the last non-blank line, "" for a blank stderr. The block ends at the box's `╵`,
    an unboxed blank line, or the next `Error:`."""
    lines = [ANSI_SGR.sub("", line).strip() for line in stderr.splitlines()]
    texts = [line.removeprefix("│").strip() for line in lines]
    start = next((i for i, text in enumerate(texts) if text.startswith("Error:")), None)
    if start is None:
        return last_line("\n".join(lines))
    block = [texts[start]]
    for line, text in zip(lines[start + 1 :], texts[start + 1 :], strict=True):
        if line in ("╵", "") or text.startswith("Error:"):
            break
        if text:
            block.append(text)
    return "; ".join(block)


def last_line(stderr: str) -> str:
    return next((line for line in reversed(stderr.splitlines()) if line.strip()), "")


