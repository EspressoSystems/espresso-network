class Refused(Exception):
    """A plan or run must be refused before any AWS write; caught once, in `main`."""


class TfFailed(Exception):
    """`tofu apply` or `tofu destroy` failed after resources may already have been created or
    changed, unlike `Refused`. `stage` picks the exit code in `main`: `apply` may have written
    a partial fleet (exit 3, destroyed by the caller); `destroy` means resources may remain
    (exit 4)."""

    def __init__(self, stage: Literal["apply", "destroy"], message: str):
        self.stage = stage
        super().__init__(message)


