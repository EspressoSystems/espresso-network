DOCKER_HUB_HOST = "registry-1.docker.io"
# Both are docker.io aliases in image refs; the registry API itself is only ever reachable at
# registry-1.docker.io (https://docker.io/v2/... 302s to www.docker.com).
DOCKER_HUB_ALIASES = ("docker.io", "index.docker.io")


def parse_ref(ref: str) -> tuple[str, str, str]:
    """`[registry[:port]/]repository[:tag]` -> (registry host, repository, tag). No registry
    segment means docker.io, and a single-word repository is implicitly under `library/`."""
    name, sep, tag = ref.rpartition(":")
    if not sep or "/" in tag:
        name, tag = ref, "latest"
    parts = name.split("/", 1)
    if len(parts) == 1:
        return DOCKER_HUB_HOST, f"library/{parts[0]}", tag
    first, repository = parts
    if first in DOCKER_HUB_ALIASES:
        return DOCKER_HUB_HOST, repository, tag
    if "." in first or ":" in first or first == "localhost":
        return first, repository, tag
    return DOCKER_HUB_HOST, name, tag


def _registry_scheme(host: str) -> str:
    # Loopback is only ever the test fixture; every real registry requires TLS.
    return "http" if host.split(":")[0] in ("localhost", "127.0.0.1") else "https"


def _registry_get(url: str, headers: dict[str, str]) -> tuple[int, Any, bytes]:
    request = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.status, response.headers, response.read()
    except urllib.error.HTTPError as exc:
        with exc:
            return exc.code, exc.headers, exc.read()


def _bearer_token(www_authenticate: str, ref: str) -> str:
    params = dict(re.findall(r'(\w+)="([^"]*)"', www_authenticate))
    realm = params["realm"]
    query = urllib.parse.urlencode({k: v for k, v in params.items() if k != "realm"})
    status, _, body = _registry_get(f"{realm}?{query}", {})
    if status != 200:
        raise Refused(f"token request for {ref} to {realm} failed with status {status}")
    token = json.loads(body)
    return token["token"] if "token" in token else token["access_token"]


def resolve_image(ref: str) -> ImageInfo:
    """Anonymous token challenge, then the manifest (an index for a multi-arch image, or a
    single manifest otherwise) and its config blob, for the digest, the `linux/arm64`
    platform and the `org.opencontainers.image.revision` label. Works against ghcr and docker
    hub unmodified: both implement the same OCI distribution spec."""
    host, repository, tag = parse_ref(ref)
    scheme = _registry_scheme(host)
    manifest_url = f"{scheme}://{host}/v2/{repository}/manifests/{tag}"
    headers = {"Accept": ", ".join(MANIFEST_MEDIA_TYPES)}
    status, resp_headers, body = _registry_get(manifest_url, headers)
    if status == 401:
        headers["Authorization"] = (
            f"Bearer {_bearer_token(resp_headers['WWW-Authenticate'], ref)}"
        )
        status, resp_headers, body = _registry_get(manifest_url, headers)
    if status == 404:
        raise Refused(f"image not found: {ref}")
    if status in (401, 403):
        raise Refused(
            f"image is private or inaccessible anonymously: {ref} (status {status})"
        )
    if status != 200:
        raise Refused(f"unexpected status {status} resolving {ref}")
    manifest = json.loads(body)
    media_type = manifest.get("mediaType", resp_headers.get("Content-Type", ""))
    if media_type in INDEX_MEDIA_TYPES:
        # buildx attestations (SBOM, provenance) show up as extra manifests with
        # platform.os == "unknown" and must not be mistaken for a real platform.
        entries = [m for m in manifest["manifests"] if m["platform"]["os"] != "unknown"]
        platforms = [
            f"{m['platform']['os']}/{m['platform']['architecture']}" for m in entries
        ]
        arm64 = next(
            (
                m
                for m in entries
                if m["platform"]["os"] == "linux"
                and m["platform"]["architecture"] == "arm64"
            ),
            None,
        )
        if arm64 is None:
            raise Refused(
                f"no linux/arm64 platform for {ref}: has {', '.join(platforms)}"
            )
        digest = arm64["digest"]
        child_status, _, child_body = _registry_get(
            f"{scheme}://{host}/v2/{repository}/manifests/{digest}", headers
        )
        if child_status != 200:
            raise Refused(
                f"failed to fetch the arm64 manifest for {ref}: status {child_status}"
            )
        config_digest = json.loads(child_body)["config"]["digest"]
    else:
        digest = resp_headers.get("Docker-Content-Digest") or (
            f"sha256:{hashlib.sha256(body).hexdigest()}"
        )
        config_digest = manifest["config"]["digest"]
        platforms = []
    status, _, config_body = _registry_get(
        f"{scheme}://{host}/v2/{repository}/blobs/{config_digest}", headers
    )
    if status != 200:
        raise Refused(f"failed to fetch the config blob for {ref}: status {status}")
    config = json.loads(config_body)
    if not platforms:
        platform = f"{config['os']}/{config['architecture']}"
        if platform != "linux/arm64":
            raise Refused(f"no linux/arm64 platform for {ref}: has {platform}")
        platforms = [platform]
    revision = (config.get("config", {}).get("Labels") or {}).get(
        "org.opencontainers.image.revision"
    )
    return {"ref": ref, "digest": digest, "revision": revision, "platforms": platforms}


def check_git_clean(run: Runner, allow_dirty: bool) -> str | None:
    """`None` for a clean tree. With `allow_dirty`, returns the diff to be recorded as
    `diff.patch`; without it, a dirty tree is refused. `--untracked-files=no` keeps the
    dirty check in scope with `git diff HEAD`, which never includes untracked files."""
    status = run(["git", "status", "--porcelain", "--untracked-files=no"])
    if status.returncode != 0:
        raise Refused(f"git status failed: {status.stderr.strip()}")
    if not status.stdout.strip():
        return None
    if not allow_dirty:
        raise Refused("git tree is dirty; commit the changes or pass --allow-dirty")
    diff = run(["git", "diff", "HEAD"])
    if diff.returncode != 0:
        raise Refused(f"git diff failed: {diff.stderr.strip()}")
    return diff.stdout


def preflight(
    run: Runner,
    cfg: RunConfig,
    hosts: list[HostSpec],
    which: Callable[[str], str | None] = shutil.which,
) -> Preflight:
    tools = [cfg.tf, "aws", "ssh", "scp", "rsync", "git"]
    if cfg.ssh_key == SSH_KEY_AUTO:
        tools.append("ssh-keygen")
    tools_on_path(tools, which)
    account = caller_account(run, cfg)
    vpc_id = default_vpc(run, cfg)
    types = {h["instance_type"] for h in hosts}
    az = capable_az(run, cfg, types)
    running = _running_instance_types(run, cfg)
    # Fetched once: resolve_ami_arch and vcpu_headroom both need every requested and running
    # instance type's vCPU count and architecture.
    instance_types = describe_instance_types(run, cfg, set(running) | types)
    needed, in_use, quota = vcpu_headroom(run, cfg, hosts, running, instance_types)
    ami_id = resolve_ami(run, cfg, resolve_ami_arch(instance_types, types))
    images = {name: resolve_image(ref) for name, ref in image_refs(cfg).items()}
    git_diff = check_git_clean(run, cfg.allow_dirty)
    return {
        "account": account,
        "vpc_id": vpc_id,
        "az": az,
        "ami_id": ami_id,
        "images": images,
        "vcpu_needed": needed,
        "vcpu_in_use": in_use,
        "vcpu_quota": quota,
        "git_diff": git_diff,
    }


def classify_tf_error(stderr: str) -> str:
    if "VcpuLimitExceeded" in stderr:
        return (
            "VcpuLimitExceeded: aws service-quotas request-service-quota-increase "
            f"--service-code ec2 --quota-code {VCPU_QUOTA_CODE} --desired-value <n>"
        )
    if "InsufficientInstanceCapacity" in stderr:
        return "InsufficientInstanceCapacity: retry with --az <other> or a different instance type"
    if "UnauthorizedOperation" in stderr:
        return "UnauthorizedOperation: check IAM permissions for the AWS profile"
    last_line = next(
        (line for line in reversed(stderr.strip().splitlines()) if line), stderr
    )
    return f"unclassified terraform error: {last_line}"


def terraform_env() -> dict[str, str]:
    """Region, profile and account go into `terraform.tfvars.json` and the provider block, not
    the environment: `region` and `profile` are provider arguments. `TF_PLUGIN_CACHE_DIR` has
    no HCL equivalent, so it stays here."""
    TF_PLUGIN_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    return {"TF_PLUGIN_CACHE_DIR": str(TF_PLUGIN_CACHE_DIR)}


class Terraform:
    """`tofu -chdir=<terraform_dir>` through the injectable Runner. `env` is passed to every tofu
    subprocess."""

    def __init__(self, run: Runner, tf: str, terraform_dir: Path, env: dict[str, str]):
        self.run = run
        self.tf = tf
        self.dir = terraform_dir
        self.env = env

    def _tofu(self, *args: str) -> subprocess.CompletedProcess[str]:
        return self.run([self.tf, f"-chdir={self.dir}", *args], self.env)

    def init(self) -> None:
        result = self._tofu("init", "-input=false")
        if result.returncode != 0:
            raise Refused(f"tofu init failed: {result.stderr.strip()}")

    def plan(self, out: str = "plan.bin") -> str:
        result = self._tofu("plan", "-input=false", f"-out={out}")
        if result.returncode != 0:
            raise Refused(f"tofu plan failed: {result.stderr.strip()}")
        return result.stdout

    def apply(self, plan_file: str = "plan.bin") -> None:
        result = self._tofu("apply", "-input=false", "-auto-approve", plan_file)
        if result.returncode != 0:
            raise TfFailed("apply", classify_tf_error(result.stderr))

    def output(self) -> dict[str, Any]:
        result = self._tofu("output", "-json")
        if result.returncode != 0:
            raise TfFailed("output", f"tofu output failed: {result.stderr.strip()}")
        return json.loads(result.stdout)

    def destroy(self) -> None:
        result = self._tofu("destroy", "-input=false", "-auto-approve")
        if result.returncode != 0:
            raise TfFailed("destroy", f"tofu destroy failed: {result.stderr.strip()}")


