def render_postgres_args(memory_mib: int) -> list[str]:
    tuning = {key: conf for key, (conf, _) in pg_tuning(memory_mib).items()}
    settings = {**tuning, **PG_OBSERVABILITY, **PG_SSL}
    return [arg for key, value in settings.items() for arg in ("-c", f"{key}={value}")]


def check_pg_tuning(settings: dict[str, Any], tuning: PgTuning) -> list[str]:
    """Keys of `tuning` whose collected pg_settings value differs from the configured one."""
    return [key for key, (_, setting) in tuning.items() if settings[key] != setting]


def run_pg_tuning(manifest: Manifest) -> PgTuning:
    """The tuning the run's Postgres was given: scaled to node0's memory in the container,
    the reference values on the separately sized RDS class."""
    if manifest["query_db"] == "rds":
        return pg_tuning(PG_REFERENCE_MIB)
    node0 = next(h for h in manifest["hosts"] if h["role"] == "query")
    return pg_tuning(manifest["memory_mib"][node0["instance_type"]])


def pg_tls(backends: dict[str, int]) -> bool | None:
