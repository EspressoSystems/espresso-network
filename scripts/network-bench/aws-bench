class Refused(Exception):
    """A plan or run must be refused before any AWS write; caught once, in `main`."""


class TfFailed(Exception):
    """`tofu apply`, `output` or `destroy` failed after resources may already have been created
    or changed, unlike `Refused`. `measure` and `destroy_fleet` catch it."""

    def __init__(self, stage: Literal["apply", "output", "destroy"], message: str):
        self.stage = stage
        super().__init__(message)


class RemoteError(Exception):
    """ssh/rsync/cloud-init/gate failure against a live fleet; always caught in `cmd_run` and
    turned into a destroy-then-exit-3, the same as `nb.NetworkError` in the local bench."""


class Interrupted(Exception):
    """Raised by `Interrupts.check` after a SIGINT/SIGTERM, caught once in `measure` so `cmd_run`
    runs a bounded collection and a destroy prompt instead of an abrupt exit."""


