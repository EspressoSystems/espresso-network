}
# Columns of INDEX.md rows written before `index-row.json`.
LEGACY_COLUMNS = [
    *("run", "utc", "git", "tag", "nodes", "db", "latency", "rate", "decided"),
    *("kept_up", "lag_p99", "status", "exit", "cost"),
]
INDEX_HEADER = (
    f"| {' | '.join(INDEX_COLUMNS.values())} |\n{'|---' * len(INDEX_COLUMNS)}|\n"
)


def latency_cell(config: dict) -> str:
    # Manifests from before the flag have no such key.
    profile = config.get("latency", "off")
    if profile == "off":
        return "off"
    return profile if config["intra_latency"] else f"{profile} no-intra"


def capacity_bound(limits: nb.Capacity) -> str:
    """What limited the capacity: `query`, `consensus`, `both` (same rate), or `-` when the
    ramp top was reached or there is no result."""
    query, consensus = limits["query_node"], limits["consensus"]
    if not (query["bounded"] or consensus["bounded"]):
        return "-"
    if not query["bounded"]:
        return "consensus"
    if not consensus["bounded"]:
        return "query"
    # A bounded limit without a rate failed the first step, the lowest possible.
    query_mb_s = -1.0 if query["mb_s"] is None else query["mb_s"]
    consensus_mb_s = -1.0 if consensus["mb_s"] is None else consensus["mb_s"]
    if query_mb_s == consensus_mb_s:
        return "both"
    return "query" if query_mb_s < consensus_mb_s else "consensus"


def index_cells(
    manifest: Manifest,
    run_name: str,
    result: nb.BenchResult | None,
    code: int,
    cost: dict[str, float] | None,
) -> dict[str, str]:
    rate = decided = bound = lag = "-"
    status = "failed"
    if result is not None:
        status = nb.verdict_word(result["validity"])
        limits = result["capacity"]
        mb_s = limits["overall"]["mb_s"]
        rate = "-" if mb_s is None else nb.fmt_num(mb_s)
        bound = capacity_bound(limits)
        at_limit = [
            s for s in result["steps"] if s["passed"] and s["rate_mb_s"] == mb_s
        ]
        if at_limit:
            decided = nb.fmt_num(at_limit[-1]["decided_mb_s"])
            quantiles = at_limit[-1]["query_lag_ms"]
            lag = f"{quantiles['p99']:.0f}" if quantiles else "-"
    revision = (manifest["images"]["espresso-node"]["revision"] or "-")[:10]
    return {
        "run": f"{manifest['fleet']}/{run_name}",
        "utc": manifest["created_at"][:16],
        "git": manifest["git_rev"][:10],
        "tag": f"{manifest['config']['tag']}@{revision}",
        "nodes": str(manifest["config"]["nodes"]),
        "db": manifest["query_db"],
        "storage": manifest_storage(manifest["config"]),
        "latency": latency_cell(manifest["config"]),
        "node_type": manifest["config"]["node_type"],
        "rate": rate,
        "decided": decided,
        "bound": bound,
        "lag_p99": lag,
        "status": status,
        "exit": str(code),
        "cost": f"{cost['usd']:.2f}" if cost else "-",
    }


def format_index_row(cells: dict[str, str]) -> str:
    return "| " + " | ".join(cells.values()) + " |\n"


def append_index(out_root: Path, row: str) -> None:
    path = out_root / "INDEX.md"
    with path.open("a") as f:
        if f.tell() == 0:
            f.write(INDEX_HEADER)
        f.write(row)


def record_index(
    run: Run, result: nb.BenchResult | None, code: int, cost: dict[str, float] | None
) -> None:
    """Appends the run's row to INDEX.md and writes the same cells plus `user` to
    `index-row.json`."""
    cells = index_cells(run.manifest, run.run_dir.name, result, code, cost)
    append_index(run.fleet.fleet_dir.parent, format_index_row(cells))
    nb.write_json(
        run.run_dir / INDEX_ROW_JSON, {**cells, "user": run.fleet.system.user()}
    )


def auto_publish(run: Run) -> None:
    """The run is over: a failure only warns and the exit code stands."""
    if run.publish_remote is None:
        return
    try:
        publish_run(run.fleet.system, run.run_dir, run.publish_remote)
    except Exception as exc:  # noqa: BLE001
        log.warning(
            "publish failed: %s: %s; retry: just bench aws publish %s",
            type(exc).__name__,
            exc,
            run.run_dir,
        )


def cmd_publish(args: argparse.Namespace, system: System) -> int:
    failed = 0
    for run_dir in args.dirs:
        try:
            publish_run(system, run_dir, args.results_remote)
        except Exception as exc:  # noqa: BLE001
            log.error("%s: %s: %s", run_dir, type(exc).__name__, exc)
            failed += 1
    return EXIT_FAILED if failed else EXIT_OK


def publish_run(system: System, run_dir: Path, remote: str) -> None:
    """Commits the run's published files to `runs/<fleet>/<run>/` of a shallow, sparse clone of
    `remote` and pushes. Nothing is committed when the content is already there."""
    run_dir = run_dir.resolve()
    if run_dir.parent.name != "runs":
        raise Refused(f"{run_dir} is not a run dir (<fleet>/runs/<run>)")
    name = f"{run_dir.parents[1].name}/{run_dir.name}"
    files = publish_files(run_dir)
    row = read_index_row(run_dir)
    with tempfile.TemporaryDirectory(prefix="bench-results-") as tmp:
        repo = Path(tmp)
        dest = repo / "runs" / name
        clone = ("clone", "--depth", "1", "--filter=blob:none", "--sparse", remote, ".")
        git(system, repo, *clone)
        git(system, repo, "sparse-checkout", "set", f"runs/{name}")
        if dest.exists():
            shutil.rmtree(dest)
        for rel in files:
            (dest / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(run_dir / rel, dest / rel)
        nb.write_json(dest / MANIFEST_JSON, published_manifest(run_dir))
        nb.write_json(dest / INDEX_ROW_JSON, row)
        git(system, repo, "add", "--all", "runs")
        if not git(system, repo, "status", "--porcelain").stdout.strip():
            log.info("%s already published", name)
            return
        git(system, repo, "commit", "-m", commit_message(name, row))
        push_with_rebase(system, repo)
    log.info("published %s to %s", name, remote)


def publish_files(run_dir: Path) -> list[Path]:
    """Allowlist: the rest of a run dir holds secrets (pg.json, ssh/) or is large (logs).
    `manifest.json` and `index-row.json` are written separately. A symlink is refused: it could
    point at any file of this machine."""
    optional = [Path(n) for n in PUBLISH_OPTIONAL if (run_dir / n).is_file()]
    pngs = sorted(p.relative_to(run_dir) for p in run_dir.glob("trace/*.png"))
    files = [*map(Path, PUBLISH_REQUIRED), *optional, *pngs]
    for rel in [*files, Path("trace"), Path(MANIFEST_JSON), Path(INDEX_ROW_JSON)]:
        if (run_dir / rel).is_symlink():
            raise Refused(f"{run_dir / rel} is a symlink")
    return files


def published_manifest(run_dir: Path) -> dict[str, Any]:
    """Explicit field allowlist: `hosts_info`, `rds_*` and `ssh_public_key` stay local.
    `node_env` and `argv` are public: `--node-env` is documented as not for secrets, and
    `argv` is sanitized."""
    manifest = nb.read_json(run_dir / MANIFEST_JSON)
    reduced = {key: manifest[key] for key in PUBLISH_MANIFEST_KEYS}
    reduced |= {
        k: sanitize_argv(manifest[k])
        for k in PUBLISH_MANIFEST_OPTIONAL
        if k in manifest
    }
    reduced["config"] = manifest["config"]
    if "hosts" in manifest:
        reduced["hosts"] = [
            {key: host[key] for key in ("name", "role", "instance_type")}
            for host in manifest["hosts"]
        ]
    return reduced


def commit_message(name: str, row: dict[str, str]) -> str:
    outcome = "failed"
    if row["status"] != "failed":
        state = "lagging" if row["bound"] == "query" else "kept-up"
        outcome = f"{row['decided']} MB/s {state}"
    return f"run {name}: N={row['nodes']} {row['db']} {outcome}"


def read_index_row(run_dir: Path) -> dict[str, str]:
    """`index-row.json`, or for a run that predates it the row of the local INDEX.md. Cells a
    row lacks are derived from the run dir, and the row is ordered as `INDEX_COLUMNS`."""
    path = run_dir / INDEX_ROW_JSON
    row = nb.read_json(path) if path.exists() else legacy_index_row(run_dir)
    return complete_index_row(run_dir, row)


def complete_index_row(run_dir: Path, row: dict[str, str]) -> dict[str, str]:
    """Rows from before the latency, node type and bound columns get them from the manifest
    and result; a run without result has no bound. `kept_up` is dropped."""
    config = nb.read_json(run_dir / MANIFEST_JSON)["config"]
    result_path = run_dir / "result.json"
    derived = {
        "storage": lambda: manifest_storage(config),
        "latency": lambda: latency_cell(config),
        "node_type": lambda: config["node_type"],
        "bound": lambda: (
            capacity_bound(nb.read_json(result_path)["capacity"])
            if result_path.exists()
            else "-"
        ),
    }
    filled = {k: row[k] if k in row else derived[k]() for k in INDEX_COLUMNS}
    return {**filled, "user": row["user"]}


def legacy_index_row(run_dir: Path) -> dict[str, str]:
    fleet, name = run_dir.parents[1].name, run_dir.name
    index = run_dir.parents[2] / "INDEX.md"
    for line in reversed(index.read_text().splitlines()):
        cells = [cell.strip() for cell in line.strip("|").split("|")]
        if cells[0] == f"{fleet}/{name}":
            columns = LEGACY_COLUMNS
            # Rows from before the latency column have one cell fewer.
            if len(cells) == len(columns) - 1:
                columns = [c for c in columns if c != "latency"]
            row = dict(zip(columns, cells, strict=True))
            # Fleet names are `{user}-{%Y%m%d-%H%M%S}`.
            return {**row, "user": fleet.rsplit("-", 2)[0]}
    raise Refused(f"no row for {fleet}/{name} in {index}")


def git_run(system: System, repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
    """Aborts a stalled transfer after 30 s, never prompts for credentials and does not sign:
    a signing agent waiting for approval would hang the publish. No auto gc or maintenance: a
    detached one writes into the temporary clone while it is being removed."""
    argv = [
        "git",
        "-c",
        "http.lowSpeedLimit=1000",
        "-c",
        "http.lowSpeedTime=30",
        "-c",
        "commit.gpgsign=false",
        "-c",
        "gc.auto=0",
        "-c",
        "maintenance.auto=false",
    ]
    return system.run([*argv, "-C", str(repo), *args], {"GIT_TERMINAL_PROMPT": "0"})


def git(system: System, repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
    done = git_run(system, repo, *args)
    if done.returncode != 0:
        raise Refused(f"git {args[0]} failed: {done.stderr.strip()}")
    return done


def push_with_rebase(system: System, repo: Path) -> None:
    """Another publisher can push first. Runs are separate dirs, so the rebase is clean."""
    for attempt in range(1, PUSH_ATTEMPTS + 1):
        done = git_run(system, repo, "push", "origin", f"HEAD:{RESULTS_BRANCH}")
        if done.returncode == 0:
            return
        stale = any(m in done.stderr for m in ("(fetch first)", "(non-fast-forward)"))
        if not stale or attempt == PUSH_ATTEMPTS:
            raise Refused(f"git push failed: {done.stderr.strip()}")
        log.info("push rejected, rebasing (attempt %d)", attempt)
        git(system, repo, "pull", "--rebase", "origin", RESULTS_BRANCH)


class AgentReporter(logging.Handler):
    """Owns `agent-state.json`, rewritten atomically for the laptop's `poll_agent`. Attached to
    the `netbench` logger it also stores the latest INFO line as `progress`."""

    def __init__(self, path: Path):
        super().__init__(level=logging.INFO)
        self.path = path
        self.state: AgentState = {"phase": "waiting", "detail": "starting"}
        self._write_lock = threading.Lock()
        self.flush_state()

    def flush_state(self) -> None:
        with self._write_lock:
            tmp = self.path.with_suffix(".tmp")
            nb.write_json(tmp, self.state)
            os.replace(tmp, self.path)

    def set_phase(
        self, phase: Literal["waiting", "loading", "done", "error"], detail: str
    ) -> None:
        self.state["phase"] = phase
        self.state["detail"] = detail
        self.flush_state()

    def emit(self, record: logging.LogRecord) -> None:
        self.state["progress"] = record.getMessage()
        self.flush_state()


def raise_interrupt(signum: int, frame: Any) -> None:
    raise KeyboardInterrupt


def cmd_agent_drive(args: argparse.Namespace, system: System) -> int:
    """Runs on ctl under systemd-run: waits for the nodes, then `netbench.drive_load` against
    their private URLs. SIGTERM unwinds like Ctrl-C so `drive_load` flushes its output."""
    agent = nb.read_json(args.config)
    cfg = nb.load_config(agent["cfg"])
    search = search_config(agent["search"])
    topo: nb.Topology = agent["topology"]
    args.out.mkdir(parents=True, exist_ok=True)
    reporter = AgentReporter(args.out / "agent-state.json")
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        handlers=[logging.FileHandler(args.out / "agent.log"), logging.StreamHandler()],
    )
    nb.log.addHandler(reporter)
    system.trap((signal.SIGTERM,), raise_interrupt)
    stop = threading.Event()
    sampler = threading.Thread(
        target=nb.sample_metrics,
        args=(
            topo["nodes"],
            args.out / "metrics.jsonl",
            stop,
            system.clock,
        ),
    )
    sampler.start()
    pool = system.http_pool(system.clock)
    try:
        ready_s = nb.wait_ready(
            pool,
            topo["nodes"],
            nb.MIN_READY_HEIGHT,
            agent["ready_timeout_s"],
            lambda: True,
            system.clock,
        )
        reporter.state["ready_s"] = ready_s
        reporter.set_phase("loading", f"ready after {ready_s:.0f} s")
        reporter.state["t0"], reporter.state["t1"] = nb.drive_load(
            cfg,
            topo,
            args.out,
            lambda: True,
            system.clock,
            system.http_pool,
            nb.SCAN_PROCESSES,
            search,
        )
        reporter.set_phase("done", "load finished")
        return EXIT_OK
    except (Exception, KeyboardInterrupt) as exc:
        cause = nb.innermost(exc)
        if isinstance(exc, KeyboardInterrupt):
            message = "interrupted"
        elif isinstance(exc, nb.NetworkError):
            message = str(exc)
        else:
            message = f"{type(cause).__name__}: {cause}"
        log.exception("agent failed")
        reporter.state["error"] = message
        reporter.set_phase("error", message)
        return EXIT_INVALID
    finally:
        pool.close()
        stop.set()
        sampler.join()


def diskstats(text: str) -> dict[str, dict[str, int]]:
    """/proc/diskstats; sector size is a kernel-wide constant (512 bytes), not per-device. The
    kernel's column count is fixed, so a short line means this parser is wrong, not that the
    line should be skipped."""
    sector_bytes = 512
    stats: dict[str, dict[str, int]] = {}
    for line in text.splitlines():
        fields = line.split()
        if len(fields) < 14:
            raise ValueError(f"diskstats line has fewer than 14 fields: {line!r}")
        stats[fields[2]] = {
            "read_bytes": int(fields[5]) * sector_bytes,
            "write_bytes": int(fields[9]) * sector_bytes,
            "io_ticks_ms": int(fields[12]),
            "reads": int(fields[3]),
            "writes": int(fields[7]),
            "read_ms": int(fields[6]),
            "write_ms": int(fields[10]),
            "in_flight": int(fields[11]),
            "weighted_ms": int(fields[13]),
        }
    return stats


def netdev(text: str) -> dict[str, dict[str, int]]:
    """/proc/net/dev; header lines have no `:` and are skipped. A device line with a `:` but
    fewer than 16 fields means this parser is wrong, not that the line should be skipped."""
    stats: dict[str, dict[str, int]] = {}
    for line in text.splitlines():
        name, sep, rest = line.partition(":")
        if not sep:
            continue
        fields = rest.split()
        if len(fields) < 16:
            raise ValueError(f"netdev line has fewer than 16 fields: {line!r}")
        stats[name.strip()] = {"rx_bytes": int(fields[0]), "tx_bytes": int(fields[8])}
    return stats


def parse_cpu_stat(text: str) -> int:
    """cgroup v2 cpu.stat, `usage_usec <n>` line."""
    for line in text.splitlines():
        key, sep, value = line.partition(" ")
        if sep and key == "usage_usec":
            return int(value)
    raise ValueError("usage_usec not found in cpu.stat")


def parse_memory_stat_anon(text: str) -> int:
    """cgroup v2 memory.stat, `anon <n>` line: the RSS-equivalent field. memory.current also
    counts page cache, which journal writes inflate well past actual process memory use."""
    for line in text.splitlines():
        key, sep, value = line.partition(" ")
        if sep and key == "anon":
            return int(value)
    raise ValueError("anon not found in memory.stat")


def container_stats(
    containers: dict[str, str], cgroup_root: Path = CGROUP_ROOT
) -> dict[str, dict[str, float]]:
    """name -> {cpu_s, rss}, read from system.slice/docker-<id>.scope. A container whose scope
    is already gone (exited, or not yet created) contributes nothing."""
    stats: dict[str, dict[str, float]] = {}
    for name, container_id in containers.items():
        scope = cgroup_root / "system.slice" / f"docker-{container_id}.scope"
        try:
            cpu_usec = parse_cpu_stat((scope / "cpu.stat").read_text())
            rss = parse_memory_stat_anon((scope / "memory.stat").read_text())
        except FileNotFoundError:
            continue
        stats[name] = {"cpu_s": cpu_usec / 1_000_000, "rss": rss}
    return stats


def load_containers(path: Path) -> dict[str, str]:
    """name -> container id, written incrementally by start.sh; empty before any container is
    created, so the sampler can start before `docker create` runs."""
    if not path.exists():
        return {}
    return json.loads(path.read_text())


def host_sample(
    containers: dict[str, str], clock: nb.Clock, cgroup_root: Path = CGROUP_ROOT
) -> dict[str, Any]:
    """Same shape as bench.sample_host's record, plus disk and net throughput counters and
    per-container cpu/mem in place of bench's per-process labels."""
    return {
        "ts": clock.time(),
        "cpu": nb.usable_cpu_jiffies(),
        "mem_avail": nb.meminfo()["MemAvailable"],
        "procs": container_stats(containers, cgroup_root),
        "disk": diskstats(Path("/proc/diskstats").read_text()),
        "net": netdev(Path("/proc/net/dev").read_text()),
    }


def parse_ss(text: str) -> list[dict[str, Any]]:
    """`ss -tinmOH` lines of established sockets: queues, endpoints, and the info fields
    (cwnd, bbr, pacing_rate, delivery_rate, notsent, retrans, skmem, ...) verbatim."""
    sockets = []
    for line in text.splitlines():
        fields = line.split(maxsplit=5)
        if len(fields) < 5 or fields[0] != "ESTAB":
            continue
        sockets.append(
            {
                "recv_q": int(fields[1]),
                "send_q": int(fields[2]),
                "local": fields[3],
                "peer": fields[4],
                "info": fields[5] if len(fields) > 5 else "",
            }
        )
    return sockets


def proc_counters(text: str, wanted: dict[str, tuple[str, ...]]) -> dict[str, int]:
    """The `wanted` counters of /proc/net/snmp or /proc/net/netstat, whose sections are a
    `Prefix: names` line followed by a `Prefix: values` line."""
    lines = text.splitlines()
    found = {}
    for names, values in zip(lines[::2], lines[1::2]):
        prefix, _, keys = names.partition(":")
        if prefix not in wanted:
            continue
        row = dict(zip(keys.split(), values.partition(":")[2].split()))
        found |= {key: int(row[key]) for key in wanted[prefix]}
    return found


def socket_sample(system: System, qdisc: bool) -> dict[str, Any]:
    """A failing `ss` or `tc` is recorded in the sample: the host samples go on."""
    port = f"( sport = :{CLIQUENET_PORT} or dport = :{CLIQUENET_PORT} )"
    ss = system.run(["ss", "-tinmOH", port])
    counters = proc_counters(Path("/proc/net/snmp").read_text(), TCP_COUNTERS)
    counters |= proc_counters(Path("/proc/net/netstat").read_text(), TCP_COUNTERS)
    sample: dict[str, Any] = {"ts": system.clock.time(), "tcp": counters}
    if ss.returncode == 0:
        sample["sockets"] = parse_ss(ss.stdout)
    else:
        sample["error"] = f"ss exited {ss.returncode}: {ss.stderr.strip()}"
    if qdisc:
        tc = system.run(["tc", "-s", "qdisc", "show"])
        sample["qdisc"] = tc.stdout if tc.returncode == 0 else f"error: {tc.stderr}"
    return sample


def sample_sockets(out: Path, stop: threading.Event, system: System) -> None:
    with out.open("a", buffering=1) as f:
        for n in itertools.count():
            if stop.is_set():
                return
            f.write(json.dumps(socket_sample(system, n % QDISC_EVERY == 0)) + "\n")
            system.clock.wait(stop, SOCKET_SAMPLE_S)


def pg_sample_sql() -> str:
    """One json object of cumulative counters."""
    backends = (
        "from pg_stat_activity where datname = 'espresso' and pid <> pg_backend_pid()"
    )
    wal_keys = (
        "'wal_records','wal_bytes','wal_buffers_full','wal_write_time','wal_sync_time'"
    )
    return (
        "select (jsonb_build_object("
        "'xact_commit', d.xact_commit, 'xact_rollback', d.xact_rollback, "
        "'blks_read', d.blks_read, 'blks_hit', d.blks_hit, "
        "'tup_inserted', d.tup_inserted, 'tup_updated', d.tup_updated, "
        "'tup_deleted', d.tup_deleted, 'temp_bytes', d.temp_bytes, "
        "'deadlocks', d.deadlocks, 'active_time', d.active_time, "
        "'idle_in_transaction_time', d.idle_in_transaction_time, "
        "'num_timed', c.num_timed, 'num_requested', c.num_requested, "
        "'buffers_written', c.buffers_written, "
        "'buffers_clean', b.buffers_clean, 'maxwritten_clean', b.maxwritten_clean, "
        f"'active_backends', (select count(*) {backends} and state = 'active'), "
        "'ssl_backends', (select coalesce(jsonb_object_agg(ssl::text, n), '{}'::jsonb) from "
        "(select s.ssl, count(*) as n from pg_stat_ssl s "
        f"where s.pid in (select pid {backends}) group by s.ssl) g), "
        "'wait_events', (select coalesce(jsonb_object_agg(wt, n), '{}'::jsonb) from "
        f"(select coalesce(wait_event_type, 'none') as wt, count(*) as n {backends} "
        "group by 1) g), "
        "'database_bytes', pg_database_size('espresso')) "
        "|| (select jsonb_object_agg(key, value) from jsonb_each(to_jsonb(w)) "
        f"where key in ({wal_keys})))::text "
        "from pg_stat_database d, pg_stat_bgwriter b, pg_stat_wal w, "
        "pg_stat_checkpointer c "
        "where d.datname = 'espresso'"
    )


def pg_sample(system: System, pg: PgEndpoint) -> dict[str, Any] | None:
    """None when psql fails (Postgres not up yet, or stopped at freeze)."""
    argv, env = psql_argv(pg)
    result = system.run([*argv, "-At", "-c", pg_sample_sql()], env)
    if result.returncode != 0:
        log.debug("pg sample failed: %s", result.stderr.strip())
        return None
    return {"ts": system.clock.time(), **json.loads(result.stdout)}


def sample_pg(out: Path, stop: threading.Event, pg: PgEndpoint, system: System) -> None:
    with out.open("a", buffering=1) as f:
        while not stop.is_set():
            sample = pg_sample(system, pg)
            if sample is not None:
                f.write(json.dumps(sample) + "\n")
            system.clock.wait(stop, PG_SAMPLE_S)


def cmd_agent_host(args: argparse.Namespace, system: System) -> int:
    containers_path = Path(BENCH_DIR) / "containers.json"
    if args.role == "query" and args.pg is None:
        raise Refused("agent-host --role query needs --pg")
    stop = threading.Event()
    system.trap((signal.SIGINT, signal.SIGTERM), lambda *_: stop.set())
    threads = []
    if args.role == "query":
        pg_out = args.out.with_name("pg-stats.jsonl")
        pg = cast(PgEndpoint, json.loads(args.pg.read_text()))
        threads.append(
            threading.Thread(target=sample_pg, args=(pg_out, stop, pg, system))
        )
    if args.role != "ctl":
        sockets_out = args.out.with_name("sockets.jsonl")
        threads.append(
            threading.Thread(target=sample_sockets, args=(sockets_out, stop, system))
        )
    for thread in threads:
        thread.start()
    with args.out.open("a", buffering=1) as f:
        while not stop.is_set():
            sample = host_sample(load_containers(containers_path), system.clock)
            f.write(json.dumps(sample) + "\n")
            system.clock.wait(stop, HOST_SAMPLE_S)
    for thread in threads:
        thread.join()
    return EXIT_OK


def main() -> int:
    argv = sys.argv[1:]
    args = parse_args(argv)
    args.argv = argv
    system = host_system()
    if args.command in ("status", "list", "destroy", "down", "prune", "publish"):
        logging.basicConfig(level=logging.INFO, format="%(message)s")
    try:
        # `OUT_ROOT` is relative so ssh ControlPaths fit the socket limit, and only the repo
        # root's `bench-state/` is git-ignored. Host agents run from /opt/bench.
        if not args.command.startswith("agent-") and Path.cwd() != REPO_ROOT:
            raise Refused(f"run from the repo root {REPO_ROOT}, not {Path.cwd()}")
        command: Command = args.func
        return command(args, system)
    except (Refused, TfFailed) as exc:
        log.error("error: %s", exc)
        return EXIT_REFUSED
    except RemoteError as exc:
        log.error("error: %s", exc)
        return EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main())
