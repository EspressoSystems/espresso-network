def capable_az(run: Runner, cfg: RunConfig, types: set[str]) -> str:
    az_sets = []
    for instance_type in sorted(types):
        result = run(
            aws_argv(
                cfg,
                "ec2",
                "describe-instance-type-offerings",
                "--region",
                cfg.region,
                "--location-type",
                "availability-zone",
                "--filters",
                f"Name=instance-type,Values={instance_type}",
                "--output",
                "json",
            )
        )
        if result.returncode != 0:
            raise Refused(
                f"aws ec2 describe-instance-type-offerings failed for {instance_type}: "
                f"{result.stderr.strip()}"
            )
        offerings = json.loads(result.stdout)["InstanceTypeOfferings"]
        az_sets.append({o["Location"] for o in offerings})
    capable = set.intersection(*az_sets) if az_sets else set()
    if not capable:
        raise Refused(
            f"no AZ in {cfg.region} offers every instance type: {', '.join(sorted(types))}"
        )
    if cfg.az == "auto":
        return min(capable)
    if cfg.az not in capable:
        raise Refused(
            f"--az {cfg.az} does not offer every instance type; AZs that do: "
            f"{', '.join(sorted(capable))}"
        )
    return cfg.az


