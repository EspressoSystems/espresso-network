def check_latency_flags(profile: str, intra: bool, tcp_cc: str, mtu: int) -> None:
    if profile == "off" and not intra:
        raise Refused("--no-intra-latency needs --latency decaf-2025 or mainnet")
    if profile == "off" and tcp_cc != RunConfig.tcp_cc:
        raise Refused("--tcp-cc needs --latency decaf-2025 or mainnet")
    if profile == "off" and mtu != RunConfig.mtu:
        raise Refused("--mtu needs --latency decaf-2025 or mainnet")


