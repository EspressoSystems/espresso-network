class DefaultsFormatter(argparse.ArgumentDefaultsHelpFormatter):
    """Also shows the default of flags without help text, which the base class skips."""

    def _get_help_string(self, action: argparse.Action) -> str | None:
        return (
            action.help if action.default is None else super()._get_help_string(action)
        )

    def _format_action(self, action: argparse.Action) -> str:
        if action.help is None and action.default not in (None, argparse.SUPPRESS):
            action.help = "default: %(default)s"
        return super()._format_action(action)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", required=True)
    defaults = RunConfig(tag="")

    plan_p = sub.add_parser(
        "plan",
        help="render the run dir and print the cost estimate",
        formatter_class=DefaultsFormatter,
    )
    add_run_flags(plan_p)
    add_node_env_flag(plan_p)
    add_block_size_flag(plan_p)
    add_leader_trace_flag(plan_p)
    add_latency_flags(plan_p)
    add_consensus_storage_flag(plan_p)
    add_submit_nodes_flag(plan_p)
    add_ttl_flag(plan_p)
    plan_p.add_argument("--db-modes", type=parse_db_modes, default=defaults.db_modes)
    plan_p.set_defaults(func=cmd_plan, yes=False, max_usd=UP_MAX_USD)

    up_p = sub.add_parser(
        "up",
        help="plan, confirm, provision a fleet and leave it idle for `run --fleet`",
        formatter_class=DefaultsFormatter,
    )
    add_run_flags(up_p)
    add_ttl_flag(up_p)
    up_p.add_argument("--db-modes", type=parse_db_modes, default=defaults.db_modes)
    up_p.add_argument("--yes", action="store_true")
    up_p.set_defaults(
        func=cmd_up,
        node_env=[],
        max_block_size=defaults.max_block_size,
        leader_trace=defaults.leader_trace,
        latency=defaults.latency,
        intra_latency=defaults.intra_latency,
        tcp_cc=defaults.tcp_cc,
        mtu=defaults.mtu,
        consensus_storage=defaults.consensus_storage,
        submit_nodes=None,
        fleet=None,
        force=False,
        query_db=defaults.query_db,
        max_usd=UP_MAX_USD,
        ttl_min=UP_TTL_MIN,
    )

    run_p = sub.add_parser(
        "run",
        help="plan, confirm, provision, load, measure, collect, destroy; with --fleet, "
        "measure on a fleet from `up`",
        formatter_class=DefaultsFormatter,
        allow_abbrev=False,
    )
    add_run_flags(run_p, tag_required=False)
    add_node_env_flag(run_p)
    add_block_size_flag(run_p)
    add_leader_trace_flag(run_p)
    add_latency_flags(run_p)
    add_consensus_storage_flag(run_p)
    add_submit_nodes_flag(run_p)
    add_ttl_flag(run_p)
    run_p.add_argument(
        "--fleet",
        nargs="?",
        const=PICK,
        help="fleet from `up`, by name or dir; without a value the only selectable one",
    )
    run_p.add_argument("--query-db", choices=DB_MODES, default=defaults.query_db)
    run_p.add_argument(
        "--force",
        action="store_true",
        help="with --fleet: reset a dirty or stale fleet",
    )
    run_p.add_argument("--yes", action="store_true")
    run_p.add_argument(
        "--no-publish",
        action="store_true",
        help="do not push the run's results to --results-remote",
    )
    add_results_remote_flag(run_p)
    run_p.set_defaults(func=cmd_run, db_modes=defaults.db_modes)

    down_p = sub.add_parser("down", help="destroy a fleet")
    down_p.add_argument("dir", nargs="?", metavar="FLEET")
    down_p.add_argument("--yes", action="store_true")
    down_p.set_defaults(func=cmd_down)

    status_p = sub.add_parser(
        "status", help="list tagged resources or one fleet's progress"
    )
    status_p.add_argument("dir", nargs="?", metavar="FLEET")
    status_p.add_argument("--all", action="store_true")
    add_region_flag(status_p, None)
    status_p.set_defaults(func=cmd_status)

    list_p = sub.add_parser("list", help="local fleets, newest first; no AWS calls")
    list_p.set_defaults(func=cmd_list)

    collect_p = sub.add_parser(
        "collect", help="re-collect logs and samples from live hosts"
    )
    collect_p.add_argument("dir", type=Path, nargs="?", metavar="RUN_DIR")
    collect_p.set_defaults(func=cmd_collect)

    render_p = sub.add_parser(
        "render", help="re-analyze a run dir and rewrite its summary"
    )
    render_p.add_argument("dir", type=Path, metavar="RUN_DIR")
    render_p.add_argument("--baseline", type=Path)
    render_p.set_defaults(func=cmd_render)

    publish_p = sub.add_parser(
        "publish",
        help="push run dirs to the shared results repo (retry, backfill)",
