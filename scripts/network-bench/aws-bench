def resolve_ami_arch(instance_types: dict[str, dict[str, Any]], types: set[str]) -> str:
    """`resolve_image` always requires `linux/arm64`; refusing here catches an amd64-only
    instance type before the AMI lookup instead of at the image digest check."""
    arch_sets = [set(instance_types[t]["Archs"]) for t in types]
    common = set.intersection(*arch_sets) if arch_sets else set()
    if "arm64" not in common:
        raise Refused(
            f"instance types {', '.join(sorted(types))} are not all arm64: "
            "only linux/arm64 images are resolved"
        )
    return "arm64"


