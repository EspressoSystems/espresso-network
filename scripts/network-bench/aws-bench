        )
    return json.loads(result.stdout)["Quota"]["Value"]


def vcpu_headroom(
    run: Runner,
    cfg: RunConfig,
    hosts: list[HostSpec],
    running: list[str],
    instance_types: dict[str, dict[str, Any]],
) -> tuple[int, int, float]:
    """`running` has one entry per running instance (not deduplicated), so `in_use` counts
    each instance's vCPUs once, not once per distinct type."""
    vcpus = {t: row["VCpus"] for t, row in instance_types.items()}
    needed = sum(vcpus[h["instance_type"]] for h in hosts)
    in_use = sum(vcpus[t] for t in running)
    quota = _vcpu_quota(run, cfg)
    if needed + in_use > quota:
        raise Refused(
            f"vCPU quota {VCPU_QUOTA_CODE} is {quota:.0f} in {cfg.region}; {in_use} in use + "
            f"{needed} needed exceeds it: aws service-quotas request-service-quota-increase "
            f"--service-code ec2 --quota-code {VCPU_QUOTA_CODE} "
            f"--desired-value {int(needed + in_use)} --region {cfg.region}"
        )
    return needed, in_use, quota


