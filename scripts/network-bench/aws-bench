#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
r"""AWS benchmark harness for espresso-node: fleet lifecycle, load, and query-service lag.

Runs the shared `netbench` load driver against a Terraform-provisioned fleet in one AWS account
and region, replacing manual `espresso-deploy` runs for this purpose. `plan` renders every file
and prints a cost estimate without writing anything to AWS; `run` additionally provisions,
measures, collects and destroys.

`plan` (including `--offline`) is implemented; every other subcommand raises
`NotImplementedError` for now. Also runs on AWS hosts under system python3 as `agent-drive`
(on ctl) and `agent-host` (on every host).

Examples:
    scripts/network-bench/aws-bench plan --tag release-x --offline \
        --price c8g.4xlarge=0.71 --price c8g.2xlarge=0.355
    scripts/network-bench/aws-bench plan --tag release-x --nodes 5
"""

import argparse
import dataclasses
import getpass
import json
import logging
import re
import subprocess
import sys
import time
from collections.abc import Callable
from dataclasses import dataclass, field
from datetime import UTC, datetime
from pathlib import Path
from typing import Any, Literal, TypedDict

import netbench as nb

log = logging.getLogger("aws-bench")

EXIT_OK = 0
EXIT_INVALID = 1
EXIT_REFUSED = 2
EXIT_FAILED = 3
EXIT_LEFTOVER = 4

# Duration model. Phases not on the critical path of a laptop disconnect (provision, services,
# destroy) use the same value for expected and worst case.
PROVISION_S = 480.0
SERVICES_S = 180.0
READY_EXPECTED_S = 180.0
COLLECT_EXPECTED_S = 300.0
COLLECT_MAX_S = 600.0
DESTROY_S = 180.0
# Operator reaction time if the laptop is unattended, e.g. a 2am run.
TTL_MARGIN_S = 900.0

# gp3 includes this many IOPS and this much throughput at no extra charge.
GP3_BASELINE_IOPS = 3000
GP3_BASELINE_MBPS = 125
# AWS's own prorating denominator for monthly EBS prices.
HOURS_PER_MONTH = 730.0
# Gzipped container logs and the final rsync, from local bench runs.
EGRESS_MB_PER_HOST = 60.0

# OS and support container logs only; no journal or Postgres data.
CTL_ROOT_GB = 40
# OS + journal headroom for the default 7-step staircase to 16 MB/s.
NODE_ROOT_GB_DEFAULT = 100

# Instance prices drift slowly; avoids hammering the API.
PRICE_CACHE_TTL_S = 7 * 24 * 3600
# The Pricing API is only ever queried from us-east-1.
PRICING_API_REGION = "us-east-1"

# Minor EC2/EBS items, priced per region: gp3 GB-month, gp3 IOPS above the 3000 baseline
# (per IOPS-month), gp3 throughput above the 125 MB/s baseline (per MB/s-month), a public
# IPv4 address (per hour, charged since 2024-02-01), and internet egress (per GB, first tier).
# Source: https://aws.amazon.com/ebs/pricing/ and https://aws.amazon.com/vpc/pricing/;
# not yet checked against a live pricing call, re-check before trusting a stale estimate.
MINOR_PRICE_SOURCE = (
    "https://aws.amazon.com/ebs/pricing/ https://aws.amazon.com/vpc/pricing/"
)
MINOR_PRICES: dict[str, dict[str, float]] = {
    "eu-west-1": {
        "gp3_gb_month_usd": 0.088,
        "gp3_iops_month_usd": 0.005,
        "gp3_mbps_month_usd": 0.04,
        "public_ipv4_hour_usd": 0.005,
        "egress_gb_usd": 0.09,
    },
}

# Terraform's `name` variable validation is stricter than this; matching it here refuses a bad
# --name before any file is written instead of failing deep in a later commit's tfvars render.
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")


class Refused(Exception):
    """A plan or run must be refused before any AWS write; caught once, in `main`."""


class HostSpec(TypedDict):
    name: str
    role: Literal["ctl", "query", "validator"]
    instance_type: str
    root_gb: int
    root_iops: int
    root_mbps: int


class InstancePrice(TypedDict):
    usd_hour: float
    source: str


class Prices(TypedDict):
    instances: dict[str, InstancePrice]


class CostLine(TypedDict):
    item: str
    qty: float
    unit: str
    usd_per_unit: float
    usd: float
    source: str


class Estimate(TypedDict):
    expected_s: float
    worst_s: float
    ttl_s: float
    lines: list[CostLine]
    expected_usd: float
    bound_usd: float


class Manifest(TypedDict):
    name: str
    created_at: str
    argv: list[str]
    config: dict[str, Any]
    hosts: list[HostSpec]
    peers: dict[str, list[str]]
    phase: str
    phase_seconds: dict[str, list[float]]
    estimate: Estimate


@dataclass(frozen=True)
class RunConfig:
    tag: str
    nodes: int = 5
    node_type: str = "c8g.4xlarge"
    ctl_type: str = "c8g.2xlarge"
    az: str = "auto"
    region: str = "eu-west-1"
    profile: str = "timeboost-dev"
    account: str = "027574771971"
    load: nb.BenchConfig = field(default_factory=nb.BenchConfig)
    ready_timeout_s: float = 600.0
    max_block_size: str = "100mb"
    root_gb: str = "auto"
    pg_iops: int = 6000
    pg_mbps: int = 500
    operator_cidr: str = "auto"
    ssh_key: Path = Path("~/.ssh/id_ed25519")
    max_usd: float = 10.0
    price: tuple[str, ...] = ()
    name: str | None = None
    out_root: Path = Path("tmp/aws-bench")
    tf: str = "tofu"
    yes: bool = False
    keep: bool = False
    allow_dirty: bool = False
    offline: bool = False


# Callers need the return code and stderr, unlike scripts/release's Runner, to classify a
# failed `tofu apply` and to add context to a failed `aws` call.
Runner = Callable[[list[str]], subprocess.CompletedProcess[str]]


def _run(argv: list[str]) -> subprocess.CompletedProcess[str]:
    log.debug("+ %s", " ".join(argv))
    return subprocess.run(argv, capture_output=True, text=True, check=False)


def aws_argv(cfg: RunConfig, *args: str) -> list[str]:
    return ["aws", "--profile", cfg.profile, *args]


def plan_hosts(cfg: RunConfig) -> list[HostSpec]:
    if cfg.nodes < 2:
        raise Refused(f"--nodes must be at least 2: {cfg.nodes}")
    if not 1 <= cfg.load.submit_nodes <= cfg.nodes - 1:
        raise Refused(
            f"--submit-nodes must be between 1 and {cfg.nodes - 1}: "
            f"{cfg.load.submit_nodes}"
        )
    node_root_gb = NODE_ROOT_GB_DEFAULT if cfg.root_gb == "auto" else int(cfg.root_gb)
    hosts: list[HostSpec] = [
        {
            "name": "ctl",
            "role": "ctl",
            "instance_type": cfg.ctl_type,
            "root_gb": CTL_ROOT_GB,
            "root_iops": GP3_BASELINE_IOPS,
            "root_mbps": GP3_BASELINE_MBPS,
        }
    ]
    for i in range(cfg.nodes):
        query = i == 0
        hosts.append(
            {
                "name": f"node{i}",
                "role": "query" if query else "validator",
                "instance_type": cfg.node_type,
                "root_gb": node_root_gb,
                "root_iops": cfg.pg_iops if query else GP3_BASELINE_IOPS,
                "root_mbps": cfg.pg_mbps if query else GP3_BASELINE_MBPS,
            }
        )
    return hosts


def peers(i: int, n: int) -> list[int]:
    """Up to 3 other validators for node i's `STATE_PEERS`, never itself or node0 (the query
    node carries no submit load and is not used to catch up). Deterministic: the next
    `min(3, n - 2)` validators after i in the fixed cycle `1, 2, .., n-1`, wrapping around.
    """
    if i == 0 or n <= 2:
        return []
    count = min(3, n - 2)
    return [(i - 1 + k) % (n - 1) + 1 for k in range(1, count + 1)]


def plan_peers(hosts: list[HostSpec]) -> dict[str, list[str]]:
    nodes = [h["name"] for h in hosts if h["role"] != "ctl"]
    return {
        nodes[i]: [nodes[j] for j in peers(i, len(nodes))] for i in range(len(nodes))
    }


def load_seconds(load: nb.BenchConfig) -> float:
    """warmup, every step, the refine step, and the final drain (`tx_timeout_s`)."""
    return load.warmup_s + (len(load.steps) + 1) * load.step_s + load.tx_timeout_s


def phase_seconds(cfg: RunConfig) -> dict[str, tuple[float, float]]:
    """phase -> (expected_s, worst_s). `worst_s` swaps in the timeouts that bound a laptop
    disconnect: the ready timeout and the collection cap."""
    load_s = load_seconds(cfg.load)
    return {
        "provision": (PROVISION_S, PROVISION_S),
        "services": (SERVICES_S, SERVICES_S),
        "ready": (READY_EXPECTED_S, cfg.ready_timeout_s),
        "load": (load_s, load_s),
        "collect": (COLLECT_EXPECTED_S, COLLECT_MAX_S),
        "destroy": (DESTROY_S, DESTROY_S),
    }


def parse_price(text: str) -> tuple[str, float]:
    instance_type, sep, price = text.partition("=")
    if not sep or not instance_type or not price:
        raise Refused(f"--price must be TYPE=USD, got {text!r}")
    try:
        return instance_type, float(price)
    except ValueError:
        raise Refused(f"--price must be TYPE=USD, got {text!r}") from None


def fetch_prices(
    run: Runner, cfg: RunConfig, types: set[str], cache: Path, now: float
) -> Prices:
    stored: dict[str, dict[str, float]] = (
        json.loads(cache.read_text()) if cache.exists() else {}
    )
    instances: dict[str, InstancePrice] = {}
    changed = False
    for instance_type in sorted(types):
        key = f"{cfg.region}:{instance_type}"
        entry = stored.get(key)
        if entry is not None and now - entry["fetched_at"] < PRICE_CACHE_TTL_S:
            instances[instance_type] = {
                "usd_hour": entry["usd_hour"],
                "source": f"cache {cache}",
            }
            continue
        usd_hour = _fetch_instance_price(run, cfg, instance_type)
        instances[instance_type] = {
            "usd_hour": usd_hour,
            "source": "aws pricing get-products",
        }
        stored[key] = {"usd_hour": usd_hour, "fetched_at": now}
        changed = True
    if changed:
        cache.parent.mkdir(parents=True, exist_ok=True)
        cache.write_text(json.dumps(stored, indent=2, sort_keys=True) + "\n")
    return {"instances": instances}


def _fetch_instance_price(run: Runner, cfg: RunConfig, instance_type: str) -> float:
    filters = [
        {"Type": "TERM_MATCH", "Field": "instanceType", "Value": instance_type},
        {"Type": "TERM_MATCH", "Field": "regionCode", "Value": cfg.region},
        {"Type": "TERM_MATCH", "Field": "operatingSystem", "Value": "Linux"},
        {"Type": "TERM_MATCH", "Field": "tenancy", "Value": "Shared"},
        {"Type": "TERM_MATCH", "Field": "preInstalledSw", "Value": "NA"},
        {"Type": "TERM_MATCH", "Field": "capacitystatus", "Value": "Used"},
    ]
    result = run(
        aws_argv(
            cfg,
            "pricing",
            "get-products",
            "--region",
            PRICING_API_REGION,
            "--service-code",
            "AmazonEC2",
            "--filters",
            json.dumps(filters),
            "--output",
            "json",
        )
    )
    if result.returncode != 0:
        raise Refused(
            f"aws pricing get-products failed for {instance_type} in {cfg.region}: "
            f"{result.stderr.strip()}; pass --price {instance_type}=<usd/hour>"
        )
    return _parse_price_response(result.stdout, instance_type, cfg.region)


def _parse_price_response(stdout: str, instance_type: str, region: str) -> float:
    price_list = json.loads(stdout)["PriceList"]
    if len(price_list) != 1:
        raise Refused(
            f"expected exactly one price for {instance_type} in {region}, got "
            f"{len(price_list)}; pass --price {instance_type}=<usd/hour>"
        )
    product = json.loads(price_list[0])
    term = next(iter(product["terms"]["OnDemand"].values()))
    dimension = next(iter(term["priceDimensions"].values()))
    if dimension["unit"] != "Hrs":
        raise Refused(
            f"expected an hourly price for {instance_type}, got unit "
            f"{dimension['unit']!r}; pass --price {instance_type}=<usd/hour>"
        )
    usd = float(dimension["pricePerUnit"]["USD"])
    if usd <= 0:
        raise Refused(
            f"got a non-positive price for {instance_type}: {usd}; "
            f"pass --price {instance_type}=<usd/hour>"
        )
    return usd


def resolve_prices(run: Runner, cfg: RunConfig, cache: Path, now: float) -> Prices:
    types = {cfg.node_type, cfg.ctl_type}
    overrides = dict(parse_price(p) for p in cfg.price)
    missing = types - overrides.keys()
    if missing and cfg.offline:
        raise Refused(f"--offline requires --price for: {', '.join(sorted(missing))}")
    fetched = (
        fetch_prices(run, cfg, missing, cache, now) if missing else {"instances": {}}
    )
    instances = dict(fetched["instances"])
    for instance_type, usd_hour in overrides.items():
        instances[instance_type] = {"usd_hour": usd_hour, "source": "--price override"}
    return {"instances": instances}


def region_minor_prices(region: str) -> dict[str, float]:
    try:
        return MINOR_PRICES[region]
    except KeyError:
        raise Refused(f"add EBS/IPv4/egress prices for {region}") from None


def estimate_cost(
    hosts: list[HostSpec], cfg: RunConfig, prices: Prices, minor: dict[str, float]
) -> Estimate:
    phases = phase_seconds(cfg)
    expected_s = sum(expected for expected, _ in phases.values())
    worst_s = sum(worst for _, worst in phases.values())
    ttl_s = worst_s + TTL_MARGIN_S
    lines = _cost_lines(hosts, prices, minor, expected_s)
    bound_lines = _cost_lines(hosts, prices, minor, ttl_s)
    return {
        "expected_s": expected_s,
        "worst_s": worst_s,
        "ttl_s": ttl_s,
        "lines": lines,
        "expected_usd": sum(line["usd"] for line in lines),
        "bound_usd": sum(line["usd"] for line in bound_lines),
    }


def _cost_lines(
    hosts: list[HostSpec], prices: Prices, minor: dict[str, float], duration_s: float
) -> list[CostLine]:
    hours = duration_s / 3600
    lines: list[CostLine] = []
    by_type: dict[str, int] = {}
    for host in hosts:
        by_type[host["instance_type"]] = by_type.get(host["instance_type"], 0) + 1
    for instance_type, count in sorted(by_type.items()):
        price = prices["instances"][instance_type]
        usd = count * hours * price["usd_hour"]
        lines.append(
            {
                "item": f"instance {instance_type}",
                "qty": count * hours,
                "unit": "host-hour",
                "usd_per_unit": price["usd_hour"],
                "usd": usd,
                "source": price["source"],
            }
        )
    gb_hours = sum(h["root_gb"] for h in hosts) * hours
    lines.append(
        _minor_line(
            "gp3 storage",
            gb_hours,
            "gb-hour",
            minor["gp3_gb_month_usd"] / HOURS_PER_MONTH,
        )
    )
    iops_hours = sum(max(0, h["root_iops"] - GP3_BASELINE_IOPS) for h in hosts) * hours
    if iops_hours:
        lines.append(
            _minor_line(
                "gp3 iops",
                iops_hours,
                "iops-hour",
                minor["gp3_iops_month_usd"] / HOURS_PER_MONTH,
            )
        )
    mbps_hours = sum(max(0, h["root_mbps"] - GP3_BASELINE_MBPS) for h in hosts) * hours
    if mbps_hours:
        lines.append(
            _minor_line(
                "gp3 throughput",
                mbps_hours,
                "mbps-hour",
                minor["gp3_mbps_month_usd"] / HOURS_PER_MONTH,
            )
        )
    ipv4_hours = len(hosts) * hours
    lines.append(
        _minor_line(
            "public ipv4", ipv4_hours, "host-hour", minor["public_ipv4_hour_usd"]
        )
    )
    egress_gb = len(hosts) * EGRESS_MB_PER_HOST / 1024
    lines.append(_minor_line("egress", egress_gb, "gb", minor["egress_gb_usd"]))
    return lines


def _minor_line(item: str, qty: float, unit: str, usd_per_unit: float) -> CostLine:
    return {
        "item": item,
        "qty": qty,
        "unit": unit,
        "usd_per_unit": usd_per_unit,
        "usd": qty * usd_per_unit,
        "source": MINOR_PRICE_SOURCE,
    }


def format_estimate_summary(estimate: Estimate, max_usd: float) -> str:
    return (
        f"cost: expected ${estimate['expected_usd']:.2f} "
        f"({round(estimate['expected_s'] / 60)} min), "
        f"hard bound ${estimate['bound_usd']:.2f}, limit ${max_usd:.2f}"
    )


def format_estimate_lines(estimate: Estimate) -> list[str]:
    return [
        f"  {line['item']}: {line['qty']:g} {line['unit']} @ ${line['usd_per_unit']:.4f} "
        f"= ${line['usd']:.2f} ({line['source']})"
        for line in estimate["lines"]
    ]


def format_estimate(estimate: Estimate, max_usd: float) -> str:
    return "\n".join(
        [format_estimate_summary(estimate, max_usd), *format_estimate_lines(estimate)]
    )


def confirm(prompt: str, yes: bool, stdin_is_tty: bool) -> bool:
    if yes:
        return True
    if not stdin_is_tty:
        return False
    return input(f"{prompt} [y/N] ").strip().lower() == "y"


def default_run_name(now: datetime | None = None) -> str:
    now = now if now is not None else datetime.now(UTC)
    return f"{getpass.getuser()}-{now.strftime('%Y%m%d-%H%M')}"


def new_run_dir(out_root: Path, name: str | None) -> Path:
    run_name = name if name is not None else default_run_name()
    if not NAME_RE.match(run_name):
        raise Refused(f"--name must match {NAME_RE.pattern}: {run_name!r}")
    run_dir = out_root / run_name
    if run_dir.exists():
        raise Refused(f"run {run_name} already exists at {run_dir}")
    run_dir.mkdir(parents=True)
    return run_dir


def setup_logging(run_dir: Path) -> None:
    for handler in list(log.handlers):
        log.removeHandler(handler)
        handler.close()
    log.setLevel(logging.DEBUG)
    log.propagate = False
    file_handler = logging.FileHandler(run_dir / "driver.log")
    file_handler.setLevel(logging.DEBUG)
    file_handler.setFormatter(
        logging.Formatter("%(asctime)s %(levelname)s %(message)s")
    )
    log.addHandler(file_handler)
    stream_handler = logging.StreamHandler(sys.stderr)
    stream_handler.setLevel(logging.INFO)
    stream_handler.setFormatter(logging.Formatter("%(message)s"))
    log.addHandler(stream_handler)


def append_event(run_dir: Path, phase: str, event: str, detail: str | None) -> None:
    record = {
        "ts": datetime.now(UTC).isoformat(),
        "phase": phase,
        "event": event,
        "detail": detail,
    }
    with (run_dir / "events.jsonl").open("a") as f:
        f.write(json.dumps(record) + "\n")


def config_to_json(cfg: RunConfig) -> dict[str, Any]:
    data = dataclasses.asdict(cfg)
    data["ssh_key"] = str(cfg.ssh_key)
    data["out_root"] = str(cfg.out_root)
    return data


def write_manifest(
    run_dir: Path,
    cfg: RunConfig,
    hosts: list[HostSpec],
    peers_by_node: dict[str, list[str]],
    estimate: Estimate,
    phase: str,
    argv: list[str],
) -> None:
    manifest: Manifest = {
        "name": run_dir.name,
        "created_at": datetime.now(UTC).isoformat(),
        "argv": argv,
        "config": config_to_json(cfg),
        "hosts": hosts,
        "peers": peers_by_node,
        "phase": phase,
        "phase_seconds": {
            name: list(bounds) for name, bounds in phase_seconds(cfg).items()
        },
        "estimate": estimate,
    }
    nb.write_json(run_dir / "manifest.json", manifest)
    append_event(run_dir, phase, "manifest-written", None)


def add_run_flags(parser: argparse.ArgumentParser) -> None:
    defaults = RunConfig(tag="")
    load = defaults.load
    parser.add_argument(
        "--tag", required=True, help="ghcr tag pushed by CI, no default"
    )
    parser.add_argument("--nodes", type=int, default=defaults.nodes)
    parser.add_argument("--node-type", default=defaults.node_type)
    parser.add_argument("--ctl-type", default=defaults.ctl_type)
    parser.add_argument("--az", default=defaults.az)
    parser.add_argument("--region", default=defaults.region)
    parser.add_argument("--profile", default=defaults.profile)
    parser.add_argument("--account", default=defaults.account)
    parser.add_argument("--steps", type=nb.parse_rates, default=load.steps)
    parser.add_argument("--step-s", type=int, default=load.step_s)
    parser.add_argument("--cap-s", type=float, default=load.cap_s)
    parser.add_argument("--tx-size", type=int, default=load.tx_size)
    parser.add_argument(
        "--submit-nodes", type=int, default=None, help="default: --nodes - 1"
    )
    parser.add_argument("--tx-timeout-s", type=int, default=load.tx_timeout_s)
    parser.add_argument("--workers", type=int, default=load.workers)
    parser.add_argument("--seed", type=int, default=load.seed)
    parser.add_argument("--warmup-s", type=int, default=load.warmup_s)
    parser.add_argument("--latency-target-ms", type=int, default=load.latency_target_ms)
    parser.add_argument(
        "--query-lag-target-ms", type=int, default=load.query_lag_target_ms
    )
    parser.add_argument(
        "--ready-timeout-s", type=float, default=defaults.ready_timeout_s
    )
    parser.add_argument("--genesis", type=Path, default=Path(load.genesis))
    parser.add_argument("--max-block-size", default=defaults.max_block_size)
    parser.add_argument("--root-gb", default=defaults.root_gb)
    parser.add_argument("--pg-iops", type=int, default=defaults.pg_iops)
    parser.add_argument("--pg-mbps", type=int, default=defaults.pg_mbps)
    parser.add_argument("--operator-cidr", default=defaults.operator_cidr)
    parser.add_argument("--ssh-key", type=Path, default=defaults.ssh_key)
    parser.add_argument("--max-usd", type=float, default=defaults.max_usd)
    parser.add_argument("--price", action="append", default=[], metavar="TYPE=USD")
    parser.add_argument("--name")
    parser.add_argument("--out-root", type=Path, default=defaults.out_root)
    parser.add_argument("--tf", default=defaults.tf)


def config_from_args(args: argparse.Namespace) -> RunConfig:
    submit_nodes = (
        args.submit_nodes if args.submit_nodes is not None else args.nodes - 1
    )
    load = nb.BenchConfig(
        genesis=str(args.genesis),
        tx_size=args.tx_size,
        steps=args.steps,
        step_s=args.step_s,
        submit_nodes=submit_nodes,
        workers=args.workers,
        cap_s=args.cap_s,
        tx_timeout_s=args.tx_timeout_s,
        warmup_s=args.warmup_s,
        seed=args.seed,
        latency_target_ms=args.latency_target_ms,
        query_lag_target_ms=args.query_lag_target_ms,
    )
    return RunConfig(
        tag=args.tag,
        nodes=args.nodes,
        node_type=args.node_type,
        ctl_type=args.ctl_type,
        az=args.az,
        region=args.region,
        profile=args.profile,
        account=args.account,
        load=load,
        ready_timeout_s=args.ready_timeout_s,
        max_block_size=args.max_block_size,
        root_gb=args.root_gb,
        pg_iops=args.pg_iops,
        pg_mbps=args.pg_mbps,
        operator_cidr=args.operator_cidr,
        ssh_key=args.ssh_key,
        max_usd=args.max_usd,
        price=tuple(args.price),
        name=args.name,
        out_root=args.out_root,
        tf=args.tf,
        yes=args.yes,
        keep=args.keep,
        allow_dirty=args.allow_dirty,
        offline=args.offline,
    )


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", required=True)

    plan_p = sub.add_parser(
        "plan", help="render the run dir and print the cost estimate"
    )
    add_run_flags(plan_p)
    plan_p.add_argument("--offline", action="store_true", help="use no AWS credentials")
    plan_p.set_defaults(func=cmd_plan, yes=False, keep=False, allow_dirty=False)

    run_p = sub.add_parser(
        "run", help="plan, confirm, provision, load, measure, collect, destroy"
    )
    add_run_flags(run_p)
    run_p.add_argument("--yes", action="store_true")
    run_p.add_argument(
        "--keep", action="store_true", help="skip destroy; the TTL still applies"
    )
    run_p.add_argument("--allow-dirty", action="store_true")
    run_p.set_defaults(func=cmd_run, offline=False)

    status_p = sub.add_parser(
        "status", help="list tagged resources or one run's progress"
    )
    status_p.add_argument("dir", type=Path, nargs="?")
    status_p.add_argument("--all", action="store_true")
    status_p.add_argument("--out-root", type=Path, default=Path("tmp/aws-bench"))
    status_p.set_defaults(func=cmd_status)

    collect_p = sub.add_parser(
        "collect", help="re-collect logs and samples from live hosts"
    )
    collect_p.add_argument("dir", type=Path)
    collect_p.set_defaults(func=cmd_collect)

    render_p = sub.add_parser(
        "render", help="re-analyze a run dir and rewrite its summary"
    )
    render_p.add_argument("dir", type=Path)
    render_p.add_argument("--baseline", type=Path)
    render_p.set_defaults(func=cmd_render)

    destroy_p = sub.add_parser(
        "destroy", help="tear down a run's fleet, or sweep orphans"
    )
    destroy_p.add_argument("dir", type=Path, nargs="?")
    destroy_p.add_argument("--orphans", action="store_true")
    destroy_p.add_argument("--region", default="eu-west-1")
    destroy_p.add_argument("--yes", action="store_true")
    destroy_p.set_defaults(func=cmd_destroy)

    agent_drive_p = sub.add_parser("agent-drive", help="ctl only: run the load driver")
    agent_drive_p.add_argument("config", type=Path)
    agent_drive_p.add_argument("out", type=Path)
    agent_drive_p.set_defaults(func=cmd_agent_drive)

    agent_host_p = sub.add_parser(
        "agent-host", help="every host: sample /proc and cgroups"
    )
    agent_host_p.add_argument("out", type=Path)
    agent_host_p.set_defaults(func=cmd_agent_host)

    return parser.parse_args(argv)


def cmd_plan(args: argparse.Namespace, run: Runner = _run) -> int:
    cfg = config_from_args(args)
    now = time.time()
    minor = region_minor_prices(cfg.region)
    run_dir = new_run_dir(cfg.out_root, cfg.name)
    setup_logging(run_dir)
    log.debug("argv %s", args.argv)
    hosts = plan_hosts(cfg)
    host_peers = plan_peers(hosts)
    prices = resolve_prices(run, cfg, cfg.out_root / "prices.json", now)
    estimate = estimate_cost(hosts, cfg, prices, minor)
    log.info(format_estimate_summary(estimate, cfg.max_usd))
    for line in format_estimate_lines(estimate):
        log.debug(line)
    if estimate["bound_usd"] > cfg.max_usd:
        append_event(
            run_dir,
            "planned",
            "refused",
            f"bound ${estimate['bound_usd']:.2f} exceeds --max-usd ${cfg.max_usd:.2f}",
        )
        raise Refused(
            f"hard bound ${estimate['bound_usd']:.2f} exceeds --max-usd "
            f"${cfg.max_usd:.2f}; pass --max-usd {estimate['bound_usd']:.2f} or shrink the run"
        )
    write_manifest(
        run_dir, cfg, hosts, host_peers, estimate, phase="planned", argv=args.argv
    )
    log.info("rendered %s (phase=planned)", run_dir)
    return EXIT_OK


