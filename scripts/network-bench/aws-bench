# Callers need the return code and stderr, unlike scripts/release's Runner, to classify a
# failed `tofu apply` and to add context to a failed `aws` call.
Runner = Callable[[list[str]], subprocess.CompletedProcess[str]]


def _run(argv: list[str]) -> subprocess.CompletedProcess[str]:
    log.debug("+ %s", " ".join(argv))
    return subprocess.run(argv, capture_output=True, text=True, check=False)


def aws_argv(cfg: RunConfig, *args: str) -> list[str]:
    return ["aws", "--profile", cfg.profile, *args]


def plan_hosts(cfg: RunConfig) -> list[HostSpec]:
    if cfg.nodes < 2:
        raise Refused(f"--nodes must be at least 2: {cfg.nodes}")
    if not 1 <= cfg.load.submit_nodes <= cfg.nodes - 1:
        raise Refused(
            f"--submit-nodes must be between 1 and {cfg.nodes - 1}: "
            f"{cfg.load.submit_nodes}"
        )
    node_root_gb = NODE_ROOT_GB_DEFAULT if cfg.root_gb == "auto" else int(cfg.root_gb)
    hosts: list[HostSpec] = [
        {
            "name": "ctl",
            "role": "ctl",
            "instance_type": cfg.ctl_type,
            "root_gb": CTL_ROOT_GB,
            "root_iops": GP3_BASELINE_IOPS,
            "root_mbps": GP3_BASELINE_MBPS,
        }
    ]
    for i in range(cfg.nodes):
        query = i == 0
        hosts.append(
            {
                "name": f"node{i}",
                "role": "query" if query else "validator",
                "instance_type": cfg.node_type,
                "root_gb": node_root_gb,
                "root_iops": cfg.pg_iops if query else GP3_BASELINE_IOPS,
                "root_mbps": cfg.pg_mbps if query else GP3_BASELINE_MBPS,
            }
        )
    return hosts


def peers(i: int, n: int) -> list[int]:
    """Up to 3 other validators for node i's `STATE_PEERS`, never itself or node0 (the query
    node carries no submit load and is not used to catch up). Deterministic: the next
    `min(3, n - 2)` validators after i in the fixed cycle `1, 2, .., n-1`, wrapping around.
    """
    if i == 0 or n <= 2:
        return []
    count = min(3, n - 2)
    return [(i - 1 + k) % (n - 1) + 1 for k in range(1, count + 1)]


def plan_peers(hosts: list[HostSpec]) -> dict[str, list[str]]:
    nodes = [h["name"] for h in hosts if h["role"] != "ctl"]
    return {
        nodes[i]: [nodes[j] for j in peers(i, len(nodes))] for i in range(len(nodes))
    }


def load_seconds(load: nb.BenchConfig) -> float:
    """warmup, every step, the refine step, and the final drain (`tx_timeout_s`)."""
    return load.warmup_s + (len(load.steps) + 1) * load.step_s + load.tx_timeout_s


def phase_seconds(cfg: RunConfig) -> dict[str, tuple[float, float]]:
    """phase -> (expected_s, worst_s). `worst_s` swaps in the timeouts that bound a laptop
    disconnect: the ready timeout and the collection cap."""
    load_s = load_seconds(cfg.load)
    return {
        "provision": (PROVISION_S, PROVISION_S),
        "services": (SERVICES_S, SERVICES_S),
        "ready": (READY_EXPECTED_S, cfg.ready_timeout_s),
        "load": (load_s, load_s),
        "collect": (COLLECT_EXPECTED_S, COLLECT_MAX_S),
        "destroy": (DESTROY_S, DESTROY_S),
    }


def parse_price(text: str) -> tuple[str, float]:
    instance_type, sep, price = text.partition("=")
    if not sep or not instance_type or not price:
        raise Refused(f"--price must be TYPE=USD, got {text!r}")
    try:
        return instance_type, float(price)
    except ValueError:
        raise Refused(f"--price must be TYPE=USD, got {text!r}") from None


def fetch_prices(
    run: Runner, cfg: RunConfig, types: set[str], cache: Path, now: float
) -> Prices:
    stored: dict[str, dict[str, float]] = (
        json.loads(cache.read_text()) if cache.exists() else {}
    )
    instances: dict[str, InstancePrice] = {}
    changed = False
    for instance_type in sorted(types):
        key = f"{cfg.region}:{instance_type}"
        entry = stored.get(key)
        if entry is not None and now - entry["fetched_at"] < PRICE_CACHE_TTL_S:
            instances[instance_type] = {
                "usd_hour": entry["usd_hour"],
                "source": f"cache {cache}",
            }
            continue
        usd_hour = _fetch_instance_price(run, cfg, instance_type)
        instances[instance_type] = {
            "usd_hour": usd_hour,
            "source": "aws pricing get-products",
        }
        stored[key] = {"usd_hour": usd_hour, "fetched_at": now}
        changed = True
    if changed:
        cache.parent.mkdir(parents=True, exist_ok=True)
        cache.write_text(json.dumps(stored, indent=2, sort_keys=True) + "\n")
    return {"instances": instances}


def _fetch_instance_price(run: Runner, cfg: RunConfig, instance_type: str) -> float:
    filters = [
        {"Type": "TERM_MATCH", "Field": "instanceType", "Value": instance_type},
        {"Type": "TERM_MATCH", "Field": "regionCode", "Value": cfg.region},
        {"Type": "TERM_MATCH", "Field": "operatingSystem", "Value": "Linux"},
        {"Type": "TERM_MATCH", "Field": "tenancy", "Value": "Shared"},
        {"Type": "TERM_MATCH", "Field": "preInstalledSw", "Value": "NA"},
        {"Type": "TERM_MATCH", "Field": "capacitystatus", "Value": "Used"},
    ]
    result = run(
        aws_argv(
            cfg,
            "pricing",
            "get-products",
            "--region",
            PRICING_API_REGION,
            "--service-code",
            "AmazonEC2",
            "--filters",
            json.dumps(filters),
            "--output",
            "json",
        )
    )
    if result.returncode != 0:
        raise Refused(
            f"aws pricing get-products failed for {instance_type} in {cfg.region}: "
            f"{result.stderr.strip()}; pass --price {instance_type}=<usd/hour>"
        )
    return _parse_price_response(result.stdout, instance_type, cfg.region)


def _parse_price_response(stdout: str, instance_type: str, region: str) -> float:
    price_list = json.loads(stdout)["PriceList"]
    if len(price_list) != 1:
        raise Refused(
            f"expected exactly one price for {instance_type} in {region}, got "
            f"{len(price_list)}; pass --price {instance_type}=<usd/hour>"
        )
    product = json.loads(price_list[0])
    term = next(iter(product["terms"]["OnDemand"].values()))
    dimension = next(iter(term["priceDimensions"].values()))
    if dimension["unit"] != "Hrs":
        raise Refused(
            f"expected an hourly price for {instance_type}, got unit "
            f"{dimension['unit']!r}; pass --price {instance_type}=<usd/hour>"
        )
    usd = float(dimension["pricePerUnit"]["USD"])
    if usd <= 0:
        raise Refused(
            f"got a non-positive price for {instance_type}: {usd}; "
            f"pass --price {instance_type}=<usd/hour>"
        )
    return usd


def resolve_prices(run: Runner, cfg: RunConfig, cache: Path, now: float) -> Prices:
    types = {cfg.node_type, cfg.ctl_type}
    overrides = dict(parse_price(p) for p in cfg.price)
    missing = types - overrides.keys()
    if missing and cfg.offline:
        raise Refused(f"--offline requires --price for: {', '.join(sorted(missing))}")
    fetched = (
        fetch_prices(run, cfg, missing, cache, now) if missing else {"instances": {}}
    )
    instances = dict(fetched["instances"])
    for instance_type, usd_hour in overrides.items():
        instances[instance_type] = {"usd_hour": usd_hour, "source": "--price override"}
    return {"instances": instances}


def region_minor_prices(region: str) -> dict[str, float]:
    try:
        return MINOR_PRICES[region]
    except KeyError:
        raise Refused(f"add EBS/IPv4/egress prices for {region}") from None


def estimate_cost(
    hosts: list[HostSpec], cfg: RunConfig, prices: Prices, minor: dict[str, float]
) -> Estimate:
    phases = phase_seconds(cfg)
    expected_s = sum(expected for expected, _ in phases.values())
    worst_s = sum(worst for _, worst in phases.values())
    ttl_s = worst_s + TTL_MARGIN_S
    lines = _cost_lines(hosts, prices, minor, expected_s)
    bound_lines = _cost_lines(hosts, prices, minor, ttl_s)
    return {
        "expected_s": expected_s,
        "worst_s": worst_s,
        "ttl_s": ttl_s,
        "lines": lines,
        "expected_usd": sum(line["usd"] for line in lines),
        "bound_usd": sum(line["usd"] for line in bound_lines),
    }


def _cost_lines(
    hosts: list[HostSpec], prices: Prices, minor: dict[str, float], duration_s: float
) -> list[CostLine]:
    hours = duration_s / 3600
    lines: list[CostLine] = []
    by_type: dict[str, int] = {}
    for host in hosts:
        by_type[host["instance_type"]] = by_type.get(host["instance_type"], 0) + 1
    for instance_type, count in sorted(by_type.items()):
        price = prices["instances"][instance_type]
        usd = count * hours * price["usd_hour"]
        lines.append(
            {
                "item": f"instance {instance_type}",
                "qty": count * hours,
                "unit": "host-hour",
                "usd_per_unit": price["usd_hour"],
                "usd": usd,
                "source": price["source"],
            }
        )
    gb_hours = sum(h["root_gb"] for h in hosts) * hours
    lines.append(
        _minor_line(
            "gp3 storage",
            gb_hours,
            "gb-hour",
            minor["gp3_gb_month_usd"] / HOURS_PER_MONTH,
        )
    )
    iops_hours = sum(max(0, h["root_iops"] - GP3_BASELINE_IOPS) for h in hosts) * hours
    if iops_hours:
        lines.append(
            _minor_line(
                "gp3 iops",
                iops_hours,
                "iops-hour",
                minor["gp3_iops_month_usd"] / HOURS_PER_MONTH,
            )
        )
    mbps_hours = sum(max(0, h["root_mbps"] - GP3_BASELINE_MBPS) for h in hosts) * hours
    if mbps_hours:
        lines.append(
            _minor_line(
                "gp3 throughput",
                mbps_hours,
                "mbps-hour",
                minor["gp3_mbps_month_usd"] / HOURS_PER_MONTH,
            )
        )
    ipv4_hours = len(hosts) * hours
    lines.append(
        _minor_line(
            "public ipv4", ipv4_hours, "host-hour", minor["public_ipv4_hour_usd"]
        )
    )
    egress_gb = len(hosts) * EGRESS_MB_PER_HOST / 1024
    lines.append(_minor_line("egress", egress_gb, "gb", minor["egress_gb_usd"]))
    return lines


def _minor_line(item: str, qty: float, unit: str, usd_per_unit: float) -> CostLine:
    return {
        "item": item,
        "qty": qty,
        "unit": unit,
        "usd_per_unit": usd_per_unit,
        "usd": qty * usd_per_unit,
        "source": MINOR_PRICE_SOURCE,
    }


def format_estimate_summary(estimate: Estimate, max_usd: float) -> str:
    return (
        f"cost: expected ${estimate['expected_usd']:.2f} "
        f"({round(estimate['expected_s'] / 60)} min), "
        f"hard bound ${estimate['bound_usd']:.2f}, limit ${max_usd:.2f}"
    )


def format_estimate_lines(estimate: Estimate) -> list[str]:
    return [
        f"  {line['item']}: {line['qty']:g} {line['unit']} @ ${line['usd_per_unit']:.4f} "
        f"= ${line['usd']:.2f} ({line['source']})"
        for line in estimate["lines"]
    ]


def format_estimate(estimate: Estimate, max_usd: float) -> str:
    return "\n".join(
        [format_estimate_summary(estimate, max_usd), *format_estimate_lines(estimate)]
    )


def confirm(prompt: str, yes: bool, stdin_is_tty: bool) -> bool:
    if yes:
        return True
    if not stdin_is_tty:
        return False
    return input(f"{prompt} [y/N] ").strip().lower() == "y"


def default_run_name(now: datetime | None = None) -> str:
    now = now if now is not None else datetime.now(UTC)
    return f"{getpass.getuser()}-{now.strftime('%Y%m%d-%H%M')}"


def new_run_dir(out_root: Path, name: str | None) -> Path:
    run_name = name if name is not None else default_run_name()
    if not NAME_RE.match(run_name):
        raise Refused(f"--name must match {NAME_RE.pattern}: {run_name!r}")
    run_dir = out_root / run_name
    if run_dir.exists():
        raise Refused(f"run {run_name} already exists at {run_dir}")
    run_dir.mkdir(parents=True)
    return run_dir


def setup_logging(run_dir: Path) -> None:
    for handler in list(log.handlers):
        log.removeHandler(handler)
        handler.close()
    log.setLevel(logging.DEBUG)
    log.propagate = False
    file_handler = logging.FileHandler(run_dir / "driver.log")
    file_handler.setLevel(logging.DEBUG)
    file_handler.setFormatter(
        logging.Formatter("%(asctime)s %(levelname)s %(message)s")
    )
    log.addHandler(file_handler)
    stream_handler = logging.StreamHandler(sys.stderr)
    stream_handler.setLevel(logging.INFO)
    stream_handler.setFormatter(logging.Formatter("%(message)s"))
    log.addHandler(stream_handler)


def append_event(run_dir: Path, phase: str, event: str, detail: str | None) -> None:
    record = {
        "ts": datetime.now(UTC).isoformat(),
        "phase": phase,
        "event": event,
        "detail": detail,
    }
    with (run_dir / "events.jsonl").open("a") as f:
        f.write(json.dumps(record) + "\n")


def config_to_json(cfg: RunConfig) -> dict[str, Any]:
    data = dataclasses.asdict(cfg)
    data["ssh_key"] = str(cfg.ssh_key)
    data["out_root"] = str(cfg.out_root)
    return data


def write_manifest(
    run_dir: Path,
    cfg: RunConfig,
    hosts: list[HostSpec],
    peers_by_node: dict[str, list[str]],
    estimate: Estimate,
    phase: str,
    argv: list[str],
) -> None:
    manifest: Manifest = {
        "name": run_dir.name,
        "created_at": datetime.now(UTC).isoformat(),
        "argv": argv,
        "config": config_to_json(cfg),
        "hosts": hosts,
        "peers": peers_by_node,
        "phase": phase,
        "phase_seconds": {
            name: list(bounds) for name, bounds in phase_seconds(cfg).items()
        },
        "estimate": estimate,
    }
    nb.write_json(run_dir / "manifest.json", manifest)
    append_event(run_dir, phase, "manifest-written", None)


def tools_on_path(
    names: Iterable[str], which: Callable[[str], str | None] = shutil.which
) -> None:
    missing = [name for name in names if which(name) is None]
    if missing:
        raise Refused(f"missing tools on PATH: {', '.join(missing)}")


def caller_account(run: Runner, cfg: RunConfig) -> str:
    """The account guard: the first AWS call preflight makes, so a mismatch is caught before
    any other `aws` call (a wrong profile must never touch the right account by accident)."""
    result = run(aws_argv(cfg, "sts", "get-caller-identity", "--output", "json"))
    if result.returncode != 0:
        raise Refused(f"aws sts get-caller-identity failed: {result.stderr.strip()}")
    account = json.loads(result.stdout)["Account"]
    if account != cfg.account:
        raise Refused(
            f"caller account {account} does not match --account {cfg.account} "
            f"(wrong --profile {cfg.profile}?)"
        )
    return account


def default_vpc(run: Runner, cfg: RunConfig) -> str:
    result = run(
        aws_argv(
            cfg,
            "ec2",
            "describe-vpcs",
            "--region",
            cfg.region,
            "--filters",
            "Name=is-default,Values=true",
            "--output",
            "json",
        )
    )
    if result.returncode != 0:
        raise Refused(f"aws ec2 describe-vpcs failed: {result.stderr.strip()}")
    vpcs = json.loads(result.stdout)["Vpcs"]
    if not vpcs:
        raise Refused(f"no default VPC in {cfg.region}; the terraform module needs one")
    vpc_id = vpcs[0]["VpcId"]
    attr = run(
        aws_argv(
            cfg,
            "ec2",
            "describe-vpc-attribute",
            "--region",
            cfg.region,
            "--vpc-id",
            vpc_id,
            "--attribute",
            "enableDnsHostnames",
            "--output",
            "json",
        )
    )
    if attr.returncode != 0:
        raise Refused(f"aws ec2 describe-vpc-attribute failed: {attr.stderr.strip()}")
    if not json.loads(attr.stdout)["EnableDnsHostnames"]["Value"]:
        raise Refused(
            f"default VPC {vpc_id} has DNS hostnames disabled: aws ec2 modify-vpc-attribute "
            f"--vpc-id {vpc_id} --enable-dns-hostnames --region {cfg.region}"
        )
    return vpc_id


def describe_instance_types(
    run: Runner, cfg: RunConfig, types: set[str]
) -> dict[str, dict[str, Any]]:
    result = run(
        aws_argv(
            cfg,
            "ec2",
            "describe-instance-types",
            "--region",
            cfg.region,
            "--instance-types",
            *sorted(types),
            "--query",
            "InstanceTypes[].{Type:InstanceType,VCpus:VCpuInfo.DefaultVCpus,"
            "Archs:ProcessorInfo.SupportedArchitectures}",
            "--output",
            "json",
        )
    )
    if result.returncode != 0:
        raise Refused(
            f"aws ec2 describe-instance-types failed: {result.stderr.strip()}"
        )
    return {row["Type"]: row for row in json.loads(result.stdout)}


def resolve_ami_arch(instance_types: dict[str, dict[str, Any]], types: set[str]) -> str:
    """`resolve_image` always requires `linux/arm64`; refusing here catches an amd64-only
    instance type before the AMI lookup instead of at the image digest check."""
    arch_sets = [set(instance_types[t]["Archs"]) for t in types]
    common = set.intersection(*arch_sets) if arch_sets else set()
    if "arm64" not in common:
        raise Refused(
            f"instance types {', '.join(sorted(types))} are not all arm64: "
            "only linux/arm64 images are resolved"
        )
    return "arm64"


def resolve_ami(run: Runner, cfg: RunConfig, arch: str) -> str:
    result = run(
        aws_argv(
            cfg,
            "ec2",
            "describe-images",
            "--region",
            cfg.region,
            "--owners",
            UBUNTU_OWNER_ID,
            "--filters",
            f"Name=name,Values=ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-{arch}-server-*",
            "--query",
            "sort_by(Images, &CreationDate)[-1].ImageId",
            "--output",
            "text",
        )
    )
    if result.returncode != 0:
        raise Refused(f"aws ec2 describe-images failed: {result.stderr.strip()}")
    ami_id = result.stdout.strip()
    if not ami_id or ami_id == "None":
        raise Refused(f"no Ubuntu 24.04 {arch} AMI found in {cfg.region}")
    return ami_id


def capable_az(run: Runner, cfg: RunConfig, types: set[str]) -> str:
    az_sets = []
    for instance_type in sorted(types):
        result = run(
            aws_argv(
                cfg,
                "ec2",
                "describe-instance-type-offerings",
                "--region",
                cfg.region,
                "--location-type",
                "availability-zone",
                "--filters",
                f"Name=instance-type,Values={instance_type}",
                "--output",
                "json",
            )
        )
        if result.returncode != 0:
            raise Refused(
                f"aws ec2 describe-instance-type-offerings failed for {instance_type}: "
                f"{result.stderr.strip()}"
            )
        offerings = json.loads(result.stdout)["InstanceTypeOfferings"]
        az_sets.append({o["Location"] for o in offerings})
    capable = set.intersection(*az_sets) if az_sets else set()
    if not capable:
        raise Refused(
            f"no AZ in {cfg.region} offers every instance type: {', '.join(sorted(types))}"
        )
    if cfg.az == "auto":
        return min(capable)
    if cfg.az not in capable:
        raise Refused(
            f"--az {cfg.az} does not offer every instance type; AZs that do: "
            f"{', '.join(sorted(capable))}"
        )
    return cfg.az


def _running_instance_types(run: Runner, cfg: RunConfig) -> list[str]:
    """One entry per running instance, not deduplicated: `vcpu_headroom` sums per instance."""
    result = run(
        aws_argv(
            cfg,
            "ec2",
            "describe-instances",
            "--region",
            cfg.region,
            "--filters",
            "Name=instance-state-name,Values=pending,running",
            "--query",
            "Reservations[].Instances[].InstanceType",
            "--output",
            "json",
        )
    )
    if result.returncode != 0:
        raise Refused(f"aws ec2 describe-instances failed: {result.stderr.strip()}")
    return list(json.loads(result.stdout))


def _vcpu_quota(run: Runner, cfg: RunConfig) -> float:
    result = run(
        aws_argv(
            cfg,
            "service-quotas",
            "get-service-quota",
            "--region",
            cfg.region,
            "--service-code",
            "ec2",
            "--quota-code",
            VCPU_QUOTA_CODE,
            "--output",
            "json",
        )
    )
    if result.returncode != 0:
        raise Refused(
            f"aws service-quotas get-service-quota failed: {result.stderr.strip()}"
        )
    return json.loads(result.stdout)["Quota"]["Value"]


def vcpu_headroom(
    run: Runner,
    cfg: RunConfig,
    hosts: list[HostSpec],
    running: list[str],
    instance_types: dict[str, dict[str, Any]],
) -> tuple[int, int, float]:
    """`running` has one entry per running instance (not deduplicated), so `in_use` counts
    each instance's vCPUs once, not once per distinct type."""
    vcpus = {t: row["VCpus"] for t, row in instance_types.items()}
    needed = sum(vcpus[h["instance_type"]] for h in hosts)
    in_use = sum(vcpus[t] for t in running)
    quota = _vcpu_quota(run, cfg)
    if needed + in_use > quota:
        raise Refused(
            f"vCPU quota {VCPU_QUOTA_CODE} is {quota:.0f} in {cfg.region}; {in_use} in use + "
            f"{needed} needed exceeds it: aws service-quotas request-service-quota-increase "
            f"--service-code ec2 --quota-code {VCPU_QUOTA_CODE} "
            f"--desired-value {int(needed + in_use)} --region {cfg.region}"
        )
    return needed, in_use, quota


def image_refs(cfg: RunConfig) -> dict[str, str]:
    images = {c: f"{GHCR_ORG}/{c}:{cfg.tag}" for c in IMAGE_COMPONENTS}
    images.update(SUPPORT_IMAGES)
    return images


DOCKER_HUB_HOST = "registry-1.docker.io"
# Both are docker.io aliases in image refs; the registry API itself is only ever reachable at
# registry-1.docker.io (https://docker.io/v2/... 302s to www.docker.com).
DOCKER_HUB_ALIASES = ("docker.io", "index.docker.io")


def parse_ref(ref: str) -> tuple[str, str, str]:
    """`[registry[:port]/]repository[:tag]` -> (registry host, repository, tag). No registry
    segment means docker.io, and a single-word repository is implicitly under `library/`."""
    name, sep, tag = ref.rpartition(":")
    if not sep or "/" in tag:
        name, tag = ref, "latest"
    parts = name.split("/", 1)
    if len(parts) == 1:
        return DOCKER_HUB_HOST, f"library/{parts[0]}", tag
    first, repository = parts
    if first in DOCKER_HUB_ALIASES:
        return DOCKER_HUB_HOST, repository, tag
    if "." in first or ":" in first or first == "localhost":
        return first, repository, tag
    return DOCKER_HUB_HOST, name, tag


def _registry_scheme(host: str) -> str:
    # Loopback is only ever the test fixture; every real registry requires TLS.
    return "http" if host.split(":")[0] in ("localhost", "127.0.0.1") else "https"


def _registry_get(url: str, headers: dict[str, str]) -> tuple[int, Any, bytes]:
    request = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.status, response.headers, response.read()
    except urllib.error.HTTPError as exc:
        with exc:
            return exc.code, exc.headers, exc.read()


def _bearer_token(www_authenticate: str, ref: str) -> str:
    params = dict(re.findall(r'(\w+)="([^"]*)"', www_authenticate))
    realm = params["realm"]
    query = urllib.parse.urlencode({k: v for k, v in params.items() if k != "realm"})
    status, _, body = _registry_get(f"{realm}?{query}", {})
    if status != 200:
        raise Refused(f"token request for {ref} to {realm} failed with status {status}")
    token = json.loads(body)
    return token["token"] if "token" in token else token["access_token"]


def resolve_image(ref: str) -> ImageInfo:
    """Anonymous token challenge, then the manifest (an index for a multi-arch image, or a
    single manifest otherwise) and its config blob, for the digest, the `linux/arm64`
    platform and the `org.opencontainers.image.revision` label. Works against ghcr and docker
    hub unmodified: both implement the same OCI distribution spec."""
    host, repository, tag = parse_ref(ref)
    scheme = _registry_scheme(host)
    manifest_url = f"{scheme}://{host}/v2/{repository}/manifests/{tag}"
    headers = {"Accept": ", ".join(MANIFEST_MEDIA_TYPES)}
    status, resp_headers, body = _registry_get(manifest_url, headers)
    if status == 401:
        headers["Authorization"] = (
            f"Bearer {_bearer_token(resp_headers['WWW-Authenticate'], ref)}"
        )
        status, resp_headers, body = _registry_get(manifest_url, headers)
    if status == 404:
        raise Refused(f"image not found: {ref}")
    if status in (401, 403):
        raise Refused(
            f"image is private or inaccessible anonymously: {ref} (status {status})"
        )
    if status != 200:
        raise Refused(f"unexpected status {status} resolving {ref}")
    manifest = json.loads(body)
    media_type = manifest.get("mediaType", resp_headers.get("Content-Type", ""))
    if media_type in INDEX_MEDIA_TYPES:
        # buildx attestations (SBOM, provenance) show up as extra manifests with
        # platform.os == "unknown" and must not be mistaken for a real platform.
        entries = [m for m in manifest["manifests"] if m["platform"]["os"] != "unknown"]
        platforms = [
            f"{m['platform']['os']}/{m['platform']['architecture']}" for m in entries
        ]
        arm64 = next(
            (
                m
                for m in entries
                if m["platform"]["os"] == "linux"
                and m["platform"]["architecture"] == "arm64"
            ),
            None,
        )
        if arm64 is None:
            raise Refused(
                f"no linux/arm64 platform for {ref}: has {', '.join(platforms)}"
            )
        digest = arm64["digest"]
        child_status, _, child_body = _registry_get(
            f"{scheme}://{host}/v2/{repository}/manifests/{digest}", headers
        )
        if child_status != 200:
            raise Refused(
                f"failed to fetch the arm64 manifest for {ref}: status {child_status}"
            )
        config_digest = json.loads(child_body)["config"]["digest"]
    else:
        digest = resp_headers.get("Docker-Content-Digest") or (
            f"sha256:{hashlib.sha256(body).hexdigest()}"
        )
        config_digest = manifest["config"]["digest"]
        platforms = []
    status, _, config_body = _registry_get(
        f"{scheme}://{host}/v2/{repository}/blobs/{config_digest}", headers
    )
    if status != 200:
        raise Refused(f"failed to fetch the config blob for {ref}: status {status}")
    config = json.loads(config_body)
    if not platforms:
        platform = f"{config['os']}/{config['architecture']}"
        if platform != "linux/arm64":
            raise Refused(f"no linux/arm64 platform for {ref}: has {platform}")
        platforms = [platform]
    revision = (config.get("config", {}).get("Labels") or {}).get(
        "org.opencontainers.image.revision"
    )
    return {"ref": ref, "digest": digest, "revision": revision, "platforms": platforms}


def check_git_clean(run: Runner, allow_dirty: bool) -> str | None:
    """`None` for a clean tree. With `allow_dirty`, returns the diff to be recorded as
    `diff.patch`; without it, a dirty tree is refused. `--untracked-files=no` keeps the
    dirty check in scope with `git diff HEAD`, which never includes untracked files."""
    status = run(["git", "status", "--porcelain", "--untracked-files=no"])
    if status.returncode != 0:
        raise Refused(f"git status failed: {status.stderr.strip()}")
    if not status.stdout.strip():
        return None
    if not allow_dirty:
        raise Refused("git tree is dirty; commit the changes or pass --allow-dirty")
    diff = run(["git", "diff", "HEAD"])
    if diff.returncode != 0:
        raise Refused(f"git diff failed: {diff.stderr.strip()}")
    return diff.stdout


def preflight(
    run: Runner,
    cfg: RunConfig,
    hosts: list[HostSpec],
    which: Callable[[str], str | None] = shutil.which,
) -> Preflight:
    tools_on_path((cfg.tf, "aws", "ssh", "scp", "rsync", "git"), which)
    account = caller_account(run, cfg)
    vpc_id = default_vpc(run, cfg)
    types = {h["instance_type"] for h in hosts}
    az = capable_az(run, cfg, types)
    running = _running_instance_types(run, cfg)
    # Fetched once: resolve_ami_arch and vcpu_headroom both need every requested and running
    # instance type's vCPU count and architecture.
    instance_types = describe_instance_types(run, cfg, set(running) | types)
    needed, in_use, quota = vcpu_headroom(run, cfg, hosts, running, instance_types)
    ami_id = resolve_ami(run, cfg, resolve_ami_arch(instance_types, types))
    images = {name: resolve_image(ref) for name, ref in image_refs(cfg).items()}
    git_diff = check_git_clean(run, cfg.allow_dirty)
    return {
        "account": account,
        "vpc_id": vpc_id,
        "az": az,
        "ami_id": ami_id,
        "images": images,
        "vcpu_needed": needed,
        "vcpu_in_use": in_use,
        "vcpu_quota": quota,
        "git_diff": git_diff,
    }


def classify_tf_error(stderr: str) -> str:
    if "VcpuLimitExceeded" in stderr:
        return (
            "VcpuLimitExceeded: aws service-quotas request-service-quota-increase "
            f"--service-code ec2 --quota-code {VCPU_QUOTA_CODE} --desired-value <n>"
        )
    if "InsufficientInstanceCapacity" in stderr:
        return "InsufficientInstanceCapacity: retry with --az <other> or a different instance type"
    if "UnauthorizedOperation" in stderr:
        return "UnauthorizedOperation: check IAM permissions for the AWS profile"
    last_line = next(
        (line for line in reversed(stderr.strip().splitlines()) if line), stderr
    )
    return f"unclassified terraform error: {last_line}"


def terraform_env() -> dict[str, str]:
    """Region, profile and account go into `terraform.tfvars.json` and the provider block, not
    the environment: `region` and `profile` are provider arguments. `TF_PLUGIN_CACHE_DIR` has
    no HCL equivalent, so it stays here."""
    return {"TF_PLUGIN_CACHE_DIR": str(TF_PLUGIN_CACHE_DIR)}


class Terraform:
    """`tofu -chdir=<terraform_dir>` through the injectable Runner. `env` is exported into the
    current process's environment once at construction, since neither `tofu` nor the Runner
    interface takes a subprocess environment; keep it to values constant for the process
    lifetime (like `TF_PLUGIN_CACHE_DIR`), never per-run values, or later tests observe them."""

    def __init__(self, run: Runner, tf: str, terraform_dir: Path, env: dict[str, str]):
        self.run = run
        self.tf = tf
        self.dir = terraform_dir
        os.environ.update(env)

    def _argv(self, *args: str) -> list[str]:
        return [self.tf, f"-chdir={self.dir}", *args]

    def init(self) -> None:
        result = self.run(self._argv("init", "-input=false"))
        if result.returncode != 0:
            raise Refused(f"tofu init failed: {result.stderr.strip()}")

    def plan(self, out: str = "plan.bin") -> str:
        result = self.run(self._argv("plan", "-input=false", f"-out={out}"))
        if result.returncode != 0:
            raise Refused(f"tofu plan failed: {result.stderr.strip()}")
        return result.stdout

    def apply(self, plan_file: str = "plan.bin") -> None:
        result = self.run(
            self._argv("apply", "-input=false", "-auto-approve", plan_file)
        )
        if result.returncode != 0:
            raise TfFailed("apply", classify_tf_error(result.stderr))

    def output(self) -> dict[str, Any]:
        result = self.run(self._argv("output", "-json"))
        if result.returncode != 0:
            raise Refused(f"tofu output failed: {result.stderr.strip()}")
        return json.loads(result.stdout)

    def destroy(self) -> None:
        result = self.run(self._argv("destroy", "-input=false", "-auto-approve"))
        if result.returncode != 0:
            raise TfFailed("destroy", f"tofu destroy failed: {result.stderr.strip()}")


def render_tfvars(
    cfg: RunConfig,
    run_dir: Path,
    name: str,
    owner: str,
    hosts: list[HostSpec],
    ssh_pub: str,
    operator_cidr: str,
    expires_at: str,
    git_rev: str,
    az: str,
    ami_id: str,
) -> dict[str, Any]:
    """`az` and `ami_id` come from `preflight`, or from an offline caller's own placeholders;
    the terraform module no longer re-resolves either (it would risk picking a different AZ
    than the one preflight already checked every instance type against)."""
    return {
        "name": name,
        "owner": owner,
        "git_rev": git_rev,
        "account_id": cfg.account,
        "region": cfg.region,
        "profile": cfg.profile,
        "az": az,
        "ami_id": ami_id,
        "ssh_public_key": ssh_pub,
        "operator_cidr": operator_cidr,
        "expires_at": expires_at,
        "offline": cfg.offline,
        "hosts": {
            h["name"]: {
                "role": h["role"],
                "instance_type": h["instance_type"],
                "root_gb": h["root_gb"],
                "root_iops": h["root_iops"],
                "root_mbps": h["root_mbps"],
                "user_data_path": str(run_dir / "hosts" / h["name"] / "user-data.sh"),
            }
            for h in hosts
        },
    }


