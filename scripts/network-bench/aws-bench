def freeze_command(names: tuple[str, ...]) -> str:
    """`docker stop` per container, ignoring only a container that does not exist."""
    return (
        f"for c in {' '.join(names)}; do "
        f"out=$(docker stop -t {int(FREEZE_STOP_TIMEOUT_S)} $c 2>&1) || "
        'case "$out" in *"No such container"*) ;; *) echo "$out" >&2; exit 1;; esac; '
