#!/usr/bin/env python3
r"""Compile-cost metrics for CI: collect per-job numbers, merge them, compare against main.

`collect` reads the `cargo build --timings` HTML a build job already produces plus the binaries it
produced, so tracking costs no extra compilation. Only workspace units are kept: third-party unit
times depend on the state of the dependency cache, which differs between any two runs whose
Cargo.lock differs.

Unit durations are wall time under whatever parallelism the job had, so a single unit is noisy on
jobs that build many crates at once. The per-job sum and the critical path are the signals; the
per-unit table is a pointer.

`collect` also records the feature set cargo resolved for every package. Feature unification is
per package across the whole build, so a feature enabled on one leaf crate is compiled into every
build that reaches it; the diff against main is the only visible sign of it.

Examples:
    # Wrap the build to record its peak memory.
    scripts/compile-metrics sample-rss --out peak-rss.json -- scripts/ci-build-binary espresso-node

    # In a build job, after the build. --timing and --binaries-dir are optional, so a job that
    # compiles without --timings still reports what it cost in memory.
    scripts/compile-metrics collect --job amd-espresso-node --peak-rss peak-rss.json \
        --timing target/cargo-timings/cargo-timing.html --binaries-dir target/release \
        --out compile-metrics-amd-espresso-node.json

    # Merge the per-job artifacts of one run.
    scripts/compile-metrics merge metrics-artifacts --sha "$SHA" --run-id "$RUN_ID" \
        --out compile-metrics.json

    # Compare a run against the newest main run, from `nextest-ci stats-fetch` output.
    scripts/compile-metrics report compile-metrics.json --main-stats main-compile-metrics.json
"""

import argparse
import json
import logging
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any

log = logging.getLogger("compile-metrics")

UNIT_DATA_RE = re.compile(r"^const UNIT_DATA = (\[.*?^\]);$", re.MULTILINE | re.DOTALL)
DURATION_RE = re.compile(r"^DURATION = ([0-9.]+);$", re.MULTILINE)
# `nm --print-size` writes "<address> <size> <type> <name>", but drops the size column for
# symbols that have none. A demangled name contains spaces, so the columns cannot be counted.
SYMBOL_RE = re.compile(r"^[0-9a-fA-F]{2,} ([0-9a-fA-F]{2,}) \S (.+)$")
# A generic argument list with nothing nested left inside it, and the 64-bit disambiguator
# rustc's legacy mangling appends to every symbol.
GENERIC_ARGS_RE = re.compile(r"<[^<>]*(?<!-)>")
LEGACY_HASH_RE = re.compile(r"::h[0-9a-f]{16}$")
EMPTY_PATH_RE = re.compile(r"::(::)+")

# Thresholds. Chosen from a measured run-to-run spread of about +-15 % on job wall time and
# +-20 % on a single compilation unit, so a unit needs a wider band than a per-job total, and
# the deterministic binary metrics get the tightest one. Retune once main baselines exist.
WORKSPACE_CPU_PCT = 10.0
CRITICAL_PATH_PCT = 10.0
UNIT_CPU_PCT = 15.0
UNIT_MIN_S = 20.0
PEAK_RSS_PCT = 10.0
BINARY_PCT = 5.0
CRATE_BYTES_MIN = 256 * 1024
INSTANTIATIONS_MIN = 50
TOP_CRATES = 25
TOP_BASES = 25
TOP_MOVERS = 10
TOP_BINARIES = 10
TOP_UNITS = 10
TOP_FEATURE_ROWS = 25
NAME_KEPT_CHARS = 200
MOVER_MIN_PCT = 0.5
JOB_METRICS = ("peak memory", "largest process", "workspace cpu-s", "critical path s")
RSS_SAMPLE_S = 2.0
NO_TIMINGS = "no `--timings`"
NOT_SAMPLED = "not sampled"
NOT_COMPARED = "not in both runs"
NO_FEATURE_RECORD = "no feature record in both runs"


@dataclass(frozen=True)
class Change:
    scope: str
    name: str
    metric: str
    main: float
    current: float
    threshold_pct: float

    @property
    def delta_pct(self) -> float:
        return (self.current - self.main) / self.main * 100 if self.main else 0.0

    @property
    def regressed(self) -> bool:
        return self.delta_pct > self.threshold_pct


@dataclass
class FeatureDiff:
    """`changed` is package -> (features gained, features lost); the rest are whole packages.

    A feature change is reported but is never a regression: it is not a measurement, and a
    Cargo.lock update moves dozens of them at once. It says where to look when a number moved.
    """

    changed: dict[str, tuple[list[str], list[str]]]
    added: list[str]
    removed: list[str]
    compared: bool


# collect


def parse_timing(html: str) -> tuple[float, list[dict]]:
    units = UNIT_DATA_RE.search(html)
    if units is None:
        raise RuntimeError("no UNIT_DATA array in the timing HTML")
    duration = DURATION_RE.search(html)
    if duration is None:
        raise RuntimeError("no DURATION line in the timing HTML")
    return float(duration.group(1)), json.loads(units.group(1))


def unit_key(unit: dict) -> str:
    """`espresso-node lib`, `espresso-node build-script`, `staking-cli bin`.

    Cargo leaves `target` empty for a lib unit, and otherwise writes ` [<name> ]"<kind>"` or
    ` build-script[ (run)]`.
    """
    target = unit["target"].strip().replace('"', "")
    if not target:
        return f"{unit['name']} lib"
    return (
        target if target.startswith(f"{unit['name']} ") else f"{unit['name']} {target}"
    )


def workspace_cpu(units: list[dict], members: set[str]) -> dict[str, float]:
    cpu: dict[str, float] = {}
    for unit in units:
        if unit["name"] in members:
            key = unit_key(unit)
            cpu[key] = round(cpu.get(key, 0.0) + unit["duration"], 1)
    return dict(sorted(cpu.items()))


def critical_path(units: list[dict]) -> list[tuple[str, float]]:
    """Longest chain through the unit graph, as [(unit, duration)] from root to leaf.

    Cargo splits successors into units unblocked when this one finishes and units unblocked when it
    emits rmeta; the rmeta timestamp is not in the report, so both edges are weighted with the full
    duration. That makes this an upper bound on the true path, but a stable one: unlike a cpu sum or
    a single unit's time, it does not move with how many other crates happened to compile alongside.
    """
    by_index = {unit["i"]: unit for unit in units}
    edges = {
        unit["i"]: [
            successor
            for successor in unit["unblocked_units"] + unit["unblocked_rmeta_units"]
            if successor in by_index
        ]
        for unit in units
    }
    order = topological_order(edges)
    best: dict[int, tuple[float, list[int]]] = {}
    for index in reversed(order):
        duration = by_index[index]["duration"]
        tail = max(
            (best[successor] for successor in edges[index] if successor in best),
            key=lambda result: result[0],
            default=(0.0, []),
        )
        best[index] = (duration + tail[0], [index] + tail[1])
    _, path = max(best.values(), key=lambda result: result[0], default=(0.0, []))
    return [(unit_key(by_index[i]), by_index[i]["duration"]) for i in path]


def topological_order(edges: dict[int, list[int]]) -> list[int]:
    indegree = {node: 0 for node in edges}
    for successors in edges.values():
        for successor in successors:
            indegree[successor] += 1
    queue = [node for node, count in indegree.items() if count == 0]
    order = []
    while queue:
        node = queue.pop()
        order.append(node)
        for successor in edges[node]:
            indegree[successor] -= 1
            if indegree[successor] == 0:
                queue.append(successor)
    if len(order) != len(edges):
        raise RuntimeError("the cargo unit graph is not acyclic")
    return order


def read_metadata() -> dict[str, Any]:
    """`cargo metadata` with dependencies, or an empty dict.

    One call feeds both the workspace-unit filter and the feature record; `--no-deps` is cheaper
    but leaves `resolve` null. It compiles nothing and takes 0.58 s on this workspace, against
    0.03 s for `--no-deps`. A failure here costs the unit table and the feature record,
    never the job's memory numbers.
    """
    try:
        out = subprocess.run(
            ["cargo", "metadata", "--format-version", "1"],
            check=True,
            capture_output=True,
            text=True,
        )
        return json.loads(out.stdout)
    except Exception as error:  # noqa: BLE001
        log.warning("no cargo metadata: %s", error)
        return {}


def workspace_members(metadata: dict[str, Any]) -> set[str]:
    ids = set(metadata.get("workspace_members", []))
    return {
        package["name"]
        for package in metadata.get("packages", [])
        if package["id"] in ids
    }


def resolved_features(metadata: dict[str, Any]) -> dict[str, str]:
    """Every package cargo resolved a feature for, as `"name version": "feat feat"`.

    Cargo unifies features per package across the whole build, so enabling one on a leaf crate
    pulls it into everything that depends on it, and the diff against main is what makes that
    visible. `cargo metadata` resolves the whole workspace whatever the job built, so the jobs of
    one run normally record the same map; each job records its own anyway, so a job whose
    checkout or cargo config differs shows up instead of being averaged away.

    Space-joined rather than a list because `json.dumps(indent=2)` puts every list element on its
    own line: 44 kB per job instead of 64 kB, and this rides in an artifact kept for 90 days.
    Packages with no feature enabled are dropped, so a package that gains its first feature reads
    as an added package.
    """
    names = {
        package["id"]: f"{package['name']} {package['version']}"
        for package in metadata.get("packages", [])
    }
    nodes = (metadata.get("resolve") or {}).get("nodes", [])
    return dict(
        sorted(
            (names[node["id"]], " ".join(sorted(node["features"])))
            for node in nodes
            if node["features"] and node["id"] in names
        )
    )


def text_section_bytes(path: Path) -> int:
    out = subprocess.run(
        ["size", "-A", str(path)], check=True, capture_output=True, text=True
    )
    for line in out.stdout.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0] == ".text":
            return int(fields[1])
    raise RuntimeError(f"no .text section in {path}")


def measure_binary(path: Path) -> dict[str, Any]:
    """One `nm` pass per binary, read as a stream.

    The line count is the symbol count and sized lines carry the bytes, the instantiation counts
    and the name lengths, so all of it comes out of the same pass. It is streamed because `nm` on
    a 130 MB release binary emits hundreds of MB, and this runs in a job that has just peaked at
    11 GB.

    `instantiated_symbols` over `generic_bases` is the average multiplicity, and the top of
    `instantiations` is which base to go after: that is what turns "symbols +8 %" into "this
    function is instantiated 340 times".

    `name_bytes` and `max_name_len` are the v0-mangling signal: v0 encodes the full generic
    arguments, so a deep combinator chain or a nested `impl Future` produces a name in the
    kilobytes, and `max_name` names the type to go after. They cover the sized symbols, which is
    every function; the unsized lines are undefined and absolute symbols with short names.
    """
    measured = {"bytes": path.stat().st_size, "text_bytes": text_section_bytes(path)}
    symbols = 0
    instantiations = 0
    name_bytes = 0
    longest = ""
    totals: dict[str, int] = {}
    counts: dict[str, int] = {}
    with subprocess.Popen(
        ["nm", "--demangle", "--print-size", str(path)],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        encoding="utf-8",
        errors="replace",
    ) as nm:
        for line in nm.stdout or ():
            symbols += 1
            symbol = SYMBOL_RE.match(line)
            if symbol is None:
                continue
            name = symbol.group(2)
            crate = symbol_crate(name)
            totals[crate] = totals.get(crate, 0) + int(symbol.group(1), 16)
            name_bytes += len(name)
            if len(name) > len(longest):
                longest = name
            base = generic_base(name)
            if base is not None:
                instantiations += 1
                counts[base] = counts.get(base, 0) + 1
    if nm.returncode != 0:
        raise RuntimeError(f"nm exited {nm.returncode} on {path}")
    return measured | {
        "symbols": symbols,
        # The report keeps the top N so the artifact the comparison reads stays small. The full
        # tallies go to --raw-out, for questions nobody has asked yet.
        "_full": {
            "crate_bytes": dict(sorted(totals.items())),
            "instantiations": dict(sorted(counts.items())),
        },
        "crate_bytes": dict(sorted(top_n(totals, TOP_CRATES))),
        "instantiations": dict(sorted(top_n(counts, TOP_BASES))),
        "instantiated_symbols": instantiations,
        "generic_bases": len(counts),
        "name_bytes": name_bytes,
        "max_name_len": len(longest),
        "max_name": elide(longest, NAME_KEPT_CHARS),
    }


def top_n(values: dict[str, int], count: int) -> list[tuple[str, int]]:
    return sorted(values.items(), key=lambda item: -item[1])[:count]


def elide(text: str, limit: int) -> str:
    return text if len(text) <= limit else text[: limit - 1] + "…"


def symbol_crate(name: str) -> str:
    """Crate a demangled symbol belongs to: the leading path segment of the defining type."""
    name = name.lstrip("<&*").lstrip()
    for separator in (" as ", "::", "<", "("):
        head, _, _ = name.partition(separator)
        name = head
    return name.strip("<>&*()[] ") or "?"


def generic_base(name: str) -> str | None:
    """The path a demangled symbol is an instantiation of, or None if it is not one.

    Both mangling schemes reduce to one path per generic function, so grouping by it counts
    instantiations. v0, which rustc 1.97 defaults to here, writes the generic arguments out
    (`core::ptr::drop_in_place::<T>`), so they are stripped. The impl qualifier a name opens with
    is kept, with its own arguments stripped, because dropping `<alloc::vec::Vec<u8> as Drop>` or
    `<alloc::raw_vec::RawVec<u8>>` would merge every `drop` or every `grow_one` in the binary into
    one base. Legacy erases the arguments already and appends `::h<16 hex>`, so the hash is
    stripped instead.

    A name with neither, a C symbol or a non-generic function, is not an instantiation and returns
    None: including those would put one base per symbol in the table and grow it by the size of
    the binary.
    """
    base = LEGACY_HASH_RE.sub("", name)
    qualifier, rest = split_qualifier(base)
    stripped = strip_generic_args(qualifier) + strip_generic_args(rest)
    if stripped == name:
        return None
    return EMPTY_PATH_RE.sub("::", stripped).removesuffix("::")


def split_qualifier(name: str) -> tuple[str, str]:
    """`<Vec<u8> as Drop>::drop` -> (`<Vec<u8> as Drop>`, `::drop`), else ("", name).

    Only a leading group is an impl qualifier. Everywhere else `<...>` is an argument list, and
    `foo::<u8>` follows `::` exactly as `<Vec<u8> as Drop>::drop` does, so position is what
    separates the two.
    """
    if not name.startswith("<"):
        return "", name
    depth = 0
    for index, char in enumerate(name):
        depth += (char == "<") - (char == ">" and name[index - 1] != "-")
        if depth == 0:
            return name[: index + 1], name[index + 1 :]
    return "", name


def strip_generic_args(name: str) -> str:
    """Drop every argument list, innermost first, keeping any `<T as Trait>` inside."""
    if name.startswith("<") and name.endswith(">"):
        return f"<{strip_generic_args(name[1:-1])}>"
    while "<" in name:
        stripped = GENERIC_ARGS_RE.sub(
            lambda group: group[0] if " as " in group[0] else "", name
        )
        if stripped == name:
            return name
        name = stripped
    return name


def executables(directory: Path) -> list[Path]:
    return sorted(
        path
        for path in directory.iterdir()
        if path.is_file() and path.stat().st_mode & 0o111
    )


def read_json(path: Path) -> dict:
    """A missing or truncated file costs the metrics it holds and nothing else."""
    try:
        return json.loads(path.read_text())
    except Exception as error:  # noqa: BLE001
        log.warning("ignoring %s: %s", path, error)
        return {}


def timing_metrics(
    timing: Path | None, members: set[str]
) -> tuple[float, dict[str, float], list[tuple[str, float]]]:
    """(wall, cpu per unit, critical path), all empty when there is no readable timing report.

    A job that builds without `--timings` has none, and so does a job whose report cargo did not
    finish writing or whose `cargo metadata` failed, leaving no member list to filter units by.
    The memory numbers are worth keeping in every case, so nothing here raises. `wall` is what
    tells the report which case a zero belongs to.
    """
    if timing is None or not members:
        return 0.0, {}, []
    try:
        wall, units = parse_timing(timing.read_text())
        return wall, workspace_cpu(units, members), critical_path(units)
    except Exception as error:  # noqa: BLE001
        log.warning("no usable timing report at %s: %s", timing, error)
        return 0.0, {}, []


def measured_binaries(directory: Path | None) -> dict[str, dict[str, Any]]:
    """One unreadable file must not cost the whole job its metrics, memory included."""
    if directory is None or not directory.is_dir():
        return {}
    measured = {}
    for path in executables(directory):
        try:
            measured[path.name] = measure_binary(path)
        except Exception as error:  # noqa: BLE001
            log.warning("skipping %s: %s", path, error)
    return measured


def cmd_collect(args: argparse.Namespace) -> int:
    metadata = read_metadata()
    wall, cpu, path = timing_metrics(args.timing, workspace_members(metadata))
    binaries = measured_binaries(args.binaries_dir)
    rss = read_json(args.peak_rss) if args.peak_rss else {}
    features = resolved_features(metadata)
    metrics = {
        "job": args.job,
        "wall_s": wall,
        "workspace_cpu_s": round(sum(cpu.values()), 1),
        "critical_path_s": round(sum(duration for _, duration in path), 1),
        "critical_path": [{"unit": unit, "s": duration} for unit, duration in path],
        "peak_used_kb": rss.get("peak_used_kb", 0),
        "mem_total_kb": rss.get("mem_total_kb", 0),
        "peak_rss_kb": rss.get("peak_rss_kb", 0),
        "peak_rss_by": rss.get("peak_rss_by", ""),
        "units": cpu,
        "binaries": binaries,
        "features": features,
    }
    full = {name: sizes.pop("_full", {}) for name, sizes in binaries.items()}
    args.out.write_text(json.dumps(metrics, indent=2) + "\n")
    if args.raw_out:
        # Everything the report caps away, kept so a later question can be answered without a
        # rebuild. Deliberately not named compile-metrics-*.json: merge globs that.
        args.raw_out.write_text(
            json.dumps({"job": args.job, "binaries": full}, indent=2) + "\n"
        )
    log.info(
        "%s: %.1f workspace cpu-s over %d units, %.1f s critical path, %d binaries, "
        "%d packages with features",
        args.job,
        metrics["workspace_cpu_s"],
        len(cpu),
        metrics["critical_path_s"],
        len(binaries),
        len(features),
    )
    return 0


# sample-rss


def process_peak_rss(pid: str) -> tuple[int, str] | None:
    """(VmHWM in kB, label) for one pid, or None if it is gone or unreadable."""
    try:
        status = Path(f"/proc/{pid}/status").read_text(errors="replace")
        command = Path(f"/proc/{pid}/cmdline").read_text(errors="replace").split("\0")
    except OSError:
        return None
    for line in status.splitlines():
        if line.startswith("VmHWM:"):
            label = Path(command[0]).name if command and command[0] else pid
            if "--crate-name" in command:
                label = f"{label} {command[command.index('--crate-name') + 1]}"
            return int(line.split()[1]), label
    return None


def parent_pids() -> dict[int, int]:
    parents = {}
    for entry in Path("/proc").iterdir():
        if entry.name.isdigit():
            try:
                stat = (entry / "stat").read_text(errors="replace")
            except OSError:
                continue
            # comm sits in parens and may contain spaces, so ppid is the field after the last ')'.
            parents[int(entry.name)] = int(stat.rpartition(")")[2].split()[1])
    return parents


def process_tree(root: int) -> set[int]:
    parents = parent_pids()
    tree = {root}
    for pid in parents:
        chain, current = [], pid
        while current > 1 and current not in tree and current in parents:
            chain.append(current)
            current = parents[current]
        if current in tree:
            tree.update(chain)
    return tree


def meminfo() -> dict[str, int]:
    values = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        field, _, rest = line.partition(":")
        if field in ("MemTotal", "MemAvailable"):
            values[field] = int(rest.split()[0])
    return values


def scan_peak_rss(root: int, peak: tuple[int, str]) -> tuple[int, str]:
    for pid in process_tree(root):
        sample = process_peak_rss(str(pid))
        if sample is not None and sample[0] > peak[0]:
            peak = sample
    return peak


def cmd_sample_rss(args: argparse.Namespace) -> int:
    """Run a build and record how much memory it needed.

    Two numbers, because they answer different questions. `peak_used_kb` is machine-wide
    (MemTotal - the lowest MemAvailable seen); it is what decides whether a 16 GB runner survives,
    since every rustc, linker and test service on the box counts. `peak_rss_kb` is the largest
    single process, which says which crate to go after.

    Sampling /proc is the only route that works here: /usr/bin/time is absent on NixOS, and
    getrusage(RUSAGE_CHILDREN) from a wrapper did not capture rustc's peak through cargo. VmHWM is
    a high-water mark, so a 2 s interval cannot miss the peak of a rustc that runs for minutes; it
    can miss a spike that both starts and ends inside one interval.

    This wraps five real build steps, so its own exit status is the build's: sampling failures are
    logged and dropped, and a signal death is reported the way a shell reports it.
    """
    if not args.build_command:
        raise RuntimeError("usage: compile-metrics sample-rss --out FILE -- COMMAND...")
    child = subprocess.Popen(args.build_command)
    peak = (0, "")
    total = 0
    least_available = None
    while child.poll() is None:
        try:
            peak = scan_peak_rss(child.pid, peak)
            memory = meminfo()
            total = memory.get("MemTotal", total)
            available = memory.get("MemAvailable")
            if available is not None:
                least_available = min(available, least_available or available)
        # Anything raised here, including a decode error on another process's argv, would
        # orphan the build and fail the step.
        except Exception as error:  # noqa: BLE001
            log.warning("memory sampling failed: %s", error)
        time.sleep(RSS_SAMPLE_S)
    used = total - least_available if least_available is not None else 0
    try:
        args.out.write_text(
            json.dumps(
                {
                    "peak_used_kb": used,
                    "mem_total_kb": total,
                    "peak_rss_kb": peak[0],
                    "peak_rss_by": peak[1],
                }
            )
            + "\n"
        )
        log.info(
            "peak memory %s of %s, largest process %s at %s",
            fmt_bytes(used * 1024),
            fmt_bytes(total * 1024),
            peak[1] or "none sampled",
            fmt_bytes(peak[0] * 1024),
        )
    except Exception as error:  # noqa: BLE001
        log.warning("could not write %s: %s", args.out, error)
    if child.returncode < 0:
        return 128 - child.returncode  # killed by signal N, as a shell reports it
    return child.returncode


# merge


def merge_jobs(paths: list[Path]) -> dict[str, Any]:
    jobs = {}
    for path in paths:
        metrics = read_json(path)
        if not metrics:
            continue  # read_json has already said why
        if "job" not in metrics:
            log.warning("ignoring %s: no job field", path)
            continue
        jobs[metrics["job"]] = metrics
    return jobs


def cmd_merge(args: argparse.Namespace) -> int:
    paths = sorted(args.dir.rglob("compile-metrics-*.json"))
    if not paths:
        raise RuntimeError(f"no compile-metrics-*.json under {args.dir}")
    merged = {
        "sha": args.sha,
        "run_id": args.run_id,
        "run_url": args.run_url,
        "jobs": merge_jobs(paths),
    }
    args.out.write_text(json.dumps(merged, indent=2) + "\n")
    log.info("wrote %s with %d job(s)", args.out, len(merged["jobs"]))
    return 0


# report


def compare(main: dict[str, Any], current: dict[str, Any]) -> list[Change]:
    changes = []
    for job, now in current["jobs"].items():
        before = main.get("jobs", {}).get(job)
        if before is None:
            continue
        for key, label, threshold in (
            ("peak_used_kb", "peak memory", PEAK_RSS_PCT),
            ("workspace_cpu_s", "workspace cpu-s", WORKSPACE_CPU_PCT),
            ("critical_path_s", "critical path s", CRITICAL_PATH_PCT),
            ("peak_rss_kb", "largest process", PEAK_RSS_PCT),
        ):
            if before.get(key) and now.get(key):
                changes.append(
                    Change(job, job, label, before[key], now[key], threshold)
                )
        for unit, cpu in now.get("units", {}).items():
            was = before.get("units", {}).get(unit)
            if was is not None and was >= UNIT_MIN_S:
                changes.append(Change(job, unit, "cpu-s", was, cpu, UNIT_CPU_PCT))
        for binary, sizes in now.get("binaries", {}).items():
            was_sizes = before.get("binaries", {}).get(binary)
            if was_sizes is None:
                continue
            for metric in ("bytes", "text_bytes", "symbols"):
                if metric not in was_sizes or metric not in sizes:
                    continue
                changes.append(
                    Change(
                        job,
                        binary,
                        metric,
                        was_sizes[metric],
                        sizes[metric],
                        BINARY_PCT,
                    )
                )
            for crate, crate_size in sizes.get("crate_bytes", {}).items():
                was_crate = was_sizes.get("crate_bytes", {}).get(crate)
                if was_crate is not None and was_crate >= CRATE_BYTES_MIN:
                    changes.append(
                        Change(
                            job,
                            f"{binary}: {crate}",
                            "bytes",
                            was_crate,
                            crate_size,
                            BINARY_PCT,
                        )
                    )
            # Only the top TOP_BASES bases are recorded, so a base that was outside the baseline's
            # top list has nothing to compare against and produces no row; the binary's symbol
            # count still moves. The minimum count keeps a base going 2 -> 3 out of the table.
            for base, count in sizes.get("instantiations", {}).items():
                was_count = was_sizes.get("instantiations", {}).get(base)
                if was_count is not None and was_count >= INSTANTIATIONS_MIN:
                    changes.append(
                        Change(
                            job,
                            f"{binary}: {base}",
                            "instantiations",
                            was_count,
                            count,
                            BINARY_PCT,
                        )
                    )
    return changes


def fmt_value(value: float) -> str:
    return f"{value:,.0f}" if value == int(value) else f"{value:,.1f}"


def fmt_metric(metric: str, value: float) -> str:
    if metric in ("peak memory", "largest process"):
        return fmt_bytes(value * 1024)
    if metric in ("bytes", "text_bytes"):
        return fmt_bytes(value)
    return fmt_value(value)


def table(rows: list[Change], columns: list[str]) -> list[str]:
    if not rows:
        return []
    lines = [
        "| " + " | ".join(columns) + " | metric | main | this run | change |",
        "|---" * len(columns) + "|---|---:|---:|---:|",
    ]
    for change in rows:
        cells = [change.scope] if len(columns) == 1 else [change.scope, change.name]
        mark = " :warning:" if change.regressed else ""
        lines.append(
            "| "
            + " | ".join(cells)
            + f" | {change.metric} | {fmt_metric(change.metric, change.main)} | "
            f"{fmt_metric(change.metric, change.current)} | {change.delta_pct:+.1f}%{mark} |"
        )
    return lines


def top_movers(changes: list[Change]) -> list[Change]:
    """Every regression, then the largest remaining moves in either direction."""
    regressed = [c for c in changes if c.regressed]
    rest = sorted(
        (c for c in changes if not c.regressed), key=lambda c: -abs(c.delta_pct)
    )
    return sorted(
        regressed + rest[: max(0, TOP_MOVERS - len(regressed))],
        key=lambda c: -c.delta_pct,
    )


def fmt_bytes(count: float) -> str:
    for unit, scale in (("GB", 1024**3), ("MB", 1024**2), ("kB", 1024)):
        if count >= scale:
            return f"{count / scale:.1f} {unit}"
    return f"{count:.0f} B"


def instantiation_table(binaries: list[tuple[str, dict[str, Any]]]) -> list[str]:
    """How much of a binary is monomorphization, and over how few generics it is spread.

    The names are deliberately not here. A top-N by count is dominated by std across every run:
    on this workspace the leaders were `catch_unwind::do_call` at 6820 and `MapFuture` at 2536,
    while the instantiation that actually mattered ranked fourth. The comparison table is what
    surfaces a base whose count moved, and the raw artifact holds every base for digging.

    Empty for a run written before these fields existed, and for a binary with no generic symbol.
    """
    rows = [
        f"| {name} | {sizes.get('instantiated_symbols', 0):,} "
        f"| {sizes.get('generic_bases', 0):,} |"
        for name, sizes in binaries
        if sizes.get("instantiated_symbols")
    ]
    if not rows:
        return []
    return [
        "",
        "| binary | instantiated symbols | distinct bases |",
        "|---|---:|---:|",
    ] + rows


def state_tables(current: dict[str, Any]) -> list[str]:
    """What this run costs, standing alone: no baseline needed to read it."""
    jobs = current["jobs"]
    lines = [
        "| job | peak memory | largest process | workspace cpu-s | critical path s |",
        "|---|---:|---|---:|---:|",
    ]
    for job, metrics in sorted(jobs.items()):
        used = metrics.get("peak_used_kb", 0)
        rss = metrics.get("peak_rss_kb", 0)
        largest = (
            f"{metrics.get('peak_rss_by') or '?'} {fmt_bytes(rss * 1024)}"
            if rss
            else NOT_SAMPLED
        )
        # wall_s is 0 exactly when the job produced no timing report, which is the only reason
        # the two cpu columns can be empty. A measured 0.0 is printed as 0.0.
        timed = bool(metrics.get("wall_s"))
        cpu = fmt_value(metrics.get("workspace_cpu_s", 0.0)) if timed else NO_TIMINGS
        path = fmt_value(metrics.get("critical_path_s", 0.0)) if timed else NO_TIMINGS
        lines.append(
            f"| {job} | {fmt_bytes(used * 1024) if used else NOT_SAMPLED} | {largest} "
            f"| {cpu} | {path} |"
        )

    binaries = sorted(
        (
            (sizes["bytes"], name, sizes)
            for _job, metrics in jobs.items()
            for name, sizes in metrics.get("binaries", {}).items()
        ),
        key=lambda entry: -entry[0],
    )[:TOP_BINARIES]
    if binaries:
        lines += [
            "",
            "| binary | size | `.text` | symbols | largest crate |",
            "|---|---:|---:|---:|---|",
        ]
        for _, name, sizes in binaries:
            crates = sizes.get("crate_bytes", {})
            largest = max(crates.items(), key=lambda item: item[1], default=None)
            lines.append(
                f"| {name} | {fmt_bytes(sizes['bytes'])} | {fmt_bytes(sizes['text_bytes'])} "
                f"| {sizes['symbols']:,} "
                f"| {f'{largest[0]} {fmt_bytes(largest[1])}' if largest else 'no sized symbols'} |"
            )
        lines += instantiation_table([(name, sizes) for _, name, sizes in binaries])

    units = sorted(
        (
            (cpu, unit, job)
            for job, metrics in jobs.items()
            for unit, cpu in metrics.get("units", {}).items()
        ),
        reverse=True,
    )[:TOP_UNITS]
    if units:
        lines += ["", "| slowest unit | job | cpu-s |", "|---|---|---:|"]
        lines += [f"| {unit} | {job} | {cpu:,.1f} |" for cpu, unit, job in units]
    return lines


def fmt_cell(change: Change) -> str:
    mark = " :warning:" if change.regressed else ""
    return (
        f"{fmt_metric(change.metric, change.main)} -> "
        f"{fmt_metric(change.metric, change.current)} ({change.delta_pct:+.1f}%){mark}"
    )


def comparison_tables(changes: list[Change]) -> list[str]:
    if not changes:
        return ["No job in this run has a counterpart in the baseline run."]
    regressions = [c for c in changes if c.regressed]
    lines = [
        f"**{len(regressions)} over threshold** "
        f"(workspace cpu +{WORKSPACE_CPU_PCT:g}%, critical path +{CRITICAL_PATH_PCT:g}%, "
        f"peak rss +{PEAK_RSS_PCT:g}%, unit +{UNIT_CPU_PCT:g}%, binary +{BINARY_PCT:g}%)."
        if regressions
        else "No metric over threshold.",
        "",
        "| job | " + " | ".join(JOB_METRICS) + " |",
        "|---" * (len(JOB_METRICS) + 1) + "|",
    ]
    by_job: dict[str, dict[str, Change]] = {}
    for change in changes:
        if change.metric in JOB_METRICS:
            by_job.setdefault(change.scope, {})[change.metric] = change
    for job, metrics in sorted(by_job.items()):
        cells = [
            fmt_cell(metrics[m]) if m in metrics else NOT_COMPARED for m in JOB_METRICS
        ]
        lines.append(f"| {job} | " + " | ".join(cells) + " |")
    if any(len(metrics) < len(JOB_METRICS) for metrics in by_job.values()):
        lines += ["", f"{NOT_COMPARED}: missing from this run or from the baseline."]

    movers = top_movers(
        [
            c
            for c in changes
            if c.metric not in JOB_METRICS and abs(c.delta_pct) >= MOVER_MIN_PCT
        ]
    )
    lines.append("")
    lines += table(movers, ["job", "unit or binary"]) or [
        f"No unit or binary moved by more than {MOVER_MIN_PCT:g} %."
    ]
    return lines


def feature_changes(main: dict[str, Any], current: dict[str, Any]) -> FeatureDiff:
    """What the resolved feature sets do against main, unioned over the jobs in both runs.

    The jobs of one run normally hold the same map, so the union keeps the table to one row per
    package while still catching a job that differs. A run whose baseline predates the feature
    record compares nothing, which is why `compared` is separate from an empty diff.
    """
    diff = FeatureDiff({}, [], [], False)
    gained: dict[str, set[str]] = {}
    lost: dict[str, set[str]] = {}
    added: set[str] = set()
    removed: set[str] = set()
    for job, now in current["jobs"].items():
        was = main.get("jobs", {}).get(job, {}).get("features") or {}
        has = now.get("features") or {}
        if not was or not has:
            continue
        diff.compared = True
        added |= set(has) - set(was)
        removed |= set(was) - set(has)
        for package in set(was) & set(has):
            before, after = set(was[package].split()), set(has[package].split())
            gained.setdefault(package, set()).update(after - before)
            lost.setdefault(package, set()).update(before - after)
    diff.changed = {
        package: (sorted(gained[package]), sorted(lost[package]))
        for package in sorted(gained, key=lambda p: (-len(gained[p]), p))
        if gained[package] or lost[package]
    }
    diff.added, diff.removed = sorted(added), sorted(removed)
    return diff


def feature_tables(main: dict[str, Any], current: dict[str, Any]) -> list[str]:
    diff = feature_changes(main, current)
    lines = ["", "### Features against main", ""]
    if not diff.compared:
        return lines + [f"{NO_FEATURE_RECORD}."]
    if not (diff.changed or diff.added or diff.removed):
        return lines + ["No package resolved a different feature set."]
    if diff.changed:
        lines += ["| package | gained | lost |", "|---|---|---|"]
        for package, (plus, minus) in list(diff.changed.items())[:TOP_FEATURE_ROWS]:
            lines.append(
                f"| {package} | {fmt_features(plus)} | {fmt_features(minus)} |"
            )
        if len(diff.changed) > TOP_FEATURE_ROWS:
            lines.append(f"| and {len(diff.changed) - TOP_FEATURE_ROWS} more | | |")
        lines.append("")
    for label, packages in (("Only here", diff.added), ("Only on main", diff.removed)):
        if packages:
            lines.append(
                f"{label}: {fmt_features(packages[:TOP_FEATURE_ROWS])}"
                + (
                    f" and {len(packages) - TOP_FEATURE_ROWS} more."
                    if len(packages) > TOP_FEATURE_ROWS
                    else "."
                )
            )
    return lines


def fmt_features(names: list[str]) -> str:
    return ", ".join(f"`{name}`" for name in names)


def render(
    main: dict[str, Any] | None,
    current: dict[str, Any],
    changes: list[Change],
    title: str,
) -> str:
    lines = [f"## {title}", "", "### This run", ""]
    lines += state_tables(current)
    lines += ["", "### Against main", ""]
    if main is None:
        lines.append("No main-branch baseline available yet.")
    else:
        baseline = (
            f"[{main.get('sha', '')[:8]}]({main['run_url']})"
            if main.get("run_url")
            else main.get("sha", "unknown")[:8]
        )
        lines += [f"Baseline: main {baseline}.", ""]
        lines += comparison_tables(changes)
        lines += feature_tables(main, current)
    lines.append("")
    return "\n".join(lines)


def newest_main_run(stats: dict[str, Any]) -> dict[str, Any] | None:
    return next(iter(stats.get("runs", [])), None)


def cmd_report(args: argparse.Namespace) -> int:
    current = json.loads(args.metrics.read_text())
    main = (
        newest_main_run(json.loads(args.main_stats.read_text()))
        if args.main_stats
        else None
    )
    changes = compare(main, current) if main else []
    summary = render(main, current, changes, args.title)
    print(summary)
    if args.pr_comment_out:
        # The step summary always carries the full table. A PR comment notifies everyone watching
        # the PR, so it is written only when something crossed a threshold; an empty file tells the
        # workflow to delete a comment left by an earlier run that has since been fixed.
        regressed = any(change.regressed for change in changes)
        args.pr_comment_out.write_text(summary if regressed else "")
    return 0


def split_command(argv: list[str]) -> tuple[list[str], list[str]]:
    """Split `... -- COMMAND...` before argparse sees it.

    argparse's own handling of `--` and of REMAINDER has changed between 3.12 patch releases, and
    a misparse here would break a build step. Splitting first makes the parse identical on every
    interpreter.
    """
    if "--" not in argv:
        return argv, []
    index = argv.index("--")
    return argv[:index], argv[index + 1 :]


def main(argv: list[str]) -> int:
    argv, build_command = split_command(argv)
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="subcommand", required=True)

    collect = sub.add_parser("collect", help="metrics for one build job")
    collect.add_argument(
        "--timing", type=Path, help="cargo-timing.html, for jobs built with --timings"
    )
    collect.add_argument(
        "--binaries-dir",
        type=Path,
        help="directory whose executables are measured, e.g. target/release",
    )
    collect.add_argument("--job", required=True, help="label for this job")
    collect.add_argument("--out", required=True, type=Path)
    collect.add_argument(
        "--peak-rss", type=Path, help="JSON written by the sample-rss subcommand"
    )
    collect.add_argument(
        "--raw-out",
        type=Path,
        help="write the uncapped per-crate and per-base tallies here, for later analysis",
    )
    collect.set_defaults(func=cmd_collect)

    sample = sub.add_parser(
        "sample-rss", help="run a build and record the largest VmHWM reached"
    )
    sample.add_argument("--out", required=True, type=Path)
    sample.set_defaults(func=cmd_sample_rss)

    merge = sub.add_parser("merge", help="merge the per-job metrics of one run")
    merge.add_argument(
        "dir", type=Path, help="directory of downloaded per-job artifacts"
    )
    merge.add_argument("--sha", required=True)
    merge.add_argument("--run-id", required=True)
    merge.add_argument("--run-url", required=True)
    merge.add_argument("--out", required=True, type=Path)
    merge.set_defaults(func=cmd_merge)

    report = sub.add_parser("report", help="compare a run against the newest main run")
    report.add_argument("metrics", type=Path, help="merged metrics of this run")
    report.add_argument(
        "--main-stats",
        type=Path,
        help="aggregated main runs from `nextest-ci stats-fetch`",
    )
    report.add_argument(
        "--title",
        default="Compile metrics",
        help="heading for the summary and the comment; distinguishes one workflow's report "
        "from another's when several post to the same pull request",
    )
    report.add_argument(
        "--pr-comment-out",
        type=Path,
        help="write the comment body here, empty unless something crossed a threshold",
    )
    report.set_defaults(func=cmd_report)

    args = parser.parse_args(argv)
    args.build_command = build_command
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
