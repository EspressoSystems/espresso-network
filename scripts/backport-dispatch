#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 PR_NUMBER TARGET_BRANCH" >&2
  exit 1
fi

pr_number="$1"
target_branch="$2"

# Whoever can label a PR sets the target, so allow a plain branch name only, never a git option.
if [[ ! "${target_branch}" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]]; then
  echo "invalid target branch: ${target_branch}" >&2
  exit 1
fi

: "${GITHUB_OUTPUT:?GITHUB_OUTPUT is not set}"
: "${GH_TOKEN:?GH_TOKEN is not set}"

meta=$(gh pr view "${pr_number}" --json state,title,mergeCommit,commits \
  -q '{state,title,sha:.mergeCommit.oid,commits:(.commits | length)}')
if [[ "$(jq -r '.state' <<<"${meta}")" != "MERGED" ]]; then
  echo "PR #${pr_number} is not merged; refusing to backport" >&2
  exit 1
fi
title=$(jq -r '.title' <<<"${meta}")
sha=$(jq -r '.sha' <<<"${meta}")
commits=$(jq -r '.commits' <<<"${meta}")

# The cherry-pick below takes only the merge commit, which holds the whole change only after a
# squash merge. GitHub titles a squash commit "<PR title> (#<number>)".
subject=$(git log -1 --format=%s "${sha}")
if git rev-parse -q --verify "${sha}^2" >/dev/null ||
  [[ "${commits}" -gt 1 && "${subject}" != *"(#${pr_number})" ]]; then
  echo "PR #${pr_number} was not squash-merged, so ${sha} does not hold the whole change;" \
    "backport it by hand" >&2
  exit 1
fi

echo "backporting PR #${pr_number} (${sha}) to ${target_branch}"

branch="backport-${pr_number}-to-${target_branch}"
if git ls-remote --exit-code --heads origin "${branch}" >/dev/null; then
  existing_pr=$(gh pr list --head "${branch}" --state open --json number,url -q '.[0]')
  echo "branch '${branch}' already exists on origin: ${existing_pr:-no open PR}" >&2
  echo "delete the branch (and close its PR) and re-run to retry" >&2
  exit 1
fi

git fetch origin "${target_branch}"
git checkout -b "${branch}" "origin/${target_branch}"

cherry_status=0
git cherry-pick -x "${sha}" || cherry_status=$?

if [[ "${cherry_status}" -ne 0 ]]; then
  # -z: raw paths. Without it, git quotes non-ASCII paths and `git add` cannot match them.
  mapfile -d '' -t conflicted < <(git diff -z --name-only --diff-filter=U)

  if [[ ${#conflicted[@]} -eq 0 ]]; then
    echo "cherry-pick failed (status ${cherry_status}) with no conflicted paths" >&2
    exit 1
  fi

  # A file changed on one side and deleted on the other gets no conflict markers. Committing it
  # as git leaves it would keep the source branch's whole copy of a file the target lacks (DU),
  # or keep a file the original PR deleted (UD). Remove it, and name it in a trailer so the
  # resolution step ports the change to where the target keeps that code.
  mapfile -d '' -t status < <(git status --porcelain -z --untracked-files=no)
  trailers=()
  for ((i = 0; i < ${#status[@]}; i++)); do
    entry="${status[i]}"
    case "${entry:0:2}" in
      DU) trailers+=(--trailer "Backport-Missing: ${entry:3}") ;;
      UD) trailers+=(--trailer "Backport-Deleted: ${entry:3}") ;;
      # A rename or copy carries its source path in the next entry.
      R? | C? | ?R | ?C) i=$((i + 1)); continue ;;
      *) continue ;;
    esac
    git --literal-pathspecs rm -q -f -- "${entry:3}"
  done

  mapfile -d '' -t conflicted < <(git diff -z --name-only --diff-filter=U)
  for path in ${conflicted[@]+"${conflicted[@]}"}; do
    # Git leaves other conflicts without markers too: a binary file or a symlink keeps the
    # target's version, and a file that both sides renamed is present under both names.
    # -I: a binary file never counts as having markers.
    if [[ -L "${path}" ]] || { [[ -f "${path}" ]] && ! grep -q -I -e '^<<<<<<< ' -- "${path}"; }; then
      trailers+=(--trailer "Backport-Unresolved: ${path}")
    fi
  done
  if [[ ${#conflicted[@]} -gt 0 ]]; then
    git --literal-pathspecs add -- "${conflicted[@]}"
  fi
  # --allow-empty: removing the files above can leave nothing to commit.
  git commit --allow-empty -m "backport: cherry-pick #${pr_number} to ${target_branch}" \
             -m "Cherry-picked from ${sha}; conflicts committed for resolution." \
             ${trailers[@]+"${trailers[@]}"}
fi

git push -u origin "${branch}"

pr_url=$(gh pr create \
  --base "${target_branch}" \
  --head "${branch}" \
  --draft \
  --title "[Backport ${target_branch}] ${title}" \
  --body "Backport of #${pr_number} to \`${target_branch}\`.")
pr_number_new="${pr_url##*/}"

if [[ -z "${pr_number_new}" || ! "${pr_number_new}" =~ ^[0-9]+$ ]]; then
  echo "Could not parse new PR number from gh output: ${pr_url}" >&2
  exit 1
fi

echo "created_pull_numbers=${pr_number_new}" >>"${GITHUB_OUTPUT}"
