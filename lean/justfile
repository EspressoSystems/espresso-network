default:
    just --list

# Build the specification and check its claims about itself.
spec:
    cd new-protocol-spec && lake build

# Check that every name the specification's prose mentions still exists.
lint:
    cd new-protocol-spec && lake exe lint

# Build the executable machine and its conformance proof.
impl:
    cd new-protocol-impl && lake build

# Build the trace checker and the simulator.
diff:
    cd new-protocol-diff && lake build

# Run the machine on random schedules over a simulated network, and check every run.
sim seeds="4":
    cd new-protocol-diff && lake build sim && .lake/build/bin/sim {{seeds}}

# Build and render the reference document.
docs:
    cd new-protocol-docs && lake build && .lake/build/bin/reference --output _out --with-tex

# Check that every result of the specification is spliced into the reference.
coverage:
    cd new-protocol-docs && lake exe coverage

pdf: docs
    cd new-protocol-docs/_out/tex && latexmk -lualatex -interaction=nonstopmode main.tex

serve-docs: docs
    cd new-protocol-docs/_out/html-multi && python3 -m http.server --bind 127.0.0.1 8000

# Build the stake table specification and prove its invariant.
stake-spec:
    cd stake-table-spec && lake build

# Build the stake table implementation and its conformance proof.
stake-impl:
    cd stake-table-impl && lake build

# Build the checker that compares the node's stake table cases with the implementation.
stake-check:
    cd stake-table-diff && lake build

all: spec lint impl diff sim docs coverage stake-spec stake-impl stake-check


# Generate stake table cases with the node's results, and check them against the
# Lean implementation.
stake-diff dir="../target/stake-table-corpus":
    rm -f {{absolute_path(dir)}}/*.jsonl
    STAKE_TABLE_CORPUS={{absolute_path(dir)}} cargo test -p espresso-types --lib stake_table_corpus -- --ignored
    cd stake-table-diff && lake build && .lake/build/bin/check {{absolute_path(dir)}}
