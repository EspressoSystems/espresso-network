          schema:
            minimum: 0
            type: integer
          style: simple
      responses:
        "200":
          description: ""
      summary: Get blocks in range
      tags:
        - availability
  "/v1/availability/block/{from}/{until}/namespace/{namespace}":
    get:
      description: "Get the transactions in the specified namespace from each block in a range, with proofs."
      parameters:
        - in: path
          name: from
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
        - in: path
          name: until
