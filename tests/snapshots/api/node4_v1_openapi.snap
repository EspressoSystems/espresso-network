            minimum: 0
            type: integer
          style: simple
      responses:
        "200":
          description: ""
      summary: Get namespace proof
      tags:
        - availability
  "/v1/availability/block/summaries/{from}/{until}":
    get:
      description: "Get block summaries by position, from the given `from` up to `until`."
      parameters:
        - in: path
          name: from
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
        - in: path
          name: until
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
      responses:
        "200":
          description: ""
      summary: Get block summaries in range
      tags:
        - availability
  "/v1/availability/block/summary/{height}":
    get:
      description: Get the block summary for a block based on its position in the ledger.
      parameters:
        - in: path
          name: height
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
      responses:
        "200":
          description: ""
      summary: Get block summary
      tags:
        - availability
  "/v1/availability/block/{from}/{until}":
    get:
      description: "Get blocks by position in the ledger, from the given `from` up to `until`."
