        "200":
          description: ""
      summary: Get RewardMerkleTreeV2 snapshot
      tags:
        - reward-state-v2
  "/v1/reward-state-v2/{height}/{key}":
    get:
      description: "Retrieve the Merkle path for the membership proof of a leaf in the reward-state-v2 tree, by block height and key."
