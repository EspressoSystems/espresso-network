      description: "Retrieve the Merkle path for the membership proof of a leaf in the reward-state-v2 tree, by tree commitment and key."
      parameters:
        - in: path
          name: commit
          required: true
          schema:
            type: string
          style: simple
        - in: path
          name: key
          required: true
          schema:
            type: string
          style: simple
      responses:
        "200":
          description: ""
      summary: Get reward-state-v2 Merkle path by commitment
      tags:
        - reward-state-v2
  "/v1/reward-state-v2/proof/latest/{address}":
    get:
      description: Get the Merkle proof (RewardAccountProofV2) for a reward account at the latest block height finalized by the light client contract.
      parameters:
        - in: path
          name: address
          required: true
          schema:
            type: string
          style: simple
      responses:
        "200":
          description: ""
      summary: Get latest reward account proof
      tags:
        - reward-state-v2
  "/v1/reward-state-v2/proof/{height}/{address}":
    get:
      description: "Get the Merkle proof for a reward account at a given block height (RewardAccountProofV1 pre-V4, RewardAccountProofV2 from V4 onward)."
      parameters:
        - in: path
          name: height
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
        - in: path
          name: address
          required: true
          schema:
            type: string
          style: simple
      responses:
        "200":
          description: ""
      summary: Get reward account proof
      tags:
        - reward-state-v2
  "/v1/reward-state-v2/reward-amounts/{height}/{offset}/{limit}":
    get:
      description: "Return all RewardMerkleTreeV2 accounts stored for the requested height, paginated by offset and limit (limit must be <= 10000)."
      parameters:
        - in: path
          name: height
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
        - in: path
          name: offset
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
        - in: path
          name: limit
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
      responses:
        "200":
          description: ""
      summary: List reward amounts
      tags:
        - reward-state-v2
  "/v1/reward-state-v2/reward-balance/latest/{address}":
    get:
      description: Get current balance in reward state for an Ethereum address.
      parameters:
        - in: path
          name: address
          required: true
          schema:
            type: string
          style: simple
      responses:
        "200":
          description: ""
      summary: Get latest reward balance
      tags:
        - reward-state-v2
  "/v1/reward-state-v2/reward-balance/{height}/{address}":
    get:
      description: Get balance in reward state at a specific height for an Ethereum address.
      parameters:
        - in: path
          name: height
          required: true
          schema:
            minimum: 0
            type: integer
          style: simple
        - in: path
          name: address
          required: true
          schema:
            type: string
          style: simple
      responses:
        "200":
          description: ""
      summary: Get reward balance at height
