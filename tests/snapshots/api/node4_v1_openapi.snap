        - reward-state-v2
  "/v1/reward-state-v2/reward-claim-input/{height}/{address}":
    get:
      description: "Returns the RewardClaimInput needed to call claimRewards() on L1: lifetime rewards, Merkle proof, and auth root inputs, for the account at the given block height finalized by the light client contract."
      parameters:
        - in: path
          name: height
          required: true
