# Recipes for the binary upgrade test. Invoke via `just binary-upgrade-tests::<recipe>`.

run *args:
    ./run.py {{args}}

fmt *args:
    ruff format run.py test_run.py {{args}}

lint *args:
    ruff check run.py test_run.py {{args}}

check *args:
    ty check run.py {{args}}

test *args:
    uv run --with pytest --with-requirements run.py pytest test_run.py {{args}}
